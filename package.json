{
  "name": "axonwall",
  "version": "0.11.73",
  "private": true,
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:ui": "turbo run dev --filter=axonwall-ui",
    "dev:daemon": "cd apps/axonwalld && mkdir -p bin && go build -o bin/axonwalld . && sudo --preserve-env=SUDO_UID,SUDO_GID,SUDO_USER,AXONWALL_AGENT_TOKEN,AXONWALL_DEV_MODE ./bin/axonwalld --dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "postcss": ">=8.5.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "postcss": ">=8.5.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "postcss": "^8.5.32"
  }
}
