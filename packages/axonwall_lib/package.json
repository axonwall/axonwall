{
  "name": "@axonwall/lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./compile/nft": {
      "types": "./dist/compile/nft/index.d.ts",
      "default": "./dist/compile/nft/index.js"
    },
    "./compile/kea": {
      "types": "./dist/compile/kea/index.d.ts",
      "default": "./dist/compile/kea/index.js"
    },
    "./compile/unbound": {
      "types": "./dist/compile/unbound/index.d.ts",
      "default": "./dist/compile/unbound/index.js"
    },
    "./compile/wireguard": {
      "types": "./dist/compile/wireguard/index.d.ts",
      "default": "./dist/compile/wireguard/index.js"
    },
    "./import/opnsense": {
      "types": "./dist/import/opnsense/index.d.ts",
      "default": "./dist/import/opnsense/index.js"
    },
    "./rbac": {
      "types": "./dist/rbac/index.d.ts",
      "default": "./dist/rbac/index.js"
    },
    "./ldap": {
      "types": "./dist/ldap/index.d.ts",
      "default": "./dist/ldap/index.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "default": "./dist/util/index.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "default": "./dist/lint/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "fast-xml-parser": "^5.4.1",
    "jose": "^6.0.8",
    "ldapts": "^8.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
