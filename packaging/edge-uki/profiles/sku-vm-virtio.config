# ==============================================================================
# Axonwall Manufacturing Hardware Profile: sku-vm-virtio (DEFAULT)
# Target Hardware: KVM / QEMU / Proxmox VE / Cloud Virtual Edge NGFW Appliance
# NICs: VirtIO Paravirtualized Network (virtio_net) ONLY — zero physical drivers
# Compiler Tuning: -march=x86-64-v1 / GOAMD64=v1 (Maximum Hypervisor Portability)
# ==============================================================================
# AXONWALL_SKU_ARCH=amd64
# AXONWALL_GOAMD64=v1
# AXONWALL_KCFLAGS=-O2 -march=x86-64

CONFIG_X86_64=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Paravirtualized VirtIO Bus, Console, RNG, Cloud-Init Seed Block/CD-ROM & Multi-Queue Network
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_NET_FAILOVER=y
CONFIG_SCSI_COMMON=y
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_FW_CFG_SYSFS=y
CONFIG_FW_CFG_SYSFS_CMDLINE=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_I6300ESB_WDT=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y

# Explicitly strip all physical NIC vendors, physical storage controllers & hardware sensors
# for the fastest possible kernel build and smallest (~6.5 MB) UKI footprint
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_REALTEK is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_ATHEROS is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_ATA is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set

# Crypto Acceleration
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_CHACHA20_X86_64=y
CONFIG_CRYPTO_POLY1305_X86_64=y
