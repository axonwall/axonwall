# ==============================================================================
# Axonwall Manufacturing Hardware Profile: sku-x86-enterprise-10g-25g
# Target Hardware: 1U/2U Enterprise Rack NGFW (Intel Xeon D / Scalable & AMD EPYC)
# NICs: Intel X550/82599 10GbE (ixgbe), X710 10/25/40GbE (i40e), E810 25/100GbE (ice),
#       and NVIDIA/Mellanox ConnectX-5/6/7 25/100GbE (mlx5_core)
# Compiler Tuning: -march=x86-64-v3 / GOAMD64=v3
# ==============================================================================
# AXONWALL_SKU_ARCH=amd64
# AXONWALL_GOAMD64=v3
# AXONWALL_KCFLAGS=-O3 -march=x86-64-v3

CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=128
CONFIG_NUMA=y
CONFIG_X86_64_ACPI_NUMA=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y

# High-Speed Crypto & WireGuard AVX2/AVX-512 Acceleration
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_CHACHA20_X86_64=y
CONFIG_CRYPTO_POLY1305_X86_64=y
CONFIG_CRYPTO_SHA256_SSSE3=y
CONFIG_CRYPTO_SHA512_SSSE3=y
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=y

# Built-in 10GbE / 25GbE / 40GbE / 100GbE Carrier NIC Drivers (Zero Modules)
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IXGBE=y
CONFIG_I40E=y
CONFIG_ICE=y
CONFIG_IGC=y
CONFIG_IGB=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y
CONFIG_PAGE_POOL=y

# Dedicated Appliance Boot Disk (NVMe / SATA DOM), Watchdog & EFI Variables for A/B UKI Slots + CIDATA
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EFIVAR_FS=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_ITCO_WDT=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
