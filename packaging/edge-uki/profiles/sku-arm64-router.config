# ==============================================================================
# Axonwall Manufacturing Hardware Profile: sku-arm64-router
# Target Hardware: ARM64 SoC Edge Gateway (MediaTek Filogic MT7988A / Marvell Armada)
# NICs: Built-in DSA Switch Fabric (mt7530_dsa), mvpp2, & VirtIO ARM64
# Compiler Tuning: GOARCH=arm64 (ARMv8 Crypto Extensions AES/SHA2/NEON)
# ==============================================================================
# AXONWALL_SKU_ARCH=arm64
# AXONWALL_GOAMD64=
# AXONWALL_KCFLAGS=-O3 -mcpu=cortex-a73+crypto

CONFIG_ARM64=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_MVEBU=y
CONFIG_ARM64_CRYPTO=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_CCM=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_CHACHA20_NEON=y
CONFIG_CRYPTO_POLY1305_ARM64=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y

# Distributed Switch Architecture (DSA) & SoC Ethernet MACs
CONFIG_NET_DSA=y
CONFIG_NET_DSA_MT7530=y
CONFIG_NET_VENDOR_MEDIATEK=y
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_MEDIATEK_GE_PHY=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_MVPP2=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
