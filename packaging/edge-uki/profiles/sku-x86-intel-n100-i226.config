# ==============================================================================
# Axonwall Manufacturing Hardware Profile: sku-x86-intel-n100-i226
# Target Hardware: Intel Alder Lake-N (N100 / N305) Desktop & 1U Branch Appliance
# NICs: 4x or 6x Intel i225-V / i226-V 2.5GbE (CONFIG_IGC=y) + 1GbE (CONFIG_IGB=y)
# Compiler Tuning: -march=alderlake / GOAMD64=v3 (AVX2, BMI2, AES-NI, VAES)
# ==============================================================================
# AXONWALL_SKU_ARCH=amd64
# AXONWALL_GOAMD64=v3
# AXONWALL_KCFLAGS=-O3 -march=x86-64-v3 -mtune=alderlake

CONFIG_X86_64=y
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_MCORE2=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y

# Hardware Crypto Acceleration (AES-NI, ChaCha20-Poly1305 AVX2, SHA-NI)
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_CHACHA20_X86_64=y
CONFIG_CRYPTO_POLY1305_X86_64=y
CONFIG_CRYPTO_SHA256_SSSE3=y
CONFIG_CRYPTO_SHA512_SSSE3=y
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=y
CONFIG_HW_RANDOM_INTEL=y

# Built-in 2.5GbE & 1GbE Intel NIC Drivers (Zero Modules)
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IGC=y
CONFIG_IGB=y
CONFIG_E1000E=y

# Hardware Watchdog (Intel TCO Watchdog for Autonomous Hang Recovery)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_ITCO_WDT=y
CONFIG_ITCO_VENDOR_SUPPORT=y

# Dedicated Appliance Boot Disk (NVMe / SATA DOM) & EFI Variables for A/B UKI Slots + CIDATA
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EFIVAR_FS=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
