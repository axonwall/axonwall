#!/bin/sh
# ==============================================================================
# Axonwall Alpine Linux OpenRC <-> systemctl Compatibility Shim
# ==============================================================================

ACTION=""
UNITS=""
PROP_FILTER=""
PROP_VALUE=0

while [ $# -gt 0 ]; do
  case "$1" in
    --no-block|--no-pager|-q|--quiet|--system|--full|-l)
      shift
      ;;
    -p|--property)
      if [ $# -lt 2 ]; then
        echo "systemctl: option '$1' requires an argument" >&2
        exit 1
      fi
      if [ -n "$PROP_FILTER" ]; then
        PROP_FILTER="${PROP_FILTER},$2"
      else
        PROP_FILTER="$2"
      fi
      shift 2
      ;;
    --property=*)
      _pval="${1#--property=}"
      if [ -n "$PROP_FILTER" ]; then
        PROP_FILTER="${PROP_FILTER},${_pval}"
      else
        PROP_FILTER="$_pval"
      fi
      shift
      ;;
    --value)
      PROP_VALUE=1
      shift
      ;;
    start|stop|restart|try-restart|try-reload-or-restart|reload|status|enable|disable|is-enabled|daemon-reload|reboot|poweroff|show|is-active)
      if [ -z "$ACTION" ]; then
        ACTION="$1"
      else
        UNITS="$UNITS $1"
      fi
      shift
      ;;
    -*)
      shift
      ;;
    *)
      UNITS="$UNITS $1"
      shift
      ;;
  esac
done

normalize_svc() {
  svc="${1%.service}"
  if [ "$svc" = "kea-dhcp4-server" ] && [ -x /etc/init.d/kea-dhcp4 ]; then
    echo "kea-dhcp4"
  elif [ "$svc" = "ssh" ] && [ -x /etc/init.d/sshd ]; then
    echo "sshd"
  elif [ "$svc" = "chrony" ] && [ -x /etc/init.d/chronyd ]; then
    echo "chronyd"
  else
    echo "$svc"
  fi
}

case "$ACTION" in
  daemon-reload)
    exit 0
    ;;
  reboot)
    exec /sbin/reboot
    ;;
  poweroff)
    exec /sbin/poweroff
    ;;
  enable)
    for u in $UNITS; do
      s="$(normalize_svc "$u")"
      [ -x "/etc/init.d/$s" ] && rc-update add "$s" default >/dev/null 2>&1 || true
    done
    exit 0
    ;;
  disable)
    for u in $UNITS; do
      s="$(normalize_svc "$u")"
      rc-update del "$s" default >/dev/null 2>&1 || true
    done
    exit 0
    ;;
  start|stop|restart|reload|status)
    rc=0
    for u in $UNITS; do
      s="$(normalize_svc "$u")"
      if [ -x "/etc/init.d/$s" ]; then
        rc-service "$s" "$ACTION" || rc=$?
      else
        rc=1
      fi
    done
    exit $rc
    ;;
  try-restart|try-reload-or-restart)
    rc=0
    for u in $UNITS; do
      s="$(normalize_svc "$u")"
      if [ -e "/run/openrc/started/$s" ] && [ -x "/etc/init.d/$s" ]; then
        rc-service "$s" restart || rc=$?
      fi
    done
    exit $rc
    ;;
  is-enabled)
    for u in $UNITS; do
      s="$(normalize_svc "$u")"
      if rc-update show default 2>/dev/null | grep -qw "$s"; then
        echo "enabled"
        exit 0
      else
        echo "disabled"
        exit 1
      fi
    done
    ;;
  is-active)
    for u in $UNITS; do
      s="$(normalize_svc "$u")"
      if [ -e "/run/openrc/started/$s" ]; then
        echo "active"
        exit 0
      else
        echo "inactive"
        exit 3
      fi
    done
    ;;
  show)
    emit_prop() {
      _k="$1"
      _v="$2"
      if [ -n "$PROP_FILTER" ]; then
        case ",${PROP_FILTER}," in
          *",${_k},"*) ;;
          *) return 0 ;;
        esac
      fi
      if [ "$PROP_VALUE" = "1" ]; then
        echo "$_v"
      else
        echo "${_k}=${_v}"
      fi
    }
    for u in $UNITS; do
      s="$(normalize_svc "$u")"
      if [ ! -x "/etc/init.d/$s" ]; then
        exit 1
      fi
      ACTIVE="inactive"
      SUB="dead"
      PID="0"
      MEM="0"
      if [ -e "/run/openrc/started/$s" ]; then
        ACTIVE="active"
        SUB="running"
      elif [ -e "/run/openrc/failed/$s" ]; then
        ACTIVE="failed"
        SUB="failed"
      fi
      for pf in "/run/${s}.pid" "/run/${s}/${s}.pid" "/var/run/${s}.pid"; do
        if [ -f "$pf" ]; then
          PID="$(cat "$pf" 2>/dev/null | tr -d '[:space:]')"
          break
        fi
      done
      if [ -z "$PID" ] || [ "$PID" = "0" ]; then
        PID="$(pgrep -f "$s" 2>/dev/null | head -n 1)"
        [ -z "$PID" ] && PID="0"
      fi
      if [ "$PID" != "0" ] && [ -f "/proc/$PID/status" ]; then
        RSS_KB="$(awk '/VmRSS:/ {print $2}' "/proc/$PID/status" 2>/dev/null)"
        if [ -n "$RSS_KB" ]; then
          MEM=$((RSS_KB * 1024))
        fi
      fi
      emit_prop "ActiveState" "$ACTIVE"
      emit_prop "SubState" "$SUB"
      emit_prop "MainPID" "$PID"
      emit_prop "MemoryCurrent" "$MEM"
    done
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
