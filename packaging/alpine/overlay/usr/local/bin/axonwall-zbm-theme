#!/usr/bin/env bash
# ==============================================================================
# Axonwall ZFSBootMenu Visual Theme & Bootloader Management Utility
# Also serves as `generate-zbm` and `zbm-kcl` when invoked via symlink.
# ==============================================================================
set -euo pipefail

COLOR_RESET="\033[0m"
COLOR_BOLD="\033[1m"
COLOR_EMERALD="\033[38;2;52;211;153m"
COLOR_CYAN="\033[38;2;6;182;212m"
COLOR_SLATE="\033[38;2;148;163;184m"
COLOR_RED="\033[38;2;244;63;94m"

ZBM_CONFIG="/etc/zfsbootmenu/config.yaml"
ZBM_SPLASH="/etc/zfsbootmenu/splash.bmp"
ZBM_HOOK_DIR="/etc/zfsbootmenu/hooks"
ZBM_THEME_HOOK="${ZBM_HOOK_DIR}/early-setup.d/90-axonwall-theme.sh"
ZBM_THEME_HOOK_LEGACY="${ZBM_HOOK_DIR}/early-setup.d/15-axonwall-theme.sh"
ESP_MOUNT="/boot/efi"
ESP_ZBM_DIR="${ESP_MOUNT}/EFI/ZBM"
ESP_ZBM_HOOKS="${ESP_ZBM_DIR}/hooks"
ESP_UKI="${ESP_ZBM_DIR}/VMLINUZ.EFI"
ESP_SYSLINUX="${ESP_ZBM_DIR}/syslinux.cfg"

show_banner() {
  printf "${COLOR_EMERALD}${COLOR_BOLD}Axonwall ZFSBootMenu Theme & UKI Manager${COLOR_RESET}\n"
  printf "${COLOR_SLATE}Root-on-ZFS Bootloader Visual Styling, Fonts, Palettes & UKI Sync${COLOR_RESET}\n\n"
}

usage() {
  show_banner
  cat << EOF
Usage: axonwall-zbm-theme [COMMAND] [OPTIONS]

Commands:
  status                Show current boot splash, console font, and color theme
  set-font <font>       Set console font (e.g. auto, ter-v32b, ter-v28b, ter-v24b, ter-v20b, ter-v14b)
  set-splash <file>     Install custom boot splash image (.bmp or .png)
  set-palette <scheme>  Switch 16-color ANSI console palette
                        Available: axonwall (default), cyber-cyan, dracula, nord, monokai
  apply                 Rebuild & sync ZFSBootMenu UEFI UKI, BIOS Syslinux & mirror ESPs

Options:
  -h, --help            Show this help text
EOF
}

sync_secondary_esps() {
  local primary_dev
  primary_dev="$(findmnt -n -o SOURCE "$ESP_MOUNT" 2>/dev/null || true)"
  [ -b "$primary_dev" ] || return 0

  local sec_dev
  for sec_dev in $(blkid -t LABEL="AXON_EFI" -o device 2>/dev/null || true); do
    [ -b "$sec_dev" ] || continue
    [ "$sec_dev" = "$primary_dev" ] && continue
    local tmp_mnt
    tmp_mnt="$(mktemp -d /tmp/axon-esp-sync.XXXXXX)"
    if mount "$sec_dev" "$tmp_mnt" 2>/dev/null; then
      cp -rf "${ESP_MOUNT}/EFI" "$tmp_mnt/" 2>/dev/null || true
      [ -f "${ESP_MOUNT}/syslinux.cfg" ] && cp -f "${ESP_MOUNT}/syslinux.cfg" "$tmp_mnt/syslinux.cfg" 2>/dev/null || true
      sync
      umount "$tmp_mnt" 2>/dev/null || true
      printf "[+] Synchronized secondary mirror ESP: %s\n" "$sec_dev"
    fi
    rmdir "$tmp_mnt" 2>/dev/null || true
  done
}

cmd_status() {
  show_banner
  printf " ${COLOR_BOLD}Configuration Files:${COLOR_RESET}\n"
  printf "   ZBM Config    : %s %s\n" "$ZBM_CONFIG" "$([ -f "$ZBM_CONFIG" ] && printf '[OK]' || printf '[MISSING]')"
  printf "   Splash Image  : %s %s\n" "$ZBM_SPLASH" "$([ -f "$ZBM_SPLASH" ] && printf '[OK]' || printf '[MISSING]')"
  printf "   Theme Hook    : %s %s\n" "$ZBM_THEME_HOOK" "$([ -f "$ZBM_THEME_HOOK" ] && printf '[OK]' || printf '[MISSING]')"
  printf "   Installed UKI : %s %s\n" "$ESP_UKI" "$([ -f "$ESP_UKI" ] && printf '[OK]' || printf '[MISSING]')"
  echo ""

  if [ -f "$ESP_UKI" ] && command -v objcopy >/dev/null 2>&1; then
    printf " ${COLOR_BOLD}Installed UKI (.EFI) Inspection:${COLOR_RESET}\n"
    if objdump -h "$ESP_UKI" 2>/dev/null | grep -q '\.splash'; then
      printf "   Splash Section: ${COLOR_EMERALD}Embedded (.splash section present)${COLOR_RESET}\n"
    else
      printf "   Splash Section: ${COLOR_SLATE}None (fallback text only)${COLOR_RESET}\n"
    fi

    KCL_TMP=$(mktemp)
    if objcopy --dump-section .cmdline="$KCL_TMP" "$ESP_UKI" 2>/dev/null; then
      KCL_STR=$(tr -d '\0' < "$KCL_TMP" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      printf "   Kernel Cmdline: %s\n" "$KCL_STR"
      CUR_FONT=$(echo "$KCL_STR" | grep -o 'rd\.vconsole\.font=[^ ]*' | cut -d= -f2 || true)
      printf "   Active Font   : ${COLOR_CYAN}%s${COLOR_RESET}\n" "${CUR_FONT:-auto (zbm.autosize=1)}"
    fi
    rm -f "$KCL_TMP"
  fi
  echo ""
}

cmd_set_font() {
  local font="${1:-}"
  if [ -z "$font" ]; then
    printf "${COLOR_RED}Error: Font face name required (e.g. auto, ter-v32b, ter-v28b, ter-v24b, default)${COLOR_RESET}\n"
    exit 1
  fi

  show_banner
  printf "[+] Updating target console font to: %s\n" "$font"

  if [ -f "$ZBM_CONFIG" ]; then
    if [ "$font" = "default" ] || [ "$font" = "auto" ]; then
      sed -i -E 's/[[:space:]]*rd\.vconsole\.font=[^ "]+//g' "$ZBM_CONFIG"
    else
      if grep -q "rd\.vconsole\.font=" "$ZBM_CONFIG"; then
        sed -i -E "s|rd\.vconsole\.font=[^ \"']+|rd.vconsole.font=${font}|g" "$ZBM_CONFIG"
      else
        sed -i -E "s|(zbm\.autosize=1)|\1 rd.vconsole.font=${font}|" "$ZBM_CONFIG"
      fi
    fi
  fi

  cmd_apply "$font"
  printf "${COLOR_EMERALD}[✓] Console font updated successfully.${COLOR_RESET}\n"
}

cmd_set_splash() {
  local src="${1:-}"
  if [ -z "$src" ] || [ ! -f "$src" ]; then
    printf "${COLOR_RED}Error: Splash image file not found: %s${COLOR_RESET}\n" "$src"
    exit 1
  fi

  show_banner
  printf "[+] Processing splash image: %s\n" "$src"

  mkdir -p /etc/zfsbootmenu "$ESP_ZBM_DIR"
  case "$src" in
    *.bmp)
      cp -f "$src" "$ZBM_SPLASH"
      ;;
    *.png|*.jpg|*.jpeg)
      if command -v convert >/dev/null 2>&1; then
        convert "$src" -type truecolor -compress none "$ZBM_SPLASH"
      elif command -v magick >/dev/null 2>&1; then
        magick "$src" -type truecolor -compress none "$ZBM_SPLASH"
      else
        printf "${COLOR_RED}Error: ImageMagick (convert/magick) required to convert %s to .bmp${COLOR_RESET}\n" "$src"
        exit 1
      fi
      ;;
    *)
      printf "${COLOR_RED}Error: Unsupported image format. Use .bmp or .png${COLOR_RESET}\n" "$src"
      exit 1
      ;;
  esac

  cmd_apply
  printf "${COLOR_EMERALD}[✓] Splash screen updated successfully.${COLOR_RESET}\n"
}

cmd_set_palette() {
  local scheme="${1:-axonwall}"
  show_banner

  local seq=""
  case "$scheme" in
    axonwall|default)
      printf "[+] Applying Axonwall Cyber-Slate & Emerald palette...\n"
      seq="P0090e1a\033]P1f43f5e\033]P210b981\033]P3f59e0b\033]P40284c7\033]P58b5cf6\033]P606b6d4\033]P7cbd5e1\033]P81e293b\033]P9fb7185\033]PA34d399\033]PBfbbf24\033]PC38bdf8\033]PDa78bfa\033]PE22d3ee\033]PFf8fafc"
      ;;
    cyber-cyan)
      printf "[+] Applying Cyber-Cyan palette...\n"
      seq="P003131e\033]P1f43f5e\033]P206b6d4\033]P3f59e0b\033]P40284c7\033]P58b5cf6\033]P638bdf8\033]P7e0f2fe\033]P80f293d\033]P9fb7185\033]PA22d3ee\033]PBfbbf24\033]PC7dd3fc\033]PDa78bfa\033]PEa5f3fc\033]PFf0f9ff"
      ;;
    nord)
      printf "[+] Applying Nord palette...\n"
      seq="P02e3440\033]P1bf616a\033]P2a3be8c\033]P3ebcb8b\033]P481a1c1\033]P5b48ead\033]P688c0d0\033]P7e5e9f0\033]P84c566a\033]P9d08770\033]PAa3be8c\033]PBebcb8b\033]PC81a1c1\033]PDb48ead\033]PE8fbcbb\033]PFeceff4"
      ;;
    dracula)
      printf "[+] Applying Dracula palette...\n"
      seq="P0282a36\033]P1ff5555\033]P250fa7b\033]P3f1fa8c\033]P4bd93f9\033]P5ff79c6\033]P68be9fd\033]P7f8f8f2\033]P86272a4\033]P9ff6e6e\033]PA69ff94\033]PBffffa5\033]PCd6acff\033]PDff92df\033]PEa4ffff\033]PFffffff"
      ;;
    monokai)
      printf "[+] Applying Monokai palette...\n"
      seq="P0272822\033]P1f92672\033]P2a6e22e\033]P3f4bf75\033]P466d9ef\033]P5ae81ff\033]P6a1efe4\033]P7f8f8f2\033]P875715e\033]P9fd971f\033]PAa6e22e\033]PBe6db74\033]PC66d9ef\033]PDae81ff\033]PEa1efe4\033]PFf9f8f5"
      ;;
    *)
      printf "${COLOR_RED}Error: Unknown color palette '%s'. Available: axonwall, cyber-cyan, nord, dracula, monokai${COLOR_RESET}\n" "$scheme"
      exit 1
      ;;
  esac

  mkdir -p "${ZBM_HOOK_DIR}/early-setup.d" "${ESP_ZBM_HOOKS}/early-setup.d"

  cat << HOOK_EOF > "$ZBM_THEME_HOOK"
#!/bin/bash
# Axonwall ZFSBootMenu Visual Theme Hook (${scheme})
TERM_DEV="\${control_term:-/dev/tty1}"
case "\$TERM_DEV" in
  /dev/tty[0-9]*) ;;
  *) TERM_DEV="/dev/tty1" ;;
esac
[ -c "\$TERM_DEV" ] || TERM_DEV="/dev/tty0"

if [ -c "\$TERM_DEV" ]; then
  printf '\033]${seq}' > "\$TERM_DEV" 2>/dev/null || true
  printf '\033[2J\033[H' > "\$TERM_DEV" 2>/dev/null || true
fi

for fzf_cfg in /lib/fzf-defaults.sh /usr/lib/fzf-defaults.sh; do
  if [ -f "\$fzf_cfg" ] && ! grep -q "AXONWALL_FZF_THEME" "\$fzf_cfg" 2>/dev/null; then
    cat << 'FZF_EOF' >> "\$fzf_cfg"

# AXONWALL_FZF_THEME
fuzzy_default_options+=(
  "--color='border:cyan,label:brightcyan,preview-label:brightgreen,current-fg:brightgreen,selected-fg:brightcyan,prompt:brightgreen,pointer:brightgreen,marker:brightgreen,header:cyan,info:brightblue,spinner:brightgreen,hl:brightgreen,hl+:brightcyan'"
)
export FZF_DEFAULT_OPTS="\${fuzzy_default_options[*]}"
FZF_EOF
  fi
done

if [ "\${0##*/}" = "15-axonwall-theme.sh" ] && [ -d /libexec/hooks/early-setup.d ] && [ ! -f /libexec/hooks/early-setup.d/90-axonwall-theme.sh ]; then
  cp -f "\$0" /libexec/hooks/early-setup.d/90-axonwall-theme.sh 2>/dev/null || true
  chmod +x /libexec/hooks/early-setup.d/90-axonwall-theme.sh 2>/dev/null || true
fi

exit 0
HOOK_EOF

  chmod +x "$ZBM_THEME_HOOK"
  cp -f "$ZBM_THEME_HOOK" "$ZBM_THEME_HOOK_LEGACY"
  chmod +x "$ZBM_THEME_HOOK_LEGACY"

  cmd_apply
  printf "${COLOR_EMERALD}[✓] Palette '%s' applied to UKI, initramfs, and EFI partition.${COLOR_RESET}\n" "$scheme"
}

cmd_apply() {
  local font_arg="${1:-auto}"
  show_banner
  printf "[+] Synchronizing ZFSBootMenu UKI, initramfs hooks, and Syslinux config...\n"

  mkdir -p "${ESP_ZBM_DIR}" "${ESP_MOUNT}/EFI/BOOT" "${ESP_ZBM_HOOKS}/early-setup.d" "${ESP_ZBM_HOOKS}/setup.d"
  [ -f "$ZBM_SPLASH" ] && cp -f "$ZBM_SPLASH" "${ESP_ZBM_DIR}/splash.bmp"
  if [ -f "$ZBM_THEME_HOOK" ]; then
    cp -f "$ZBM_THEME_HOOK" "${ESP_ZBM_HOOKS}/early-setup.d/90-axonwall-theme.sh"
    cp -f "$ZBM_THEME_HOOK" "${ESP_ZBM_HOOKS}/early-setup.d/15-axonwall-theme.sh"
  elif [ -f "$ZBM_THEME_HOOK_LEGACY" ]; then
    cp -f "$ZBM_THEME_HOOK_LEGACY" "${ESP_ZBM_HOOKS}/early-setup.d/90-axonwall-theme.sh"
    cp -f "$ZBM_THEME_HOOK_LEGACY" "${ESP_ZBM_HOOKS}/early-setup.d/15-axonwall-theme.sh"
  fi
  [ -f "${ZBM_HOOK_DIR}/setup.d/20-axonwall-watchdog.sh" ] && cp -f "${ZBM_HOOK_DIR}/setup.d/20-axonwall-watchdog.sh" "${ESP_ZBM_HOOKS}/setup.d/20-axonwall-watchdog.sh"
  chmod +x "${ESP_ZBM_HOOKS}"/*/*.sh 2>/dev/null || true

  local src_uki="/usr/lib/zfsbootmenu/vmlinuz.efi"
  [ -f "$src_uki" ] || src_uki="$ESP_UKI"

  if [ -f "$src_uki" ] && [ -x /usr/lib/axonwall/theme-zbm-uki.py ]; then
    python3 /usr/lib/axonwall/theme-zbm-uki.py "$src_uki" \
      -o "$ESP_UKI" \
      -s "$ZBM_SPLASH" \
      -f "$font_arg" \
      --extract-linux "${ESP_ZBM_DIR}/vmlinuz-bootmenu" \
      --extract-initrd "${ESP_ZBM_DIR}/initramfs-bootmenu.img"
    cp -f "$ESP_UKI" "${ESP_ZBM_DIR}/VMLINUZ-BACKUP.EFI"
    cp -f "$ESP_UKI" "${ESP_MOUNT}/EFI/BOOT/BOOTX64.EFI"
  fi

  local extra_font=""
  if [ "$font_arg" != "auto" ] && [ "$font_arg" != "default" ]; then
    extra_font=" rd.vconsole.font=${font_arg}"
  fi

  cat << ZBM_SYSLINUX_EOF > "$ESP_SYSLINUX"
DEFAULT zbm
PROMPT 0
TIMEOUT 5

LABEL zbm
  LINUX /EFI/ZBM/vmlinuz-bootmenu
  INITRD /EFI/ZBM/initramfs-bootmenu.img
  APPEND zfsbootmenu quiet loglevel=3 net.ifnames=0 zbm.timeout=10 zbm.autosize=1${extra_font} zbm.hookroot=LABEL=AXON_EFI//EFI/ZBM/hooks console=ttyS0,115200 console=tty1

LABEL zbm_backup
  LINUX /EFI/ZBM/vmlinuz-bootmenu
  INITRD /EFI/ZBM/initramfs-bootmenu.img
  APPEND zfsbootmenu zbm.force_import=1 loglevel=3 net.ifnames=0 zbm.timeout=10 zbm.autosize=1${extra_font} zbm.hookroot=LABEL=AXON_EFI//EFI/ZBM/hooks console=ttyS0,115200 console=tty1
ZBM_SYSLINUX_EOF
  cp -f "$ESP_SYSLINUX" "${ESP_MOUNT}/syslinux.cfg" 2>/dev/null || true

  sync
  sync_secondary_esps

  printf "${COLOR_EMERALD}[✓] All ZFSBootMenu UKI, BIOS Syslinux, and hook assets synced.${COLOR_RESET}\n"
}

cmd_zbm_kcl() {
  local append_args=()
  local remove_args=()
  local target_efi="$ESP_UKI"

  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--append)
        shift
        [ $# -gt 0 ] && append_args+=("$1")
        ;;
      -r|--remove)
        shift
        [ $# -gt 0 ] && remove_args+=("$1")
        ;;
      -*)
        ;;
      *)
        target_efi="$1"
        ;;
    esac
    shift || true
  done

  [ -f "$target_efi" ] || target_efi="$ESP_UKI"
  local kcl_tmp
  kcl_tmp=$(mktemp)
  objcopy --dump-section .cmdline="$kcl_tmp" "$target_efi" 2>/dev/null || true
  local cur_kcl
  cur_kcl=$(tr -d '\0' < "$kcl_tmp" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  rm -f "$kcl_tmp"

  if [ ${#append_args[@]} -eq 0 ] && [ ${#remove_args[@]} -eq 0 ]; then
    echo "$cur_kcl"
    return 0
  fi

  local a
  for a in "${remove_args[@]}"; do
    local key="${a%%=*}"
    cur_kcl=$(echo "$cur_kcl" | sed -E "s/(^|[[:space:]])${key}(=[^[:space:]]*)?//g")
  done
  for a in "${append_args[@]}"; do
    cur_kcl="${cur_kcl} ${a}"
  done

  python3 /usr/lib/axonwall/theme-zbm-uki.py "$target_efi" -o "$target_efi" -s "$ZBM_SPLASH" -c "$cur_kcl"
  if [ "$target_efi" = "$ESP_UKI" ]; then
    cp -f "$ESP_UKI" "${ESP_ZBM_DIR}/VMLINUZ-BACKUP.EFI" 2>/dev/null || true
    cp -f "$ESP_UKI" "${ESP_MOUNT}/EFI/BOOT/BOOTX64.EFI" 2>/dev/null || true
    sync_secondary_esps
  fi
}

INVOKED_AS="$(basename "$0")"
if [ "$INVOKED_AS" = "generate-zbm" ]; then
  cmd_apply
  exit 0
elif [ "$INVOKED_AS" = "zbm-kcl" ]; then
  cmd_zbm_kcl "$@"
  exit 0
fi

case "${1:-status}" in
  status) cmd_status ;;
  set-font) shift; cmd_set_font "${1:-}" ;;
  set-splash) shift; cmd_set_splash "${1:-}" ;;
  set-palette) shift; cmd_set_palette "${1:-}" ;;
  apply) cmd_apply ;;
  -h|--help|help) usage ;;
  *)
    printf "${COLOR_RED}Error: Unknown command '%s'${COLOR_RESET}\n\n" "$1"
    usage
    exit 1
    ;;
esac
