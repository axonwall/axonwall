#!/bin/sh
# ==============================================================================
# Axonwall Alpine Linux Early Network Configuration Generator
#
# Runs from the `axonwall-network-setup` OpenRC service in the BOOT runlevel,
# ordered `before networking`. OpenRC's networking service reads
# /etc/network/interfaces to decide what to configure; the appliance overlay
# ships without that file (interface roles are detected from the hardware
# actually present), so unless it is generated here, networking starts with
# an empty configuration and no DHCPv4 client ever runs. Axonwall's firstboot
# provisioner (default runlevel) runs far too late to fix that: it configures
# interfaces itself, but only as a one-shot fallback.
#
# This script generates /etc/axonwall/interfaces.conf and
# /etc/network/interfaces from NIC detection, using exactly the layout the
# firstboot provisioner (axonwall-firstboot-alpine) writes, but ONLY when a
# file is missing or empty. On the live ISO /etc is a fresh tmpfs on every
# boot, so the files are always generated here, before networking starts. On
# an installed system the files already exist on disk (possibly edited via
# the console) and are never overwritten.
#
# When interfaces.conf already exists, /etc/network/interfaces is derived
# from its recorded roles, modes, and addresses -- never from fresh NIC
# detection: enumeration order can shift (added/renamed NIC), and
# re-detecting would swap roles, e.g. WAN DHCP on the LAN NIC and the
# static LAN address on the WAN NIC.
#
# AXONWALL_ROOT may prefix the target root (used by tests and the installer);
# it is empty in normal operation. This script must never fail the boot:
# it always exits 0.
# ==============================================================================
set -u

ROOT="${AXONWALL_ROOT:-}"
CONF="${ROOT}/etc/axonwall/interfaces.conf"
IFACES_FILE="${ROOT}/etc/network/interfaces"

# Do nothing unless at least one generated file is missing.
if [ -s "$CONF" ] && [ -s "$IFACES_FILE" ]; then
  exit 0
fi

# Identify Primary WAN, LAN, OPT1 & OPT2 NICs (same detection as firstboot)
IFACES="$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -vE '^(lo|wg.*|tailscale.*|tun.*|tap.*|sit.*|ip6tnl.*|gre.*|gretap.*|erspan.*|ip_vti.*|ip6_vti.*|ip6gre.*|docker.*|veth.*|br-.*|virbr.*|dummy.*|bond.*|pimreg)$' | head -n 4 || true)"
WAN_IF="$(echo "$IFACES" | sed -n '1p')"
LAN_IF="$(echo "$IFACES" | sed -n '2p')"
OPT1_IF="$(echo "$IFACES" | sed -n '3p')"
OPT2_IF="$(echo "$IFACES" | sed -n '4p')"
[ -z "$WAN_IF" ] && WAN_IF="eth0"

echo "[Axonwall Network Setup] Detected WAN: ${WAN_IF}, LAN: ${LAN_IF:-<none>}, OPT1: ${OPT1_IF:-<none>}, OPT2: ${OPT2_IF:-<none>}"

if [ ! -s "$CONF" ]; then
  mkdir -p "${ROOT}/etc/axonwall" || exit 0
  cat << CONF_EOF > "$CONF" || exit 0
WAN_INTERFACE=${WAN_IF}
WAN_MODE=dhcp
WAN_IPV4_ADDRESS=
WAN_IPV4_GATEWAY=
WAN_DNS1=1.1.1.1
WAN_DNS2=8.8.8.8
LAN_INTERFACE=${LAN_IF}
LAN_MODE=static
LAN_IPV4_ADDRESS=192.168.1.1/24
LAN_DHCP_ENABLED=true
OPT1_INTERFACE=${OPT1_IF}
OPT1_MODE=dhcp
OPT1_IPV4_ADDRESS=
OPT2_INTERFACE=${OPT2_IF}
OPT2_MODE=dhcp
OPT2_IPV4_ADDRESS=
CONF_EOF
fi

# A recorded interfaces.conf is authoritative: override the detected
# roles (and modes/addresses) with its values whenever they are set.
# Parsed with grep/cut, exactly as axonwall-firstboot-alpine does -- the
# file is never sourced. Detection stays only as the fallback for a
# missing/blank entry.
conf_val() {
  grep "^$1=" "$CONF" 2>/dev/null | head -n1 | cut -d= -f2- || true
}
conf_has_key() {
  grep -q "^$1=" "$CONF" 2>/dev/null
}
if [ -s "$CONF" ]; then
  if conf_has_key WAN_INTERFACE; then WAN_IF="$(conf_val WAN_INTERFACE)"; fi
  _v="$(conf_val WAN_MODE)"; [ -n "$_v" ] && WAN_MODE="$_v"
  _v="$(conf_val WAN_IPV4_ADDRESS)"; [ -n "$_v" ] && WAN_IPV4_ADDRESS="$_v"
  _v="$(conf_val WAN_IPV4_GATEWAY)"; [ -n "$_v" ] && WAN_IPV4_GATEWAY="$_v"
  if conf_has_key LAN_INTERFACE; then LAN_IF="$(conf_val LAN_INTERFACE)"; fi
  _v="$(conf_val LAN_MODE)"; [ -n "$_v" ] && LAN_MODE="$_v"
  _v="$(conf_val LAN_IPV4_ADDRESS)"; [ -n "$_v" ] && LAN_IPV4_ADDRESS="$_v"
  if conf_has_key OPT1_INTERFACE; then OPT1_IF="$(conf_val OPT1_INTERFACE)"; fi
  _v="$(conf_val OPT1_MODE)"; [ -n "$_v" ] && OPT1_MODE="$_v"
  _v="$(conf_val OPT1_IPV4_ADDRESS)"; [ -n "$_v" ] && OPT1_IPV4_ADDRESS="$_v"
  if conf_has_key OPT2_INTERFACE; then OPT2_IF="$(conf_val OPT2_INTERFACE)"; fi
  _v="$(conf_val OPT2_MODE)"; [ -n "$_v" ] && OPT2_MODE="$_v"
  _v="$(conf_val OPT2_IPV4_ADDRESS)"; [ -n "$_v" ] && OPT2_IPV4_ADDRESS="$_v"
  # Prevent duplicate interface stanzas if a role was reassigned to another role's default NIC
  [ "$LAN_IF" = "$WAN_IF" ] && LAN_IF=""
  { [ "$OPT1_IF" = "$WAN_IF" ] || [ "$OPT1_IF" = "$LAN_IF" ]; } && OPT1_IF=""
  { [ "$OPT2_IF" = "$WAN_IF" ] || [ "$OPT2_IF" = "$LAN_IF" ] || [ "$OPT2_IF" = "$OPT1_IF" ]; } && OPT2_IF=""
fi
[ -z "$WAN_IF" ] && WAN_IF="eth0"
WAN_MODE="${WAN_MODE:-dhcp}"
LAN_MODE="${LAN_MODE:-static}"
LAN_IPV4_ADDRESS="${LAN_IPV4_ADDRESS:-192.168.1.1/24}"
OPT1_MODE="${OPT1_MODE:-dhcp}"
OPT2_MODE="${OPT2_MODE:-dhcp}"

# cidr_to_netmask PREFIX: dotted-quad netmask for a CIDR prefix length
# (plain shell arithmetic; no hex literals, so it works under dash/ash).
cidr_to_netmask() {
  _bits="$1"
  _mask=""
  _i=0
  while [ "$_i" -lt 4 ]; do
    if [ "$_bits" -ge 8 ]; then
      _octet=255
      _bits=$(( _bits - 8 ))
    elif [ "$_bits" -gt 0 ]; then
      _octet=$(( 256 - (1 << (8 - _bits)) ))
      _bits=0
    else
      _octet=0
    fi
    if [ -z "$_mask" ]; then _mask="$_octet"; else _mask="$_mask.$_octet"; fi
    _i=$(( _i + 1 ))
  done
  printf '%s' "$_mask"
}

# append_stanza IFACE MODE CIDR GATEWAY: print one ifupdown stanza to
# stdout. Static mode needs a parseable dotted-quad address; anything
# else (dhcp mode, or an unusable static address) degrades to a DHCP
# stanza rather than writing a stanza networking cannot bring up.
append_stanza() {
  _iface="$1"; _mode="$2"; _cidr="$3"; _gw="$4"
  if [ "$_mode" = "static" ]; then
    _addr="${_cidr%%/*}"
    case "$_cidr" in */*) _prefix="${_cidr##*/}" ;; *) _prefix=24 ;; esac
    case "$_prefix" in ''|*[!0-9]*) _prefix=24 ;; esac
    if [ "$_prefix" -gt 32 ]; then _prefix=24; fi
    case "$_addr" in
      *.*.*.*)
        case "$_addr" in *[!0-9.]*) _addr="" ;; esac
        ;;
      *) _addr="" ;;
    esac
    if [ -n "$_addr" ]; then
      printf 'auto %s\niface %s inet static\n    address %s\n    netmask %s\n' \
        "$_iface" "$_iface" "$_addr" "$(cidr_to_netmask "$_prefix")"
      [ -n "$_gw" ] && printf '    gateway %s\n' "$_gw"
      printf '\n'
      return 0
    fi
  fi
  printf 'auto %s\niface %s inet dhcp\n\n' "$_iface" "$_iface"
}

if [ ! -s "$IFACES_FILE" ]; then
  mkdir -p "${ROOT}/etc/network" "${ROOT}/etc/network/interfaces.d" || exit 0
  {
    printf '# /etc/network/interfaces -- Generated by Axonwall\n'
    printf 'auto lo\niface lo inet loopback\n\n'
    printf '# WAN Interface\n'
    append_stanza "$WAN_IF" "$WAN_MODE" "${WAN_IPV4_ADDRESS:-}" "${WAN_IPV4_GATEWAY:-}"
    if [ -n "$LAN_IF" ]; then
      printf '# LAN Interface\n'
      append_stanza "$LAN_IF" "$LAN_MODE" "$LAN_IPV4_ADDRESS" ""
    fi
    if [ -n "$OPT1_IF" ]; then
      printf '# OPT1 Interface\n'
      append_stanza "$OPT1_IF" "$OPT1_MODE" "${OPT1_IPV4_ADDRESS:-}" ""
    fi
    if [ -n "$OPT2_IF" ]; then
      printf '# OPT2 Interface\n'
      append_stanza "$OPT2_IF" "$OPT2_MODE" "${OPT2_IPV4_ADDRESS:-}" ""
    fi
  } > "$IFACES_FILE" || exit 0

  rm -f "${ROOT}/etc/network/interfaces.d/axonwall" 2>/dev/null || true
fi

exit 0
