#!/bin/sh
# ==============================================================================
# Axonwall Alpine Linux Firstboot Provisioner
# ==============================================================================
set -eu

MARKER="/etc/axonwall/.firstboot"
K3S_MARKER="/etc/axonwall/.k3s-firstboot"

# Barebones K3s + OpenZFS + OpenEBS Storage Host Edition (`k3s-storage`)
if [ -f /etc/axonwall/.k3s-edition ]; then
  if [ ! -f "$K3S_MARKER" ] && [ ! -f "$MARKER" ]; then
    exit 0
  fi

  echo "[Axonwall K3s Firstboot] Initializing Alpine Linux K3s + OpenZFS Storage Host..."
  mkdir -p /etc/axonwall /etc/axonwall/certs /etc/modprobe.d /etc/rancher/k3s /var/lib/axonwall/etc-axonwall /var/log

  if [ ! -s /etc/axonwall/k3s-storage.env ] && [ -s /var/lib/axonwall/etc-axonwall/k3s-storage.env ]; then
    cp -f /var/lib/axonwall/etc-axonwall/k3s-storage.env /etc/axonwall/k3s-storage.env
    chmod 0600 /etc/axonwall/k3s-storage.env
  fi

  K3S_ROLE="server"
  K3S_SERVER_URL=""
  K3S_JOIN_TOKEN=""
  ZFS_ARC_MAX_MB="0"
  if [ -f /etc/axonwall/k3s-storage.env ]; then
    # shellcheck disable=SC1091
    . /etc/axonwall/k3s-storage.env
  fi
  case "${K3S_ROLE:-server}" in
    agent|worker) K3S_ROLE="agent" ;;
    *) K3S_ROLE="server" ;;
  esac

  # 1. Compute dynamic zfs_arc_max and load kernel modules + sysctl
  _arc_mb="${ZFS_ARC_MAX_MB:-0}"
  case "$_arc_mb" in ''|*[!0-9]*) _arc_mb=0 ;; esac
  if [ "$_arc_mb" -gt 0 ]; then
    _arc_bytes=$(( _arc_mb * 1048576 ))
  else
    _mem_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 4194304)"
    case "$_mem_kb" in ''|*[!0-9]*) _mem_kb=4194304 ;; esac
    _mem_mb=$(( _mem_kb / 1024 ))
    if [ "$_mem_mb" -le 2048 ]; then
      _arc_bytes=$(( 384 * 1048576 ))
    elif [ "$_mem_mb" -le 4096 ]; then
      _arc_bytes=$(( 512 * 1048576 ))
    elif [ "$_mem_mb" -le 8192 ]; then
      _arc_bytes=$(( 1024 * 1048576 ))
    else
      _arc_bytes=$(( (_mem_kb * 1024) / 4 ))
    fi
  fi
  printf '# Generated by axonwall-firstboot-alpine (k3s-storage)\noptions zfs zfs_arc_max=%s\n' "$_arc_bytes" > /etc/modprobe.d/zfs.conf
  chmod 0644 /etc/modprobe.d/zfs.conf

  for _mod in zfs overlay br_netfilter wireguard nf_conntrack; do
    modprobe "$_mod" 2>/dev/null || true
  done
  if [ -w /sys/module/zfs/parameters/zfs_arc_max ]; then
    echo "$_arc_bytes" > /sys/module/zfs/parameters/zfs_arc_max 2>/dev/null || true
  fi
  [ -f /etc/sysctl.d/90-k3s-storage.conf ] && sysctl -p /etc/sysctl.d/90-k3s-storage.conf >/dev/null 2>&1 || true

  if command -v nft >/dev/null 2>&1 && [ -f /etc/nftables.conf ]; then
    nft -f /etc/nftables.conf 2>/dev/null || true
  fi

  # 2. Host Mode DHCP networking (never router NAT / never static 192.168.1.1)
  _phys_nics="$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -vE '^(lo|wg.*|tailscale.*|tun.*|tap.*|sit.*|ip6tnl.*|gre.*|gretap.*|erspan.*|ip_vti.*|ip6_vti.*|ip6gre.*|docker.*|veth.*|br-.*|cni.*|flannel.*|virbr.*|dummy.*|bond.*|pimreg)$' || true)"
  if [ ! -s /etc/network/interfaces ] && [ ! -f /etc/axonwall/.interfaces_configured ]; then
    mkdir -p /etc/network /etc/network/interfaces.d
    {
      echo "# /etc/network/interfaces -- Generated by Axonwall K3s Storage Host"
      echo "auto lo"
      echo "iface lo inet loopback"
      echo ""
      for _nic in $_phys_nics; do
        echo "auto ${_nic}"
        echo "iface ${_nic} inet dhcp"
        echo ""
      done
    } > /etc/network/interfaces
  fi
  for _nic in $_phys_nics; do
    ip link set up dev "$_nic" 2>/dev/null || true
    if ! ip -4 addr show dev "$_nic" 2>/dev/null | grep -q 'inet '; then
      if command -v dhcpcd >/dev/null 2>&1; then
        dhcpcd -4 -t 10 "$_nic" >/dev/null 2>&1 || true
      else
        /sbin/udhcpc -b -i "$_nic" -p "/var/run/udhcpc.${_nic}.pid" >/dev/null 2>&1 || true
      fi
    fi
  done

  # 3. SSH host keys & Appliance TLS PKI
  ssh-keygen -A >/dev/null 2>&1 || true
  if command -v axonwall-rotate-hub-cert >/dev/null 2>&1; then
    axonwall-rotate-hub-cert --ensure || true
  fi
  if [ ! -s /etc/axonwall/certs/hub.crt ] || [ ! -s /etc/axonwall/certs/hub.key ]; then
    if [ -s /etc/axonwall/certs/ca.crt ]; then
      echo "[Axonwall K3s Firstboot] ERROR: hub certificate missing while ca.crt exists; refusing non-chaining self-signed cert." >&2
      exit 1
    fi
    _hn="$(hostname 2>/dev/null || echo axonwall-storage)"
    _san="DNS:${_hn},DNS:axonwall-storage.local,DNS:localhost,IP:127.0.0.1"
    for _ip in $(ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]}' || true); do
      _san="${_san},IP:${_ip}"
    done
    openssl req -x509 -newkey rsa:2048 -nodes \
      -keyout /etc/axonwall/certs/hub.key \
      -out /etc/axonwall/certs/hub.crt \
      -days 825 \
      -subj "/O=Axonwall/OU=K3sStorage/CN=${_hn}" \
      -addext "subjectAltName=${_san}" >/dev/null 2>&1 || true
  fi
  chmod 0750 /etc/axonwall /etc/axonwall/certs 2>/dev/null || true
  chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
  chmod 0644 /etc/axonwall/certs/hub.crt 2>/dev/null || true

  # 4. OpenZFS pool ('tank' or 'zroot') & K8s/runtime datasets
  if command -v zpool >/dev/null 2>&1; then
    zpool list -H tank >/dev/null 2>&1 || zpool import -f tank >/dev/null 2>&1 || true
    zpool list -H zroot >/dev/null 2>&1 || zpool import -f zroot >/dev/null 2>&1 || true
    if [ -s /var/lib/axonwall/install-zfs.json ] && command -v jq >/dev/null 2>&1; then
      _zpool="$(jq -r '.poolName // "tank"' /var/lib/axonwall/install-zfs.json 2>/dev/null || echo "tank")"
      _ztopo="$(jq -r '.topology // "stripe"' /var/lib/axonwall/install-zfs.json 2>/dev/null || echo "stripe")"
      _zvdevs="$(jq -r '(.vdevs // []) | join(" ")' /var/lib/axonwall/install-zfs.json 2>/dev/null || true)"
      _slog="$(jq -r '(.slogVdevs // []) | join(" ")' /var/lib/axonwall/install-zfs.json 2>/dev/null || true)"
      _l2arc="$(jq -r '(.l2arcVdevs // []) | join(" ")' /var/lib/axonwall/install-zfs.json 2>/dev/null || true)"
      _spare="$(jq -r '(.spareVdevs // []) | join(" ")' /var/lib/axonwall/install-zfs.json 2>/dev/null || true)"
      _accel=""
      if [ -n "$_slog" ]; then
        _scnt="$(printf '%s\n' "$_slog" | wc -w | tr -d ' ')"
        if [ "$_scnt" -ge 2 ]; then _accel="${_accel} log mirror ${_slog}"; else _accel="${_accel} log ${_slog}"; fi
      fi
      [ -n "$_l2arc" ] && _accel="${_accel} cache ${_l2arc}"
      [ -n "$_spare" ] && _accel="${_accel} spare ${_spare}"
      if [ -n "$_zpool" ] && [ -n "$_zvdevs" ] && ! zpool list -H "$_zpool" >/dev/null 2>&1; then
        _targ=""
        case "$_ztopo" in stripe|auto|"") _targ="" ;; *) _targ="$_ztopo" ;; esac
        if [ "$_zpool" = "zroot" ]; then
          # shellcheck disable=SC2086
          zpool create -f -o ashift=12 -o autotrim=on -O compression=lz4 -O atime=off -O xattr=sa -O acltype=posixacl -O normalization=formD -O canmount=off -O mountpoint=none zroot $_targ $_zvdevs $_accel 2>/dev/null || true
        else
          # shellcheck disable=SC2086
          zpool create -f -o ashift=12 -o autotrim=on -O compression=lz4 -O atime=off -O xattr=sa -O acltype=posixacl -O normalization=formD -O mountpoint=/mnt/tank "$_zpool" $_targ $_zvdevs $_accel 2>/dev/null || true
        fi
      fi
    fi
  fi

  K8S_ZFS_POOL="tank/k8s"
  mkdir -p /var/lib/rancher/k3s
  if command -v zpool >/dev/null 2>&1 && command -v zfs >/dev/null 2>&1; then
    if zpool list -H tank >/dev/null 2>&1; then
      zfs list -H tank/k8s >/dev/null 2>&1 || zfs create -o compression=lz4 -o atime=off -o recordsize=128k -o xattr=sa -o acltype=posixacl tank/k8s 2>/dev/null || true
      if ! zfs list -H tank/k3s-runtime >/dev/null 2>&1; then
        zfs create -o mountpoint=/var/lib/rancher/k3s -o canmount=on -o compression=lz4 -o atime=off -o recordsize=128k -o xattr=sa -o acltype=posixacl tank/k3s-runtime 2>/dev/null || true
      else
        zfs mount tank/k3s-runtime 2>/dev/null || true
      fi
      K8S_ZFS_POOL="tank/k8s"
    elif zpool list -H zroot >/dev/null 2>&1; then
      mkdir -p /var/lib/axonwall/k8s-zfs
      zfs list -H zroot/k8s >/dev/null 2>&1 || zfs create -o mountpoint=/var/lib/axonwall/k8s-zfs -o canmount=on -o compression=lz4 -o atime=off -o recordsize=128k -o xattr=sa -o acltype=posixacl zroot/k8s 2>/dev/null || true
      if ! zfs list -H zroot/k3s-runtime >/dev/null 2>&1; then
        zfs create -o mountpoint=/var/lib/rancher/k3s -o canmount=on -o compression=lz4 -o atime=off -o recordsize=128k -o xattr=sa -o acltype=posixacl zroot/k3s-runtime 2>/dev/null || true
      else
        zfs mount zroot/k3s-runtime 2>/dev/null || true
      fi
      K8S_ZFS_POOL="zroot/k8s"
    fi
  fi

  if [ -d /usr/share/axonwall/k3s/images ]; then
    for _img in /usr/share/axonwall/k3s/images/*.tar*; do
      [ -f "$_img" ] || continue
      mkdir -p /var/lib/rancher/k3s/agent/images
      cp -f "$_img" /var/lib/rancher/k3s/agent/images/
    done
  fi

  # 5. Write /etc/rancher/k3s/config.yaml & OpenEBS manifests + enable OpenRC service
  chmod 0700 /etc/rancher/k3s
  mkdir -p /etc/runlevels/default /etc/runlevels/boot
  [ -x /etc/init.d/zfs-import ] && ln -sf /etc/init.d/zfs-import /etc/runlevels/boot/zfs-import
  [ -x /etc/init.d/zfs-mount ] && ln -sf /etc/init.d/zfs-mount /etc/runlevels/boot/zfs-mount

  if [ "$K3S_ROLE" = "agent" ]; then
    touch /etc/rancher/k3s/agent-mode
    chmod 0600 /etc/rancher/k3s/agent-mode
    printf '%s\n' "${K3S_JOIN_TOKEN:-}" > /etc/rancher/k3s/agent-token
    chmod 0600 /etc/rancher/k3s/agent-token
    cat << K3S_AGENT_EOF > /etc/rancher/k3s/config.yaml
# Generated by axonwall-firstboot-alpine (role: agent)
server: "${K3S_SERVER_URL:-}"
token-file: "/etc/rancher/k3s/agent-token"
kubelet-arg:
  - "eviction-hard=memory.available<200Mi,nodefs.available<5%"
K3S_AGENT_EOF
    chmod 0600 /etc/rancher/k3s/config.yaml
    rm -f /etc/runlevels/default/k3s
    [ -x /etc/init.d/k3s-agent ] && ln -sf /etc/init.d/k3s-agent /etc/runlevels/default/k3s-agent
  else
    rm -f /etc/rancher/k3s/agent-mode
    _hn="$(hostname 2>/dev/null || echo axonwall-storage)"
    {
      echo "# Generated by axonwall-firstboot-alpine (role: server)"
      [ -n "${K3S_SERVER_URL:-}" ] && printf 'server: "%s"\n' "$K3S_SERVER_URL"
      if [ -n "${K3S_JOIN_TOKEN:-}" ]; then
        printf '%s\n' "$K3S_JOIN_TOKEN" > /etc/rancher/k3s/agent-token
        chmod 0600 /etc/rancher/k3s/agent-token
        echo 'token-file: "/etc/rancher/k3s/agent-token"'
      fi
      cat << 'K3S_SRV_STATIC'
write-kubeconfig-mode: "0600"
flannel-backend: "wireguard-native"
disable:
  - local-storage
  - traefik
  - servicelb
  - metrics-server
kubelet-arg:
  - "eviction-hard=memory.available<200Mi,nodefs.available<5%"
tls-san:
K3S_SRV_STATIC
      printf '  - "%s"\n' "$_hn"
      echo '  - "axonwall-storage.local"'
      echo '  - "localhost"'
      echo '  - "127.0.0.1"'
      for _ip in $(ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]}' || true); do
        [ "$_ip" = "127.0.0.1" ] && continue
        printf '  - "%s"\n' "$_ip"
      done
    } > /etc/rancher/k3s/config.yaml
    chmod 0600 /etc/rancher/k3s/config.yaml

    mkdir -p /var/lib/rancher/k3s/server/manifests
    if [ -s /usr/share/axonwall/k3s/zfs-operator.yaml ]; then
      cp -f /usr/share/axonwall/k3s/zfs-operator.yaml /var/lib/rancher/k3s/server/manifests/00-openebs-zfs-operator.yaml
    fi
    cat << SC_EOF > /var/lib/rancher/k3s/server/manifests/01-axonwall-openebs.yaml
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: axonwall-zfs-local
  annotations:
    storageclass.kubernetes.io/is-default-class: "true"
provisioner: zfs.csi.openebs.io
allowVolumeExpansion: true
reclaimPolicy: Retain
volumeBindingMode: WaitForFirstConsumer
parameters:
  poolname: "${K8S_ZFS_POOL}"
  fstype: "zfs"
  compression: "lz4"
  thinprovision: "yes"
  recordsize: "128k"
SC_EOF
    rm -f /etc/runlevels/default/k3s-agent
    [ -x /etc/init.d/k3s ] && ln -sf /etc/init.d/k3s /etc/runlevels/default/k3s
  fi

  _pip="$(ip -4 -o addr show scope global 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}' || true)"
  cat << ISSUE_EOF > /etc/issue
======================================================================
  Axonwall K3s + OpenZFS + OpenEBS Storage Host (Alpine Linux)
  Role: ${K3S_ROLE} | ZFS Dataset: ${K8S_ZFS_POOL} | IP: ${_pip:-DHCP pending}
  Run 'axonwall-k3s-status' as root to inspect ZFS & K3s health.
======================================================================

ISSUE_EOF

  rm -f "$K3S_MARKER" "$MARKER"
  echo "[Axonwall K3s Firstboot] Complete."
  exit 0
fi

if [ ! -f "$MARKER" ]; then
  exit 0
fi

echo "[Axonwall Firstboot] Initializing Alpine Linux network appliance..."

# 1. Load kernel modules and apply sysctl performance tuning
modprobe nf_conntrack 2>/dev/null || true
modprobe nf_tables 2>/dev/null || true
modprobe nft_chain_nat 2>/dev/null || true
modprobe nft_MASQUERADE 2>/dev/null || true
modprobe wireguard 2>/dev/null || true
modprobe tcp_bbr 2>/dev/null || true
sysctl -p /etc/sysctl.d/99-axonwall.conf 2>/dev/null || true

# 2. Identify Primary WAN, LAN, OPT1 & OPT2 NICs
mkdir -p /etc/axonwall /var/lib/axonwall /var/log/axonwall /run/axonwall /run/headscale
PRECONFIGURED_IFACES=0
if [ -f /var/lib/axonwall/etc-axonwall/.interfaces_configured ] && [ -s /var/lib/axonwall/etc-axonwall/interfaces.conf ]; then
  cp -a /var/lib/axonwall/etc-axonwall/interfaces.conf /etc/axonwall/interfaces.conf 2>/dev/null || true
  cp -a /var/lib/axonwall/etc-axonwall/.interfaces_configured /etc/axonwall/.interfaces_configured 2>/dev/null || true
fi
if { [ -f /etc/axonwall/.interfaces_configured ] || [ -f /var/lib/axonwall/etc-axonwall/.interfaces_configured ]; } && [ -s /etc/axonwall/interfaces.conf ]; then
  echo "[Axonwall Firstboot] Preserving pre-configured network interfaces from /etc/axonwall/interfaces.conf..."
  PRECONFIGURED_IFACES=1
  WAN_IF="$(grep '^WAN_INTERFACE=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || true)"
  WAN_MODE="$(grep '^WAN_MODE=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || echo "dhcp")"
  WAN_IPV4_ADDRESS="$(grep '^WAN_IPV4_ADDRESS=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || true)"
  WAN_IPV4_GATEWAY="$(grep '^WAN_IPV4_GATEWAY=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || true)"
  LAN_IF="$(grep '^LAN_INTERFACE=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || true)"
  LAN_MODE="$(grep '^LAN_MODE=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || echo "static")"
  LAN_IPV4_ADDRESS="$(grep '^LAN_IPV4_ADDRESS=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || true)"
  OPT1_IF="$(grep '^OPT1_INTERFACE=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || true)"
  OPT1_MODE="$(grep '^OPT1_MODE=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || echo "dhcp")"
  OPT1_IPV4_ADDRESS="$(grep '^OPT1_IPV4_ADDRESS=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || true)"
  OPT2_IF="$(grep '^OPT2_INTERFACE=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || true)"
  OPT2_MODE="$(grep '^OPT2_MODE=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || echo "dhcp")"
  OPT2_IPV4_ADDRESS="$(grep '^OPT2_IPV4_ADDRESS=' /etc/axonwall/interfaces.conf | head -n1 | cut -d= -f2- || true)"
else
  IFACES="$(ip -o link show | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -vE '^(lo|wg.*|tailscale.*|tun.*|tap.*|sit.*|ip6tnl.*|gre.*|gretap.*|erspan.*|ip_vti.*|ip6_vti.*|ip6gre.*|docker.*|veth.*|br-.*|virbr.*|dummy.*|bond.*|pimreg)$' | head -n 4 || true)"
  WAN_IF="$(echo "$IFACES" | sed -n '1p')"
  LAN_IF="$(echo "$IFACES" | sed -n '2p')"
  OPT1_IF="$(echo "$IFACES" | sed -n '3p')"
  OPT2_IF="$(echo "$IFACES" | sed -n '4p')"
  [ -z "$WAN_IF" ] && WAN_IF="eth0"

  echo "[Axonwall Firstboot] Detected WAN: ${WAN_IF}, LAN: ${LAN_IF:-<none>}, OPT1: ${OPT1_IF:-<none>}, OPT2: ${OPT2_IF:-<none>}"

  cat << CONF_EOF > /etc/axonwall/interfaces.conf
WAN_INTERFACE=${WAN_IF}
WAN_MODE=dhcp
WAN_IPV4_ADDRESS=
WAN_IPV4_GATEWAY=
WAN_DNS1=1.1.1.1
WAN_DNS2=8.8.8.8
LAN_INTERFACE=${LAN_IF}
LAN_MODE=static
LAN_IPV4_ADDRESS=192.168.1.1/24
LAN_DHCP_ENABLED=true
OPT1_INTERFACE=${OPT1_IF}
OPT1_MODE=dhcp
OPT1_IPV4_ADDRESS=
OPT2_INTERFACE=${OPT2_IF}
OPT2_MODE=dhcp
OPT2_IPV4_ADDRESS=
CONF_EOF

  # Ensure /etc/network/interfaces is populated persistently
  mkdir -p /etc/network /etc/network/interfaces.d
  cat << IFACES_EOF > /etc/network/interfaces
# /etc/network/interfaces -- Generated by Axonwall
auto lo
iface lo inet loopback

# WAN Interface
auto ${WAN_IF}
iface ${WAN_IF} inet dhcp

IFACES_EOF

  if [ -n "$LAN_IF" ]; then
cat << IFACES_LAN_EOF >> /etc/network/interfaces
# LAN Interface
auto ${LAN_IF}
iface ${LAN_IF} inet static
    address 192.168.1.1
    netmask 255.255.255.0

IFACES_LAN_EOF
  fi

  if [ -n "$OPT1_IF" ]; then
cat << IFACES_OPT1_EOF >> /etc/network/interfaces
# OPT1 Interface
auto ${OPT1_IF}
iface ${OPT1_IF} inet dhcp

IFACES_OPT1_EOF
  fi

  if [ -n "$OPT2_IF" ]; then
cat << IFACES_OPT2_EOF >> /etc/network/interfaces
# OPT2 Interface
auto ${OPT2_IF}
iface ${OPT2_IF} inet dhcp

IFACES_OPT2_EOF
  fi

  rm -f /etc/network/interfaces.d/axonwall 2>/dev/null || true
fi

# Start a DHCPv4 client on $1 only when the interface has no IPv4 address
# yet. The boot-runlevel networking service (ifup + dhcpcd, configured by
# axonwall-network-setup before it) normally holds the lease by the time
# firstboot runs; starting a second client regardless would flush that
# lease, because every udhcpc start runs its deconfig script
# (`ip -4 addr flush`). Client output is deliberately NOT discarded:
# when DHCP fails, the boot log has to say so.
dhcp_if_missing() {
  _dhcp_if="$1"
  [ -n "$_dhcp_if" ] || return 0
  ip link show "$_dhcp_if" >/dev/null 2>&1 || return 0
  ip link set up dev "$_dhcp_if" 2>/dev/null || true
  if ip -4 addr show dev "$_dhcp_if" 2>/dev/null | grep -q 'inet '; then
    return 0
  fi
  echo "[Axonwall Firstboot] No IPv4 address on ${_dhcp_if}; starting DHCPv4 client..."
  if command -v dhcpcd >/dev/null 2>&1; then
    dhcpcd -4 "$_dhcp_if" || true
  else
    /sbin/udhcpc -b -i "$_dhcp_if" -p "/var/run/udhcpc.${_dhcp_if}.pid" || true
  fi
}

if [ "$PRECONFIGURED_IFACES" = "1" ]; then
  if [ -n "$WAN_IF" ] && ip link show "$WAN_IF" >/dev/null 2>&1; then
    if [ "$WAN_MODE" = "static" ] && [ -n "$WAN_IPV4_ADDRESS" ]; then
      ip addr add "$WAN_IPV4_ADDRESS" dev "$WAN_IF" 2>/dev/null || true
      ip link set up dev "$WAN_IF" 2>/dev/null || true
      [ -n "$WAN_IPV4_GATEWAY" ] && ip route replace default via "$WAN_IPV4_GATEWAY" dev "$WAN_IF" 2>/dev/null || true
    else
      dhcp_if_missing "$WAN_IF"
    fi
  fi
  if [ -n "$LAN_IF" ] && ip link show "$LAN_IF" >/dev/null 2>&1; then
    if [ "$LAN_MODE" = "dhcp" ]; then
      dhcp_if_missing "$LAN_IF"
    else
      ip addr add "${LAN_IPV4_ADDRESS:-192.168.1.1/24}" dev "$LAN_IF" 2>/dev/null || true
      ip link set up dev "$LAN_IF" 2>/dev/null || true
    fi
  fi
  if [ -n "$OPT1_IF" ] && ip link show "$OPT1_IF" >/dev/null 2>&1; then
    if [ "$OPT1_MODE" = "static" ] && [ -n "$OPT1_IPV4_ADDRESS" ]; then
      ip addr add "$OPT1_IPV4_ADDRESS" dev "$OPT1_IF" 2>/dev/null || true
      ip link set up dev "$OPT1_IF" 2>/dev/null || true
    else
      dhcp_if_missing "$OPT1_IF"
    fi
  fi
  if [ -n "$OPT2_IF" ] && ip link show "$OPT2_IF" >/dev/null 2>&1; then
    if [ "$OPT2_MODE" = "static" ] && [ -n "$OPT2_IPV4_ADDRESS" ]; then
      ip addr add "$OPT2_IPV4_ADDRESS" dev "$OPT2_IF" 2>/dev/null || true
      ip link set up dev "$OPT2_IF" 2>/dev/null || true
    else
      dhcp_if_missing "$OPT2_IF"
    fi
  fi
else
  # Bring up WAN with DHCP (fallback; networking normally configured it first)
  dhcp_if_missing "$WAN_IF"

  # 3. Configure default LAN static IP (192.168.1.1/24) on second NIC
  if [ -n "$LAN_IF" ] && ip link show "$LAN_IF" >/dev/null 2>&1; then
    ip addr add 192.168.1.1/24 dev "$LAN_IF" 2>/dev/null || true
    ip link set up dev "$LAN_IF" 2>/dev/null || true
  fi

  dhcp_if_missing "$OPT1_IF"

  dhcp_if_missing "$OPT2_IF"
fi

# 4. Bootstrap baseline lockdown nftables ruleset
if [ -f /usr/share/axonwall/lockdown.nft ]; then
  INTERNAL_HAS_LINK=0
  for _int_if in "$LAN_IF" "$OPT1_IF" "$OPT2_IF"; do
    if [ -n "$_int_if" ] && [ "$(cat "/sys/class/net/${_int_if}/carrier" 2>/dev/null || echo 0)" = "1" ]; then
      INTERNAL_HAS_LINK=1
      break
    fi
  done
  if [ "$INTERNAL_HAS_LINK" = "1" ] && [ -n "$WAN_IF" ] && [ "$WAN_IF" != "wan0" ]; then
    if ! grep -q "\"${WAN_IF}\"" /usr/share/axonwall/lockdown.nft; then
      sed -i "s/elements = { [^}]* }/elements = { \"wan0\", \"${WAN_IF}\" }/" /usr/share/axonwall/lockdown.nft || true
    fi
  else
    sed -i 's/elements = { [^}]* }/elements = { "wan0" }/' /usr/share/axonwall/lockdown.nft || true
  fi
  nft -f /usr/share/axonwall/lockdown.nft || true
fi

# 5. Initialize Axonwall System User & Environment
if ! id -u axonwall >/dev/null 2>&1; then
  addgroup -S axonwall 2>/dev/null || true
  adduser -S -D -H -h /var/lib/axonwall -s /sbin/nologin -G axonwall axonwall 2>/dev/null || true
fi

# Service-identity split (audit B-12): separate controller user + shared api group
addgroup -S axonwall-api 2>/dev/null || true
addgroup -S axonwall-controller 2>/dev/null || true
if ! id -u axonwall-controller >/dev/null 2>&1; then
  adduser -S -D -H -h /var/lib/axonwall -s /sbin/nologin -G axonwall-controller axonwall-controller 2>/dev/null || true
fi
adduser axonwall axonwall-api 2>/dev/null || true
adduser axonwall-controller axonwall-api 2>/dev/null || true

# Headscale identity split (B-12 follow-up): headscale runs as its own user
addgroup -S axonwall-headscale 2>/dev/null || true
if ! id -u axonwall-headscale >/dev/null 2>&1; then
  adduser -S -D -H -h /var/lib/axonwall -s /sbin/nologin -G axonwall-headscale axonwall-headscale 2>/dev/null || true
fi

# Provision the hub TLS PKI (audit B-14): an on-box appliance CA plus a
# CA-issued hub leaf, via the shared provisioning tool. --ensure is
# idempotent and never disturbs an operator CA. The inline fallback is
# the previous self-signed generation, used only if the tool is missing.
mkdir -p /etc/axonwall/certs
if command -v axonwall-rotate-hub-cert >/dev/null 2>&1; then
  echo "[Axonwall Firstboot] Provisioning appliance TLS PKI (CA + hub leaf)..."
  axonwall-rotate-hub-cert --ensure || true
fi
# D2-M4: the old guard tested /var/lib/axonwall/tls/ca.crt, a path
# nothing ever writes, so it always passed and firstboot minted a
# non-chaining self-signed leaf even when an operator CA was
# installed. Test the real CA path (the rotate tool's CERT_DIR,
# /etc/axonwall/certs/ca.crt) and fail loudly when a CA exists but
# the pair is missing, exactly like the Debian firstboot. The marker
# is removed only at the end of this script, so the exit below keeps
# it and the next boot retries instead of silently degrading.
if [ ! -s /etc/axonwall/certs/hub.crt ] || [ ! -s /etc/axonwall/certs/hub.key ]; then
  if [ -s /etc/axonwall/certs/ca.crt ]; then
    echo "[Axonwall Firstboot] ERROR: hub certificate pair missing but an appliance CA exists; refusing to mint a non-chaining certificate. Fix the PKI and re-run firstboot." >&2
    exit 1
  fi
  echo "[Axonwall Firstboot] Generating appliance TLS certificate..."
  HN="$(hostname 2>/dev/null || echo axonwall)"
  SAN="DNS:${HN},DNS:axonwall.local,DNS:localhost,IP:127.0.0.1,IP:192.168.1.1"
  openssl req -x509 -newkey rsa:2048 -nodes \
    -keyout /etc/axonwall/certs/hub.key \
    -out /etc/axonwall/certs/hub.crt \
    -days 3650 \
    -subj "/O=Axonwall/OU=Appliance/CN=${HN}" \
    -addext "subjectAltName=${SAN}" >/dev/null 2>&1 || true
fi

chown root:axonwall-api /etc/axonwall /etc/axonwall/certs 2>/dev/null || true
chown axonwall-controller:axonwall-controller /etc/axonwall/certs/hub.key /etc/axonwall/certs/hub.crt 2>/dev/null || true
chmod 1770 /etc/axonwall 2>/dev/null || true
chmod 0750 /etc/axonwall/certs 2>/dev/null || true
chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
chmod 0644 /etc/axonwall/certs/hub.crt 2>/dev/null || true

mkdir -p /var/lib/axonwall/headscale /var/lib/axonwall/etc-axonwall /var/lib/axonwall/bundles /var/lib/axonwall/gitops /var/lib/axonwall/home /run/headscale
mkdir -p /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups
mkdir -p /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki /var/lib/openldap/run /run/openldap
chown -R axonwall:axonwall-api /var/lib/axonwall /run/headscale /run/axonwall 2>/dev/null || true
chown root:axonwall-api /var/log/axonwall 2>/dev/null || true
chmod 1770 /var/log/axonwall 2>/dev/null || true
chmod 3775 /var/lib/axonwall /var/lib/axonwall/etc-axonwall 2>/dev/null || true
chmod 0755 /var/lib/axonwall/home /var/lib/axonwall/ldap 2>/dev/null || true
chmod 0750 /var/lib/axonwall/secrets /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki 2>/dev/null || true
chmod 0770 /var/lib/axonwall/headscale /run/headscale /run/axonwall 2>/dev/null || true
chown -R axonwall-headscale:axonwall-headscale /var/lib/axonwall/headscale 2>/dev/null || true
chown axonwall-headscale:axonwall-api /run/headscale 2>/dev/null || true
chown root:axonwall-api /etc/headscale/config.yaml 2>/dev/null || true
chmod 0640 /etc/headscale/config.yaml 2>/dev/null || true

if id -u ldap >/dev/null 2>&1; then
  chown -R ldap:ldap /var/lib/axonwall/ldap /var/lib/openldap/run /run/openldap 2>/dev/null || true
  chmod 0750 /var/lib/axonwall/ldap /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups 2>/dev/null || true
  chown -R root:ldap /var/lib/axonwall/secrets/ha-pki 2>/dev/null || true
fi
[ ! -e /etc/ldap ] && [ -d /etc/openldap ] && ln -sf /etc/openldap /etc/ldap 2>/dev/null || true
[ ! -e /usr/lib/ldap ] && [ -d /usr/lib/openldap ] && ln -sf /usr/lib/openldap /usr/lib/ldap 2>/dev/null || true

# Bind-mount persistent /var/lib/axonwall/home onto /home
mkdir -p /home
if ! grep -q ' /home ' /proc/mounts 2>/dev/null; then
  cp -a /home/. /var/lib/axonwall/home/ 2>/dev/null || true
  mount --bind /var/lib/axonwall/home /home 2>/dev/null || true
fi

# /usr/bin/zsh must resolve to a real shell. On full builds the zsh package
# installs /bin/zsh, so point /usr/bin/zsh there (replacing any stale ash
# symlink): an ash symlink makes busybox reject the shell with
# "zsh: applet not found", which breaks the console shell drop. Only on
# minimal builds (no zsh anywhere) fall back to ash, so SSO users replicated
# with loginShell=/usr/bin/zsh can log in over SSH cleanly.
if [ -x /bin/zsh ]; then
  if [ -L /usr/bin/zsh ] || [ ! -x /usr/bin/zsh ]; then
    ln -sf /bin/zsh /usr/bin/zsh 2>/dev/null || true
  fi
elif [ ! -x /usr/bin/zsh ] && [ -x /bin/ash ]; then
  ln -sf /bin/ash /usr/bin/zsh 2>/dev/null || true
fi

# Generate appliance security tokens
if [ ! -s /etc/axonwall/axonwall.env ]; then
  JWT_SECRET="$(openssl rand -hex 32)"
  ADMIN_PASS="$(openssl rand -hex 16 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"
  if [ ! -f /etc/axonwall/install-mode ] && ! grep -qE 'slot=A|slot=B|root=LABEL=axon_root' /proc/cmdline 2>/dev/null; then
    ADMIN_PASS="axonwall"
  fi
  if [ -f /etc/axonwall/admin.env ]; then
    INSTALL_PASS="$(grep '^LOCAL_ADMIN_PASSWORD=' /etc/axonwall/admin.env | cut -d= -f2- || true)"
    [ -n "$INSTALL_PASS" ] && ADMIN_PASS="$INSTALL_PASS"
  fi

  cat << ENV_EOF > /etc/axonwall/axonwall.env
JWT_SECRET=${JWT_SECRET}
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=${ADMIN_PASS}
AGENT_SOCKET_PATH=/run/axonwall/agent.sock
AGENT_API_SOCKET=/run/axonwall/agent-api.sock
ENV_EOF

  case "$ADMIN_PASS" in
    scrypt\$*) ;;
    *)
      if [ ! -f /etc/axonwall/.password_changed ]; then
        echo "$ADMIN_PASS" > /etc/axonwall/initial-admin-password
        chmod 0600 /etc/axonwall/initial-admin-password
      fi
      ;;
  esac
fi

if [ ! -s /etc/axonwall/controller.env ]; then
  ZTP_TOKEN="$(openssl rand -hex 16)"
  cat << ENV_EOF > /etc/axonwall/controller.env
AXONWALL_ZTP_TOKEN=${ZTP_TOKEN}
ENV_EOF
fi

chmod 0600 /etc/axonwall/axonwall.env 2>/dev/null || true
chown axonwall /etc/axonwall/axonwall.env 2>/dev/null || true
if [ -f /etc/axonwall/controller.env ]; then
  chown root:axonwall-controller /etc/axonwall/controller.env 2>/dev/null || true
  chmod 0640 /etc/axonwall/controller.env 2>/dev/null || true
fi
chown -R root:root /opt/axonwall 2>/dev/null || true
chmod -R go-w /opt/axonwall 2>/dev/null || true

# Initialize etckeeper if installed
if command -v etckeeper >/dev/null 2>&1; then
  if [ ! -d /etc/.git ]; then
    echo "[Axonwall Firstboot] Initializing etckeeper for /etc configuration tracking..."
    etckeeper init || true
    etckeeper commit "Initial etckeeper commit for Axonwall appliance" || true
  fi
fi

# Ensure SSH host keys are generated and sshd is running
if command -v ssh-keygen >/dev/null 2>&1; then
  ssh-keygen -A >/dev/null 2>&1 || true
fi
if [ -x /etc/init.d/sshd ]; then
  /etc/init.d/sshd start >/dev/null 2>&1 || true
fi

rm -f "$MARKER"

PRIMARY_IP=""
for _cand_if in "$LAN_IF" "$OPT1_IF" "$OPT2_IF" "$WAN_IF"; do
  if [ -n "$_cand_if" ]; then
    DETECTED_IP="$(ip -4 addr show dev "$_cand_if" 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n 1 || true)"
    if [ -n "$DETECTED_IP" ]; then
      PRIMARY_IP="$DETECTED_IP"
      break
    fi
  fi
done
[ -z "$PRIMARY_IP" ] && PRIMARY_IP="192.168.1.1"

cat << ISSUE_EOF > /etc/issue
================================================================================
Axonwall Appliance (Alpine Linux Edition)
Web Console (LAN): https://${PRIMARY_IP}:2966
WAN Inbound      : Blocked by default (Anti-Lockout enabled on LAN only)
Appliance Console: Login with administrator credentials
Install to Disk  : Run 'axonwall-install' from shell or Console TUI
================================================================================
\n (\l)

ISSUE_EOF

echo "[Axonwall Firstboot] Provisioning complete."
