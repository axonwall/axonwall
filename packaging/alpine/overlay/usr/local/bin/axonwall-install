#!/bin/sh
# ==============================================================================
# Axonwall Next-Gen Unified Appliance Installer (Debian 13 & Alpine Linux)
# Supports:
#   - Interactive Branded Go TUI Wizard (/usr/sbin/axonwall-console --install)
#   - Direct Live SquashFS / Rootfs High-Speed Imaging
#   - Dual-Root A/B (Slot A + Slot B + Data), ZFSBootMenu (zroot), Rolling (/)
#   - Multi-Disk System RAID-1 (mdadm) + OpenZFS Pool Topologies (tank / zroot)
#   - LUKS2 Persistent Data Encryption + TPM 2.0 Enrollment (systemd-cryptenroll)
#   - Dedicated /var/log Partition (axon_logs)
#   - Zero-Touch Unattended Cloud-Init / NoCloud Provisioning
# ==============================================================================
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "[!] axonwall-install must be run as root."
  exit 1
fi

MODE="interactive"
CONFIG_FILE=""
CLI_DISKS=""

while [ $# -gt 0 ]; do
  case "$1" in
    --apply-config)
      MODE="apply-config"
      CONFIG_FILE="${2:-}"
      shift 2
      ;;
    --unattended)
      MODE="unattended"
      shift
      ;;
    --shell-wizard)
      MODE="shell"
      shift
      ;;
    --help|-h)
      echo "Usage: axonwall-install [--apply-config <file> | --unattended | --shell-wizard | /dev/disk...]"
      exit 0
      ;;
    *)
      CLI_DISKS="${CLI_DISKS} $1"
      shift
      ;;
  esac
done

# Auto-detect kernel cmdline unattended flag
if [ "$MODE" = "interactive" ] && [ -z "$CLI_DISKS" ] && [ -f /proc/cmdline ]; then
  if grep -q 'axonwall.unattended=1' /proc/cmdline 2>/dev/null; then
    MODE="unattended"
  fi
fi

# Delegate interactive invocations to the Branded Go TUI Installer if available
if [ "$MODE" = "interactive" ] && [ -z "$CLI_DISKS" ] && [ "${AXONWALL_INSTALL_BACKEND:-0}" != "1" ]; then
  if [ -t 0 ] && [ -t 1 ] && [ -x /usr/sbin/axonwall-console ]; then
    exec /usr/sbin/axonwall-console --install
  fi
fi

cleanup_secrets() {
  if [ -n "${CONFIG_FILE:-}" ] && [ -f "${CONFIG_FILE:-}" ]; then
    shred -u "$CONFIG_FILE" 2>/dev/null || rm -f "$CONFIG_FILE" 2>/dev/null || true
  fi
  rm -f /tmp/axonwall-luks* /mnt/slot_a/tmp/.axonwall_pw_install.tmp /mnt/slot_a/run/axonwall-luks-enroll.key 2>/dev/null || true
}
trap cleanup_secrets EXIT INT TERM

emit_phase() {
  phase_num="$1"
  phase_total="$2"
  phase_msg="$3"
  echo "[PHASE:${phase_num}/${phase_total}] ${phase_msg}"
}

part_dev() {
  disk_dev="$1"
  p_num="$2"
  case "$disk_dev" in
    *nvme*|*mmcblk*|*loop*) echo "${disk_dev}p${p_num}" ;;
    *) echo "${disk_dev}${p_num}" ;;
  esac
}

is_mounted() {
  grep -qE "[[:space:]]${1%/}[[:space:]]" /proc/mounts 2>/dev/null
}

# Detect OS Family (debian vs alpine) and Edition (axonwall vs vault)
OS_FAMILY="debian"
if [ -f /etc/alpine-release ]; then
  OS_FAMILY="alpine"
fi

EDITION_LABEL="Axonwall NGFW Appliance"
INSTALL_EDITION="axonwall"
if [ -f /etc/axonwall/.vault-edition ] || grep -qE '(^|[[:space:]])(axonwall_edition=vault|axonwall\.edition=vault)($|[[:space:]])' /proc/cmdline 2>/dev/null; then
  EDITION_LABEL="Axonwall Vault Edition"
  INSTALL_EDITION="vault"
fi

# Default installation parameters
SYSTEM_DISKS=""
INSTALL_MODE="ab"
SLOT_MB=4096
ROOT_FSTYPE="ext4"
DATA_FSTYPE="ext4"
ZFS_ALLOC_MODE="remainder"
CUSTOM_ZFS_GB=0
ZFS_EXTRA_DISKS=""
ZFS_SLOG_DISKS=""
ZFS_L2ARC_DISKS=""
ZFS_SPARE_DISKS=""
ZFS_RAID_TOPOLOGY="auto"
LOGS_ENABLED=0
LOGS_GB=8
LOGS_FSTYPE="xfs"
LUKS_ENABLED=0
LUKS_TPM2=0
LUKS_PASSPHRASE=""
ADMIN_USER="admin"
ADMIN_PASSWORD=""
HOSTNAME_OVERRIDE=""
REBOOT_AFTER_INSTALL=0

# Helper: discover first suitable non-removable system disk
discover_default_disk() {
  for devpath in /sys/block/*; do
    [ -e "$devpath" ] || continue
    devname="$(basename "$devpath")"
    case "$devname" in
      loop*|ram*|sr*|fd*|dm-*|md*|zd*|zram*) continue ;;
    esac
    if [ -f "$devpath/removable" ] && [ "$(cat "$devpath/removable" 2>/dev/null || echo 0)" = "1" ]; then
      continue
    fi
    sectors="$(cat "$devpath/size" 2>/dev/null || echo 0)"
    if [ "$sectors" -le 4194304 ]; then
      continue
    fi
    if grep -q "^/dev/${devname}" /proc/mounts 2>/dev/null; then
      continue
    fi
    echo "/dev/${devname}"
    return 0
  done
  return 1
}

# Load parameters according to mode
if [ "$MODE" = "apply-config" ]; then
  if [ -z "$CONFIG_FILE" ] || [ ! -f "$CONFIG_FILE" ]; then
    echo "[!] Error: Configuration file '$CONFIG_FILE' not found."
    exit 1
  fi
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
elif [ "$MODE" = "unattended" ]; then
  echo "================================================================================"
  echo "  ${EDITION_LABEL} — Zero-Touch Unattended Installer (${OS_FAMILY})"
  echo "================================================================================"
  if [ -x /usr/lib/axonwall/detect-cloudinit ]; then
    /usr/lib/axonwall/detect-cloudinit || true
  fi
  CI_FILE=""
  for cand in /var/lib/partman/cloud-config.yaml /var/lib/cloud/seed/nocloud-net/user-data /etc/axonwall/cloud-config.yaml; do
    if [ -s "$cand" ]; then
      CI_FILE="$cand"
      break
    fi
  done

  if [ -n "$CI_FILE" ]; then
    echo "[+] Loaded Cloud-Init seed from ${CI_FILE}"
    ci_edition="$(grep -E '^[[:space:]]*edition:' "$CI_FILE" 2>/dev/null | head -n1 | awk -F: '{print $2}' | tr -d ' "'"'"'\r' || true)"
    case "$ci_edition" in
      vault|s3|storage)
        INSTALL_EDITION="vault"
        EDITION_LABEL="Axonwall Vault Edition"
        ;;
      axonwall|ngfw|firewall)
        INSTALL_EDITION="axonwall"
        EDITION_LABEL="Axonwall NGFW Appliance"
        ;;
    esac
    ci_mode="$(grep -E '^[[:space:]]*install_mode:' "$CI_FILE" 2>/dev/null | head -n1 | awk -F: '{print $2}' | tr -d ' "'"'"'\r' || true)"
    case "$ci_mode" in
      ab|dual|dual-root) INSTALL_MODE="ab" ;;
      zbm|zfsbootmenu) INSTALL_MODE="zbm" ;;
      rolling|single) INSTALL_MODE="rolling" ;;
    esac

    ci_disk="$(grep -E '^[[:space:]]*target_disk:' "$CI_FILE" 2>/dev/null | head -n1 | awk -F: '{print $2}' | tr -d ' "'"'"'\r' || true)"
    if [ -n "$ci_disk" ] && [ "$ci_disk" != "auto" ] && [ -b "$ci_disk" ]; then
      SYSTEM_DISKS="$ci_disk"
    fi

    ci_raid_disks="$(grep -E '^[[:space:]]*system_raid_disks:' "$CI_FILE" 2>/dev/null | head -n1 | cut -d: -f2- | tr -d '[]"'"'"'\r' | tr ',' ' ' || true)"
    if [ -n "$ci_raid_disks" ] && [ "$ci_raid_disks" != "none" ]; then
      SYSTEM_DISKS="$ci_raid_disks"
    fi

    ci_slot_gb="$(grep -E '^[[:space:]]*slot_size_gb:' "$CI_FILE" 2>/dev/null | head -n1 | awk -F: '{print $2}' | tr -dc '0-9' || true)"
    if [ -n "$ci_slot_gb" ] && [ "$ci_slot_gb" -ge 2 ]; then
      SLOT_MB=$(( ci_slot_gb * 1024 ))
    fi

    ci_zfs_mode="$(grep -E '^[[:space:]]*zfs_alloc_mode:' "$CI_FILE" 2>/dev/null | head -n1 | awk -F: '{print $2}' | tr -d ' "'"'"'\r' || true)"
    case "$ci_zfs_mode" in
      remainder|split|custom|none) ZFS_ALLOC_MODE="$ci_zfs_mode" ;;
    esac

    ci_zfs_gb="$(grep -E '^[[:space:]]*zfs_size_gb:' "$CI_FILE" 2>/dev/null | head -n1 | awk -F: '{print $2}' | tr -dc '0-9' || true)"
    if [ -n "$ci_zfs_gb" ] && [ "$ci_zfs_gb" -ge 1 ]; then
      CUSTOM_ZFS_GB="$ci_zfs_gb"
    fi

    ci_zfs_topo="$(grep -E '^[[:space:]]*zfs_raid_topology:' "$CI_FILE" 2>/dev/null | head -n1 | awk -F: '{print $2}' | tr -d ' "'"'"'\r' || true)"
    if [ -n "$ci_zfs_topo" ]; then
      ZFS_RAID_TOPOLOGY="$ci_zfs_topo"
    fi

    ci_extra_disks="$(grep -E '^[[:space:]]*zfs_extra_disks:' "$CI_FILE" 2>/dev/null | head -n1 | cut -d: -f2- | tr -d '[]"'"'"'\r' | tr ',' ' ' || true)"
    if [ -n "$ci_extra_disks" ] && [ "$ci_extra_disks" != "none" ]; then
      ZFS_EXTRA_DISKS="$ci_extra_disks"
    fi

    ci_slog_disks="$(grep -E '^[[:space:]]*zfs_slog_disks:' "$CI_FILE" 2>/dev/null | head -n1 | cut -d: -f2- | tr -d '[]"'"'"'\r' | tr ',' ' ' || true)"
    if [ -n "$ci_slog_disks" ] && [ "$ci_slog_disks" != "none" ]; then
      ZFS_SLOG_DISKS="$ci_slog_disks"
    fi

    ci_l2arc_disks="$(grep -E '^[[:space:]]*zfs_l2arc_disks:' "$CI_FILE" 2>/dev/null | head -n1 | cut -d: -f2- | tr -d '[]"'"'"'\r' | tr ',' ' ' || true)"
    if [ -n "$ci_l2arc_disks" ] && [ "$ci_l2arc_disks" != "none" ]; then
      ZFS_L2ARC_DISKS="$ci_l2arc_disks"
    fi

    ci_spare_disks="$(grep -E '^[[:space:]]*zfs_spare_disks:' "$CI_FILE" 2>/dev/null | head -n1 | cut -d: -f2- | tr -d '[]"'"'"'\r' | tr ',' ' ' || true)"
    if [ -n "$ci_spare_disks" ] && [ "$ci_spare_disks" != "none" ]; then
      ZFS_SPARE_DISKS="$ci_spare_disks"
    fi

    ci_luks="$(grep -E '^[[:space:]]*luks_enabled:' "$CI_FILE" 2>/dev/null | head -n1 | awk -F: '{print $2}' | tr -d ' "'"'"'\r' || true)"
    if [ "$ci_luks" = "true" ] || [ "$ci_luks" = "1" ]; then
      LUKS_ENABLED=1
    fi

    ci_tpm="$(grep -E '^[[:space:]]*luks_tpm2:' "$CI_FILE" 2>/dev/null | head -n1 | awk -F: '{print $2}' | tr -d ' "'"'"'\r' || true)"
    if [ "$ci_tpm" = "true" ] || [ "$ci_tpm" = "1" ]; then
      LUKS_TPM2=1
    fi

    ci_luks_pw="$(grep -E '^[[:space:]]*luks_passphrase:' "$CI_FILE" 2>/dev/null | head -n1 | sed -e 's/.*luks_passphrase:[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' || true)"
    if [ -n "$ci_luks_pw" ]; then
      LUKS_PASSPHRASE="$ci_luks_pw"
    fi

    ci_pw="$(grep -A 10 "auth:" "$CI_FILE" 2>/dev/null | grep "admin_password:" | head -n1 | sed -e 's/.*admin_password:[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' || true)"
    [ "$ci_pw" = "CHANGE_ME_ON_DEPLOY" ] && ci_pw=""
    if [ -n "$ci_pw" ]; then
      ADMIN_PASSWORD="$ci_pw"
    fi
  fi

  if [ -z "$SYSTEM_DISKS" ]; then
    SYSTEM_DISKS="$(discover_default_disk || true)"
  fi
  REBOOT_AFTER_INSTALL=1
else
  # Interactive Shell Fallback Mode
  echo "================================================================================"
  echo "  ${EDITION_LABEL} Installer (${OS_FAMILY} — A/B + RAID + OpenZFS + LUKS2)"
  echo "================================================================================"
  echo ""
  echo "Available block devices:"
  lsblk -d -n -o NAME,SIZE,MODEL,TYPE 2>/dev/null | grep "disk" || fdisk -l 2>/dev/null | grep "^Disk /dev/" || true
  echo ""

  SYSTEM_DISKS="$(echo "$CLI_DISKS" | sed 's/^ *//;s/ *$//')"
  if [ -z "$SYSTEM_DISKS" ]; then
    printf "Enter system disk(s) to install Axonwall (space-separated for RAID-1 Mirror, e.g. '/dev/vda' or '/dev/nvme0n1 /dev/nvme1n1'): "
    read -r SYSTEM_DISKS
  fi

  echo ""
  echo "Select Appliance Edition:"
  echo "  [1] Axonwall NGFW & Router Appliance [Default]"
  echo "  [2] Axonwall Vault Edition (Immutable S3 Object-Lock Backup Appliance)"
  printf "Choice [1-2] (default 1): "
  read -r EDITION_CHOICE
  case "${EDITION_CHOICE:-1}" in
    2|vault|VAULT)
      INSTALL_EDITION="vault"
      EDITION_LABEL="Axonwall Vault Edition"
      ;;
    *)
      INSTALL_EDITION="axonwall"
      EDITION_LABEL="Axonwall NGFW Appliance"
      ;;
  esac

  echo ""
  echo "Select Installation Architecture:"
  echo "  [1] Dual-Root A/B (Unbrickable Dual Slots + Data Partition) [Default]"
  echo "  [2] ZFSBootMenu Root-on-ZFS (Boot Environments, Snapshots & Full ZFS RAID)"
  echo "  [3] Rolling Standard Linux (Single Root /)"
  printf "Choice [1-3] (default 1): "
  read -r ARCH_CHOICE
  case "${ARCH_CHOICE:-1}" in
    2) INSTALL_MODE="zbm" ;;
    3) INSTALL_MODE="rolling" ;;
    *) INSTALL_MODE="ab" ;;
  esac

  if [ "$INSTALL_MODE" = "ab" ]; then
    printf "Select Slot Size for A/B Dual-Root [1=2GB Compact, 2=4GB Standard, 3=8GB Expanded, 4=16GB Enterprise] (default 2): "
    read -r SLOT_CHOICE
    case "${SLOT_CHOICE:-2}" in
      1) SLOT_MB=2048 ;;
      3) SLOT_MB=8192 ;;
      4) SLOT_MB=16384 ;;
      *) SLOT_MB=4096 ;;
    esac
  else
    SLOT_MB=8192
  fi

  if [ "$INSTALL_MODE" != "zbm" ]; then
    echo ""
    echo "Select ZFS Storage Allocation on System Disk(s):"
    echo "  [1] Reserve remaining space for ZFS Pool (8GB System Data + Remainder ZFS) [Default]"
    echo "  [2] Split remaining space 50/50 between System Data and ZFS Pool"
    echo "  [3] Custom ZFS Partition Size (in GB)"
    echo "  [4] None on system disk (Use 100% of remaining space for System Data)"
    printf "Choice [1-4] (default 1): "
    read -r ZFS_CHOICE
    case "${ZFS_CHOICE:-1}" in
      2) ZFS_ALLOC_MODE="split" ;;
      3)
        ZFS_ALLOC_MODE="custom"
        printf "Enter desired ZFS partition size on system disk(s) in GB: "
        read -r CUSTOM_ZFS_GB
        CUSTOM_ZFS_GB=$(echo "${CUSTOM_ZFS_GB:-0}" | tr -dc '0-9')
        ;;
      4) ZFS_ALLOC_MODE="none" ;;
      *) ZFS_ALLOC_MODE="remainder" ;;
    esac
  fi

  echo ""
  printf "Optional: Enter any dedicated whole disks for ZFS Data Pool 'tank' (space-separated, or Enter for none): "
  read -r ZFS_EXTRA_DISKS
  printf "Optional: Enter any dedicated ZFS SLOG (ZIL write log) disks (space-separated, or Enter for none): "
  read -r ZFS_SLOG_DISKS
  printf "Optional: Enter any dedicated ZFS L2ARC (read cache) disks (space-separated, or Enter for none): "
  read -r ZFS_L2ARC_DISKS
  printf "Optional: Enter any dedicated ZFS Hot Spare disks (space-separated, or Enter for none): "
  read -r ZFS_SPARE_DISKS

  echo ""
  printf "Enable LUKS2 disk encryption on persistent data volume (/var/lib/axonwall)? (y/N): "
  read -r LUKS_ANS
  if [ "$LUKS_ANS" = "y" ] || [ "$LUKS_ANS" = "Y" ]; then
    LUKS_ENABLED=1
    printf "Enter LUKS2 passphrase: "
    stty -echo 2>/dev/null || true
    read -r LUKS_PASSPHRASE || LUKS_PASSPHRASE=""
    stty echo 2>/dev/null || true
    echo ""
    if [ -e /dev/tpmrm0 ] || [ -e /dev/tpm0 ]; then
      printf "Enroll hardware TPM 2.0 (PCRs 0+2+7) for automatic boot unlock? (Y/n): "
      read -r TPM_ANS
      if [ "${TPM_ANS:-Y}" != "n" ] && [ "${TPM_ANS:-Y}" != "N" ]; then
        LUKS_TPM2=1
      fi
    fi
  fi

  if [ ! -f /etc/axonwall/.vault-edition ]; then
    echo ""
    PW_ATTEMPT=0
    while [ $PW_ATTEMPT -lt 3 ]; do
      PW_ATTEMPT=$((PW_ATTEMPT + 1))
      printf "Set a new admin password for the installed system (leave empty to keep default): "
      stty -echo 2>/dev/null || true
      read -r PW_FIRST || PW_FIRST=""
      stty echo 2>/dev/null || true
      echo ""
      if [ -z "$PW_FIRST" ]; then
        break
      fi
      printf "Confirm the new admin password: "
      stty -echo 2>/dev/null || true
      read -r PW_SECOND || PW_SECOND=""
      stty echo 2>/dev/null || true
      echo ""
      if [ "$PW_FIRST" = "$PW_SECOND" ]; then
        ADMIN_PASSWORD="$PW_FIRST"
        PW_FIRST=""; PW_SECOND=""
        break
      fi
      PW_FIRST=""; PW_SECOND=""
      echo "[!] Passwords do not match -- please try again."
    done
  fi

  printf "WARNING: All data on %s %s will be erased! Proceed? (y/N): " "$SYSTEM_DISKS" "$ZFS_EXTRA_DISKS"
  read -r CONFIRM
  if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
    echo "Aborted."
    exit 0
  fi
fi

# Validate system disks
SYSTEM_DISKS=$(echo "$SYSTEM_DISKS" | tr ',' ' ' | tr -s ' ' | sed 's/^ *//;s/ *$//')
ZFS_EXTRA_DISKS=$(echo "${ZFS_EXTRA_DISKS:-}" | tr ',' ' ' | tr -s ' ' | sed 's/^ *//;s/ *$//')
ZFS_SLOG_DISKS=$(echo "${ZFS_SLOG_DISKS:-}" | tr ',' ' ' | tr -s ' ' | sed 's/^ *//;s/ *$//')
ZFS_L2ARC_DISKS=$(echo "${ZFS_L2ARC_DISKS:-}" | tr ',' ' ' | tr -s ' ' | sed 's/^ *//;s/ *$//')
ZFS_SPARE_DISKS=$(echo "${ZFS_SPARE_DISKS:-}" | tr ',' ' ' | tr -s ' ' | sed 's/^ *//;s/ *$//')
SYS_DISK_COUNT=0
PRIMARY_DISK=""
for d in $SYSTEM_DISKS; do
  if [ ! -b "$d" ]; then
    echo "[!] Error: Block device '$d' does not exist."
    exit 1
  fi
  if [ -z "$PRIMARY_DISK" ]; then
    PRIMARY_DISK="$d"
  fi
  SYS_DISK_COUNT=$(( SYS_DISK_COUNT + 1 ))
done

if [ -z "$PRIMARY_DISK" ]; then
  echo "[!] Error: No target system disk specified or discovered."
  exit 1
fi

SYSTEM_RAID_MODE="single"
if [ "$SYS_DISK_COUNT" -ge 2 ]; then
  SYSTEM_RAID_MODE="mirror"
  echo "[+] System RAID Mode: RAID-1 Mirror across ${SYS_DISK_COUNT} disks (${SYSTEM_DISKS})"
else
  echo "[+] System RAID Mode: Single Disk (${PRIMARY_DISK})"
fi

# Compute partition geometry in MiB from primary disk size
DEV_BASE=$(basename "$PRIMARY_DISK")
DISK_SECTORS=$(cat "/sys/block/${DEV_BASE}/size" 2>/dev/null || echo 0)
DISK_MB=$(( DISK_SECTORS * 512 / 1024 / 1024 ))
if [ "$DISK_MB" -le 0 ]; then
  DISK_MB=32768
fi

END_EFI=260
END_A=$((END_EFI + SLOT_MB))
if [ "$INSTALL_MODE" = "ab" ]; then
  END_B=$((END_A + SLOT_MB))
else
  END_B="$END_A"
fi

LOGS_MB=0
if [ "${LOGS_ENABLED:-0}" = "1" ] && [ "${LOGS_GB:-0}" -ge 1 ]; then
  LOGS_MB=$(( LOGS_GB * 1024 ))
fi
END_LOGS=$((END_B + LOGS_MB))

REM_MB=$((DISK_MB - END_LOGS - 16))
if [ "$REM_MB" -lt 1024 ]; then
  REM_MB=1024
fi

ZFS_MB=0
DATA_MB="$REM_MB"

if [ "$INSTALL_MODE" = "zbm" ]; then
  DATA_MB=4096
  if [ "$REM_MB" -gt 6144 ]; then
    ZFS_MB=$(( REM_MB - DATA_MB ))
  else
    DATA_MB=$(( REM_MB / 2 ))
    ZFS_MB=$(( REM_MB - DATA_MB ))
  fi
else
  case "${ZFS_ALLOC_MODE:-remainder}" in
    split)
      DATA_MB=$(( REM_MB / 2 ))
      ZFS_MB=$(( REM_MB - DATA_MB ))
      ;;
    custom)
      if [ "${CUSTOM_ZFS_GB:-0}" -ge 1 ]; then
        ZFS_MB=$(( CUSTOM_ZFS_GB * 1024 ))
        if [ "$ZFS_MB" -gt $(( REM_MB - 2048 )) ]; then
          ZFS_MB=$(( REM_MB - 2048 ))
        fi
        DATA_MB=$(( REM_MB - ZFS_MB ))
      else
        ZFS_MB=0
      fi
      ;;
    none)
      ZFS_MB=0
      ;;
    *)
      if [ "$REM_MB" -gt 10240 ]; then
        DATA_MB=8192
        ZFS_MB=$(( REM_MB - DATA_MB ))
      elif [ "$REM_MB" -gt 4096 ]; then
        DATA_MB=2048
        ZFS_MB=$(( REM_MB - DATA_MB ))
      else
        ZFS_MB=0
      fi
      ;;
  esac
fi

END_DATA=$((END_LOGS + DATA_MB))

# ==============================================================================
# PHASE 1: Partition Target Disks
# ==============================================================================
emit_phase 1 8 "Partitioning target disk(s) (${SYSTEM_DISKS})..."

# Stop any pre-existing mdadm or crypt mappings from previous runs
umount /mnt/slot_a/boot/efi /mnt/slot_a /mnt/slot_b /mnt/data /mnt/logs /mnt/squash_ro 2>/dev/null || true
cryptsetup close axon_crypt_data 2>/dev/null || true
for md_dev in /dev/md0 /dev/md1 /dev/md2 /dev/md3; do
  if [ -b "$md_dev" ]; then
    mdadm --stop "$md_dev" 2>/dev/null || true
  fi
done

ZFS_VDEVS=""
DISK_IDX=0

for sys_disk in $SYSTEM_DISKS; do
  DISK_IDX=$(( DISK_IDX + 1 ))
  wipefs -a "$sys_disk" 2>/dev/null || true
  dd if=/dev/zero of="$sys_disk" bs=1M count=16 conv=notrunc 2>/dev/null || true

  echo "[+] Creating GPT partition table on ${sys_disk} (Mode=${INSTALL_MODE}, Slot=${SLOT_MB}MB, Logs=${LOGS_MB}MB, Data=${DATA_MB}MB, ZFS=${ZFS_MB}MB)..."
  parted -s "$sys_disk" \
    mklabel gpt \
    mkpart bios_grub 1MiB 4MiB \
    set 1 bios_grub on \
    mkpart ESP fat32 4MiB ${END_EFI}MiB \
    set 2 esp on

  NEXT_PART=3
  CUR_START="$END_EFI"

  # Partition 3: Slot A / Primary Root
  ROOT_A_PART_NUM="$NEXT_PART"
  parted -s "$sys_disk" mkpart axon_root_a "${ROOT_FSTYPE}" "${CUR_START}MiB" "${END_A}MiB"
  CUR_START="$END_A"
  NEXT_PART=$(( NEXT_PART + 1 ))

  # Optional Slot B (A/B mode)
  ROOT_B_PART_NUM=""
  if [ "$INSTALL_MODE" = "ab" ]; then
    ROOT_B_PART_NUM="$NEXT_PART"
    parted -s "$sys_disk" mkpart axon_root_b "${ROOT_FSTYPE}" "${CUR_START}MiB" "${END_B}MiB"
    CUR_START="$END_B"
    NEXT_PART=$(( NEXT_PART + 1 ))
  fi

  # Optional Dedicated /var/log Partition
  LOGS_PART_NUM=""
  if [ "$LOGS_MB" -gt 0 ]; then
    LOGS_PART_NUM="$NEXT_PART"
    parted -s "$sys_disk" mkpart axon_logs "${LOGS_FSTYPE}" "${CUR_START}MiB" "${END_LOGS}MiB"
    CUR_START="$END_LOGS"
    NEXT_PART=$(( NEXT_PART + 1 ))
  fi

  # Persistent Data Partition (/var/lib/axonwall)
  DATA_PART_NUM="$NEXT_PART"
  if [ "$ZFS_MB" -gt 0 ]; then
    parted -s "$sys_disk" mkpart axon_data "${DATA_FSTYPE}" "${CUR_START}MiB" "${END_DATA}MiB"
    NEXT_PART=$(( NEXT_PART + 1 ))
    ZFS_PART_NUM="$NEXT_PART"
    parted -s "$sys_disk" mkpart "axon_zfs_${DISK_IDX}" "${END_DATA}MiB" 100%
    sgdisk -t "${ZFS_PART_NUM}:bf01" "$sys_disk" 2>/dev/null || true
    ZFS_PART=$(part_dev "$sys_disk" "$ZFS_PART_NUM")
    ZFS_VDEVS="${ZFS_VDEVS} ${ZFS_PART}"
  else
    parted -s "$sys_disk" mkpart axon_data "${DATA_FSTYPE}" "${CUR_START}MiB" 100%
  fi

  partprobe "$sys_disk" 2>/dev/null || true
done

udevadm settle 2>/dev/null || mdev -s 2>/dev/null || true
sleep 1

# ==============================================================================
# PHASE 2: Format Filesystems, Assemble RAID-1 & Configure LUKS2 + TPM2
# ==============================================================================
emit_phase 2 8 "Formatting filesystems, RAID-1 mirrors & LUKS2 encryption..."

format_esp() {
  _esp_dev="$1"
  if ! command -v mkfs.vfat >/dev/null 2>&1 && ! command -v mkfs.fat >/dev/null 2>&1; then
    for _deb in /run/live/medium/pool*/main/d/dosfstools/dosfstools*.*deb /cdrom/pool*/main/d/dosfstools/dosfstools*.*deb; do
      if [ -f "$_deb" ] && command -v dpkg-deb >/dev/null 2>&1; then
        echo "[+] Extracting fallback dosfstools package (${_deb}) into live environment..."
        dpkg-deb -x "$_deb" / 2>/dev/null || true
        break
      fi
    done
  fi
  if command -v mkfs.vfat >/dev/null 2>&1; then
    mkfs.vfat -F 32 -n AXON_EFI "$_esp_dev" >/dev/null 2>&1 || mkfs.vfat -F 32 "$_esp_dev"
  elif command -v mkfs.fat >/dev/null 2>&1; then
    mkfs.fat -F 32 -n AXON_EFI "$_esp_dev" >/dev/null 2>&1 || mkfs.fat -F 32 "$_esp_dev"
  else
    echo "[!] FATAL: Neither mkfs.vfat nor mkfs.fat is available to format EFI System Partition ${_esp_dev}." >&2
    exit 1
  fi
}

for sys_disk in $SYSTEM_DISKS; do
  EFI_P=$(part_dev "$sys_disk" 2)
  format_esp "$EFI_P"
done

ROOT_A_DEV=$(part_dev "$PRIMARY_DISK" "$ROOT_A_PART_NUM")
ROOT_B_DEV=""
if [ -n "$ROOT_B_PART_NUM" ]; then
  ROOT_B_DEV=$(part_dev "$PRIMARY_DISK" "$ROOT_B_PART_NUM")
fi
LOGS_DEV=""
if [ -n "$LOGS_PART_NUM" ]; then
  LOGS_DEV=$(part_dev "$PRIMARY_DISK" "$LOGS_PART_NUM")
fi
DATA_DEV=$(part_dev "$PRIMARY_DISK" "$DATA_PART_NUM")

if [ "$SYSTEM_RAID_MODE" = "mirror" ] && command -v mdadm >/dev/null 2>&1; then
  echo "[+] Assembling mdadm RAID-1 mirrors across ${SYS_DISK_COUNT} system disks..."
  RAID_A_MEMBERS=""
  RAID_B_MEMBERS=""
  RAID_LOGS_MEMBERS=""
  RAID_DATA_MEMBERS=""
  for sys_disk in $SYSTEM_DISKS; do
    RAID_A_MEMBERS="${RAID_A_MEMBERS} $(part_dev "$sys_disk" "$ROOT_A_PART_NUM")"
    if [ -n "$ROOT_B_PART_NUM" ]; then
      RAID_B_MEMBERS="${RAID_B_MEMBERS} $(part_dev "$sys_disk" "$ROOT_B_PART_NUM")"
    fi
    if [ -n "$LOGS_PART_NUM" ]; then
      RAID_LOGS_MEMBERS="${RAID_LOGS_MEMBERS} $(part_dev "$sys_disk" "$LOGS_PART_NUM")"
    fi
    RAID_DATA_MEMBERS="${RAID_DATA_MEMBERS} $(part_dev "$sys_disk" "$DATA_PART_NUM")"
  done

  # Zero superblocks before creation
  for mbr in $RAID_A_MEMBERS $RAID_B_MEMBERS $RAID_LOGS_MEMBERS $RAID_DATA_MEMBERS; do
    mdadm --zero-superblock "$mbr" 2>/dev/null || true
  done

  # shellcheck disable=SC2086
  mdadm --create /dev/md0 --level=1 --raid-devices="$SYS_DISK_COUNT" --metadata=1.2 --run $RAID_A_MEMBERS
  ROOT_A_DEV="/dev/md0"
  if [ -n "$ROOT_B_PART_NUM" ]; then
    # shellcheck disable=SC2086
    mdadm --create /dev/md1 --level=1 --raid-devices="$SYS_DISK_COUNT" --metadata=1.2 --run $RAID_B_MEMBERS
    ROOT_B_DEV="/dev/md1"
  fi
  # shellcheck disable=SC2086
  mdadm --create /dev/md2 --level=1 --raid-devices="$SYS_DISK_COUNT" --metadata=1.2 --run $RAID_DATA_MEMBERS
  DATA_DEV="/dev/md2"
  if [ -n "$LOGS_PART_NUM" ]; then
    # shellcheck disable=SC2086
    mdadm --create /dev/md3 --level=1 --raid-devices="$SYS_DISK_COUNT" --metadata=1.2 --run $RAID_LOGS_MEMBERS
    LOGS_DEV="/dev/md3"
  fi
fi

format_fs() {
  dev="$1"
  fstype="$2"
  label="$3"
  if [ "$fstype" = "xfs" ] && command -v mkfs.xfs >/dev/null 2>&1; then
    mkfs.xfs -f -L "$label" "$dev" >/dev/null
  else
    mkfs.ext4 -F -L "$label" "$dev" >/dev/null
  fi
}

ROOT_A_LABEL="axon_root_a"
if [ "$INSTALL_MODE" = "rolling" ] || [ "$INSTALL_MODE" = "zbm" ]; then
  ROOT_A_LABEL="axon_root"
fi

echo "[+] Formatting Root (${ROOT_A_DEV} -> ${ROOT_A_LABEL}, ${ROOT_FSTYPE})..."
format_fs "$ROOT_A_DEV" "$ROOT_FSTYPE" "$ROOT_A_LABEL"

if [ "$INSTALL_MODE" = "ab" ] && [ -n "$ROOT_B_DEV" ]; then
  echo "[+] Formatting Standby Slot B (${ROOT_B_DEV} -> axon_root_b, ${ROOT_FSTYPE})..."
  format_fs "$ROOT_B_DEV" "$ROOT_FSTYPE" "axon_root_b"
fi

if [ -n "$LOGS_DEV" ]; then
  echo "[+] Formatting Dedicated Logs (${LOGS_DEV} -> axon_logs, ${LOGS_FSTYPE})..."
  format_fs "$LOGS_DEV" "$LOGS_FSTYPE" "axon_logs"
fi

TARGET_DATA_MAPPER="$DATA_DEV"
TEMP_LUKS_KEY=""
if [ "${LUKS_ENABLED:-0}" = "1" ] && command -v cryptsetup >/dev/null 2>&1; then
  echo "[+] Initializing LUKS2 AES-XTS-512 encryption on ${DATA_DEV}..."
  TEMP_LUKS_KEY="/tmp/axonwall-luks.key"
  rm -f "$TEMP_LUKS_KEY"
  if [ -n "$LUKS_PASSPHRASE" ]; then
    printf '%s' "$LUKS_PASSPHRASE" > "$TEMP_LUKS_KEY"
  else
    dd if=/dev/urandom of="$TEMP_LUKS_KEY" bs=32 count=1 2>/dev/null
  fi
  chmod 0400 "$TEMP_LUKS_KEY"

  cryptsetup luksFormat --type luks2 --batch-mode --cipher aes-xts-plain64 -s 512 -d "$TEMP_LUKS_KEY" "$DATA_DEV"
  cryptsetup open -d "$TEMP_LUKS_KEY" "$DATA_DEV" axon_crypt_data
  TARGET_DATA_MAPPER="/dev/mapper/axon_crypt_data"
fi

echo "[+] Formatting Persistent Data (${TARGET_DATA_MAPPER} -> axon_data, ${DATA_FSTYPE})..."
format_fs "$TARGET_DATA_MAPPER" "$DATA_FSTYPE" "axon_data"

udevadm settle 2>/dev/null || mdev -s 2>/dev/null || true

# ==============================================================================
# PHASE 3: Image Axonwall OS onto Slot A
# ==============================================================================
emit_phase 3 8 "Imaging ${EDITION_LABEL} root filesystem to Slot A..."

PRIMARY_EFI=$(part_dev "$PRIMARY_DISK" 2)
mkdir -p /mnt/slot_a /mnt/slot_b /mnt/data
mount "$ROOT_A_DEV" /mnt/slot_a
mkdir -p /mnt/slot_a/boot/efi /mnt/slot_a/var/lib/axonwall
mount "$PRIMARY_EFI" /mnt/slot_a/boot/efi
mount "$TARGET_DATA_MAPPER" /mnt/data

SQUASH_MOUNT=""
for sq_dir in /run/live/rootfs/filesystem.squashfs /lib/live/mount/rootfs/filesystem.squashfs; do
  if [ -d "$sq_dir/usr" ] && [ -d "$sq_dir/etc" ]; then
    SQUASH_MOUNT="$sq_dir"
    break
  fi
done

if [ -z "$SQUASH_MOUNT" ]; then
  for sq_file in /run/live/medium/live/filesystem.squashfs /lib/live/mount/medium/live/filesystem.squashfs /cdrom/live/filesystem.squashfs; do
    if [ -f "$sq_file" ]; then
      mkdir -p /mnt/squash_ro
      if mount -t squashfs -o loop,ro "$sq_file" /mnt/squash_ro 2>/dev/null; then
        SQUASH_MOUNT="/mnt/squash_ro"
        break
      fi
    fi
  done
fi

if [ -n "$SQUASH_MOUNT" ]; then
  echo "[+] Direct-imaging pristine SquashFS image from ${SQUASH_MOUNT}..."
  if command -v rsync >/dev/null 2>&1; then
    rsync -aAX \
      --exclude='/proc/*' \
      --exclude='/sys/*' \
      --exclude='/dev/*' \
      --exclude='/run/*' \
      --exclude='/tmp/*' \
      --exclude='/mnt/*' \
      --exclude='/media/*' \
      --exclude='/boot/efi/*' \
      "${SQUASH_MOUNT}/" /mnt/slot_a/
  else
    ( cd "$SQUASH_MOUNT" && tar --exclude='./proc/*' --exclude='./sys/*' --exclude='./dev/*' --exclude='./run/*' --exclude='./tmp/*' --exclude='./mnt/*' --exclude='./media/*' --exclude='./boot/efi/*' -cf - . ) | ( cd /mnt/slot_a && tar -xf - )
  fi
  if [ "$SQUASH_MOUNT" = "/mnt/squash_ro" ]; then
    umount /mnt/squash_ro 2>/dev/null || true
  fi
else
  echo "[+] Copying live root filesystem to Slot A..."
  for dir in bin etc home lib lib64 opt root sbin usr var; do
    if [ -d "/$dir" ]; then
      cp -a "/$dir" /mnt/slot_a/ 2>/dev/null || true
    fi
  done
  # On Alpine Live, replace symlinked /lib/modules with real kernel module tree from modloop
  if [ -e /lib/modules ] && { [ -L /mnt/slot_a/lib/modules ] || [ ! -d /mnt/slot_a/lib/modules ]; }; then
    echo "[+] Installing loadable kernel modules to Slot A..."
    rm -rf /mnt/slot_a/lib/modules
    mkdir -p /mnt/slot_a/lib/modules
    ( cd /lib/modules && tar cf - . ) | ( cd /mnt/slot_a/lib/modules && tar xf - ) || true
  fi
  for boot_src in /media/cdrom/boot /media/usb/boot /media/*/boot /run/live/medium/live /boot; do
    if [ -d "$boot_src" ] && ls "$boot_src"/vmlinuz* >/dev/null 2>&1; then
      cp -a "$boot_src"/* /mnt/slot_a/boot/ 2>/dev/null || true
      break
    fi
  done
fi

mkdir -p /mnt/slot_a/dev /mnt/slot_a/proc /mnt/slot_a/sys /mnt/slot_a/run /mnt/slot_a/tmp /mnt/slot_a/boot /mnt/slot_a/mnt /mnt/slot_a/var/log

# ==============================================================================
# PHASE 4: Configure fstab, crypttab, TPM2, Cloud-Init & Credentials
# ==============================================================================
emit_phase 4 8 "Configuring fstab, LUKS2/TPM2, Cloud-Init & administrator credentials..."

mkdir -p /mnt/data/home /mnt/data/ldap /mnt/data/secrets /mnt/data/etc-axonwall /mnt/slot_a/home /mnt/slot_a/etc/axonwall
echo "${INSTALL_MODE}" > /mnt/slot_a/etc/axonwall/install-mode
echo "${INSTALL_MODE}" > /mnt/data/install-mode

if [ "${INSTALL_EDITION:-axonwall}" = "vault" ] || [ -f /mnt/slot_a/etc/axonwall/.vault-edition ]; then
  echo "[+] Configuring target as Axonwall Vault Edition (hardened immutable S3 storage appliance)..."
  mkdir -p /mnt/slot_a/etc/axonwall /mnt/slot_a/etc/systemd/system/multi-user.target.wants
  touch /mnt/slot_a/etc/axonwall/.vault-edition /mnt/slot_a/etc/axonwall/.vault-firstboot
  rm -f /mnt/slot_a/etc/axonwall/.firstboot

  if [ -d /mnt/slot_a/usr/share/axonwall/vault ]; then
    VSTAGE="/mnt/slot_a/usr/share/axonwall/vault"
    if [ -f "${VSTAGE}/weed" ]; then
      cp -f "${VSTAGE}/weed" /mnt/slot_a/usr/sbin/weed
      chmod 0755 /mnt/slot_a/usr/sbin/weed
    fi
    for vunit in seaweedfs.service axonwall-vault-firstboot.service axonwall-vault-provision.service; do
      if [ -f "${VSTAGE}/${vunit}" ]; then
        cp -f "${VSTAGE}/${vunit}" "/mnt/slot_a/etc/systemd/system/${vunit}"
        ln -sf "/etc/systemd/system/${vunit}" "/mnt/slot_a/etc/systemd/system/multi-user.target.wants/${vunit}"
      fi
    done
    ln -sf /lib/systemd/system/nftables.service /mnt/slot_a/etc/systemd/system/multi-user.target.wants/nftables.service
    mkdir -p /mnt/slot_a/usr/lib/sysusers.d /mnt/slot_a/usr/lib/tmpfiles.d /mnt/slot_a/usr/local/bin
    [ -f "${VSTAGE}/axonwall-vault.sysusers" ] && cp -f "${VSTAGE}/axonwall-vault.sysusers" /mnt/slot_a/usr/lib/sysusers.d/axonwall-vault.conf
    [ -f "${VSTAGE}/axonwall-vault.tmpfiles" ] && cp -f "${VSTAGE}/axonwall-vault.tmpfiles" /mnt/slot_a/usr/lib/tmpfiles.d/axonwall-vault.conf
    for vbin in axonwall-vault-provision axonwall-vault-status axonwall-vault-firstboot; do
      if [ -f "${VSTAGE}/${vbin}" ]; then
        cp -f "${VSTAGE}/${vbin}" "/mnt/slot_a/usr/local/bin/${vbin}"
        chmod 0755 "/mnt/slot_a/usr/local/bin/${vbin}"
      fi
    done
    [ -f "${VSTAGE}/nftables.conf" ] && cp -f "${VSTAGE}/nftables.conf" /mnt/slot_a/etc/nftables.conf
    if [ -f "${VSTAGE}/splash-vault.png" ]; then
      mkdir -p /mnt/slot_a/etc/axonwall/branding
      cp -f "${VSTAGE}/splash-vault.png" /mnt/slot_a/etc/axonwall/branding/splash.png
    fi
  fi

  # Strip firewall & router stack so it is completely absent from the Vault image
  for fw_unit in axonwall-firstboot.service axonwalld.service axonwall-controller.service axonwall-ui.service headscale.service; do
    rm -f "/mnt/slot_a/etc/systemd/system/${fw_unit}" "/mnt/slot_a/etc/systemd/system/multi-user.target.wants/${fw_unit}"
  done
  rm -rf /mnt/slot_a/opt/axonwall \
         /mnt/slot_a/usr/sbin/axonwalld \
         /mnt/slot_a/usr/sbin/headscale \
         /mnt/slot_a/usr/sbin/litestream \
         /mnt/slot_a/usr/sbin/axonwall-satellite \
         /mnt/slot_a/usr/share/axonwall/satellites \
         /mnt/slot_a/usr/share/axonwall/lockdown.nft \
         /mnt/slot_a/usr/lib/axonwall/edge \
         /mnt/slot_a/usr/local/bin/axonwall-firstboot \
         /mnt/slot_a/usr/local/bin/axonwallctl \
         /mnt/slot_a/usr/local/bin/axonwall-tui \
         /mnt/slot_a/usr/local/bin/axonwall-ha-notify \
         /mnt/slot_a/usr/local/bin/axonwall-cloud-init \
         /mnt/slot_a/usr/local/bin/axonwall-import \
         /mnt/slot_a/etc/headscale \
         /mnt/slot_a/etc/systemd/system/suricata.service.d

  if [ "$OS_FAMILY" = "debian" ] && [ -x /mnt/slot_a/usr/bin/dpkg ]; then
    echo "[+] Purging firewall packages from Vault target..."
    chroot /mnt/slot_a /usr/bin/dpkg --purge --force-all \
      suricata kea-dhcp4-server kea-common unbound frr strongswan strongswan-charon strongswan-starter \
      openvpn conntrackd keepalived wireguard-tools samba samba-common-bin nfs-kernel-server open-iscsi \
      slapd ldap-utils sssd-ldap sssd-common sssd-tools libnss-sss libpam-sss nodejs \
      qemu-system-x86 qemu-utils ovmf xorriso bridge-utils >/dev/null 2>&1 || true
  fi

  chroot /mnt/slot_a systemd-sysusers >/dev/null 2>&1 || \
    chroot /mnt/slot_a useradd -r -U -d /var/lib/axonwall/vault -s /usr/sbin/nologin axonwall-vault >/dev/null 2>&1 || true

  if [ -z "${HOSTNAME_OVERRIDE:-}" ] || [ "${HOSTNAME_OVERRIDE:-}" = "axonwall" ]; then
    HOSTNAME_OVERRIDE="axonwall-vault"
  fi
else
  touch /mnt/slot_a/etc/axonwall/.firstboot
fi
rm -rf /mnt/slot_a/usr/share/axonwall/vault

# Preserve any live-configured network interfaces if modified during Live session
if [ -s /etc/axonwall/interfaces.conf ]; then
  cp -a /etc/axonwall/interfaces.conf /mnt/slot_a/etc/axonwall/interfaces.conf 2>/dev/null || true
fi

if [ -n "${HOSTNAME_OVERRIDE:-}" ]; then
  echo "$HOSTNAME_OVERRIDE" > /mnt/slot_a/etc/hostname
fi

cp -a /mnt/slot_a/home/. /mnt/data/home/ 2>/dev/null || true

# Enroll TPM 2.0 and write /etc/crypttab if LUKS2 is enabled
DATA_FSTAB_SRC="LABEL=axon_data"
if [ "${LUKS_ENABLED:-0}" = "1" ] && [ -n "$TEMP_LUKS_KEY" ] && [ -f "$TEMP_LUKS_KEY" ]; then
  DATA_UUID="$(blkid -s UUID -o value "$DATA_DEV" 2>/dev/null || echo "$DATA_DEV")"
  TPM2_SUCCESS=0
  if [ "${LUKS_TPM2:-0}" = "1" ] && command -v systemd-cryptenroll >/dev/null 2>&1; then
    echo "[+] Enrolling hardware TPM 2.0 (PCRs 0+2+7) token on ${DATA_DEV}..."
    if systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=0,2,7 --unlock-key-file="$TEMP_LUKS_KEY" "$DATA_DEV" 2>/dev/null; then
      TPM2_SUCCESS=1
      echo "[+] Hardware TPM 2.0 enrollment succeeded."
    else
      echo "[!] Warning: TPM 2.0 enrollment failed; falling back to passphrase unlock at boot."
    fi
  fi
  if [ "$TPM2_SUCCESS" = "1" ]; then
    echo "axon_crypt_data UUID=${DATA_UUID} none luks,discard,tpm2-device=auto" > /mnt/slot_a/etc/crypttab
  elif [ -z "$LUKS_PASSPHRASE" ]; then
    echo "[+] Persisting root-only LUKS keyfile (/etc/axonwall/luks-data.key) since no passphrase was specified and TPM 2.0 is unavailable..."
    mkdir -p /mnt/slot_a/etc/axonwall
    ( umask 077 && cp "$TEMP_LUKS_KEY" /mnt/slot_a/etc/axonwall/luks-data.key )
    chown root:root /mnt/slot_a/etc/axonwall/luks-data.key 2>/dev/null || true
    chmod 0400 /mnt/slot_a/etc/axonwall/luks-data.key
    echo "axon_crypt_data UUID=${DATA_UUID} /etc/axonwall/luks-data.key luks,discard" > /mnt/slot_a/etc/crypttab
  else
    echo "axon_crypt_data UUID=${DATA_UUID} none luks,discard" > /mnt/slot_a/etc/crypttab
  fi
  DATA_FSTAB_SRC="/dev/mapper/axon_crypt_data"
  shred -u "$TEMP_LUKS_KEY" 2>/dev/null || rm -f "$TEMP_LUKS_KEY" 2>/dev/null || true
fi

# Generate /etc/fstab on Slot A
cat << FSTAB_EOF > /mnt/slot_a/etc/fstab
LABEL=${ROOT_A_LABEL}   /                   ${ROOT_FSTYPE}    defaults,noatime        0 1
LABEL=AXON_EFI      /boot/efi           vfat    umask=0077              0 2
${DATA_FSTAB_SRC}   /var/lib/axonwall   ${DATA_FSTYPE}    defaults,noatime        0 2
/var/lib/axonwall/home /home            none    bind,nofail             0 0
tmpfs               /tmp                tmpfs   nosuid,nodev            0 0
FSTAB_EOF

if [ -n "$LOGS_DEV" ]; then
  echo "LABEL=axon_logs     /var/log            ${LOGS_FSTYPE}    defaults,noatime        0 2" >> /mnt/slot_a/etc/fstab
fi

# Persist mdadm configuration if System RAID-1 is active
if [ "$SYSTEM_RAID_MODE" = "mirror" ] && command -v mdadm >/dev/null 2>&1; then
  mkdir -p /mnt/slot_a/etc/mdadm
  mdadm --detail --scan > /mnt/slot_a/etc/mdadm/mdadm.conf 2>/dev/null || true
  cp /mnt/slot_a/etc/mdadm/mdadm.conf /mnt/slot_a/etc/mdadm.conf 2>/dev/null || true
fi

# Seed Cloud-Init configuration into target if present
for ci_src in /var/lib/partman/cloud-config.yaml /var/lib/cloud/seed/nocloud-net/user-data /etc/axonwall/cloud-config.yaml; do
  if [ -s "$ci_src" ]; then
    echo "[+] Copying Cloud-Init configuration into installed target..."
    mkdir -p /mnt/slot_a/var/lib/cloud/seed/nocloud-net /mnt/slot_a/etc/axonwall
    cp "$ci_src" /mnt/slot_a/var/lib/cloud/seed/nocloud-net/user-data
    cp "$ci_src" /mnt/slot_a/etc/axonwall/cloud-config.yaml
    chmod 0600 /mnt/slot_a/etc/axonwall/cloud-config.yaml /mnt/slot_a/var/lib/cloud/seed/nocloud-net/user-data 2>/dev/null || true
    echo "instance-id: $(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo "axonwall-01")" > /mnt/slot_a/var/lib/cloud/seed/nocloud-net/meta-data
    break
  fi
done

# Configure Debian APT sources on installed target
if [ "$OS_FAMILY" = "debian" ] && [ -d /mnt/slot_a/etc/apt ]; then
  cat > /mnt/slot_a/etc/apt/sources.list << 'APT_EOF'
deb https://deb.debian.org/debian trixie main contrib non-free non-free-firmware
deb https://deb.debian.org/debian-security trixie-security main contrib non-free non-free-firmware
deb https://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware
APT_EOF
fi

# Configure Admin & Root Credentials
CUSTOM_PW_SET=1
if [ -z "$ADMIN_PASSWORD" ]; then
  ADMIN_PASSWORD="axonwall"
  CUSTOM_PW_SET=0
fi

if [ -n "$ADMIN_PASSWORD" ]; then
  PW_TMP="/mnt/slot_a/tmp/.axonwall_pw_install.tmp"
  printf '%s' "$ADMIN_PASSWORD" > "$PW_TMP"
  chmod 0600 "$PW_TMP"
  SCRYPT_HASH=""
  case "$ADMIN_PASSWORD" in
    scrypt\$*)
      SCRYPT_HASH="$ADMIN_PASSWORD"
      ;;
    *)
      if command -v node >/dev/null 2>&1; then
        SCRYPT_HASH="$(node -e '
          const crypto = require("crypto");
          const fs = require("fs");
          try {
            const pw = fs.readFileSync(process.argv[1], "utf-8");
            const salt = crypto.randomBytes(16).toString("hex");
            const hash = crypto.scryptSync(pw, salt, 64, { N: 16384, r: 8, p: 1 }).toString("hex");
            console.log("scrypt$" + salt + "$" + hash);
          } catch (e) { process.exit(1); }
        ' "$PW_TMP" 2>/dev/null || true)"
      fi
      ;;
  esac
  rm -f "$PW_TMP"

  if [ -n "$SCRYPT_HASH" ]; then
    printf 'LOCAL_ADMIN_USER=%s\nLOCAL_ADMIN_PASSWORD=%s\n' "${ADMIN_USER:-admin}" "$SCRYPT_HASH" > /mnt/slot_a/etc/axonwall/admin.env
    chmod 0600 /mnt/slot_a/etc/axonwall/admin.env
    cp -a /mnt/slot_a/etc/axonwall/admin.env /mnt/data/etc-axonwall/admin.env 2>/dev/null || true
    chmod 0600 /mnt/data/etc-axonwall/admin.env 2>/dev/null || true
    if [ "$CUSTOM_PW_SET" -eq 1 ]; then
      rm -f /mnt/slot_a/etc/axonwall/initial-admin-password /mnt/data/etc-axonwall/initial-admin-password
      NOW_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "installed")"
      printf '%s\n' "$NOW_TS" > /mnt/slot_a/etc/axonwall/.password_changed
      printf '%s\n' "$NOW_TS" > /mnt/data/.password_changed
      echo "[+] Provisioned custom scrypt administrator credentials for '${ADMIN_USER:-admin}'."
    else
      rm -f /mnt/slot_a/etc/axonwall/.password_changed /mnt/data/.password_changed
      printf '%s\n' "$ADMIN_PASSWORD" > /mnt/slot_a/etc/axonwall/initial-admin-password
      chmod 0600 /mnt/slot_a/etc/axonwall/initial-admin-password
      printf '%s\n' "$ADMIN_PASSWORD" > /mnt/data/etc-axonwall/initial-admin-password 2>/dev/null || true
      chmod 0600 /mnt/data/etc-axonwall/initial-admin-password 2>/dev/null || true
      echo "[+] Provisioned default factory credentials (${ADMIN_USER:-admin} / axonwall — password change required on first web login)."
    fi
  fi

  case "$ADMIN_PASSWORD" in
    scrypt\$*) ;;
    *)
      printf 'root:%s\n' "$ADMIN_PASSWORD" | chroot /mnt/slot_a /usr/sbin/chpasswd 2>/dev/null || true
      if grep -q '^axonwall:' /mnt/slot_a/etc/passwd 2>/dev/null; then
        printf 'axonwall:%s\n' "$ADMIN_PASSWORD" | chroot /mnt/slot_a /usr/sbin/chpasswd 2>/dev/null || true
      fi
      ;;
  esac
  ADMIN_PASSWORD=""
fi

# Ensure stable kernel & initrd symlinks in /mnt/slot_a/boot
KERNEL_FLAVOR="virt"
if [ "$OS_FAMILY" = "alpine" ]; then
  if [ -f /mnt/slot_a/boot/vmlinuz-lts ]; then
    KERNEL_FLAVOR="lts"
  elif [ -f /mnt/slot_a/boot/vmlinuz-virt ]; then
    KERNEL_FLAVOR="virt"
  fi
  ln -sf "vmlinuz-${KERNEL_FLAVOR}" /mnt/slot_a/boot/vmlinuz
  ln -sf "initramfs-${KERNEL_FLAVOR}" /mnt/slot_a/boot/initrd.img
  ln -sf boot/vmlinuz /mnt/slot_a/vmlinuz 2>/dev/null || true
  ln -sf boot/initrd.img /mnt/slot_a/initrd.img 2>/dev/null || true
else
  LATEST_KERN=$(ls -1t /mnt/slot_a/boot/vmlinuz-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_KERN" ]; then
    ln -sf "$(basename "$LATEST_KERN")" /mnt/slot_a/boot/vmlinuz
    ln -sf "boot/$(basename "$LATEST_KERN")" /mnt/slot_a/vmlinuz 2>/dev/null || true
  fi
  LATEST_INITRD=$(ls -1t /mnt/slot_a/boot/initrd.img-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_INITRD" ]; then
    ln -sf "$(basename "$LATEST_INITRD")" /mnt/slot_a/boot/initrd.img
    ln -sf "boot/$(basename "$LATEST_INITRD")" /mnt/slot_a/initrd.img 2>/dev/null || true
  fi
fi

# ==============================================================================
# PHASE 5: Replicate Slot A to Standby Slot B (A/B Mode)
# ==============================================================================
emit_phase 5 8 "Synchronizing Standby Slot B & recording slot metadata..."

INSTALL_VER="0.11.32"
if [ -f /mnt/slot_a/etc/axonwall/version ]; then
  INSTALL_VER="$(head -n1 /mnt/slot_a/etc/axonwall/version | tr -d '\r\n ')"
fi

if [ "$INSTALL_MODE" = "ab" ] && [ -n "$ROOT_B_DEV" ]; then
  echo "[+] Cloning Slot A into Standby Slot B (${ROOT_B_DEV})..."
  mount "$ROOT_B_DEV" /mnt/slot_b
  if command -v rsync >/dev/null 2>&1; then
    rsync -aAX --delete \
      --exclude='/boot/efi/*' \
      --exclude='/var/lib/axonwall/*' \
      --exclude='/proc/*' \
      --exclude='/sys/*' \
      --exclude='/dev/*' \
      --exclude='/run/*' \
      --exclude='/tmp/*' \
      --exclude='/mnt/*' \
      /mnt/slot_a/ /mnt/slot_b/
  else
    cp -a /mnt/slot_a/. /mnt/slot_b/ 2>/dev/null || true
  fi
  sed -i 's/LABEL=axon_root_a/LABEL=axon_root_b/' /mnt/slot_b/etc/fstab

  INIT_SLOT_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s (Factory Standby)",\n  "updatedAt": "%s"\n}\n' "$INSTALL_VER" "$INSTALL_VER" "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")")"
  printf '%s' "$INIT_SLOT_JSON" > /mnt/slot_a/etc/axonwall/slot_versions.json
  printf '%s' "$INIT_SLOT_JSON" > /mnt/slot_b/etc/axonwall/slot_versions.json
  printf '%s' "$INIT_SLOT_JSON" > /mnt/data/slot_versions.json
  umount /mnt/slot_b
else
  SLOT_B_DESC="Rolling (Single-Root)"
  if [ "$INSTALL_MODE" = "zbm" ]; then
    SLOT_B_DESC="axonwall-${INSTALL_VER}@factory-initial"
  fi
  INIT_SLOT_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s",\n  "updatedAt": "%s"\n}\n' "$INSTALL_VER" "$SLOT_B_DESC" "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")")"
  printf '%s' "$INIT_SLOT_JSON" > /mnt/slot_a/etc/axonwall/slot_versions.json
  printf '%s' "$INIT_SLOT_JSON" > /mnt/data/slot_versions.json
fi

# ==============================================================================
# PHASE 6: Install BIOS & UEFI Bootloaders (GRUB2 / ZFSBootMenu)
# ==============================================================================
emit_phase 6 8 "Installing BIOS & UEFI bootloaders onto system disk(s)..."

mkdir -p /mnt/slot_a/boot/grub
for sys_disk in $SYSTEM_DISKS; do
  grub-install --target=i386-pc --boot-directory=/mnt/slot_a/boot "$sys_disk" 2>/dev/null || true
done
grub-install --target=x86_64-efi --efi-directory=/mnt/slot_a/boot/efi --boot-directory=/mnt/slot_a/boot --removable --no-nvram 2>/dev/null || true

# Copy branded Axonwall splash image into installed /boot/grub/ if present
if [ -f /mnt/slot_a/etc/axonwall/branding/splash.png ]; then
  cp /mnt/slot_a/etc/axonwall/branding/splash.png /mnt/slot_a/boot/grub/splash.png 2>/dev/null || true
elif [ -f /etc/axonwall/branding/splash.png ]; then
  cp /etc/axonwall/branding/splash.png /mnt/slot_a/boot/grub/splash.png 2>/dev/null || true
fi

if [ "$INSTALL_MODE" = "zbm" ]; then
  mkdir -p /mnt/slot_a/boot/efi/EFI/ZBM
  if [ -f /mnt/slot_a/usr/lib/zfsbootmenu/vmlinuz.efi ]; then
    cp -f /mnt/slot_a/usr/lib/zfsbootmenu/vmlinuz.efi /mnt/slot_a/boot/efi/EFI/ZBM/VMLINUZ.EFI 2>/dev/null || true
  fi
fi

# Clone EFI System Partition to secondary RAID-1 disks
for sys_disk in $SYSTEM_DISKS; do
  if [ "$sys_disk" != "$PRIMARY_DISK" ]; then
    SEC_EFI=$(part_dev "$sys_disk" 2)
    dd if="$PRIMARY_EFI" of="$SEC_EFI" bs=1M conv=fsync 2>/dev/null || true
  fi
done

grub-editenv /mnt/slot_a/boot/grub/grubenv create 2>/dev/null || true
grub-editenv /mnt/slot_a/boot/grub/grubenv set active_slot=A bootcount=0 bootlimit=3 2>/dev/null || true

if [ "$OS_FAMILY" = "alpine" ]; then
  EXTRA_KARGS="modules=sd-mod,usb-storage,ext4,xfs,virtio_blk,nvme,raid1,md-mod"
else
  EXTRA_KARGS=""
fi

cat << GRUB_EOF > /mnt/slot_a/boot/grub/grub.cfg
set default=0
set timeout=3

if [ -s \$prefix/grubenv ]; then
  load_env
fi

if [ -z "\${active_slot}" ]; then
  set active_slot="A"
fi
if [ -z "\${bootcount}" ]; then
  set bootcount=0
fi
if [ -z "\${bootlimit}" ]; then
  set bootlimit=3
fi

if [ "\${bootcount}" -ge "\${bootlimit}" ]; then
  if [ "\${active_slot}" = "A" ]; then
    set active_slot="B"
  else
    set active_slot="A"
  fi
  set bootcount=0
  save_env active_slot bootcount
fi

if [ "\${bootcount}" = "0" ]; then
  set bootcount=1
elif [ "\${bootcount}" = "1" ]; then
  set bootcount=2
else
  set bootcount=3
fi
save_env bootcount

if [ "${INSTALL_MODE}" = "ab" ]; then
  if [ "\${active_slot}" = "B" ]; then
    set default="Axonwall OS (Slot B - Standby)"
  else
    set default="Axonwall OS (Slot A - Primary)"
  fi

  menuentry "Axonwall OS (Slot A - Primary)" {
    search --no-floppy --label --set=root axon_root_a
    linux /boot/vmlinuz root=LABEL=axon_root_a ro rootfstype=${ROOT_FSTYPE} slot=A ${EXTRA_KARGS} quiet console=tty0 console=ttyS0,115200
    initrd /boot/initrd.img
  }

  menuentry "Axonwall OS (Slot B - Standby)" {
    search --no-floppy --label --set=root axon_root_b
    linux /boot/vmlinuz root=LABEL=axon_root_b ro rootfstype=${ROOT_FSTYPE} slot=B ${EXTRA_KARGS} quiet console=tty0 console=ttyS0,115200
    initrd /boot/initrd.img
  }
else
  menuentry "${EDITION_LABEL} (${INSTALL_MODE})" {
    search --no-floppy --label --set=root ${ROOT_A_LABEL}
    linux /boot/vmlinuz root=LABEL=${ROOT_A_LABEL} ro rootfstype=${ROOT_FSTYPE} ${EXTRA_KARGS} quiet console=tty0 console=ttyS0,115200
    initrd /boot/initrd.img
  }
fi
GRUB_EOF

# On Debian, if update-initramfs is needed for mdadm RAID-1 or LUKS2, refresh initramfs inside chroot
if [ "$OS_FAMILY" = "debian" ] && { [ "$SYSTEM_RAID_MODE" = "mirror" ] || [ "${LUKS_ENABLED:-0}" = "1" ]; }; then
  for m in dev proc sys run; do
    mount --bind "/$m" "/mnt/slot_a/$m" 2>/dev/null || true
  done
  chroot /mnt/slot_a update-initramfs -u -k all 2>/dev/null || true
  for m in run sys proc dev; do
    umount "/mnt/slot_a/$m" 2>/dev/null || true
  done
fi

# ==============================================================================
# PHASE 7: Bootstrap OpenZFS Storage Pool (tank / zroot) + SLOG / L2ARC / Spares
# ==============================================================================
emit_phase 7 8 "Configuring OpenZFS storage pool topology & accelerators..."

SYS_ZFS_VDEVS=$(echo "$ZFS_VDEVS" | tr -s ' ' | sed 's/^ //;s/ $//')
EXTRA_DATA_VDEVS=""
for xd in $ZFS_EXTRA_DISKS; do
  if [ -b "$xd" ]; then
    wipefs -a "$xd" 2>/dev/null || true
    EXTRA_DATA_VDEVS="${EXTRA_DATA_VDEVS} ${xd}"
  fi
done
EXTRA_DATA_VDEVS=$(echo "$EXTRA_DATA_VDEVS" | tr -s ' ' | sed 's/^ //;s/ $//')

SLOG_VDEVS=""
for sd in ${ZFS_SLOG_DISKS:-}; do
  if [ -b "$sd" ]; then
    wipefs -a "$sd" 2>/dev/null || true
    SLOG_VDEVS="${SLOG_VDEVS} ${sd}"
  fi
done
SLOG_VDEVS=$(echo "$SLOG_VDEVS" | tr -s ' ' | sed 's/^ //;s/ $//')

L2ARC_VDEVS=""
for cd in ${ZFS_L2ARC_DISKS:-}; do
  if [ -b "$cd" ]; then
    wipefs -a "$cd" 2>/dev/null || true
    L2ARC_VDEVS="${L2ARC_VDEVS} ${cd}"
  fi
done
L2ARC_VDEVS=$(echo "$L2ARC_VDEVS" | tr -s ' ' | sed 's/^ //;s/ $//')

SPARE_VDEVS=""
for hd in ${ZFS_SPARE_DISKS:-}; do
  if [ -b "$hd" ]; then
    wipefs -a "$hd" 2>/dev/null || true
    SPARE_VDEVS="${SPARE_VDEVS} ${hd}"
  fi
done
SPARE_VDEVS=$(echo "$SPARE_VDEVS" | tr -s ' ' | sed 's/^ //;s/ $//')

# Build zpool tail arguments for SLOG (log / log mirror), L2ARC (cache), and Hot Spares (spare)
ZPOOL_ACCEL_ARGS=""
if [ -n "$SLOG_VDEVS" ]; then
  SLOG_COUNT=$(echo "$SLOG_VDEVS" | wc -w | tr -d ' ')
  if [ "$SLOG_COUNT" -ge 2 ]; then
    ZPOOL_ACCEL_ARGS="${ZPOOL_ACCEL_ARGS} log mirror ${SLOG_VDEVS}"
  else
    ZPOOL_ACCEL_ARGS="${ZPOOL_ACCEL_ARGS} log ${SLOG_VDEVS}"
  fi
fi
if [ -n "$L2ARC_VDEVS" ]; then
  ZPOOL_ACCEL_ARGS="${ZPOOL_ACCEL_ARGS} cache ${L2ARC_VDEVS}"
fi
if [ -n "$SPARE_VDEVS" ]; then
  ZPOOL_ACCEL_ARGS="${ZPOOL_ACCEL_ARGS} spare ${SPARE_VDEVS}"
fi

to_json_array() {
  _out=""
  for _item in $1; do
    if [ -z "$_out" ]; then
      _out="\"${_item}\""
    else
      _out="${_out}, \"${_item}\""
    fi
  done
  echo "$_out"
}

resolve_zfs_topology() {
  _req="$1"
  _cnt="$2"
  if [ "$_req" = "auto" ] || [ -z "$_req" ]; then
    if [ "$_cnt" -le 1 ]; then
      echo "stripe"
    elif [ "$_cnt" -eq 2 ]; then
      echo "mirror"
    elif [ "$_cnt" -le 4 ]; then
      echo "raidz1"
    else
      echo "raidz2"
    fi
  else
    echo "$_req"
  fi
}

init_zroot_datasets() {
  _zroot_topo="${1:-stripe}"
  _has_separate_tank="${2:-0}"
  _app_ver="$(head -n1 /mnt/slot_a/etc/axonwall/version 2>/dev/null | tr -d '\r\n ' || true)"
  [ -z "$_app_ver" ] && _app_ver="0.11.41"
  _init_be="zroot/ROOT/axonwall-${_app_ver}"
  zfs create -o canmount=off -o mountpoint=none zroot/ROOT 2>/dev/null || true
  zfs create -o canmount=noauto -o mountpoint=/ "$_init_be" 2>/dev/null || true
  if [ "$_has_separate_tank" = "0" ]; then
    zfs create -o mountpoint=/mnt/tank zroot/tank 2>/dev/null || true
  fi
  zpool set "bootfs=${_init_be}" zroot 2>/dev/null || true
  zfs set "org.axonwall:active_be=${_init_be}" zroot/ROOT 2>/dev/null || true
  zfs set "org.axonwall:fallback_be=${_init_be}" zroot/ROOT 2>/dev/null || true
  zfs set "org.axonwall:bootcount=0" zroot/ROOT 2>/dev/null || true
  zfs set "org.axonwall:bootlimit=3" zroot/ROOT 2>/dev/null || true
  zfs set "org.axonwall:topology=${_zroot_topo}" zroot/ROOT 2>/dev/null || true
  zfs snapshot "${_init_be}@factory-initial" 2>/dev/null || true
}

if [ "$INSTALL_MODE" = "zbm" ] && [ -n "$EXTRA_DATA_VDEVS" ]; then
  # Dual-Pool ZBM Architecture: 'zroot' on System Disks + Dedicated 'tank' on Extra Data Disks
  ZROOT_CNT=$(echo "$SYS_ZFS_VDEVS" | wc -w | tr -d ' ')
  ZROOT_TOPO="stripe"
  [ "$ZROOT_CNT" -ge 2 ] && ZROOT_TOPO="mirror"

  TANK_CNT=$(echo "$EXTRA_DATA_VDEVS" | wc -w | tr -d ' ')
  RESOLVED_TOPOLOGY=$(resolve_zfs_topology "${ZFS_RAID_TOPOLOGY:-auto}" "$TANK_CNT")

  JSON_VDEVS=$(to_json_array "$EXTRA_DATA_VDEVS")
  JSON_ZROOT_VDEVS=$(to_json_array "$SYS_ZFS_VDEVS")
  JSON_SLOG=$(to_json_array "$SLOG_VDEVS")
  JSON_L2ARC=$(to_json_array "$L2ARC_VDEVS")
  JSON_SPARE=$(to_json_array "$SPARE_VDEVS")

  ZFS_GB=$(( ZFS_MB / 1024 ))
  cat << ZFS_JSON_EOF > /mnt/data/install-zfs.json
{
  "poolName": "tank",
  "zrootPoolName": "zroot",
  "installMode": "${INSTALL_MODE}",
  "topology": "${RESOLVED_TOPOLOGY}",
  "zrootTopology": "${ZROOT_TOPO}",
  "vdevs": [${JSON_VDEVS}],
  "zrootVdevs": [${JSON_ZROOT_VDEVS}],
  "slogVdevs": [${JSON_SLOG}],
  "l2arcVdevs": [${JSON_L2ARC}],
  "spareVdevs": [${JSON_SPARE}],
  "sizeGb": ${ZFS_GB},
  "systemRaidMode": "${SYSTEM_RAID_MODE}",
  "systemRaidDisks": "${SYSTEM_DISKS}",
  "autoCreatePool": true
}
ZFS_JSON_EOF

  if command -v zpool >/dev/null 2>&1; then
    modprobe zfs 2>/dev/null || true
    if [ -n "$SYS_ZFS_VDEVS" ]; then
      echo "[+] Creating OpenZFS System Root Pool 'zroot' (topology=${ZROOT_TOPO}, vdevs=${SYS_ZFS_VDEVS})..."
      ZROOT_ARGS=""
      [ "$ZROOT_TOPO" != "stripe" ] && ZROOT_ARGS="$ZROOT_TOPO"
      # shellcheck disable=SC2086
      if zpool create -f -o ashift=12 -o autotrim=on -O compression=lz4 -O acltype=posixacl -O xattr=sa -O normalization=formD -O canmount=off -O mountpoint=none zroot $ZROOT_ARGS $SYS_ZFS_VDEVS 2>/dev/null; then
        init_zroot_datasets "$ZROOT_TOPO" 1
      fi
    fi
    echo "[+] Creating Dedicated OpenZFS Storage Pool 'tank' (topology=${RESOLVED_TOPOLOGY}, vdevs=${EXTRA_DATA_VDEVS}, accel=${ZPOOL_ACCEL_ARGS})..."
    TANK_ARGS=""
    [ "$RESOLVED_TOPOLOGY" != "stripe" ] && TANK_ARGS="$RESOLVED_TOPOLOGY"
    # shellcheck disable=SC2086
    zpool create -f -o ashift=12 -o autotrim=on -O compression=lz4 -O acltype=posixacl -O xattr=sa -O normalization=formD -O mountpoint=/mnt/tank tank $TANK_ARGS $EXTRA_DATA_VDEVS $ZPOOL_ACCEL_ARGS 2>/dev/null || true
  fi
else
  ZFS_VDEVS=$(echo "${SYS_ZFS_VDEVS} ${EXTRA_DATA_VDEVS}" | tr -s ' ' | sed 's/^ //;s/ $//')
  if [ -n "$ZFS_VDEVS" ]; then
    VDEV_COUNT=$(echo "$ZFS_VDEVS" | wc -w | tr -d ' ')
    RESOLVED_TOPOLOGY=$(resolve_zfs_topology "${ZFS_RAID_TOPOLOGY:-auto}" "$VDEV_COUNT")

    JSON_VDEVS=$(to_json_array "$ZFS_VDEVS")
    JSON_SLOG=$(to_json_array "$SLOG_VDEVS")
    JSON_L2ARC=$(to_json_array "$L2ARC_VDEVS")
    JSON_SPARE=$(to_json_array "$SPARE_VDEVS")

    TARGET_POOL_NAME="tank"
    if [ "$INSTALL_MODE" = "zbm" ]; then
      TARGET_POOL_NAME="zroot"
    fi

    ZFS_GB=$(( ZFS_MB / 1024 ))
    cat << ZFS_JSON_EOF > /mnt/data/install-zfs.json
{
  "poolName": "${TARGET_POOL_NAME}",
  "installMode": "${INSTALL_MODE}",
  "topology": "${RESOLVED_TOPOLOGY}",
  "vdevs": [${JSON_VDEVS}],
  "slogVdevs": [${JSON_SLOG}],
  "l2arcVdevs": [${JSON_L2ARC}],
  "spareVdevs": [${JSON_SPARE}],
  "sizeGb": ${ZFS_GB},
  "systemRaidMode": "${SYSTEM_RAID_MODE}",
  "systemRaidDisks": "${SYSTEM_DISKS}",
  "autoCreatePool": true
}
ZFS_JSON_EOF

    if command -v zpool >/dev/null 2>&1; then
      modprobe zfs 2>/dev/null || true
      echo "[+] Creating OpenZFS pool '${TARGET_POOL_NAME}' (topology=${RESOLVED_TOPOLOGY}, vdevs=${ZFS_VDEVS}, accel=${ZPOOL_ACCEL_ARGS})..."
      ZPOOL_ARGS=""
      if [ "$RESOLVED_TOPOLOGY" != "stripe" ]; then
        ZPOOL_ARGS="$RESOLVED_TOPOLOGY"
      fi
      if [ "$TARGET_POOL_NAME" = "zroot" ]; then
        # shellcheck disable=SC2086
        if zpool create -f -o ashift=12 -o autotrim=on -O compression=lz4 -O acltype=posixacl -O xattr=sa -O normalization=formD -O canmount=off -O mountpoint=none zroot $ZPOOL_ARGS $ZFS_VDEVS $ZPOOL_ACCEL_ARGS 2>/dev/null; then
          init_zroot_datasets "$RESOLVED_TOPOLOGY" 0
        fi
      else
        # shellcheck disable=SC2086
        zpool create -f -o ashift=12 -o autotrim=on -O compression=lz4 -O acltype=posixacl -O xattr=sa -O normalization=formD -O mountpoint=/mnt/tank "${TARGET_POOL_NAME}" $ZPOOL_ARGS $ZFS_VDEVS $ZPOOL_ACCEL_ARGS 2>/dev/null || true
      fi
    fi
  fi
fi

# ==============================================================================
# PHASE 8: Finalize, Unmount & Sync
# ==============================================================================
emit_phase 8 8 "Finalizing installation & flushing storage caches..."

cleanup_secrets
if command -v zpool >/dev/null 2>&1; then
  zpool export -a 2>/dev/null || true
fi
umount /mnt/slot_a/boot/efi 2>/dev/null || true
umount /mnt/slot_a 2>/dev/null || true
umount /mnt/data 2>/dev/null || true
if [ "${LUKS_ENABLED:-0}" = "1" ] && [ -b /dev/mapper/axon_crypt_data ]; then
  cryptsetup close axon_crypt_data 2>/dev/null || true
fi
sync

echo "================================================================================"
echo "[✓] ${EDITION_LABEL} Installation Complete (${INSTALL_MODE}, ${SYSTEM_RAID_MODE}: ${SYSTEM_DISKS})!"
echo "    Remove installation media and reboot the appliance."
echo "================================================================================"

if [ "${REBOOT_AFTER_INSTALL:-0}" = "1" ]; then
  echo "[+] Rebooting appliance in 3 seconds..."
  sleep 3
  systemctl reboot 2>/dev/null || /sbin/reboot 2>/dev/null || reboot 2>/dev/null || true
fi
