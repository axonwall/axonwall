#!/bin/sh
# ==============================================================================
# Axonwall Alpine Linux Disk Installer (A/B Dual-Root & Compact Sys-Mode)
# ==============================================================================
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "[!] axonwall-install must be run as root."
  exit 1
fi

echo "================================================================================"
echo "  Axonwall Appliance Installer (Alpine Linux Edition)"
echo "================================================================================"
echo ""
echo "Available block devices:"
lsblk -d -n -o NAME,SIZE,MODEL,TYPE 2>/dev/null | grep "disk" || fdisk -l 2>/dev/null | grep "^Disk /dev/"
echo ""

TARGET_DISK="${1:-}"
if [ -z "$TARGET_DISK" ]; then
  printf "Enter target disk to install Axonwall (e.g. /dev/vda, /dev/sda, /dev/nvme0n1): "
  read -r TARGET_DISK
fi

if [ ! -b "$TARGET_DISK" ]; then
  echo "[!] Error: Block device '$TARGET_DISK' does not exist."
  exit 1
fi

printf "Select Slot Size for A/B Dual-Root [1=2GB Compact, 2=4GB Standard, 3=8GB Expanded] (default 1): "
read -r SLOT_CHOICE
case "${SLOT_CHOICE:-1}" in
  2) SLOT_MB=4096 ;;
  3) SLOT_MB=8192 ;;
  *) SLOT_MB=2048 ;;
esac

printf "WARNING: All data on %s will be erased! Proceed? (y/N): " "$TARGET_DISK"
read -r CONFIRM
if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
  echo "Aborted."
  exit 0
fi

# Determine partition naming prefix (nvme0n1p1 vs sda1)
case "$TARGET_DISK" in
  *nvme*|*mmcblk*|*loop*) PART_PREFIX="${TARGET_DISK}p" ;;
  *) PART_PREFIX="${TARGET_DISK}" ;;
esac

echo "[+] Partitioning $TARGET_DISK (BIOS Boot + EFI + Slot A [${SLOT_MB}MB] + Slot B [${SLOT_MB}MB] + Data)..."
dd if=/dev/zero of="$TARGET_DISK" bs=1M count=16 conv=notrunc 2>/dev/null || true

END_EFI=260
END_A=$((END_EFI + SLOT_MB))
END_B=$((END_A + SLOT_MB))

parted -s "$TARGET_DISK" \
  mklabel gpt \
  mkpart bios_grub 1MiB 4MiB \
  set 1 bios_grub on \
  mkpart ESP fat32 4MiB ${END_EFI}MiB \
  set 2 esp on \
  mkpart axon_root_a ext4 ${END_EFI}MiB ${END_A}MiB \
  mkpart axon_root_b ext4 ${END_A}MiB ${END_B}MiB \
  mkpart axon_data ext4 ${END_B}MiB 100%

mdev -s 2>/dev/null || true
sleep 1

mkfs.vfat -F 32 -n AXON_EFI "${PART_PREFIX}2"
mkfs.ext4 -F -L axon_root_a "${PART_PREFIX}3"
mkfs.ext4 -F -L axon_root_b "${PART_PREFIX}4"
mkfs.ext4 -F -L axon_data "${PART_PREFIX}5"

mkdir -p /mnt/slot_a /mnt/slot_b /mnt/data
mount "${PART_PREFIX}3" /mnt/slot_a
mkdir -p /mnt/slot_a/boot/efi /mnt/slot_a/var/lib/axonwall
mount "${PART_PREFIX}2" /mnt/slot_a/boot/efi
mount "${PART_PREFIX}5" /mnt/data

echo "[+] Installing Alpine rootfs & Axonwall stack to Slot A..."
for dir in bin etc home lib opt root sbin usr var; do
  if [ -d "/$dir" ]; then
    cp -a "/$dir" /mnt/slot_a/ 2>/dev/null || true
  fi
done
mkdir -p /mnt/slot_a/dev /mnt/slot_a/proc /mnt/slot_a/sys /mnt/slot_a/run /mnt/slot_a/tmp /mnt/slot_a/boot

for boot_src in /media/cdrom/boot /media/usb/boot /media/*/boot /boot; do
  if [ -d "$boot_src" ] && ls "$boot_src"/vmlinuz-* >/dev/null 2>&1; then
    cp -a "$boot_src"/* /mnt/slot_a/boot/ 2>/dev/null || true
    break
  fi
done

KERNEL_FLAVOR="virt"
if [ -f /mnt/slot_a/boot/vmlinuz-lts ]; then
  KERNEL_FLAVOR="lts"
elif [ -f /mnt/slot_a/boot/vmlinuz-virt ]; then
  KERNEL_FLAVOR="virt"
fi

cat << 'FSTAB_EOF' > /mnt/slot_a/etc/fstab
LABEL=axon_root_a   /                   ext4    defaults,noatime        0 1
LABEL=AXON_EFI      /boot/efi           vfat    umask=0077              0 2
LABEL=axon_data     /var/lib/axonwall   ext4    defaults,noatime        0 2
tmpfs               /tmp                tmpfs   nosuid,nodev            0 0
FSTAB_EOF

echo "[+] Installing GRUB bootloader (BIOS + UEFI)..."
grub-install --target=i386-pc --boot-directory=/mnt/slot_a/boot "$TARGET_DISK" 2>/dev/null || true
grub-install --target=x86_64-efi --efi-directory=/mnt/slot_a/boot/efi --boot-directory=/mnt/slot_a/boot --removable --no-nvram 2>/dev/null || true

cat << GRUB_EOF > /mnt/slot_a/boot/grub/grub.cfg
set default=0
set timeout=3

if [ -s \$prefix/grubenv ]; then
  load_env
fi

if [ -z "\${active_slot}" ]; then
  set active_slot="A"
fi
if [ -z "\${bootcount}" ]; then
  set bootcount=0
fi
if [ -z "\${bootlimit}" ]; then
  set bootlimit=3
fi

if [ "\${bootcount}" -ge "\${bootlimit}" ]; then
  if [ "\${active_slot}" = "A" ]; then
    set active_slot="B"
  else
    set active_slot="A"
  fi
  set bootcount=0
  save_env active_slot bootcount
fi

if [ "\${bootcount}" = "0" ]; then
  set bootcount=1
elif [ "\${bootcount}" = "1" ]; then
  set bootcount=2
else
  set bootcount=3
fi
save_env bootcount

if [ "\${active_slot}" = "B" ]; then
  set default="Axonwall Appliance - Slot B"
else
  set default="Axonwall Appliance - Slot A"
fi

menuentry "Axonwall Appliance - Slot A" {
  search --no-floppy --label --set=root axon_root_a
  linux /boot/vmlinuz-${KERNEL_FLAVOR} root=LABEL=axon_root_a ro rootfstype=ext4 modules=sd-mod,usb-storage,ext4,virtio_blk,nvme quiet console=tty0 console=ttyS0,115200
  initrd /boot/initramfs-${KERNEL_FLAVOR}
}

menuentry "Axonwall Appliance - Slot B" {
  search --no-floppy --label --set=root axon_root_b
  linux /boot/vmlinuz-${KERNEL_FLAVOR} root=LABEL=axon_root_b ro rootfstype=ext4 modules=sd-mod,usb-storage,ext4,virtio_blk,nvme quiet console=tty0 console=ttyS0,115200
  initrd /boot/initramfs-${KERNEL_FLAVOR}
}
GRUB_EOF

grub-editenv /mnt/slot_a/boot/grub/grubenv create 2>/dev/null || true
grub-editenv /mnt/slot_a/boot/grub/grubenv set active_slot=A bootcount=0 bootlimit=3 2>/dev/null || true

echo "[+] Cloning Slot A into Standby Slot B..."
mount "${PART_PREFIX}4" /mnt/slot_b
cp -a /mnt/slot_a/* /mnt/slot_b/ 2>/dev/null || true
sed -i 's/LABEL=axon_root_a/LABEL=axon_root_b/' /mnt/slot_b/etc/fstab
umount /mnt/slot_b

umount /mnt/slot_a/boot/efi /mnt/slot_a /mnt/data 2>/dev/null || true
sync

echo "================================================================================"
echo "[✓] Axonwall Alpine Dual-Root Installation Complete on $TARGET_DISK!"
echo "    Remove installation media and run 'reboot'."
echo "================================================================================"
