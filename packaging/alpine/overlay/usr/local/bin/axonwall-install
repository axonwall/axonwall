#!/bin/sh
# ==============================================================================
# Axonwall Alpine Linux Disk Installer (A/B Dual-Root, System RAID-1 & ZFS RAID)
# ==============================================================================
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "[!] axonwall-install must be run as root."
  exit 1
fi

part_dev() {
  disk_dev="$1"
  p_num="$2"
  case "$disk_dev" in
    *nvme*|*mmcblk*|*loop*) echo "${disk_dev}p${p_num}" ;;
    *) echo "${disk_dev}${p_num}" ;;
  esac
}

echo "================================================================================"
echo "  Axonwall Appliance Installer (Alpine Linux Edition — A/B + RAID + OpenZFS)"
echo "================================================================================"
echo ""
echo "Available block devices:"
lsblk -d -n -o NAME,SIZE,MODEL,TYPE 2>/dev/null | grep "disk" || fdisk -l 2>/dev/null | grep "^Disk /dev/"
echo ""

SYSTEM_DISKS="${1:-}"
if [ -z "$SYSTEM_DISKS" ]; then
  printf "Enter system disk(s) to install Axonwall (space-separated for RAID-1 Mirror, e.g. '/dev/vda' or '/dev/nvme0n1 /dev/nvme1n1'): "
  read -r SYSTEM_DISKS
fi

SYSTEM_DISKS=$(echo "$SYSTEM_DISKS" | tr ',' ' ' | tr -s ' ')
SYS_DISK_COUNT=0
PRIMARY_DISK=""
for d in $SYSTEM_DISKS; do
  if [ ! -b "$d" ]; then
    echo "[!] Error: Block device '$d' does not exist."
    exit 1
  fi
  if [ -z "$PRIMARY_DISK" ]; then
    PRIMARY_DISK="$d"
  fi
  SYS_DISK_COUNT=$(( SYS_DISK_COUNT + 1 ))
done

if [ -z "$PRIMARY_DISK" ]; then
  echo "[!] Error: No target disk specified."
  exit 1
fi

SYSTEM_RAID_MODE="single"
if [ "$SYS_DISK_COUNT" -ge 2 ]; then
  SYSTEM_RAID_MODE="mirror"
  echo "[+] System RAID Mode: RAID-1 Mirror across ${SYS_DISK_COUNT} disks (${SYSTEM_DISKS})"
else
  echo "[+] System RAID Mode: Single Disk (${PRIMARY_DISK})"
fi

INSTALL_MODE="ab"
echo ""
echo "Select Installation Architecture:"
echo "  [1] Dual-Root A/B (Unbrickable Dual Slots + Data Partition) [Default]"
echo "  [2] ZFSBootMenu Root-on-ZFS (Boot Environments, Snapshots & Full ZFS RAID)"
echo "  [3] Rolling Standard Linux (Single Root /)"
printf "Choice [1-3] (default 1): "
read -r ARCH_CHOICE
case "${ARCH_CHOICE:-1}" in
  2) INSTALL_MODE="zbm" ;;
  3) INSTALL_MODE="rolling" ;;
  *) INSTALL_MODE="ab" ;;
esac

printf "Select Slot Size for A/B Dual-Root [1=2GB Compact, 2=4GB Standard, 3=8GB Expanded, 4=16GB Enterprise] (default 2): "
read -r SLOT_CHOICE
case "${SLOT_CHOICE:-2}" in
  1) SLOT_MB=2048 ;;
  3) SLOT_MB=8192 ;;
  4) SLOT_MB=16384 ;;
  *) SLOT_MB=4096 ;;
esac

# Detect primary disk capacity in MiB
DEV_BASE=$(basename "$PRIMARY_DISK")
DISK_SECTORS=$(cat "/sys/block/${DEV_BASE}/size" 2>/dev/null || echo 0)
DISK_MB=$(( DISK_SECTORS * 512 / 1024 / 1024 ))
if [ "$DISK_MB" -le 0 ]; then
  DISK_MB=32768
fi

echo ""
echo "Select ZFS Storage Allocation on System Disk(s):"
echo "  [1] Reserve remaining space for ZFS Pool (8GB System Data + Remainder ZFS) [Default]"
echo "  [2] Split remaining space 50/50 between System Data and ZFS Pool"
echo "  [3] Custom ZFS Partition Size (in GB)"
echo "  [4] None on system disk (Use 100% of remaining space for ext4 System Data)"
printf "Choice [1-4] (default 1): "
read -r ZFS_CHOICE

END_EFI=260
END_A=$((END_EFI + SLOT_MB))
END_B=$((END_A + SLOT_MB))
REM_MB=$((DISK_MB - END_B - 16))
if [ "$REM_MB" -lt 1024 ]; then
  REM_MB=1024
fi

ZFS_MB=0
DATA_MB="$REM_MB"
ZFS_ALLOC_MODE="remainder"

case "${ZFS_CHOICE:-1}" in
  2)
    ZFS_ALLOC_MODE="split"
    DATA_MB=$(( REM_MB / 2 ))
    ZFS_MB=$(( REM_MB - DATA_MB ))
    ;;
  3)
    ZFS_ALLOC_MODE="custom"
    printf "Enter desired ZFS partition size on system disk(s) in GB: "
    read -r CUSTOM_ZFS_GB
    CUSTOM_ZFS_GB=$(echo "${CUSTOM_ZFS_GB:-0}" | tr -dc '0-9')
    if [ -n "$CUSTOM_ZFS_GB" ] && [ "$CUSTOM_ZFS_GB" -ge 1 ]; then
      ZFS_MB=$(( CUSTOM_ZFS_GB * 1024 ))
      if [ "$ZFS_MB" -gt $(( REM_MB - 2048 )) ]; then
        ZFS_MB=$(( REM_MB - 2048 ))
      fi
      DATA_MB=$(( REM_MB - ZFS_MB ))
    else
      ZFS_ALLOC_MODE="none"
      ZFS_MB=0
    fi
    ;;
  4)
    ZFS_ALLOC_MODE="none"
    ZFS_MB=0
    ;;
  *)
    ZFS_ALLOC_MODE="remainder"
    if [ "$REM_MB" -gt 10240 ]; then
      DATA_MB=8192
      ZFS_MB=$(( REM_MB - DATA_MB ))
    elif [ "$REM_MB" -gt 4096 ]; then
      DATA_MB=2048
      ZFS_MB=$(( REM_MB - DATA_MB ))
    else
      ZFS_ALLOC_MODE="none"
      ZFS_MB=0
    fi
    ;;
esac

echo ""
printf "Optional: Enter any additional dedicated whole disks for ZFS pool (space-separated, or press Enter for none): "
read -r ZFS_EXTRA_DISKS
ZFS_EXTRA_DISKS=$(echo "${ZFS_EXTRA_DISKS:-}" | tr ',' ' ' | tr -s ' ')

TOTAL_ZFS_VDEVS=0
if [ "$ZFS_MB" -gt 0 ]; then
  TOTAL_ZFS_VDEVS=$(( TOTAL_ZFS_VDEVS + SYS_DISK_COUNT ))
fi
for xd in $ZFS_EXTRA_DISKS; do
  if [ -b "$xd" ]; then
    TOTAL_ZFS_VDEVS=$(( TOTAL_ZFS_VDEVS + 1 ))
  fi
done

ZFS_RAID_TOPOLOGY="auto"
if [ "$TOTAL_ZFS_VDEVS" -ge 1 ]; then
  echo ""
  echo "Select OpenZFS Pool ('tank') RAID Topology (${TOTAL_ZFS_VDEVS} VDEV(s) selected):"
  echo "  [1] Auto (1=Stripe, 2=Mirror, 3-4=RAIDZ1, 5+=RAIDZ2) [Default]"
  echo "  [2] Stripe (RAID-0 — max capacity, no parity)"
  echo "  [3] Mirror (RAID-1 / RAID-10 — 2+ VDEVs)"
  echo "  [4] RAID-Z1 (Single Parity — min 3 VDEVs)"
  echo "  [5] RAID-Z2 (Dual Parity — min 4 VDEVs)"
  echo "  [6] RAID-Z3 (Triple Parity — min 5 VDEVs)"
  echo "  [7] dRAID1 (Distributed RAID-Z1 — min 4 VDEVs)"
  echo "  [8] dRAID2 (Distributed RAID-Z2 — min 6 VDEVs)"
  printf "Choice [1-8] (default 1): "
  read -r TOPO_CHOICE
  case "${TOPO_CHOICE:-1}" in
    2) ZFS_RAID_TOPOLOGY="stripe" ;;
    3) ZFS_RAID_TOPOLOGY="mirror" ;;
    4) ZFS_RAID_TOPOLOGY="raidz1" ;;
    5) ZFS_RAID_TOPOLOGY="raidz2" ;;
    6) ZFS_RAID_TOPOLOGY="raidz3" ;;
    7) ZFS_RAID_TOPOLOGY="draid1" ;;
    8) ZFS_RAID_TOPOLOGY="draid2" ;;
    *) ZFS_RAID_TOPOLOGY="auto" ;;
  esac
fi

printf "WARNING: All data on %s %s will be erased! Proceed? (y/N): " "$SYSTEM_DISKS" "$ZFS_EXTRA_DISKS"
read -r CONFIRM
if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
  echo "Aborted."
  exit 0
fi

END_DATA=$((END_B + DATA_MB))
ZFS_VDEVS=""
DISK_IDX=0

for sys_disk in $SYSTEM_DISKS; do
  DISK_IDX=$(( DISK_IDX + 1 ))
  echo "[+] Partitioning $sys_disk (BIOS Boot + EFI + Slot A [${SLOT_MB}MB] + Slot B [${SLOT_MB}MB] + Data [${DATA_MB}MB] + ZFS [${ZFS_MB}MB])..."
  dd if=/dev/zero of="$sys_disk" bs=1M count=16 conv=notrunc 2>/dev/null || true

  if [ "$ZFS_MB" -gt 0 ]; then
    parted -s "$sys_disk" \
      mklabel gpt \
      mkpart bios_grub 1MiB 4MiB \
      set 1 bios_grub on \
      mkpart ESP fat32 4MiB ${END_EFI}MiB \
      set 2 esp on \
      mkpart axon_root_a ext4 ${END_EFI}MiB ${END_A}MiB \
      mkpart axon_root_b ext4 ${END_A}MiB ${END_B}MiB \
      mkpart axon_data ext4 ${END_B}MiB ${END_DATA}MiB \
      mkpart "axon_zfs_${DISK_IDX}" ${END_DATA}MiB 100%

    ZFS_PART=$(part_dev "$sys_disk" 6)
    ZFS_VDEVS="${ZFS_VDEVS} ${ZFS_PART}"
  else
    parted -s "$sys_disk" \
      mklabel gpt \
      mkpart bios_grub 1MiB 4MiB \
      set 1 bios_grub on \
      mkpart ESP fat32 4MiB ${END_EFI}MiB \
      set 2 esp on \
      mkpart axon_root_a ext4 ${END_EFI}MiB ${END_A}MiB \
      mkpart axon_root_b ext4 ${END_A}MiB ${END_B}MiB \
      mkpart axon_data ext4 ${END_B}MiB 100%
  fi
done

mdev -s 2>/dev/null || true
sleep 1

# Format EFI on all system disks
for sys_disk in $SYSTEM_DISKS; do
  EFI_P=$(part_dev "$sys_disk" 2)
  mkfs.vfat -F 32 -n AXON_EFI "$EFI_P"
done

ROOT_A_DEV=$(part_dev "$PRIMARY_DISK" 3)
ROOT_B_DEV=$(part_dev "$PRIMARY_DISK" 4)
DATA_DEV=$(part_dev "$PRIMARY_DISK" 5)

if [ "$SYSTEM_RAID_MODE" = "mirror" ] && command -v mdadm >/dev/null 2>&1; then
  echo "[+] Assembling mdadm RAID-1 mirrors for Slot A, Slot B, and Persistent Data..."
  RAID_A_MEMBERS=""
  RAID_B_MEMBERS=""
  RAID_DATA_MEMBERS=""
  for sys_disk in $SYSTEM_DISKS; do
    RAID_A_MEMBERS="${RAID_A_MEMBERS} $(part_dev "$sys_disk" 3)"
    RAID_B_MEMBERS="${RAID_B_MEMBERS} $(part_dev "$sys_disk" 4)"
    RAID_DATA_MEMBERS="${RAID_DATA_MEMBERS} $(part_dev "$sys_disk" 5)"
  done

  mdadm --create /dev/md0 --level=1 --raid-devices="$SYS_DISK_COUNT" --metadata=1.2 --run $RAID_A_MEMBERS
  mdadm --create /dev/md1 --level=1 --raid-devices="$SYS_DISK_COUNT" --metadata=1.2 --run $RAID_B_MEMBERS
  mdadm --create /dev/md2 --level=1 --raid-devices="$SYS_DISK_COUNT" --metadata=1.2 --run $RAID_DATA_MEMBERS

  ROOT_A_DEV="/dev/md0"
  ROOT_B_DEV="/dev/md1"
  DATA_DEV="/dev/md2"
fi

mkfs.ext4 -F -L axon_root_a "$ROOT_A_DEV"
mkfs.ext4 -F -L axon_root_b "$ROOT_B_DEV"
mkfs.ext4 -F -L axon_data "$DATA_DEV"

PRIMARY_EFI=$(part_dev "$PRIMARY_DISK" 2)
mkdir -p /mnt/slot_a /mnt/slot_b /mnt/data
mount "$ROOT_A_DEV" /mnt/slot_a
mkdir -p /mnt/slot_a/boot/efi /mnt/slot_a/var/lib/axonwall
mount "$PRIMARY_EFI" /mnt/slot_a/boot/efi
mount "$DATA_DEV" /mnt/data

echo "[+] Installing Alpine rootfs & Axonwall stack to Slot A..."
for dir in bin etc home lib opt root sbin usr var; do
  if [ -d "/$dir" ]; then
    cp -a "/$dir" /mnt/slot_a/ 2>/dev/null || true
  fi
done
mkdir -p /mnt/slot_a/dev /mnt/slot_a/proc /mnt/slot_a/sys /mnt/slot_a/run /mnt/slot_a/tmp /mnt/slot_a/boot

# Install the REAL kernel module tree. On the live system /lib/modules is
# a symlink into the modloop mount (/.modloop/modules); the cp -a above
# preserves that symlink, and on the installed disk nothing ever mounts
# modloop, so the symlink dangles and the installed system has NO loadable
# kernel modules at all -- most visibly af_packet, without which dhcpcd
# and udhcpc both die ("Address family not supported by protocol") and
# IPv4 never gets a DHCP lease (IPv6 SLAAC keeps working, which masks the
# failure). Replace the copied symlink with the mounted tree itself; a tar
# pipe is used because it reads file contents through the mount instead
# of copying the link. The Slot B clone below copies this real directory.
if [ -e /lib/modules ] && { [ -L /mnt/slot_a/lib/modules ] || [ ! -d /mnt/slot_a/lib/modules ]; }; then
  echo "[+] Installing kernel modules to Slot A..."
  rm -rf /mnt/slot_a/lib/modules
  mkdir -p /mnt/slot_a/lib/modules
  ( cd /lib/modules && tar cf - . ) | ( cd /mnt/slot_a/lib/modules && tar xf - ) || true
  if ! ls /mnt/slot_a/lib/modules/*/modules.dep >/dev/null 2>&1; then
    echo "[!] WARNING: kernel modules did not copy cleanly; the installed system may lack loadable modules."
  fi
fi

if [ "$SYSTEM_RAID_MODE" = "mirror" ] && command -v mdadm >/dev/null 2>&1; then
  mkdir -p /mnt/slot_a/etc/mdadm
  mdadm --detail --scan > /mnt/slot_a/etc/mdadm.conf 2>/dev/null || true
  cp /mnt/slot_a/etc/mdadm.conf /mnt/slot_a/etc/mdadm/mdadm.conf 2>/dev/null || true
fi

for boot_src in /media/cdrom/boot /media/usb/boot /media/*/boot /boot; do
  if [ -d "$boot_src" ] && ls "$boot_src"/vmlinuz-* >/dev/null 2>&1; then
    cp -a "$boot_src"/* /mnt/slot_a/boot/ 2>/dev/null || true
    break
  fi
done

KERNEL_FLAVOR="virt"
if [ -f /mnt/slot_a/boot/vmlinuz-lts ]; then
  KERNEL_FLAVOR="lts"
elif [ -f /mnt/slot_a/boot/vmlinuz-virt ]; then
  KERNEL_FLAVOR="virt"
fi

ln -sf "vmlinuz-${KERNEL_FLAVOR}" /mnt/slot_a/boot/vmlinuz
ln -sf "initramfs-${KERNEL_FLAVOR}" /mnt/slot_a/boot/initrd.img
ln -sf boot/vmlinuz /mnt/slot_a/vmlinuz 2>/dev/null || true
ln -sf boot/initrd.img /mnt/slot_a/initrd.img 2>/dev/null || true

mkdir -p /mnt/data/home /mnt/data/ldap /mnt/data/secrets /mnt/slot_a/home /mnt/slot_a/etc/axonwall
echo "${INSTALL_MODE}" > /mnt/slot_a/etc/axonwall/install-mode 2>/dev/null || true
cp -a /mnt/slot_a/home/. /mnt/data/home/ 2>/dev/null || true

cat << 'FSTAB_EOF' > /mnt/slot_a/etc/fstab
LABEL=axon_root_a   /                   ext4    defaults,noatime        0 1
LABEL=AXON_EFI      /boot/efi           vfat    umask=0077              0 2
LABEL=axon_data     /var/lib/axonwall   ext4    defaults,noatime        0 2
/var/lib/axonwall/home /home            none    bind,nofail             0 0
tmpfs               /tmp                tmpfs   nosuid,nodev            0 0
FSTAB_EOF

echo "[+] Installing GRUB bootloader (BIOS + UEFI) onto all system disks..."
for sys_disk in $SYSTEM_DISKS; do
  grub-install --target=i386-pc --boot-directory=/mnt/slot_a/boot "$sys_disk" 2>/dev/null || true
done
grub-install --target=x86_64-efi --efi-directory=/mnt/slot_a/boot/efi --boot-directory=/mnt/slot_a/boot --removable --no-nvram 2>/dev/null || true

# Clone EFI partition onto secondary system disks for redundant UEFI boot
for sys_disk in $SYSTEM_DISKS; do
  if [ "$sys_disk" != "$PRIMARY_DISK" ]; then
    SEC_EFI=$(part_dev "$sys_disk" 2)
    dd if="$PRIMARY_EFI" of="$SEC_EFI" bs=1M conv=fsync 2>/dev/null || true
  fi
done

cat << GRUB_EOF > /mnt/slot_a/boot/grub/grub.cfg
set default=0
set timeout=3

if [ -s \$prefix/grubenv ]; then
  load_env
fi

if [ -z "\${active_slot}" ]; then
  set active_slot="A"
fi
if [ -z "\${bootcount}" ]; then
  set bootcount=0
fi
if [ -z "\${bootlimit}" ]; then
  set bootlimit=3
fi

if [ "\${bootcount}" -ge "\${bootlimit}" ]; then
  if [ "\${active_slot}" = "A" ]; then
    set active_slot="B"
  else
    set active_slot="A"
  fi
  set bootcount=0
  save_env active_slot bootcount
fi

if [ "\${bootcount}" = "0" ]; then
  set bootcount=1
elif [ "\${bootcount}" = "1" ]; then
  set bootcount=2
else
  set bootcount=3
fi
save_env bootcount

if [ "\${active_slot}" = "B" ]; then
  set default="Axonwall Appliance - Slot B"
else
  set default="Axonwall Appliance - Slot A"
fi

menuentry "Axonwall Appliance - Slot A" {
  search --no-floppy --label --set=root axon_root_a
  if [ -f /boot/vmlinuz-${KERNEL_FLAVOR} ]; then
    set kfile="/boot/vmlinuz-${KERNEL_FLAVOR}"
  else
    set kfile="/boot/vmlinuz"
  fi
  if [ -f /boot/initramfs-${KERNEL_FLAVOR} ]; then
    set ifile="/boot/initramfs-${KERNEL_FLAVOR}"
  else
    set ifile="/boot/initrd.img"
  fi
  linux \${kfile} root=LABEL=axon_root_a ro rootfstype=ext4 slot=A modules=sd-mod,usb-storage,ext4,virtio_blk,nvme,raid1,md-mod quiet console=tty0 console=ttyS0,115200
  initrd \${ifile}
}

menuentry "Axonwall Appliance - Slot B" {
  search --no-floppy --label --set=root axon_root_b
  if [ -f /boot/vmlinuz-${KERNEL_FLAVOR} ]; then
    set kfile="/boot/vmlinuz-${KERNEL_FLAVOR}"
  else
    set kfile="/boot/vmlinuz"
  fi
  if [ -f /boot/initramfs-${KERNEL_FLAVOR} ]; then
    set ifile="/boot/initramfs-${KERNEL_FLAVOR}"
  else
    set ifile="/boot/initrd.img"
  fi
  linux \${kfile} root=LABEL=axon_root_b ro rootfstype=ext4 slot=B modules=sd-mod,usb-storage,ext4,virtio_blk,nvme,raid1,md-mod quiet console=tty0 console=ttyS0,115200
  initrd \${ifile}
}
GRUB_EOF

grub-editenv /mnt/slot_a/boot/grub/grubenv create 2>/dev/null || true
grub-editenv /mnt/slot_a/boot/grub/grubenv set active_slot=A bootcount=0 bootlimit=3 2>/dev/null || true

# --- Admin credentials for the installed system -------------------------
# The cloned rootfs carries the live image's credentials (web admin
# 'admin' and the OS accounts, all with the default password). Offer to
# set a real password now, stored the same way the Debian installer
# stores it (scrypt hash in admin.env, 0600). Skipping keeps the
# default; the installed system then forces a change at first sign-in
# before its API unlocks.
echo ""
# Ask twice and require a match before anything is set: a typo here would
# otherwise lock the operator out of the freshly installed system. Three
# mismatched attempts fall back to keeping the default password (with the
# forced change at first sign-in, same as skipping).
NEW_ADMIN_PASS=""
PW_ATTEMPT=0
while [ $PW_ATTEMPT -lt 3 ]; do
  PW_ATTEMPT=$((PW_ATTEMPT + 1))
  printf "Set a new admin password for the installed system (leave empty to keep the default for now): "
  stty -echo 2>/dev/null || true
  read -r PW_FIRST || PW_FIRST=""
  stty echo 2>/dev/null || true
  echo ""
  if [ -z "$PW_FIRST" ]; then
    break
  fi
  printf "Confirm the new admin password: "
  stty -echo 2>/dev/null || true
  read -r PW_SECOND || PW_SECOND=""
  stty echo 2>/dev/null || true
  echo ""
  if [ "$PW_FIRST" = "$PW_SECOND" ]; then
    NEW_ADMIN_PASS="$PW_FIRST"
    PW_FIRST=""; PW_SECOND=""
    break
  fi
  PW_FIRST=""; PW_SECOND=""
  echo "[!] Passwords do not match -- please try again."
done
if [ -z "$NEW_ADMIN_PASS" ] && [ $PW_ATTEMPT -ge 3 ]; then
  echo "[!] No matching password after 3 attempts; keeping the default -- a change will be forced at first sign-in."
fi
if [ -n "$NEW_ADMIN_PASS" ]; then
  PW_TMP="/mnt/slot_a/tmp/.axonwall_pw_install.tmp"
  printf '%s' "$NEW_ADMIN_PASS" > "$PW_TMP"
  chmod 600 "$PW_TMP"
  SCRYPT_HASH=""
  if command -v node >/dev/null 2>&1; then
    SCRYPT_HASH="$(node -e '
      const crypto = require("crypto");
      const fs = require("fs");
      try {
        const pw = fs.readFileSync(process.argv[1], "utf-8");
        const salt = crypto.randomBytes(16).toString("hex");
        const hash = crypto.scryptSync(pw, salt, 64, { N: 16384, r: 8, p: 1 }).toString("hex");
        console.log("scrypt$" + salt + "$" + hash);
      } catch (e) { process.exit(1); }
    ' "$PW_TMP" 2>/dev/null || true)"
  fi
  rm -f "$PW_TMP"
  if [ -n "$SCRYPT_HASH" ]; then
    mkdir -p /mnt/slot_a/etc/axonwall /mnt/slot_a/var/lib/axonwall /mnt/data/etc-axonwall
    printf 'LOCAL_ADMIN_USER=admin\nLOCAL_ADMIN_PASSWORD=%s\n' "$SCRYPT_HASH" > /mnt/slot_a/etc/axonwall/admin.env
    chmod 0600 /mnt/slot_a/etc/axonwall/admin.env
    cp -a /mnt/slot_a/etc/axonwall/admin.env /mnt/data/etc-axonwall/admin.env 2>/dev/null || true
    chmod 0600 /mnt/data/etc-axonwall/admin.env 2>/dev/null || true
    rm -f /mnt/slot_a/etc/axonwall/initial-admin-password /mnt/data/etc-axonwall/initial-admin-password
    date -u +%Y-%m-%dT%H:%M:%SZ > /mnt/slot_a/etc/axonwall/.password_changed
    date -u +%Y-%m-%dT%H:%M:%SZ > /mnt/slot_a/var/lib/axonwall/.password_changed
    date -u +%Y-%m-%dT%H:%M:%SZ > /mnt/data/.password_changed
    # OS accounts get the same password (best effort).
    printf 'root:%s\n' "$NEW_ADMIN_PASS" | chroot /mnt/slot_a /usr/sbin/chpasswd 2>/dev/null || true
    if grep -q '^axonwall:' /mnt/slot_a/etc/passwd 2>/dev/null; then
      printf 'axonwall:%s\n' "$NEW_ADMIN_PASS" | chroot /mnt/slot_a /usr/sbin/chpasswd 2>/dev/null || true
    fi
    echo "[+] Admin password set for the installed system."
  else
    echo "[!] Could not hash the new password (node unavailable); keeping the default -- a change will be forced at first sign-in."
  fi
  NEW_ADMIN_PASS=""
fi

echo "[+] Cloning Slot A into Standby Slot B..."
mount "$ROOT_B_DEV" /mnt/slot_b
cp -a /mnt/slot_a/. /mnt/slot_b/ 2>/dev/null || true
sed -i 's/LABEL=axon_root_a/LABEL=axon_root_b/' /mnt/slot_b/etc/fstab
ln -sf "vmlinuz-${KERNEL_FLAVOR}" /mnt/slot_b/boot/vmlinuz 2>/dev/null || true
ln -sf "initramfs-${KERNEL_FLAVOR}" /mnt/slot_b/boot/initrd.img 2>/dev/null || true
ln -sf boot/vmlinuz /mnt/slot_b/vmlinuz 2>/dev/null || true
ln -sf boot/initrd.img /mnt/slot_b/initrd.img 2>/dev/null || true

# Persist initial per-slot versions
INSTALL_VER="0.8.13"
if [ -f /mnt/slot_a/etc/axonwall/version ]; then
  INSTALL_VER="$(head -n1 /mnt/slot_a/etc/axonwall/version | tr -d '\r\n ')"
fi
INIT_SLOT_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s (Factory Standby)",\n  "updatedAt": "%s"\n}\n' "$INSTALL_VER" "$INSTALL_VER" "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")")"
mkdir -p /mnt/slot_a/etc/axonwall /mnt/slot_a/var/lib/axonwall /mnt/slot_b/etc/axonwall /mnt/data 2>/dev/null || true
printf '%s' "$INIT_SLOT_JSON" > /mnt/slot_a/etc/axonwall/slot_versions.json 2>/dev/null || true
printf '%s' "$INIT_SLOT_JSON" > /mnt/slot_a/var/lib/axonwall/slot_versions.json 2>/dev/null || true
printf '%s' "$INIT_SLOT_JSON" > /mnt/slot_b/etc/axonwall/slot_versions.json 2>/dev/null || true
printf '%s' "$INIT_SLOT_JSON" > /mnt/data/slot_versions.json 2>/dev/null || true

umount /mnt/slot_b

# Add extra dedicated ZFS disks & record / create ZFS pool
for xd in $ZFS_EXTRA_DISKS; do
  if [ -b "$xd" ]; then
    ZFS_VDEVS="${ZFS_VDEVS} ${xd}"
  fi
done
ZFS_VDEVS=$(echo "$ZFS_VDEVS" | tr -s ' ' | sed 's/^ //;s/ $//')

if [ -n "$ZFS_VDEVS" ]; then
  VDEV_COUNT=$(echo "$ZFS_VDEVS" | wc -w | tr -d ' ')
  RESOLVED_TOPOLOGY="$ZFS_RAID_TOPOLOGY"
  if [ "$RESOLVED_TOPOLOGY" = "auto" ]; then
    if [ "$VDEV_COUNT" -le 1 ]; then
      RESOLVED_TOPOLOGY="stripe"
    elif [ "$VDEV_COUNT" -eq 2 ]; then
      RESOLVED_TOPOLOGY="mirror"
    elif [ "$VDEV_COUNT" -le 4 ]; then
      RESOLVED_TOPOLOGY="raidz1"
    else
      RESOLVED_TOPOLOGY="raidz2"
    fi
  fi

  JSON_VDEVS=""
  for v in $ZFS_VDEVS; do
    if [ -z "$JSON_VDEVS" ]; then
      JSON_VDEVS="\"${v}\""
    else
      JSON_VDEVS="${JSON_VDEVS}, \"${v}\""
    fi
  done

  ZFS_GB=$(( ZFS_MB / 1024 ))
  cat << ZFS_JSON_EOF > /mnt/data/install-zfs.json
{
  "poolName": "tank",
  "topology": "${RESOLVED_TOPOLOGY}",
  "vdevs": [${JSON_VDEVS}],
  "sizeGb": ${ZFS_GB},
  "systemRaidMode": "${SYSTEM_RAID_MODE}",
  "systemRaidDisks": "${SYSTEM_DISKS}",
  "autoCreatePool": true
}
ZFS_JSON_EOF

  if command -v zpool >/dev/null 2>&1; then
    echo "[+] Creating OpenZFS pool 'tank' (topology=${RESOLVED_TOPOLOGY}, vdevs=${ZFS_VDEVS})..."
    ZPOOL_ARGS=""
    if [ "$RESOLVED_TOPOLOGY" != "stripe" ]; then
      ZPOOL_ARGS="$RESOLVED_TOPOLOGY"
    fi
    zpool create -f -o ashift=12 -o autotrim=on -O compression=lz4 -O acltype=posixacl -O xattr=sa -O mountpoint=/mnt/tank tank $ZPOOL_ARGS $ZFS_VDEVS 2>/dev/null || true
  fi
fi

umount /mnt/slot_a/boot/efi /mnt/slot_a /mnt/data 2>/dev/null || true
sync

echo "================================================================================"
echo "[✓] Axonwall Alpine Installation Complete (${SYSTEM_RAID_MODE}: ${SYSTEM_DISKS})!"
echo "    Remove installation media and run 'reboot'."
echo "================================================================================"
