#!/sbin/openrc-run

name="axonwalld"
description="Axonwall Privileged Firewall & Networking Daemon"
supervisor="supervise-daemon"
command="/usr/sbin/axonwalld"
# Run with the shared axonwall-api group (root user) so the sockets
# created in /run/axonwall are group axonwall-api and the UI/controller
# processes can connect to them. Without a shared group the daemon runs
# root:root on Alpine and its sockets are root:root 0660 -- unreachable
# for the services (A-S01). Since the B-12 identity split the shared
# group is axonwall-api, not the UI's own group.
command_user="root:axonwall-api"
command_args="--socket /run/axonwall/agent.sock --boot-apply"
pidfile="/run/axonwalld.pid"
output_log="/var/log/axonwall/axonwalld.log"
error_log="/var/log/axonwall/axonwalld.log"
respawn_delay=3
respawn_max=0

depend() {
    need localmount
    after axonwall-firstboot
}

start_pre() {
    checkpath -d -m 0770 -o root:axonwall-api /run/axonwall
    checkpath -d -m 0750 -o axonwall:axonwall /var/lib/axonwall
    checkpath -d -m 0750 -o axonwall:axonwall /var/log/axonwall
    mkdir -p /var/lib/axonwall/home /home
    if ! grep -q ' /home ' /proc/mounts 2>/dev/null; then
        mount --bind /var/lib/axonwall/home /home 2>/dev/null || true
    fi
    if id -u ldap >/dev/null 2>&1; then
        mkdir -p /var/lib/openldap/run /run/openldap
        chown -R ldap:ldap /var/lib/openldap/run /run/openldap 2>/dev/null || true
    fi
    if [ ! -x /usr/bin/zsh ] && [ -x /bin/ash ]; then
        ln -sf /bin/ash /usr/bin/zsh 2>/dev/null || true
    fi
    # B-12 upgrade migration (idempotent): split the ZTP token out of a
    # monolith axonwall.env written before the service-identity split and
    # re-assert the split ownership. Fresh installs are generated split by
    # firstboot; this covers rootfs upgrades over a persistent /etc.
    if [ -f /etc/axonwall/axonwall.env ]; then
        chown axonwall /etc/axonwall/axonwall.env 2>/dev/null || true
        chmod 0600 /etc/axonwall/axonwall.env 2>/dev/null || true
        if [ ! -f /etc/axonwall/controller.env ] && grep -q '^AXONWALL_ZTP_TOKEN=' /etc/axonwall/axonwall.env; then
            grep '^AXONWALL_ZTP_TOKEN=' /etc/axonwall/axonwall.env > /etc/axonwall/controller.env || true
            chown root:root /etc/axonwall/controller.env 2>/dev/null || true
            chmod 0600 /etc/axonwall/controller.env 2>/dev/null || true
            sed -i '/^AXONWALL_ZTP_TOKEN=/d' /etc/axonwall/axonwall.env
        fi
    fi
    if [ -f /etc/axonwall/certs/hub.key ]; then
        chown axonwall-controller:axonwall-controller /etc/axonwall/certs/hub.key 2>/dev/null || true
        chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
    fi
    # Headscale identity split migration (idempotent, B-12 follow-up):
    # installs predating the split have headscale's data owned by the
    # shared axonwall user; hand it to axonwall-headscale and tighten
    # the config (all of its readers are axonwall-api members).
    if id -u axonwall-headscale >/dev/null 2>&1; then
        chown -R axonwall-headscale:axonwall-headscale /var/lib/axonwall/headscale 2>/dev/null || true
        chown axonwall-headscale:axonwall-api /run/headscale 2>/dev/null || true
        if [ -f /etc/headscale/config.yaml ]; then
            chown root:axonwall-api /etc/headscale/config.yaml 2>/dev/null || true
            chmod 0640 /etc/headscale/config.yaml 2>/dev/null || true
        fi
    fi
    if [ -f /usr/share/axonwall/lockdown.nft ]; then
        /usr/sbin/nft -f /usr/share/axonwall/lockdown.nft 2>/dev/null || true
    fi
}
