#!/sbin/openrc-run

name="headscale"
description="Headscale WireGuard Mesh Coordination Server"
supervisor="supervise-daemon"
command="/usr/sbin/headscale"
command_args="serve -c /etc/headscale/config.yaml"
command_user="axonwall:axonwall"
pidfile="/run/headscale.pid"
output_log="/var/log/axonwall/headscale.log"
error_log="/var/log/axonwall/headscale.log"
respawn_delay=5
respawn_max=0

depend() {
    after axonwall-firstboot axonwalld
}

start_pre() {
    checkpath -d -m 0770 -o axonwall:axonwall-api /run/headscale
    checkpath -d -m 0770 -o axonwall:axonwall /var/lib/axonwall/headscale
    checkpath -d -m 0750 -o axonwall:axonwall /var/log/axonwall
}
