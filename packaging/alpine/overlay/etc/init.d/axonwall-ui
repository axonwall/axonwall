#!/sbin/openrc-run

name="axonwall-ui"
description="Axonwall Web Console & API Server"
supervisor="supervise-daemon"
command="/usr/bin/node"
command_args="/opt/axonwall/apps/axonwall/server.js"
command_user="axonwall:axonwall-api"
directory="/opt/axonwall/apps/axonwall"
pidfile="/run/axonwall-ui.pid"
output_log="/var/log/axonwall/axonwall-ui.log"
error_log="/var/log/axonwall/axonwall-ui.log"
respawn_delay=5
respawn_max=0

depend() {
    need axonwalld
    after axonwall-firstboot axonwall-controller
}

# Parse a KEY=value env file WITHOUT executing it (audit D-S08). These
# files carry credential material -- firstboot embeds the admin password
# in axonwall.env -- and sourcing them as root would execute any $(...)
# or backtick construct in a value at every service start. Values are
# taken literally; one layer of matching surrounding quotes is stripped.
load_env_file() {
    _env_file="$1"
    [ -f "$_env_file" ] || return 0
    while IFS= read -r _line || [ -n "$_line" ]; do
        case "$_line" in
            ''|'#'*) continue ;;
            *=*) ;;
            *) continue ;;
        esac
        _key=${_line%%=*}
        _val=${_line#*=}
        case "$_key" in
            *[!A-Za-z0-9_]*|'') continue ;;
        esac
        case "$_val" in
            \"*\") _val=${_val#?}; _val=${_val%?} ;;
            \'*\') _val=${_val#?}; _val=${_val%?} ;;
        esac
        export "$_key=$_val"
    done < "$_env_file"
    unset _env_file _line _key _val
}


start_pre() {
    checkpath -d -m 0770 -o axonwall:axonwall-api /var/log/axonwall
    load_env_file /etc/axonwall/axonwall.env
    load_env_file /etc/axonwall/admin.env
    export NODE_ENV=production
    export PORT=3000
    export HOSTNAME=127.0.0.1
}
