#!/bin/sh
set -e

echo "[Hook] Ensuring OpenZFS DKMS modules & zfs-initramfs are built for target chroot kernel(s)..."
if [ ! -f /etc/hostid ]; then
  zgenhostid -f 0x00bab10c 2>/dev/null || printf '\x0c\xb1\xba\x00' > /etc/hostid
fi

for kdir in /lib/modules/*; do
  if [ -d "$kdir" ]; then
    kver="$(basename "$kdir")"
    if command -v dkms >/dev/null 2>&1; then
      dkms autoinstall -k "$kver" || true
    fi
    depmod -a "$kver" || true
    if command -v update-initramfs >/dev/null 2>&1; then
      update-initramfs -u -k "$kver" || true
    fi
  fi
done

echo "[Hook] Creating stable /boot/vmlinuz and /boot/initrd.img symlinks in chroot..."
LATEST_KERN="$(ls -1t /boot/vmlinuz-* 2>/dev/null | head -n1 || true)"
if [ -n "$LATEST_KERN" ]; then
  ln -sf "$(basename "$LATEST_KERN")" /boot/vmlinuz
  ln -sf "boot/$(basename "$LATEST_KERN")" /vmlinuz
fi

LATEST_INITRD="$(ls -1t /boot/initrd.img-* 2>/dev/null | head -n1 || true)"
if [ -n "$LATEST_INITRD" ]; then
  ln -sf "$(basename "$LATEST_INITRD")" /boot/initrd.img
  ln -sf "boot/$(basename "$LATEST_INITRD")" /initrd.img
fi

echo "[Hook] Ensuring Unbound DNSSEC root trust anchor and disabling unconfigured daemons until axonwall-firstboot..."
mkdir -p /var/lib/unbound
if [ -f /usr/share/dns/root.key ] && { [ ! -s /var/lib/unbound/root.key ] || ! grep -q "AwEAAa96jeuknZlaeSrvyAJj6ZHv28hhOKkx3rLGXVaC6rXTsDc449" /var/lib/unbound/root.key 2>/dev/null; }; then
  cp -f /usr/share/dns/root.key /var/lib/unbound/root.key
fi
chown -R unbound:unbound /var/lib/unbound 2>/dev/null || true
rm -f /etc/unbound/unbound.conf.d/root-auto-trust-anchor-file.conf 2>/dev/null || true
systemctl disable suricata kea-dhcp4-server unbound unbound-resolvconf frr strongswan strongswan-starter openvpn conntrackd keepalived 2>/dev/null || true

echo "[Hook] Silencing cloud-init console output so it never bleeds into the TUI on /dev/tty1..."
if [ -f /etc/cloud/cloud.cfg.d/05_logging.cfg ]; then
  sed -i 's/ - \*log_syslog/ # - *log_syslog/' /etc/cloud/cloud.cfg.d/05_logging.cfg 2>/dev/null || true
fi
for ci_unit in cloud-init-local.service cloud-init.service cloud-init-network.service cloud-config.service cloud-final.service; do
  mkdir -p "/etc/systemd/system/${ci_unit}.d"
  cat > "/etc/systemd/system/${ci_unit}.d/10-axonwall-quiet-console.conf" << 'CI_DROPIN_EOF'
[Service]
StandardOutput=journal
StandardError=journal
CI_DROPIN_EOF
done


