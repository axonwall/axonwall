#!/bin/sh
set -e

. /usr/share/debconf/confmodule

IS_K3S_EDITION=0
if [ -f /target/etc/axonwall/.k3s-edition ]; then
  IS_K3S_EDITION=1
elif [ -f /var/lib/partman/axonwall-choices ] && grep -q "INSTALL_EDITION='k3s-storage'" /var/lib/partman/axonwall-choices 2>/dev/null; then
  IS_K3S_EDITION=1
fi

db_get passwd/root-password || true
ADMIN_PW="$RET"
ADMIN_USER="admin"

if [ -f /var/lib/partman/cloud-config.yaml ]; then
  ci_user="$(grep -A 10 "auth:" /var/lib/partman/cloud-config.yaml 2>/dev/null | grep "admin_username:" | head -n1 | sed -e 's/.*admin_username:[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' -e 's/[[:space:]]*$//' || true)"
  if [ -n "$ci_user" ]; then
    ADMIN_USER="$ci_user"
  fi
  if [ -z "$ADMIN_PW" ]; then
    ci_pw="$(grep -A 10 "auth:" /var/lib/partman/cloud-config.yaml 2>/dev/null | grep "admin_password:" | head -n1 | sed -e 's/.*admin_password:[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' || true)"
    [ "$ci_pw" = "CHANGE_ME_ON_DEPLOY" ] && ci_pw=""
    if [ -z "$ci_pw" ]; then
      ci_pw="$(grep -E '^password:[[:space:]]*' /var/lib/partman/cloud-config.yaml 2>/dev/null | head -n1 | sed -e 's/^password:[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' || true)"
      [ "$ci_pw" = "CHANGE_ME_ON_DEPLOY" ] && ci_pw=""
    fi
    if [ -z "$ci_pw" ]; then
      ci_pw="$(grep -E '^[[:space:]]+plain_text_passwd:[[:space:]]*' /var/lib/partman/cloud-config.yaml 2>/dev/null | head -n1 | sed -e 's/.*plain_text_passwd:[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' || true)"
      [ "$ci_pw" = "CHANGE_ME_ON_DEPLOY" ] && ci_pw=""
    fi
    case "$ci_pw" in
      \$1\$*|\$5\$*|\$6\$*|\$y\$*|\$2a\$*|\$2b\$*|\$2y\$*)
        ci_pw=""
        ;;
    esac
    ADMIN_PW="$ci_pw"
  fi
fi

CUSTOM_PW_SET=1
if [ -z "$ADMIN_PW" ]; then
  ADMIN_PW="axonwall"
  CUSTOM_PW_SET=0
fi

# Ensure Linux root / admin / axonwall accounts receive the password cleanly (including on k3s-storage and vault)
case "$ADMIN_PW" in
  scrypt\$*) ;;
  *)
    printf 'root:%s\n' "$ADMIN_PW" | chroot /target /usr/sbin/chpasswd 2>/dev/null || true
    if grep -q '^admin:' /target/etc/passwd 2>/dev/null; then
      printf 'admin:%s\n' "$ADMIN_PW" | chroot /target /usr/sbin/chpasswd 2>/dev/null || true
    fi
    if grep -q '^axonwall:' /target/etc/passwd 2>/dev/null; then
      printf 'axonwall:%s\n' "$ADMIN_PW" | chroot /target /usr/sbin/chpasswd 2>/dev/null || true
    fi
    ;;
esac

mkdir -p /target/etc/axonwall /target/var/lib/axonwall /target/var/lib/axonwall/etc-axonwall

SCRYPT_HASH=""
case "$ADMIN_PW" in
  scrypt\$*)
    SCRYPT_HASH="$ADMIN_PW"
    ;;
  *)
    # Safely write the password to a secure temporary file in /target
    TMP_PW="/target/tmp/.axonwall_pw_install.tmp"
    printf '%s' "$ADMIN_PW" > "$TMP_PW"
    chmod 600 "$TMP_PW"

    if [ -x /target/usr/bin/node ] || [ -x /target/usr/local/bin/node ]; then
      SCRYPT_HASH=$(in-target node -e "
        const crypto = require('crypto');
        const fs = require('fs');
        try {
          const pw = fs.readFileSync('/tmp/.axonwall_pw_install.tmp', 'utf-8');
          const salt = crypto.randomBytes(16).toString('hex');
          const hash = crypto.scryptSync(pw, salt, 64, { N: 16384, r: 8, p: 1 }).toString('hex');
          console.log('scrypt$' + salt + '$' + hash);
        } catch (e) {
          process.exit(1);
        }
      " 2>/dev/null || true)
    elif [ -x /target/usr/bin/python3 ] || [ -x /target/usr/local/bin/python3 ]; then
      SCRYPT_HASH=$(in-target python3 -c '
import hashlib, os, sys
try:
    with open("/tmp/.axonwall_pw_install.tmp", "r", encoding="utf-8") as f:
        pw = f.read().rstrip("\r\n")
    salt = os.urandom(16)
    h = hashlib.scrypt(pw.encode("utf-8"), salt=salt, n=16384, r=8, p=1, maxmem=0, dklen=64)
    print("scrypt$" + salt.hex() + "$" + h.hex())
except Exception:
    sys.exit(1)
' 2>/dev/null || true)
    fi

    rm -f "$TMP_PW"
    ;;
esac

if [ -n "$SCRYPT_HASH" ]; then
  cat << ENV_EOF > /target/etc/axonwall/admin.env
LOCAL_ADMIN_USER=${ADMIN_USER}
LOCAL_ADMIN_PASSWORD=${SCRYPT_HASH}
ENV_EOF
else
  cat << ENV_EOF > /target/etc/axonwall/admin.env
LOCAL_ADMIN_USER=${ADMIN_USER}
LOCAL_ADMIN_PASSWORD=${ADMIN_PW}
ENV_EOF
fi

cp /target/etc/axonwall/admin.env /target/var/lib/axonwall/etc-axonwall/admin.env 2>/dev/null || true
chmod 0600 /target/var/lib/axonwall/etc-axonwall/admin.env 2>/dev/null || true

chmod 0770 /target/etc/axonwall 2>/dev/null || true
chmod 0600 /target/etc/axonwall/admin.env
in-target chown root:axonwall-api /etc/axonwall 2>/dev/null || true
in-target chown axonwall /etc/axonwall/admin.env 2>/dev/null || chown 0:0 /target/etc/axonwall/admin.env 2>/dev/null || true

if [ "$CUSTOM_PW_SET" -eq 1 ]; then
  rm -f /target/etc/axonwall/initial-admin-password /target/var/lib/axonwall/etc-axonwall/initial-admin-password
  NOW=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date)
  printf '%s\n' "$NOW" > /target/etc/axonwall/.password_changed
  printf '%s\n' "$NOW" > /target/var/lib/axonwall/.password_changed
  chmod 0644 /target/etc/axonwall/.password_changed /target/var/lib/axonwall/.password_changed 2>/dev/null || true
else
  rm -f /target/etc/axonwall/.password_changed /target/var/lib/axonwall/.password_changed
  printf '%s\n' "$ADMIN_PW" > /target/etc/axonwall/initial-admin-password
  chmod 0600 /target/etc/axonwall/initial-admin-password
  printf '%s\n' "$ADMIN_PW" > /target/var/lib/axonwall/etc-axonwall/initial-admin-password 2>/dev/null || true
  chmod 0600 /target/var/lib/axonwall/etc-axonwall/initial-admin-password 2>/dev/null || true
fi
