#!/bin/sh
set -e

. /usr/share/debconf/confmodule

echo "================================================================================"
echo "[Axonwall Installer] Finalizing A/B Dual-Root, System RAID & ZFS Setup..."
echo "================================================================================"

# Load installer choices recorded by 10initial_auto
ZFS_MB=0
ZFS_GB=0
ZFS_ALLOC_MODE="none"
SYSTEM_RAID_MODE="single"
SYSTEM_RAID_DISKS=""
ZFS_EXTRA_DISKS=""
ZFS_RAID_TOPOLOGY="auto"
ROOT_FSTYPE="ext4"
DATA_FSTYPE="ext4"
LOGS_ENABLED=0
LOGS_GB=0
LOGS_FSTYPE="xfs"
LUKS_ENABLED=0
LUKS_TPM2=0
LUKS_PASSPHRASE=""

if [ -f /var/lib/partman/axonwall-choices ]; then
  . /var/lib/partman/axonwall-choices
fi

part_dev() {
  disk_dev="$1"
  p_num="$2"
  if echo "$disk_dev" | grep -q 'nvme\|mmcblk\|loop'; then
    echo "${disk_dev}p${p_num}"
  else
    echo "${disk_dev}${p_num}"
  fi
}

# 1. Identify installed block devices on primary disk
ROOT_A_DEV=$(df /target | tail -n1 | awk '{print $1}')
ROOT_B_DEV=$(df /target/mnt/standby 2>/dev/null | tail -n1 | awk '{print $1}')
DATA_DEV=$(df /target/var/lib/axonwall 2>/dev/null | tail -n1 | awk '{print $1}')
LOGS_DEV=$(df /target/var/log 2>/dev/null | tail -n1 | awk '{print $1}')

if [ -z "$TARGET_DISK" ]; then
  TARGET_DISK=$(echo "$ROOT_A_DEV" | sed -E 's/p?[0-9]+$//')
fi

# Fallback detection for Slot B device if not mounted at /target/mnt/standby
if [ -z "$ROOT_B_DEV" ] || [ "$ROOT_B_DEV" = "$ROOT_A_DEV" ]; then
  PART_NUM=$(echo "$ROOT_A_DEV" | grep -oE '[0-9]+$')
  NEXT_NUM=$(( PART_NUM + 1 ))
  ROOT_B_DEV=$(part_dev "$TARGET_DISK" "$NEXT_NUM")
fi

# Fallback detection for Logs, Data and Optional ZFS partition
ALL_PARTS=$(ls "${TARGET_DISK}"* 2>/dev/null | grep -E "${TARGET_DISK}(p?[0-9]+)$" | sort -V || true)
LAST_PART=$(echo "$ALL_PARTS" | tail -n1)
SECOND_LAST_PART=$(echo "$ALL_PARTS" | tail -n2 | head -n1)
THIRD_LAST_PART=$(echo "$ALL_PARTS" | tail -n3 | head -n1)

ZFS_DEV=""
if [ "${ZFS_MB:-0}" -gt 0 ]; then
  ZFS_DEV="$LAST_PART"
  if [ -z "$DATA_DEV" ] || [ "$DATA_DEV" = "$ROOT_A_DEV" ]; then
    DATA_DEV="$SECOND_LAST_PART"
  fi
  if [ "$LOGS_ENABLED" = "1" ] && [ -z "$LOGS_DEV" ]; then
    LOGS_DEV="$THIRD_LAST_PART"
  fi
else
  if [ -z "$DATA_DEV" ] || [ "$DATA_DEV" = "$ROOT_A_DEV" ]; then
    DATA_DEV="$LAST_PART"
  fi
  if [ "$LOGS_ENABLED" = "1" ] && [ -z "$LOGS_DEV" ]; then
    LOGS_DEV="$SECOND_LAST_PART"
  fi
fi

echo "[+] Target Disk       : ${TARGET_DISK}"
echo "[+] System RAID Mode  : ${SYSTEM_RAID_MODE} (${SYSTEM_RAID_DISKS:-$TARGET_DISK})"
echo "[+] Slot A (Primary)  : ${ROOT_A_DEV} (${ROOT_FSTYPE})"
echo "[+] Slot B (Standby)  : ${ROOT_B_DEV} (${ROOT_FSTYPE})"
echo "[+] Persistent Data   : ${DATA_DEV:-<embedded>} (${DATA_FSTYPE}, LUKS2=${LUKS_ENABLED})"
echo "[+] Dedicated Logs    : ${LOGS_DEV:-<none>} (${LOGS_FSTYPE})"
echo "[+] ZFS Partition     : ${ZFS_DEV:-<none>} (${ZFS_GB:-0} GB)"

# 2. Label filesystems and configure LUKS2 Encryption
if [ -b "$ROOT_A_DEV" ]; then
  echo "[+] Setting filesystem label: ${ROOT_A_DEV} -> axon_root_a"
  if [ "$ROOT_FSTYPE" = "xfs" ] && command -v xfs_admin >/dev/null 2>&1; then
    xfs_admin -L axon_root_a "$ROOT_A_DEV" 2>/dev/null || true
  else
    e2label "$ROOT_A_DEV" axon_root_a 2>/dev/null || tune2fs -L axon_root_a "$ROOT_A_DEV" 2>/dev/null || true
  fi
fi

if [ -b "$ROOT_B_DEV" ]; then
  echo "[+] Formatting Slot B standby partition: ${ROOT_B_DEV} as ${ROOT_FSTYPE}..."
  if [ "$ROOT_FSTYPE" = "xfs" ]; then
    mkfs.xfs -f -L axon_root_b "$ROOT_B_DEV" 2>/dev/null || true
  else
    mkfs.ext4 -F -L axon_root_b "$ROOT_B_DEV" 2>/dev/null || true
  fi
fi

# Configure dedicated /var/log partition if enabled
if [ "$LOGS_ENABLED" = "1" ] && [ -b "$LOGS_DEV" ] && [ "$LOGS_DEV" != "$ROOT_A_DEV" ]; then
  echo "[+] Formatting dedicated logs partition: ${LOGS_DEV} as ${LOGS_FSTYPE}..."
  if [ "$LOGS_FSTYPE" = "xfs" ]; then
    mkfs.xfs -f -L axon_logs "$LOGS_DEV" 2>/dev/null || true
  else
    mkfs.ext4 -F -L axon_logs "$LOGS_DEV" 2>/dev/null || true
  fi
fi

# Configure LUKS2 Encryption for Persistent Data volume if requested
TARGET_DATA_MAPPER="$DATA_DEV"
if [ "$LUKS_ENABLED" = "1" ] && [ -b "$DATA_DEV" ] && command -v cryptsetup >/dev/null 2>&1; then
  echo "[+] Initializing LUKS2 encryption on ${DATA_DEV}..."
  mkdir -p /target/etc/axonwall
  VAULT_KEY_PATH="/target/etc/axonwall/vault.key"
  if [ -n "$LUKS_PASSPHRASE" ]; then
    printf '%s' "$LUKS_PASSPHRASE" > "$VAULT_KEY_PATH"
  else
    dd if=/dev/urandom of="$VAULT_KEY_PATH" bs=32 count=1 2>/dev/null
  fi
  chmod 0400 "$VAULT_KEY_PATH"
  chown 0:0 "$VAULT_KEY_PATH"

  cryptsetup luksFormat --type luks2 --cipher aes-xts-plain64 -s 512 -d "$VAULT_KEY_PATH" "$DATA_DEV" 2>/dev/null || true
  cryptsetup open -d "$VAULT_KEY_PATH" "$DATA_DEV" axon_crypt_data 2>/dev/null || true
  TARGET_DATA_MAPPER="/dev/mapper/axon_crypt_data"

  if [ -b "$TARGET_DATA_MAPPER" ]; then
    if [ "$DATA_FSTYPE" = "xfs" ]; then
      mkfs.xfs -f -L axon_data "$TARGET_DATA_MAPPER" 2>/dev/null || true
    else
      mkfs.ext4 -F -L axon_data "$TARGET_DATA_MAPPER" 2>/dev/null || true
    fi

    DATA_UUID="$(blkid -s UUID -o value "$DATA_DEV" 2>/dev/null || echo "$DATA_DEV")"
    mkdir -p /target/etc
    echo "axon_crypt_data UUID=${DATA_UUID} /etc/axonwall/vault.key luks,discard" >> /target/etc/crypttab

    if [ "$LUKS_TPM2" = "1" ]; then
      echo "[+] Enrolling hardware TPM 2.0 PCR policy for automated unlock..."
      in-target systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=0,2,7 "$DATA_DEV" 2>/dev/null || true
    fi
  fi
elif [ -b "$DATA_DEV" ] && [ "$DATA_DEV" != "$ROOT_A_DEV" ] && [ "$DATA_DEV" != "$ROOT_B_DEV" ]; then
  echo "[+] Setting filesystem label: ${DATA_DEV} -> axon_data"
  if [ "$DATA_FSTYPE" = "xfs" ] && command -v xfs_admin >/dev/null 2>&1; then
    xfs_admin -L axon_data "$DATA_DEV" 2>/dev/null || true
  else
    e2label "$DATA_DEV" axon_data 2>/dev/null || tune2fs -L axon_data "$DATA_DEV" 2>/dev/null || true
  fi
fi

# Seed Cloud-Init configuration into target if present from install media
if [ -f /var/lib/partman/cloud-config.yaml ]; then
  echo "[+] Copying Cloud-Init seed configuration into /target/var/lib/cloud/seed/nocloud-net/..."
  mkdir -p /target/var/lib/cloud/seed/nocloud-net
  cp /var/lib/partman/cloud-config.yaml /target/var/lib/cloud/seed/nocloud-net/user-data
  if [ -f /var/lib/partman/meta-data ]; then
    cp /var/lib/partman/meta-data /target/var/lib/cloud/seed/nocloud-net/meta-data
  else
    echo "instance-id: $(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo "axonwall-01")" > /target/var/lib/cloud/seed/nocloud-net/meta-data
  fi
  if [ -f /var/lib/partman/network-config ]; then
    cp /var/lib/partman/network-config /target/var/lib/cloud/seed/nocloud-net/network-config
  fi
  chmod 0600 /target/var/lib/cloud/seed/nocloud-net/*
fi

# 3. Synchronize Slot A to Slot B for instant standby readiness
# Ensure stable /boot/vmlinuz and /boot/initrd.img symlinks exist on Slot A before replication
if [ -d /target/boot ]; then
  LATEST_A_KERN=$(ls -1t /target/boot/vmlinuz-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_A_KERN" ]; then
    ln -sf "$(basename "$LATEST_A_KERN")" /target/boot/vmlinuz
    ln -sf "boot/$(basename "$LATEST_A_KERN")" /target/vmlinuz 2>/dev/null || true
  fi
  LATEST_A_INITRD=$(ls -1t /target/boot/initrd.img-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_A_INITRD" ]; then
    ln -sf "$(basename "$LATEST_A_INITRD")" /target/boot/initrd.img
    ln -sf "boot/$(basename "$LATEST_A_INITRD")" /target/initrd.img 2>/dev/null || true
  fi
fi

if [ -b "$ROOT_B_DEV" ]; then
  STAGE_B="/tmp/stage_slot_b"
  mkdir -p "$STAGE_B"
  IS_MOUNTED=0

  if mountpoint -q /target/mnt/standby 2>/dev/null; then
    STAGE_B="/target/mnt/standby"
    IS_MOUNTED=1
  else
    mount "$ROOT_B_DEV" "$STAGE_B" 2>/dev/null || true
    if mountpoint -q "$STAGE_B" 2>/dev/null; then
      IS_MOUNTED=2
    fi
  fi

  if [ $IS_MOUNTED -gt 0 ]; then
    echo "[+] Replicating base system from Slot A to Slot B..."
    if command -v rsync >/dev/null 2>&1; then
      rsync -aAX --delete \
        --exclude=/mnt/standby \
        --exclude=/var/lib/axonwall \
        --exclude=/boot/efi/* \
        --exclude=/proc/* \
        --exclude=/sys/* \
        --exclude=/dev/* \
        --exclude=/run/* \
        --exclude=/tmp/* \
        /target/ "$STAGE_B/" 2>/dev/null || true
    else
      tar -C /target --exclude='./dev/*' --exclude='./proc/*' --exclude='./sys/*' --exclude='./tmp/*' --exclude='./run/*' --exclude='./mnt/*' --exclude='./media/*' --exclude='./lost+found' --exclude='./var/lib/axonwall/*' --exclude='./boot/efi/*' -cf - . | tar -C "$STAGE_B" -xf - || true
    fi

    # Configure Slot B's /etc/fstab for independent booting
    if [ -f "$STAGE_B/etc/fstab" ]; then
      sed -i 's/axon_root_a/axon_root_b/g' "$STAGE_B/etc/fstab"
      sed -i '\#/mnt/standby#d' "$STAGE_B/etc/fstab"
      if [ -b "$DATA_DEV" ] && [ "$DATA_DEV" != "$ROOT_A_DEV" ] && ! grep -qE '[[:space:]]/var/lib/axonwall[[:space:]]' "$STAGE_B/etc/fstab"; then
        echo "LABEL=axon_data  /var/lib/axonwall  ${DATA_FSTYPE:-ext4}  defaults,noatime  0  2" >> "$STAGE_B/etc/fstab"
      fi
      if [ "$LOGS_ENABLED" = "1" ] && [ -b "$LOGS_DEV" ] && ! grep -qE '[[:space:]]/var/log[[:space:]]' "$STAGE_B/etc/fstab"; then
        echo "LABEL=axon_logs  /var/log  ${LOGS_FSTYPE:-xfs}  defaults,noatime  0  2" >> "$STAGE_B/etc/fstab"
      fi
      if ! grep -q '/var/lib/axonwall/home' "$STAGE_B/etc/fstab"; then
        echo "/var/lib/axonwall/home  /home  none  bind  0  0" >> "$STAGE_B/etc/fstab"
      fi
      if [ -f /target/etc/crypttab ]; then
        cp /target/etc/crypttab "$STAGE_B/etc/crypttab" 2>/dev/null || true
      fi
      if [ -d /target/var/lib/cloud/seed ]; then
        mkdir -p "$STAGE_B/var/lib/cloud/seed" 2>/dev/null || true
        cp -a /target/var/lib/cloud/seed/. "$STAGE_B/var/lib/cloud/seed/" 2>/dev/null || true
      fi
    fi

    # Ensure stable kernel & initrd symlinks in /boot for GRUB on Slot B
    if [ -d "$STAGE_B/boot" ]; then
      LATEST_B_KERN=$(ls -1t "$STAGE_B/boot"/vmlinuz-* 2>/dev/null | head -n1 || true)
      if [ -n "$LATEST_B_KERN" ]; then
        ln -sf "$(basename "$LATEST_B_KERN")" "$STAGE_B/boot/vmlinuz"
        ln -sf "boot/$(basename "$LATEST_B_KERN")" "$STAGE_B/vmlinuz" 2>/dev/null || true
      fi
      LATEST_B_INITRD=$(ls -1t "$STAGE_B/boot"/initrd.img-* 2>/dev/null | head -n1 || true)
      if [ -n "$LATEST_B_INITRD" ]; then
        ln -sf "$(basename "$LATEST_B_INITRD")" "$STAGE_B/boot/initrd.img"
        ln -sf "boot/$(basename "$LATEST_B_INITRD")" "$STAGE_B/initrd.img" 2>/dev/null || true
      fi
    fi

    # Persist initial per-slot versions
    INSTALL_VER="0.8.13"
    if [ -f /target/etc/axonwall/version ]; then
      INSTALL_VER="$(head -n1 /target/etc/axonwall/version | tr -d '\r\n ')"
    fi
    INIT_SLOT_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s (Factory Standby)",\n  "updatedAt": "%s"\n}\n' "$INSTALL_VER" "$INSTALL_VER" "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")")"
    mkdir -p /target/etc/axonwall /target/var/lib/axonwall "$STAGE_B/etc/axonwall" 2>/dev/null || true
    printf '%s' "$INIT_SLOT_JSON" > /target/etc/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$INIT_SLOT_JSON" > /target/var/lib/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$INIT_SLOT_JSON" > "$STAGE_B/etc/axonwall/slot_versions.json" 2>/dev/null || true

    # Unmount standby staging
    if [ $IS_MOUNTED -eq 1 ]; then
      umount /target/mnt/standby 2>/dev/null || true
    elif [ $IS_MOUNTED -eq 2 ]; then
      umount "$STAGE_B" 2>/dev/null || true
    fi
  fi
fi

# Clean up /mnt/standby mountpoint in Slot A fstab and configure /var/lib/axonwall/home bind-mount
mkdir -p /target/var/lib/axonwall/home /target/var/lib/axonwall/ldap/config /target/var/lib/axonwall/ldap/data /target/var/lib/axonwall/ldap/accesslog /target/var/lib/axonwall/ldap/backups /target/var/lib/axonwall/secrets/ldap /target/var/lib/axonwall/secrets/ha-pki 2>/dev/null || true
if [ -d /target/home ] && [ -n "$(ls -A /target/home 2>/dev/null || true)" ]; then
  cp -a /target/home/. /target/var/lib/axonwall/home/ 2>/dev/null || true
fi
chown 0:0 /target/var/lib/axonwall/home 2>/dev/null || true
chmod 0755 /target/var/lib/axonwall /target/var/lib/axonwall/home 2>/dev/null || true
if [ -f /target/etc/fstab ]; then
  sed -i '\#/mnt/standby#d' /target/etc/fstab
  if [ -b "$DATA_DEV" ] && [ "$DATA_DEV" != "$ROOT_A_DEV" ] && ! grep -qE '[[:space:]]/var/lib/axonwall[[:space:]]' /target/etc/fstab; then
    echo "LABEL=axon_data  /var/lib/axonwall  ${DATA_FSTYPE:-ext4}  defaults,noatime  0  2" >> /target/etc/fstab
  fi
  if [ "$LOGS_ENABLED" = "1" ] && [ -b "$LOGS_DEV" ] && ! grep -qE '[[:space:]]/var/log[[:space:]]' /target/etc/fstab; then
    echo "LABEL=axon_logs  /var/log  ${LOGS_FSTYPE:-xfs}  defaults,noatime  0  2" >> /target/etc/fstab
  fi
  if ! grep -q '/var/lib/axonwall/home' /target/etc/fstab; then
    echo "/var/lib/axonwall/home  /home  none  bind  0  0" >> /target/etc/fstab
  fi
fi

# 4. Multi-Disk System RAID-1 Mirroring & Secondary Disk Partition Cloning
ZFS_VDEVS=""
if [ -b "$ZFS_DEV" ]; then
  ZFS_PART_NUM=$(echo "$ZFS_DEV" | grep -oE '[0-9]+$')
  wipefs -a "$ZFS_DEV" 2>/dev/null || true
  parted -s "$TARGET_DISK" name "$ZFS_PART_NUM" axon_zfs_1 2>/dev/null || true
  sgdisk -c "${ZFS_PART_NUM}:axon_zfs_1" -t "${ZFS_PART_NUM}:bf01" "$TARGET_DISK" 2>/dev/null || true
  ZFS_VDEVS="$ZFS_DEV"
fi

if [ "$SYSTEM_RAID_MODE" = "mirror" ] && [ -n "$SYSTEM_RAID_DISKS" ]; then
  DISK_IDX=1
  ROOT_A_NUM=$(echo "$ROOT_A_DEV" | grep -oE '[0-9]+$')
  ROOT_B_NUM=$(echo "$ROOT_B_DEV" | grep -oE '[0-9]+$')
  DATA_NUM=$(echo "$DATA_DEV" | grep -oE '[0-9]+$')
  EFI_DEV=$(part_dev "$TARGET_DISK" 2)

  for sec_disk in $SYSTEM_RAID_DISKS; do
    if [ "$sec_disk" = "$TARGET_DISK" ] || [ ! -b "$sec_disk" ]; then
      continue
    fi
    DISK_IDX=$(( DISK_IDX + 1 ))
    echo "[+] Cloning GPT partition table from ${TARGET_DISK} to mirror disk ${sec_disk}..."
    if command -v sgdisk >/dev/null 2>&1; then
      sgdisk --replicate="$sec_disk" "$TARGET_DISK" 2>/dev/null || true
      sgdisk -G "$sec_disk" 2>/dev/null || true
    elif command -v sfdisk >/dev/null 2>&1; then
      sfdisk -d "$TARGET_DISK" 2>/dev/null | grep -v '^label-id:' | sfdisk --force "$sec_disk" 2>/dev/null || true
    fi
    partprobe "$sec_disk" 2>/dev/null || true
    sleep 1

    # Clone EFI System Partition & install redundant GRUB bootloader on secondary disk
    SEC_EFI=$(part_dev "$sec_disk" 2)
    if [ -b "$EFI_DEV" ] && [ -b "$SEC_EFI" ]; then
      dd if="$EFI_DEV" of="$SEC_EFI" bs=1M conv=fsync 2>/dev/null || true
    fi
    in-target grub-install --target=i386-pc "$sec_disk" 2>/dev/null || true
    in-target grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --no-nvram 2>/dev/null || true

    # Replicate Slot A & Slot B onto secondary disk or assemble mdadm mirror
    SEC_ROOT_A=$(part_dev "$sec_disk" "$ROOT_A_NUM")
    SEC_ROOT_B=$(part_dev "$sec_disk" "$ROOT_B_NUM")
    SEC_DATA=$(part_dev "$sec_disk" "$DATA_NUM")
    if [ -b "$SEC_ROOT_A" ]; then
      dd if="$ROOT_A_DEV" of="$SEC_ROOT_A" bs=4M conv=fsync 2>/dev/null || true
    fi
    if [ -b "$SEC_ROOT_B" ]; then
      dd if="$ROOT_B_DEV" of="$SEC_ROOT_B" bs=4M conv=fsync 2>/dev/null || true
    fi
    if [ -b "$SEC_DATA" ] && [ "$DATA_DEV" != "$ROOT_A_DEV" ]; then
      dd if="$DATA_DEV" of="$SEC_DATA" bs=4M conv=fsync 2>/dev/null || true
    fi

    # Label ZFS partition on secondary system disk if ZFS allocation is active
    if [ "${ZFS_MB:-0}" -gt 0 ] && [ -n "$ZFS_PART_NUM" ]; then
      SEC_ZFS=$(part_dev "$sec_disk" "$ZFS_PART_NUM")
      if [ -b "$SEC_ZFS" ]; then
        wipefs -a "$SEC_ZFS" 2>/dev/null || true
        parted -s "$sec_disk" name "$ZFS_PART_NUM" "axon_zfs_${DISK_IDX}" 2>/dev/null || true
        sgdisk -c "${ZFS_PART_NUM}:axon_zfs_${DISK_IDX}" -t "${ZFS_PART_NUM}:bf01" "$sec_disk" 2>/dev/null || true
        ZFS_VDEVS="${ZFS_VDEVS} ${SEC_ZFS}"
      fi
    fi
  done
fi

# 5. Add any extra whole ZFS storage disks selected during install
for extra_d in $ZFS_EXTRA_DISKS; do
  if [ -b "$extra_d" ] && [ "$extra_d" != "$TARGET_DISK" ]; then
    wipefs -a "$extra_d" 2>/dev/null || true
    if [ -z "$ZFS_VDEVS" ]; then
      ZFS_VDEVS="$extra_d"
    else
      ZFS_VDEVS="${ZFS_VDEVS} ${extra_d}"
    fi
  fi
done

# 6. Resolve ZFS RAID Topology & Persist / Bootstrap Initial ZFS Pool ('tank')
if [ -n "$ZFS_VDEVS" ]; then
  VDEV_COUNT=$(echo "$ZFS_VDEVS" | wc -w | tr -d ' ')
  RESOLVED_TOPOLOGY="$ZFS_RAID_TOPOLOGY"
  if [ "$RESOLVED_TOPOLOGY" = "auto" ] || [ -z "$RESOLVED_TOPOLOGY" ]; then
    if [ "$VDEV_COUNT" -le 1 ]; then
      RESOLVED_TOPOLOGY="stripe"
    elif [ "$VDEV_COUNT" -eq 2 ]; then
      RESOLVED_TOPOLOGY="mirror"
    elif [ "$VDEV_COUNT" -le 4 ]; then
      RESOLVED_TOPOLOGY="raidz1"
    else
      RESOLVED_TOPOLOGY="raidz2"
    fi
  fi

  # Safety fallback if user picked a parity mode requiring more disks than present
  if [ "$RESOLVED_TOPOLOGY" = "mirror" ] && [ "$VDEV_COUNT" -lt 2 ]; then
    RESOLVED_TOPOLOGY="stripe"
  elif [ "$RESOLVED_TOPOLOGY" = "raidz1" ] && [ "$VDEV_COUNT" -lt 3 ]; then
    RESOLVED_TOPOLOGY=$( [ "$VDEV_COUNT" -eq 2 ] && echo "mirror" || echo "stripe" )
  elif [ "$RESOLVED_TOPOLOGY" = "raidz2" ] && [ "$VDEV_COUNT" -lt 4 ]; then
    RESOLVED_TOPOLOGY=$( [ "$VDEV_COUNT" -ge 3 ] && echo "raidz1" || echo "stripe" )
  elif [ "$RESOLVED_TOPOLOGY" = "raidz3" ] && [ "$VDEV_COUNT" -lt 5 ]; then
    RESOLVED_TOPOLOGY="raidz2"
  fi

  # Construct JSON array of VDEV paths for axonwalld firstboot bootstrap
  JSON_VDEVS=""
  for v in $ZFS_VDEVS; do
    if [ -z "$JSON_VDEVS" ]; then
      JSON_VDEVS="\"${v}\""
    else
      JSON_VDEVS="${JSON_VDEVS}, \"${v}\""
    fi
  done

  mkdir -p /target/var/lib/axonwall
  cat << ZFS_JSON_EOF > /target/var/lib/axonwall/install-zfs.json
{
  "poolName": "tank",
  "topology": "${RESOLVED_TOPOLOGY}",
  "vdevs": [${JSON_VDEVS}],
  "sizeGb": ${ZFS_GB:-0},
  "systemRaidMode": "${SYSTEM_RAID_MODE}",
  "systemRaidDisks": "${SYSTEM_RAID_DISKS:-$TARGET_DISK}",
  "autoCreatePool": true
}
ZFS_JSON_EOF

  echo "[+] Recorded ZFS pool bootstrap specification in /var/lib/axonwall/install-zfs.json (topology=${RESOLVED_TOPOLOGY}, vdevs=${ZFS_VDEVS})"

  # If zpool is already installed in /target, create the pool immediately
  ZPOOL_ARGS=""
  if [ "$RESOLVED_TOPOLOGY" != "stripe" ]; then
    ZPOOL_ARGS="$RESOLVED_TOPOLOGY"
  fi
  in-target zpool create -f \
    -o ashift=12 \
    -o autotrim=on \
    -O compression=lz4 \
    -O acltype=posixacl \
    -O xattr=sa \
    -O normalization=formD \
    -O mountpoint=/mnt/tank \
    tank $ZPOOL_ARGS $ZFS_VDEVS 2>/dev/null || true
fi

# 7. Initialize GRUB environment for A/B boot counting & automated watchdog rollback
mkdir -p /target/boot/grub
in-target grub-editenv /boot/grub/grubenv create 2>/dev/null || true
in-target grub-editenv /boot/grub/grubenv set active_slot=A 2>/dev/null || true
in-target grub-editenv /boot/grub/grubenv set bootcount=0 2>/dev/null || true
in-target grub-editenv /boot/grub/grubenv set bootlimit=3 2>/dev/null || true

# 8. Ensure stable /boot/vmlinuz and /boot/initrd.img symlinks exist on Slot A
if [ -d /target/boot ]; then
  LATEST_A_KERN=$(ls -1t /target/boot/vmlinuz-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_A_KERN" ]; then
    ln -sf "$(basename "$LATEST_A_KERN")" /target/boot/vmlinuz
    ln -sf "boot/$(basename "$LATEST_A_KERN")" /target/vmlinuz 2>/dev/null || true
  fi
  LATEST_A_INITRD=$(ls -1t /target/boot/initrd.img-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_A_INITRD" ]; then
    ln -sf "$(basename "$LATEST_A_INITRD")" /target/boot/initrd.img
    ln -sf "boot/$(basename "$LATEST_A_INITRD")" /target/initrd.img 2>/dev/null || true
  fi
fi

# Ensure kernel-img.conf exists on /target
cat << 'KCONF_EOF' > /target/etc/kernel-img.conf
do_symlinks = yes
link_in_boot = yes
relative_links = yes
KCONF_EOF

# 9. Refresh GRUB configuration
in-target update-grub 2>/dev/null || true

echo "[✓] Axonwall A/B Dual-Root, System RAID & ZFS Setup successfully finished."
