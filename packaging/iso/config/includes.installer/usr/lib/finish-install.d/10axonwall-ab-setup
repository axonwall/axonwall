  rm -rf /target/usr/share/axonwall/k3s
fi

# Persist install-mode BEFORE replicating Slot A -> Slot B so standby Slot B
# carries the exact same install-mode marker on first switch.
mkdir -p /target/etc/axonwall /target/var/lib/axonwall 2>/dev/null || true
echo "${INSTALL_MODE}" > /target/etc/axonwall/install-mode 2>/dev/null || true
echo "${INSTALL_MODE}" > /target/var/lib/axonwall/install-mode 2>/dev/null || true

# 3. Synchronize Slot A to Slot B for instant standby readiness
# Unmount /target/media/cdrom* bind mount now (after pkgsel/grub-installer/10apt-cdrom-setup have finished)
# and populate standard Debian Trixie APT repositories on /target before cloning to Slot B.
while grep -q '/target/media/cdrom' /proc/mounts 2>/dev/null; do
  umount /target/media/cdrom0 2>/dev/null || umount /target/media/cdrom 2>/dev/null || break
done
cat > /target/etc/apt/sources.list << 'APT_EOF'
deb https://deb.debian.org/debian trixie main contrib non-free non-free-firmware
deb https://deb.debian.org/debian-security trixie-security main contrib non-free non-free-firmware
deb https://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware
APT_EOF

# Ensure Axonwall Plymouth graphical boot theme is active in /target initramfs before Slot B / ZBM BE replication
# R4-D-L3: the theme regen only warns loudly (a cosmetic theme miss must
# not fail an otherwise good install), but a failed initramfs regen must
# abort -- it runs right before Slot B / ZBM replication, and a swallowed
# failure would replicate a stale initramfs to the standby slot / BE.
if ! in-target /usr/sbin/plymouth-set-default-theme axonwall >/dev/null 2>&1; then
  echo "[-] WARNING: plymouth-set-default-theme failed; continuing with the default boot theme."
fi
in-target update-initramfs -u -k all >/dev/null 2>&1 || { echo "[-] ERROR: update-initramfs failed before Slot B / ZBM replication; aborting the install rather than replicating a stale initramfs."; exit 1; }

# Ensure stable /boot/vmlinuz and /boot/initrd.img symlinks exist on Slot A before replication
if [ -d /target/boot ]; then
  LATEST_A_KERN=$(ls -1t /target/boot/vmlinuz-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_A_KERN" ]; then
    ln -sf "$(basename "$LATEST_A_KERN")" /target/boot/vmlinuz
    ln -sf "boot/$(basename "$LATEST_A_KERN")" /target/vmlinuz 2>/dev/null || true
  fi
  LATEST_A_INITRD=$(ls -1t /target/boot/initrd.img-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_A_INITRD" ]; then
    ln -sf "$(basename "$LATEST_A_INITRD")" /target/boot/initrd.img
    ln -sf "boot/$(basename "$LATEST_A_INITRD")" /target/initrd.img 2>/dev/null || true
  fi
fi

INSTALL_VER="0.11.32"
if [ -f /target/etc/axonwall/version ]; then
  INSTALL_VER="$(head -n1 /target/etc/axonwall/version | tr -d '\r\n ')"
fi

if [ "$INSTALL_MODE" = "ab" ] && [ -b "$ROOT_B_DEV" ]; then
  STAGE_B="/tmp/stage_slot_b"
  mkdir -p "$STAGE_B"
  IS_MOUNTED=0

  if is_mounted /target/mnt/standby; then
    STAGE_B="/target/mnt/standby"
    IS_MOUNTED=1
  else
    mount "$ROOT_B_DEV" "$STAGE_B" 2>/dev/null || true
    if is_mounted "$STAGE_B"; then
      IS_MOUNTED=2
    fi
  fi

  if [ $IS_MOUNTED -gt 0 ]; then
    echo "[+] Replicating base system from Slot A to Slot B..."
    # D2-M2: track the copy result. The mount-failure case below
    # already records an honest "Missing" state, but a copy failure
    # after a successful mount used to fall through to the
    # "Factory Standby" slot_versions write below.
    SYNC_OK=0
    if command -v rsync >/dev/null 2>&1; then
      if rsync -aAX --delete \
        --exclude=/mnt/standby \
        --exclude=/mnt/tank \
        --exclude=/media/* \
        --exclude=/var/lib/axonwall \
        --exclude=/boot/efi/* \
        --exclude=/proc/* \
        --exclude=/sys/* \
        --exclude=/dev/* \
        --exclude=/run/* \
        --exclude=/tmp/* \
        --exclude=/etc/machine-id \
        --exclude=/etc/ssh/ssh_host_* \
        --exclude=/var/lib/dbus/machine-id \
        --exclude=/var/lib/cloud/data \
        --exclude=/var/lib/cloud/instance \
        --exclude=/var/lib/cloud/instances \
        /target/ "$STAGE_B/" 2>/dev/null; then
        SYNC_OK=1
      fi
    else
      if tar -C /target --exclude='./dev/*' --exclude='./proc/*' --exclude='./sys/*' --exclude='./tmp/*' --exclude='./run/*' --exclude='./mnt/*' --exclude='./media/*' --exclude='./lost+found' --exclude='./var/lib/axonwall/*' --exclude='./boot/efi/*' --exclude='./etc/machine-id' --exclude='./etc/ssh/ssh_host_*' --exclude='./var/lib/dbus/machine-id' --exclude='./var/lib/cloud/data' --exclude='./var/lib/cloud/instance' --exclude='./var/lib/cloud/instances' -cf - . | tar -C "$STAGE_B" -xf -; then
        SYNC_OK=1
      fi
    fi
    # D-M1: sanitize machine identity on the standby copy, exactly as
    # the firstboot clone does, so slot B generates its own machine-id,
    # SSH host keys and cloud-init state on its first boot. (At install
    # time these are usually still empty/absent, so this is normally a
    # no-op safety net.) The cloud-init *seed* is copied separately
    # below and is deliberately not removed here.
    : > "$STAGE_B/etc/machine-id" 2>/dev/null || true
    rm -f "$STAGE_B/var/lib/dbus/machine-id" "$STAGE_B"/etc/ssh/ssh_host_* 2>/dev/null || true
    rm -rf "$STAGE_B/var/lib/cloud/data" "$STAGE_B/var/lib/cloud/instance" "$STAGE_B/var/lib/cloud/instances" 2>/dev/null || true

    # Configure Slot B's /etc/fstab for independent booting
    if [ -f "$STAGE_B/etc/fstab" ]; then
      sed -i -E 's|^[^#[:space:]]+([[:space:]]+/[[:space:]]+)|LABEL=axon_root_b\1|' "$STAGE_B/etc/fstab" 2>/dev/null || true
      sed -i '\#/mnt/standby#d' "$STAGE_B/etc/fstab"
      sed -i '\#/mnt/tank#d' "$STAGE_B/etc/fstab"
      if [ "$LUKS_ENABLED" = "1" ]; then
        sed -i '\#[[:space:]]/var/lib/axonwall[[:space:]]#d' "$STAGE_B/etc/fstab"
      fi
      if [ -b "$DATA_DEV" ] && [ "$DATA_DEV" != "$ROOT_A_DEV" ] && ! grep -qE '[[:space:]]/var/lib/axonwall[[:space:]]' "$STAGE_B/etc/fstab"; then
        echo "LABEL=axon_data  /var/lib/axonwall  ${DATA_FSTYPE:-ext4}  defaults,noatime  0  2" >> "$STAGE_B/etc/fstab"
      fi
      if [ "$LOGS_ENABLED" = "1" ] && [ -b "$LOGS_DEV" ] && ! grep -qE '[[:space:]]/var/log[[:space:]]' "$STAGE_B/etc/fstab"; then
        echo "LABEL=axon_logs  /var/log  ${LOGS_FSTYPE:-xfs}  defaults,noatime  0  2" >> "$STAGE_B/etc/fstab"
      fi
      if ! grep -q '/var/lib/axonwall/home' "$STAGE_B/etc/fstab"; then
        echo "/var/lib/axonwall/home  /home  none  bind  0  0" >> "$STAGE_B/etc/fstab"
      fi
      if [ -f /target/etc/crypttab ]; then
        cp /target/etc/crypttab "$STAGE_B/etc/crypttab" 2>/dev/null || true
      fi
      if [ -d /target/var/lib/cloud/seed ]; then
        mkdir -p "$STAGE_B/var/lib/cloud/seed" 2>/dev/null || true
        cp -a /target/var/lib/cloud/seed/. "$STAGE_B/var/lib/cloud/seed/" 2>/dev/null || true
      fi
    fi

    # Ensure stable kernel & initrd symlinks in /boot for GRUB on Slot B
    if [ -d "$STAGE_B/boot" ]; then
      LATEST_B_KERN=$(ls -1t "$STAGE_B/boot"/vmlinuz-* 2>/dev/null | head -n1 || true)
      if [ -n "$LATEST_B_KERN" ]; then
        ln -sf "$(basename "$LATEST_B_KERN")" "$STAGE_B/boot/vmlinuz"
        ln -sf "boot/$(basename "$LATEST_B_KERN")" "$STAGE_B/vmlinuz" 2>/dev/null || true
      fi
      LATEST_B_INITRD=$(ls -1t "$STAGE_B/boot"/initrd.img-* 2>/dev/null | head -n1 || true)
      if [ -n "$LATEST_B_INITRD" ]; then
        ln -sf "$(basename "$LATEST_B_INITRD")" "$STAGE_B/boot/initrd.img"
        ln -sf "boot/$(basename "$LATEST_B_INITRD")" "$STAGE_B/initrd.img" 2>/dev/null || true
      fi
    fi

    # Persist initial per-slot versions
    if [ "$SYNC_OK" = "1" ]; then
      INIT_SLOT_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s (Factory Standby)",\n  "updatedAt": "%s"\n}\n' "$INSTALL_VER" "$INSTALL_VER" "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")")"
    else
      # D2-M2: the copy failed after a successful mount — record the
      # honest state (mirroring the mount-failure branch below) so
      # the watchdog/UI never believe the partial standby is usable.
      echo "[-] WARNING: A/B install: slot B sync (rsync/tar copy) failed; NO standby system was synced."
      echo "[-] WARNING: this install has no working fallback slot until a successful update populates slot B."
      INIT_SLOT_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s",\n  "updatedAt": "%s"\n}\n' "$INSTALL_VER" "Missing (standby sync failed: slot B copy failed)" "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")")"
    fi
    mkdir -p /target/etc/axonwall /target/var/lib/axonwall "$STAGE_B/etc/axonwall" 2>/dev/null || true
    printf '%s' "$INIT_SLOT_JSON" > /target/etc/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$INIT_SLOT_JSON" > /target/var/lib/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$INIT_SLOT_JSON" > "$STAGE_B/etc/axonwall/slot_versions.json" 2>/dev/null || true

    # Unmount standby staging
    if [ $IS_MOUNTED -eq 1 ]; then
      umount /target/mnt/standby 2>/dev/null || true
      rmdir /target/mnt/standby 2>/dev/null || true
    elif [ $IS_MOUNTED -eq 2 ]; then
      umount "$STAGE_B" 2>/dev/null || true
    fi

    # Ensure filesystem label axon_root_b is set after unmounting
    if [ "$ROOT_FSTYPE" = "xfs" ] && command -v xfs_admin >/dev/null 2>&1; then
      xfs_admin -L axon_root_b "$ROOT_B_DEV" 2>/dev/null || true
    else
      e2label "$ROOT_B_DEV" axon_root_b 2>/dev/null || tune2fs -L axon_root_b "$ROOT_B_DEV" 2>/dev/null || true
    fi
  else
    # Slot B exists but could not be mounted: the old code silently
    # skipped the sync AND wrote no slot_versions at all, leaving an
    # empty formatted standby nobody knew about. Warn loudly and record
    # the honest state, so the watchdog/UI never believe B is usable.
    echo "[-] WARNING: A/B install: slot B (${ROOT_B_DEV}) could not be mounted; NO standby system was synced."
    echo "[-] WARNING: this install has no working fallback slot until a successful update populates slot B."
    INIT_SLOT_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s",\n  "updatedAt": "%s"\n}\n' "$INSTALL_VER" "Missing (standby sync failed: slot B unmountable)" "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")")"
    mkdir -p /target/etc/axonwall /target/var/lib/axonwall 2>/dev/null || true
    printf '%s' "$INIT_SLOT_JSON" > /target/etc/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$INIT_SLOT_JSON" > /target/var/lib/axonwall/slot_versions.json 2>/dev/null || true
  fi
else
  SLOT_B_DESC="Rolling (Single-Root)"
  if [ "$INSTALL_MODE" = "zbm" ]; then
    SLOT_B_DESC="axonwall-${INSTALL_VER}@factory-initial"
  elif [ "$INSTALL_MODE" = "ab" ]; then
    # A/B mode with no slot-B block device (e.g. manual partitioning
    # without the axon_root_b label): never claim "Rolling" for an A/B
    # install -- install-mode still says ab, and the watchdog/UI would
    # disagree about the layout. Warn loudly and record the honest state.
    echo "[-] WARNING: A/B install: no slot B device found; NO standby system was synced."
    echo "[-] WARNING: this install has no working fallback slot until a successful update populates slot B."
    SLOT_B_DESC="Missing (no standby slot)"
  fi
  INIT_SLOT_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s",\n  "updatedAt": "%s"\n}\n' "$INSTALL_VER" "$SLOT_B_DESC" "$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")")"
  mkdir -p /target/etc/axonwall /target/var/lib/axonwall 2>/dev/null || true
  printf '%s' "$INIT_SLOT_JSON" > /target/etc/axonwall/slot_versions.json 2>/dev/null || true
  printf '%s' "$INIT_SLOT_JSON" > /target/var/lib/axonwall/slot_versions.json 2>/dev/null || true
fi

# Clean up /mnt/standby and /mnt/tank mountpoints in fstab and configure /var/lib/axonwall/home bind-mount (A/B mode only)
mkdir -p /target/etc/axonwall /target/var/lib/axonwall/home /target/var/lib/axonwall/ldap/config /target/var/lib/axonwall/ldap/data /target/var/lib/axonwall/ldap/accesslog /target/var/lib/axonwall/ldap/backups /target/var/lib/axonwall/secrets/ldap /target/var/lib/axonwall/secrets/ha-pki 2>/dev/null || true
echo "${INSTALL_MODE}" > /target/etc/axonwall/install-mode 2>/dev/null || true
echo "${INSTALL_MODE}" > /target/var/lib/axonwall/install-mode 2>/dev/null || true

if [ "$INSTALL_MODE" = "ab" ] || [ "$INSTALL_MODE" = "zbm" ]; then
  if [ -d /target/home ] && [ -n "$(ls -A /target/home 2>/dev/null || true)" ]; then
    cp -a /target/home/. /target/var/lib/axonwall/home/ 2>/dev/null || true
  fi
fi
chown 0:0 /target/var/lib/axonwall/home 2>/dev/null || true
chmod 0755 /target/var/lib/axonwall /target/var/lib/axonwall/home 2>/dev/null || true
if [ -f /target/etc/fstab ]; then
  sed -i '\#/mnt/standby#d' /target/etc/fstab 2>/dev/null || true
  sed -i '\#/mnt/tank#d' /target/etc/fstab 2>/dev/null || true
  if [ "$INSTALL_MODE" = "zbm" ]; then
    if [ "$LUKS_ENABLED" = "1" ] && grep -qE '[[:space:]]/var/lib/axonwall[[:space:]]' /target/etc/fstab 2>/dev/null; then
      _zbm_data_line="$(grep -E '[[:space:]]/var/lib/axonwall[[:space:]]' /target/etc/fstab | head -n1)"
    elif [ "$LUKS_ENABLED" = "1" ]; then
      _zbm_data_line="/dev/mapper/axon_crypt_data /var/lib/axonwall   ${DATA_FSTYPE:-ext4}    defaults,noatime        0 2"
    else
      _zbm_data_line="zroot/data/axonwall /var/lib/axonwall   zfs     defaults,noatime        0 0"
    fi
    _zbm_log_line=""
    if [ "$LOGS_ENABLED" = "1" ] && [ "${LOGS_GB:-0}" -gt 0 ]; then
      _zbm_log_line="zroot/var-log       /var/log            zfs     defaults,noatime        0 0"
    elif [ "$LOGS_ENABLED" = "1" ] && [ -b "${LOGS_DEV:-}" ]; then
      _zbm_log_line="LABEL=axon_logs     /var/log            ${LOGS_FSTYPE:-xfs}  defaults,noatime  0 2"
    fi
    cat << FSTAB_EOF > /target/etc/fstab
# /etc/fstab: ZFSBootMenu Root-on-ZFS (/ is mounted automatically from BE)
LABEL=AXON_EFI      /boot/efi           vfat    umask=0077              0 2
${_zbm_data_line}
/var/lib/axonwall/home /home            none    bind,nofail             0 0
tmpfs               /tmp                tmpfs   nosuid,nodev            0 0
FSTAB_EOF
    [ -n "$_zbm_log_line" ] && echo "$_zbm_log_line" >> /target/etc/fstab
  elif [ "$INSTALL_MODE" = "rolling" ]; then
    sed -i -E 's|^[^#[:space:]]+([[:space:]]+/[[:space:]]+)|LABEL=axon_root\1|' /target/etc/fstab 2>/dev/null || true
    if [ "$LOGS_ENABLED" = "1" ] && [ -b "$LOGS_DEV" ] && ! grep -qE '[[:space:]]/var/log[[:space:]]' /target/etc/fstab; then
      echo "LABEL=axon_logs  /var/log  ${LOGS_FSTYPE:-xfs}  defaults,noatime  0  2" >> /target/etc/fstab
    fi
  else
    sed -i -E 's|^[^#[:space:]]+([[:space:]]+/[[:space:]]+)|LABEL=axon_root_a\1|' /target/etc/fstab 2>/dev/null || true
    if [ "$LUKS_ENABLED" = "1" ]; then
      sed -i '\#[[:space:]]/var/lib/axonwall[[:space:]]#d' /target/etc/fstab
    fi
    if [ -b "$DATA_DEV" ] && [ "$DATA_DEV" != "$ROOT_A_DEV" ] && ! grep -qE '[[:space:]]/var/lib/axonwall[[:space:]]' /target/etc/fstab; then
      echo "LABEL=axon_data  /var/lib/axonwall  ${DATA_FSTYPE:-ext4}  defaults,noatime  0  2" >> /target/etc/fstab
    fi
    if [ "$LOGS_ENABLED" = "1" ] && [ -b "$LOGS_DEV" ] && ! grep -qE '[[:space:]]/var/log[[:space:]]' /target/etc/fstab; then
      echo "LABEL=axon_logs  /var/log  ${LOGS_FSTYPE:-xfs}  defaults,noatime  0  2" >> /target/etc/fstab
    fi
    if ! grep -q '/var/lib/axonwall/home' /target/etc/fstab; then
      echo "/var/lib/axonwall/home  /home  none  bind  0  0" >> /target/etc/fstab
    fi
  fi
fi

# 4. Multi-Disk System RAID-1 Mirroring & Secondary Disk Partition Cloning
ZFS_VDEVS=""
if [ -b "$ZFS_DEV" ]; then
  ZFS_PART_NUM=$(echo "$ZFS_DEV" | grep -oE '[0-9]+$')
  wipefs -a "$ZFS_DEV" 2>/dev/null || true
  sgdisk -c "${ZFS_PART_NUM}:axon_zfs_1" -t "${ZFS_PART_NUM}:bf01" "$TARGET_DISK" 2>/dev/null || true
  ZFS_VDEVS="$ZFS_DEV"
fi

if [ "$SYSTEM_RAID_MODE" = "mirror" ] && [ -n "$SYSTEM_RAID_DISKS" ]; then
  DISK_IDX=1
  ROOT_A_NUM=$(echo "$ROOT_A_DEV" | grep -oE '[0-9]+$')
  ROOT_B_NUM=$(echo "$ROOT_B_DEV" | grep -oE '[0-9]+$')
  DATA_NUM=$(echo "$DATA_DEV" | grep -oE '[0-9]+$')
  EFI_DEV=$(part_dev "$TARGET_DISK" 2)

  for sec_disk in $SYSTEM_RAID_DISKS; do
    if [ "$sec_disk" = "$TARGET_DISK" ] || [ ! -b "$sec_disk" ]; then
      continue
    fi
    DISK_IDX=$(( DISK_IDX + 1 ))
    echo "[+] Cloning GPT partition table from ${TARGET_DISK} to mirror disk ${sec_disk}..."
    if command -v sgdisk >/dev/null 2>&1; then
      sgdisk --replicate="$sec_disk" "$TARGET_DISK" 2>/dev/null || true
      sgdisk -G "$sec_disk" 2>/dev/null || true
    elif command -v sfdisk >/dev/null 2>&1; then
      sfdisk -d "$TARGET_DISK" 2>/dev/null | grep -v '^label-id:' | sfdisk --force "$sec_disk" 2>/dev/null || true
    fi
    partprobe "$sec_disk" 2>/dev/null || true
    sleep 1

    # Clone EFI System Partition & install redundant GRUB bootloader on secondary disk
    # D-M12: a failed secondary-disk install used to be swallowed, silently
    # losing boot redundancy (the box still boots from disk 1 until disk 1
    # fails). Fail the install loudly instead -- this hook runs under
    # `set -e`, so a failure aborts here with the error visible.
    SEC_EFI=$(part_dev "$sec_disk" 2)
    if [ -b "$EFI_DEV" ] && [ -b "$SEC_EFI" ]; then
      dd if="$EFI_DEV" of="$SEC_EFI" bs=1M conv=fsync
    fi
    if [ "$INSTALL_MODE" != "zbm" ]; then
      if [ -d /target/usr/lib/grub/i386-pc ]; then
        in-target grub-install --target=i386-pc "$sec_disk"
      fi
      if [ -d /target/usr/lib/grub/x86_64-efi ]; then
        in-target grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --no-nvram
      fi
    fi

    # Replicate Slot A & Slot B onto secondary disk or assemble mdadm mirror
    SEC_ROOT_A=""
    SEC_ROOT_B=""
    SEC_DATA=""
    [ -n "${ROOT_A_NUM:-}" ] && SEC_ROOT_A=$(part_dev "$sec_disk" "$ROOT_A_NUM")
    [ -n "${ROOT_B_NUM:-}" ] && SEC_ROOT_B=$(part_dev "$sec_disk" "$ROOT_B_NUM")
    [ -n "${DATA_NUM:-}" ] && SEC_DATA=$(part_dev "$sec_disk" "$DATA_NUM")
    if [ -n "$SEC_ROOT_A" ] && [ -b "$SEC_ROOT_A" ]; then
      dd if="$ROOT_A_DEV" of="$SEC_ROOT_A" bs=4M conv=fsync 2>/dev/null || true
      e2label "$SEC_ROOT_A" "axon_root_a_m${DISK_IDX}" 2>/dev/null || xfs_admin -L "axon_root_a_m${DISK_IDX}" "$SEC_ROOT_A" 2>/dev/null || true
    fi
    if [ -n "$SEC_ROOT_B" ] && [ -b "$SEC_ROOT_B" ]; then
      dd if="$ROOT_B_DEV" of="$SEC_ROOT_B" bs=4M conv=fsync 2>/dev/null || true
      e2label "$SEC_ROOT_B" "axon_root_b_m${DISK_IDX}" 2>/dev/null || xfs_admin -L "axon_root_b_m${DISK_IDX}" "$SEC_ROOT_B" 2>/dev/null || true
    fi
    if [ -n "$SEC_DATA" ] && [ -b "$SEC_DATA" ] && [ "$DATA_DEV" != "$ROOT_A_DEV" ]; then
      dd if="$DATA_DEV" of="$SEC_DATA" bs=4M conv=fsync 2>/dev/null || true
      e2label "$SEC_DATA" "axon_data_m${DISK_IDX}" 2>/dev/null || xfs_admin -L "axon_data_m${DISK_IDX}" "$SEC_DATA" 2>/dev/null || true
    fi

    # Label ZFS partition on secondary system disk if ZFS allocation is active
    if [ "${ZFS_MB:-0}" -gt 0 ] && [ -n "$ZFS_PART_NUM" ]; then
      SEC_ZFS=$(part_dev "$sec_disk" "$ZFS_PART_NUM")
      if [ -b "$SEC_ZFS" ]; then
        wipefs -a "$SEC_ZFS" 2>/dev/null || true
        sgdisk -c "${ZFS_PART_NUM}:axon_zfs_${DISK_IDX}" -t "${ZFS_PART_NUM}:bf01" "$sec_disk" 2>/dev/null || true
        ZFS_VDEVS="${ZFS_VDEVS} ${SEC_ZFS}"
      fi
    fi
  done
fi

# 5. Add any extra whole ZFS storage disks selected during install
if [ "${ZFS_TANK_DISKS:-}" = "auto" ] && [ -z "$ZFS_EXTRA_DISKS" ]; then
  for cand_d in /dev/sd[a-z] /dev/vd[a-z] /dev/nvme[0-9]n[1-9]; do
    [ -b "$cand_d" ] || continue
    [ "$cand_d" = "$TARGET_DISK" ] && continue
    echo " ${SYSTEM_RAID_DISKS:-} " | grep -q " ${cand_d} " && continue
    grep -q "^${cand_d}" /proc/mounts 2>/dev/null && continue
    ZFS_EXTRA_DISKS="${ZFS_EXTRA_DISKS} ${cand_d}"
  done
fi
for extra_d in $ZFS_EXTRA_DISKS; do
  if [ -b "$extra_d" ] && [ "$extra_d" != "$TARGET_DISK" ]; then
    wipefs -a "$extra_d" 2>/dev/null || true
    if [ -z "$ZFS_VDEVS" ]; then
      ZFS_VDEVS="$extra_d"
    else
      ZFS_VDEVS="${ZFS_VDEVS} ${extra_d}"
    fi
  fi
done

# 6. Prepare ZFSBootMenu assets on /target BEFORE cloning into $INIT_BE, then bootstrap ZFS pool ('zroot' in ZBM mode, 'tank' otherwise)
if [ "$INSTALL_MODE" = "zbm" ]; then
  echo "[+] Preparing ZFSBootMenu v3.1.0 Root-on-ZFS hooks, tools & bootloader on /target before BE clone..."
  mkdir -p /target/etc/zfs
  printf '\x0c\xb1\xba\x00' > /target/etc/hostid
  printf '\x0c\xb1\xba\x00' > /etc/hostid
  cat << 'KCONF_EOF' > /target/etc/kernel-img.conf
do_symlinks = yes
link_in_boot = yes
relative_links = yes
KCONF_EOF
  rm -rf /target/boot/grub /target/boot/efi/EFI/debian /target/boot/efi/EFI/grub /target/etc/grub.d/40_axonwall_ab 2>/dev/null || true
  mkdir -p /target/boot/efi/EFI/ZBM /target/boot/efi/EFI/BOOT /target/etc/zfsbootmenu/dracut.conf.d \
           /target/etc/zfsbootmenu/hooks/early-setup.d /target/etc/zfsbootmenu/hooks/setup.d \
           /target/boot/efi/EFI/ZBM/hooks/early-setup.d /target/boot/efi/EFI/ZBM/hooks/setup.d

  SPLASH_BMP="splash.bmp"
  if [ "${INSTALL_EDITION:-axonwall}" = "vault" ] || [ -f /target/etc/axonwall/.vault-edition ]; then
    SPLASH_BMP="splash-vault.bmp"
  fi
  for bcand in \
    "/etc/zfsbootmenu/${SPLASH_BMP}" \
    "/etc/axonwall/branding/${SPLASH_BMP}" \
    "/target/etc/zfsbootmenu/${SPLASH_BMP}" \
    "/target/etc/axonwall/branding/${SPLASH_BMP}" \
    "/etc/zfsbootmenu/splash.bmp" \
    "/etc/axonwall/branding/splash.bmp"; do
    if [ -f "$bcand" ]; then
      cp -f "$bcand" /target/etc/zfsbootmenu/splash.bmp 2>/dev/null || true
      cp -f "$bcand" /target/boot/efi/EFI/ZBM/splash.bmp 2>/dev/null || true
      break
    fi
  done

  for f_cfg in /etc/zfsbootmenu/config.yaml /target/etc/zfsbootmenu/config.yaml; do
    if [ -f "$f_cfg" ]; then
      cp -f "$f_cfg" /target/etc/zfsbootmenu/config.yaml
      break
    fi
  done
  for f_col in /etc/zfsbootmenu/dracut.conf.d/colors.conf /target/etc/zfsbootmenu/dracut.conf.d/colors.conf; do
    if [ -f "$f_col" ]; then
      cp -f "$f_col" /target/etc/zfsbootmenu/dracut.conf.d/colors.conf
      break
    fi
  done

  for f_th in /etc/zfsbootmenu/hooks/early-setup.d/90-axonwall-theme.sh /etc/zfsbootmenu/hooks/early-setup.d/15-axonwall-theme.sh /target/etc/zfsbootmenu/hooks/early-setup.d/90-axonwall-theme.sh /target/etc/zfsbootmenu/hooks/early-setup.d/15-axonwall-theme.sh; do
    if [ -f "$f_th" ]; then
      cp -f "$f_th" /target/etc/zfsbootmenu/hooks/early-setup.d/15-axonwall-theme.sh
      cp -f "$f_th" /target/etc/zfsbootmenu/hooks/early-setup.d/90-axonwall-theme.sh
      cp -f "$f_th" /target/boot/efi/EFI/ZBM/hooks/early-setup.d/15-axonwall-theme.sh
      cp -f "$f_th" /target/boot/efi/EFI/ZBM/hooks/early-setup.d/90-axonwall-theme.sh
      chmod +x /target/etc/zfsbootmenu/hooks/early-setup.d/*.sh /target/boot/efi/EFI/ZBM/hooks/early-setup.d/*.sh 2>/dev/null || true
      break
    fi
  done
  for f_wd in /etc/zfsbootmenu/hooks/setup.d/20-axonwall-watchdog.sh /target/etc/zfsbootmenu/hooks/setup.d/20-axonwall-watchdog.sh; do
    if [ -f "$f_wd" ]; then
      cp -f "$f_wd" /target/etc/zfsbootmenu/hooks/setup.d/20-axonwall-watchdog.sh
      cp -f "$f_wd" /target/boot/efi/EFI/ZBM/hooks/setup.d/20-axonwall-watchdog.sh
      chmod +x /target/etc/zfsbootmenu/hooks/setup.d/20-axonwall-watchdog.sh /target/boot/efi/EFI/ZBM/hooks/setup.d/20-axonwall-watchdog.sh 2>/dev/null || true
      break
    fi
  done

  mkdir -p /target/usr/local/bin /target/usr/lib/axonwall
  if [ -f /usr/local/bin/axonwall-zbm-theme ]; then
    cp -f /usr/local/bin/axonwall-zbm-theme /target/usr/local/bin/
    chmod +x /target/usr/local/bin/axonwall-zbm-theme
  fi
  if [ -x /target/usr/local/bin/axonwall-zbm-theme ]; then
    ln -sf axonwall-zbm-theme /target/usr/local/bin/generate-zbm
    ln -sf axonwall-zbm-theme /target/usr/local/bin/zbm-kcl
  fi
  [ -f /usr/lib/axonwall/theme-zbm-uki.py ] && cp -f /usr/lib/axonwall/theme-zbm-uki.py /target/usr/lib/axonwall/ && chmod +x /target/usr/lib/axonwall/theme-zbm-uki.py

  if [ -f /target/usr/lib/zfsbootmenu/vmlinuz.efi ]; then
    THEMED_DONE=0
    if [ -f /target/usr/lib/axonwall/theme-zbm-uki.py ] && [ -f /target/etc/zfsbootmenu/splash.bmp ] && in-target sh -c 'command -v python3 >/dev/null 2>&1'; then
      if in-target python3 /usr/lib/axonwall/theme-zbm-uki.py /usr/lib/zfsbootmenu/vmlinuz.efi \
        -o /boot/efi/EFI/ZBM/VMLINUZ.EFI \
        -s /etc/zfsbootmenu/splash.bmp \
        --extract-linux /boot/efi/EFI/ZBM/vmlinuz-bootmenu \
        --extract-initrd /boot/efi/EFI/ZBM/initramfs-bootmenu.img 2>/dev/null; then
        THEMED_DONE=1
      fi
    elif command -v python3 >/dev/null 2>&1 && [ -x /usr/lib/axonwall/theme-zbm-uki.py ] && [ -f /target/etc/zfsbootmenu/splash.bmp ]; then
      if python3 /usr/lib/axonwall/theme-zbm-uki.py /target/usr/lib/zfsbootmenu/vmlinuz.efi \
        -o /target/boot/efi/EFI/ZBM/VMLINUZ.EFI \
        -s /target/etc/zfsbootmenu/splash.bmp \
        --extract-linux /target/boot/efi/EFI/ZBM/vmlinuz-bootmenu \
        --extract-initrd /target/boot/efi/EFI/ZBM/initramfs-bootmenu.img 2>/dev/null; then
        THEMED_DONE=1
      fi
    fi
    if [ "$THEMED_DONE" = "0" ]; then
      cp -f /target/usr/lib/zfsbootmenu/vmlinuz.efi /target/boot/efi/EFI/ZBM/VMLINUZ.EFI 2>/dev/null || true
    fi
    cp -f /target/boot/efi/EFI/ZBM/VMLINUZ.EFI /target/boot/efi/EFI/ZBM/VMLINUZ-BACKUP.EFI 2>/dev/null || true
    cp -f /target/boot/efi/EFI/ZBM/VMLINUZ.EFI /target/boot/efi/EFI/BOOT/BOOTX64.EFI 2>/dev/null || true

    cat << 'ZBM_SYSLINUX_EOF' > /target/boot/efi/EFI/ZBM/syslinux.cfg
SERIAL 0 9600
DEFAULT zbm
PROMPT 0
TIMEOUT 5

LABEL zbm
  LINUX /EFI/ZBM/vmlinuz-bootmenu
  INITRD /EFI/ZBM/initramfs-bootmenu.img
  APPEND zfsbootmenu quiet loglevel=3 net.ifnames=0 zbm.timeout=5 zbm.autosize=1 zbm.hookroot=LABEL=AXON_EFI//EFI/ZBM/hooks console=ttyS0,9600 console=tty1

LABEL zbm_backup
  LINUX /EFI/ZBM/vmlinuz-bootmenu
  INITRD /EFI/ZBM/initramfs-bootmenu.img
  APPEND zfsbootmenu zbm.force_import=1 loglevel=3 net.ifnames=0 zbm.timeout=5 zbm.autosize=1 zbm.hookroot=LABEL=AXON_EFI//EFI/ZBM/hooks console=ttyS0,9600 console=tty1
ZBM_SYSLINUX_EOF
    cp -f /target/boot/efi/EFI/ZBM/syslinux.cfg /target/boot/efi/syslinux.cfg 2>/dev/null || true

    EFI_DEV="$(awk '$2 == "/target/boot/efi" {print $1; exit}' /proc/mounts 2>/dev/null || true)"
    [ -z "$EFI_DEV" ] && EFI_DEV="/dev/disk/by-label/AXON_EFI"
    [ -e "$EFI_DEV" ] && EFI_DEV="$(readlink -f "$EFI_DEV" 2>/dev/null || echo "$EFI_DEV")"
    EFI_DISK=""
    EFI_PART_NUM="1"
    case "$EFI_DEV" in
      /dev/nvme*n*p[0-9]*|/dev/mmcblk*p[0-9]*|/dev/loop*p[0-9]*|/dev/nbd*p[0-9]*|/dev/md*p[0-9]*)
        EFI_DISK="$(printf '%s' "$EFI_DEV" | sed -E 's/p([0-9]+)$//')"
        EFI_PART_NUM="$(printf '%s' "$EFI_DEV" | sed -E 's/^.*p([0-9]+)$/\1/')"
        ;;
      /dev/*[0-9])
        EFI_DISK="$(printf '%s' "$EFI_DEV" | sed -E 's/[0-9]+$//')"
        EFI_PART_NUM="$(printf '%s' "$EFI_DEV" | sed -E 's/^.*[^0-9]([0-9]+)$/\1/')"
        ;;
    esac
    if in-target sh -c 'command -v extlinux >/dev/null 2>&1'; then
      in-target extlinux --install /boot/efi/EFI/ZBM 2>/dev/null || in-target extlinux --install /boot/efi 2>/dev/null || true
    fi
    GPTMBR_BIN=""
    for mbr_cand in \
      /target/usr/lib/SYSLINUX/gptmbr.bin \
      /target/usr/lib/syslinux/mbr/gptmbr.bin \
      /target/usr/share/syslinux/gptmbr.bin \
      /usr/lib/SYSLINUX/gptmbr.bin \
      /usr/lib/syslinux/mbr/gptmbr.bin \
      /usr/share/syslinux/gptmbr.bin; do
      if [ -f "$mbr_cand" ]; then
        GPTMBR_BIN="$mbr_cand"
        break
      fi
    done
    if [ -n "$EFI_DISK" ] && [ -b "$EFI_DISK" ]; then
      if [ -n "$GPTMBR_BIN" ]; then
        dd if="$GPTMBR_BIN" of="$EFI_DISK" bs=440 count=1 conv=notrunc 2>/dev/null || true
      fi
      in-target sgdisk --attributes="${EFI_PART_NUM}:set:2" "$EFI_DISK" >/dev/null 2>&1 || true
      if [ -d /sys/firmware/efi/efivars ] && in-target sh -c 'command -v efibootmgr >/dev/null 2>&1'; then
        in-target efibootmgr -c -d "$EFI_DISK" -p "$EFI_PART_NUM" -L "Axonwall ZFSBootMenu" -l '\EFI\ZBM\VMLINUZ.EFI' 2>/dev/null || true
      fi
    fi
    if [ "$SYSTEM_RAID_MODE" = "mirror" ] && [ -n "$SYSTEM_RAID_DISKS" ]; then
      for sec_disk in $SYSTEM_RAID_DISKS; do
        [ "$sec_disk" = "$TARGET_DISK" ] || [ ! -b "$sec_disk" ] && continue
        SEC_EFI=$(part_dev "$sec_disk" 2)
        if [ -b "$SEC_EFI" ]; then
          _sec_mnt="/tmp/zbm_sec_efi"
          mkdir -p "$_sec_mnt"
          if mount "$SEC_EFI" "$_sec_mnt" 2>/dev/null; then
            cp -rf /target/boot/efi/EFI "$_sec_mnt/" 2>/dev/null || true
            cp -f /target/boot/efi/syslinux.cfg "$_sec_mnt/syslinux.cfg" 2>/dev/null || true
            sync
            umount "$_sec_mnt" 2>/dev/null || true
          fi
          rmdir "$_sec_mnt" 2>/dev/null || true
        fi
        if [ -n "$GPTMBR_BIN" ]; then
          dd if="$GPTMBR_BIN" of="$sec_disk" bs=440 count=1 conv=notrunc 2>/dev/null || true
        fi
        in-target sgdisk --attributes="2:set:2" "$sec_disk" >/dev/null 2>&1 || true
      done
    fi
  fi
fi

# 6b. Resolve ZFS RAID Topology & Persist / Bootstrap Initial ZFS Pool ('zroot' in ZBM mode, 'tank' otherwise)
if [ -n "$ZFS_VDEVS" ]; then
  VDEV_COUNT=$(echo "$ZFS_VDEVS" | wc -w | tr -d ' ')
  RESOLVED_TOPOLOGY="$ZFS_RAID_TOPOLOGY"
  if [ "$RESOLVED_TOPOLOGY" = "auto" ] || [ -z "$RESOLVED_TOPOLOGY" ]; then
    if [ "$VDEV_COUNT" -le 1 ]; then
      RESOLVED_TOPOLOGY="stripe"
    elif [ "$VDEV_COUNT" -eq 2 ]; then
      RESOLVED_TOPOLOGY="mirror"
    elif [ "$VDEV_COUNT" -le 4 ]; then
      RESOLVED_TOPOLOGY="raidz1"
    else
      RESOLVED_TOPOLOGY="raidz2"
    fi
  fi

  # Safety fallback if user picked a parity mode requiring more disks than present
  if [ "$RESOLVED_TOPOLOGY" = "mirror" ] && [ "$VDEV_COUNT" -lt 2 ]; then
    RESOLVED_TOPOLOGY="stripe"
  elif [ "$RESOLVED_TOPOLOGY" = "raidz1" ] && [ "$VDEV_COUNT" -lt 3 ]; then
    RESOLVED_TOPOLOGY=$( [ "$VDEV_COUNT" -eq 2 ] && echo "mirror" || echo "stripe" )
  elif [ "$RESOLVED_TOPOLOGY" = "raidz2" ] && [ "$VDEV_COUNT" -lt 4 ]; then
    RESOLVED_TOPOLOGY=$( [ "$VDEV_COUNT" -ge 3 ] && echo "raidz1" || echo "stripe" )
  elif [ "$RESOLVED_TOPOLOGY" = "raidz3" ] && [ "$VDEV_COUNT" -lt 5 ]; then
    # Cascade through the same count checks the other fallbacks use,
    # instead of blindly emitting raidz2: raidz2 needs >= 4 disks,
    # raidz1 >= 3, mirror 2, else stripe. (The old code emitted raidz2
    # for a 2-disk raidz3, which zpool cannot create, so the pool
    # silently never existed.)
    if [ "$VDEV_COUNT" -ge 4 ]; then
      RESOLVED_TOPOLOGY="raidz2"
    elif [ "$VDEV_COUNT" -eq 3 ]; then
      RESOLVED_TOPOLOGY="raidz1"
    elif [ "$VDEV_COUNT" -eq 2 ]; then
      RESOLVED_TOPOLOGY="mirror"
    else
      RESOLVED_TOPOLOGY="stripe"
    fi
  fi

  # Construct JSON array of VDEV paths for axonwalld & axonwall-firstboot bootstrap
  JSON_VDEVS=""
  for v in $ZFS_VDEVS; do
    if [ -z "$JSON_VDEVS" ]; then
      JSON_VDEVS="\"${v}\""
    else
      JSON_VDEVS="${JSON_VDEVS}, \"${v}\""
    fi
  done

  TARGET_POOL_NAME="tank"
  if [ "$INSTALL_MODE" = "zbm" ]; then
    TARGET_POOL_NAME="zroot"
  fi

  mkdir -p /target/var/lib/axonwall
  cat << ZFS_JSON_EOF > /target/var/lib/axonwall/install-zfs.json
{
  "poolName": "${TARGET_POOL_NAME}",
  "installMode": "${INSTALL_MODE}",
  "topology": "${RESOLVED_TOPOLOGY}",
  "vdevs": [${JSON_VDEVS}],
  "sizeGb": ${ZFS_GB:-0},
  "systemRaidMode": "${SYSTEM_RAID_MODE}",
  "systemRaidDisks": "${SYSTEM_RAID_DISKS:-$TARGET_DISK}",
  "autoCreatePool": true
}
ZFS_JSON_EOF

  echo "[+] Recorded ZFS pool bootstrap specification in /var/lib/axonwall/install-zfs.json (pool=${TARGET_POOL_NAME}, topology=${RESOLVED_TOPOLOGY}, vdevs=${ZFS_VDEVS})"

  # If zpool & zfs kernel module are available now, create the pool immediately (otherwise axonwall-firstboot / axonwalld creates it on first boot)
  ZPOOL_ARGS=""
  if [ "$RESOLVED_TOPOLOGY" != "stripe" ]; then
    ZPOOL_ARGS="$RESOLVED_TOPOLOGY"
  fi
  if [ "$INSTALL_MODE" = "zbm" ]; then
    modprobe zfs 2>/dev/null || true
    if in-target zpool create -f \
      -o ashift=12 \
      -o autotrim=on \
      -O compression=lz4 \
      -O acltype=posixacl \
      -O xattr=sa \
      -O normalization=formD \
      -O canmount=off \
      -O mountpoint=none \
      zroot $ZPOOL_ARGS $ZFS_VDEVS 2>/dev/null; then
      INIT_BE="zroot/ROOT/axonwall-${INSTALL_VER}"
      in-target zfs create -o canmount=off -o mountpoint=none zroot/ROOT 2>/dev/null || true
      in-target zfs create -o canmount=noauto -o mountpoint=/ "$INIT_BE" 2>/dev/null || true
      in-target zfs create -o mountpoint=/mnt/tank zroot/tank 2>/dev/null || true
      if [ "$LUKS_ENABLED" != "1" ]; then
        in-target zfs create -o canmount=off -o mountpoint=none zroot/data 2>/dev/null || true
        in-target zfs create -o mountpoint=legacy zroot/data/axonwall 2>/dev/null || true
        mkdir -p /mnt/zbm_data 2>/dev/null || true
        if mount -t zfs zroot/data/axonwall /mnt/zbm_data 2>/dev/null; then
          cp -a /target/var/lib/axonwall/. /mnt/zbm_data/ 2>/dev/null || true
          chmod 3775 /mnt/zbm_data 2>/dev/null || true
          umount /mnt/zbm_data 2>/dev/null || true
        fi
        rmdir /mnt/zbm_data 2>/dev/null || true
      fi
      if [ "$LOGS_ENABLED" = "1" ] && [ "${LOGS_GB:-0}" -gt 0 ]; then
        in-target zfs create -o mountpoint=legacy -o "quota=${LOGS_GB}G" zroot/var-log 2>/dev/null || true
      fi
      # D2-M5: the BE copy is verified BEFORE bootfs and the watchdog
      # properties point at it. The old order armed bootfs first and
      # snapshotted a possibly partial copy; a failed copy left a ZBM
      # UKI with no bootable BE behind it.
      mkdir -p /mnt/zbm_root 2>/dev/null || true
      BE_COPY_OK=0
      if mount -t zfs -o zfsutil "$INIT_BE" /mnt/zbm_root 2>/dev/null; then
        if command -v rsync >/dev/null 2>&1; then
          if rsync -aAX --exclude='/proc/*' --exclude='/sys/*' --exclude='/dev/*' --exclude='/run/*' --exclude='/tmp/*' --exclude='/mnt/*' --exclude='/boot/efi/*' --exclude='/var/lib/axonwall/*' /target/ /mnt/zbm_root/ 2>/dev/null; then
            mkdir -p /mnt/zbm_root/var/lib/axonwall /mnt/zbm_root/boot/efi /mnt/zbm_root/var/log
            chmod 3775 /mnt/zbm_root/var/lib/axonwall 2>/dev/null || true
            BE_COPY_OK=1
          fi
        else
          if cp -a /target/. /mnt/zbm_root/ 2>/dev/null; then
            BE_COPY_OK=1
          fi
        fi
        umount /mnt/zbm_root 2>/dev/null || true
      fi
      rmdir /mnt/zbm_root 2>/dev/null || true
      if [ "$BE_COPY_OK" != "1" ]; then
        echo "[-] ERROR: failed to populate Boot Environment ${INIT_BE} (copy from /target failed); refusing to arm an empty or partial BE."
        echo "[-] ERROR: aborting the install — a ZBM install without a populated Boot Environment cannot boot."
        exit 1
      fi
      in-target zpool set bootfs="$INIT_BE" zroot 2>/dev/null || true
      in-target zfs set "org.zfsbootmenu:commandline=ro quiet splash plymouth.ignore-serial-consoles lsm=landlock,lockdown,yama,integrity,apparmor,bpf console=ttyS0,9600 console=tty0" zroot/ROOT 2>/dev/null || true
      in-target zfs set "org.axonwall:active_be=${INIT_BE}" zroot/ROOT 2>/dev/null || true
      in-target zfs set "org.axonwall:fallback_be=${INIT_BE}" zroot/ROOT 2>/dev/null || true
      in-target zfs set "org.axonwall:bootcount=0" zroot/ROOT 2>/dev/null || true
      in-target zfs set "org.axonwall:bootlimit=3" zroot/ROOT 2>/dev/null || true
      in-target zfs set "org.axonwall:topology=${RESOLVED_TOPOLOGY}" zroot/ROOT 2>/dev/null || true
      in-target zfs snapshot "${INIT_BE}@factory-initial" 2>/dev/null || true
    else
      # D2-M5: a ZBM install without a pool cannot boot (the hook
      # already removed GRUB and installed the ZBM UKI as the boot
      # target), so a failed create must abort, not silently continue.
      echo "[-] ERROR: zpool create zroot failed during the ZBM install; no Root-on-ZFS pool exists and the box cannot boot."
      echo "[-] ERROR: aborting the install."
      exit 1
    fi
  else
    in-target zpool create -f \
      -o ashift=12 \
      -o autotrim=on \
      -O compression=lz4 \
      -O acltype=posixacl \
      -O xattr=sa \
      -O normalization=formD \
      -O mountpoint=/mnt/tank \
      tank $ZPOOL_ARGS $ZFS_VDEVS 2>/dev/null || true
  fi
fi

# 7. Initialize Bootloader (Rolling Single-Root vs A/B boot counting; ZBM configured above before BE clone)
if [ "$INSTALL_MODE" = "zbm" ]; then
  true
elif [ "$INSTALL_MODE" = "rolling" ]; then
  echo "[+] Configuring standard Debian GRUB bootloader for Rolling Single-Root mode..."
  mkdir -p /target/boot/grub
  rm -f /target/etc/grub.d/40_axonwall_ab 2>/dev/null || true
else
  mkdir -p /target/boot/grub
  # D2-H1: install the A/B GRUB script into the target before
  # update-grub runs (section 10). Without it update-grub generates
  # a stock grub.cfg — no load_env, no bootcount handling, no slot
  # entries — and the grubenv values above are never read by GRUB,
  # leaving the watchdog fallback and slot arming dead on d-i
  # installs. The script ships in the installer payload at
  # /usr/lib/axonwall/40_axonwall_ab (a copy of the live-image
  # /etc/grub.d/40_axonwall_ab); keep the two in sync.
  mkdir -p /target/etc/grub.d
  if [ -f /usr/lib/axonwall/40_axonwall_ab ]; then
    cp -f /usr/lib/axonwall/40_axonwall_ab /target/etc/grub.d/40_axonwall_ab
    chmod +x /target/etc/grub.d/40_axonwall_ab
  else
    echo "[-] ERROR: A/B GRUB script /usr/lib/axonwall/40_axonwall_ab is missing from the installer environment; update-grub would generate a stock grub.cfg with no slot logic."
    echo "[-] ERROR: aborting the install rather than shipping a target whose GRUB cannot switch slots."
    exit 1
  fi
  in-target grub-editenv /boot/grub/grubenv create 2>/dev/null || true
  in-target grub-editenv /boot/grub/grubenv set active_slot=A 2>/dev/null || true
  in-target grub-editenv /boot/grub/grubenv set bootcount=0 2>/dev/null || true
  in-target grub-editenv /boot/grub/grubenv set bootlimit=3 2>/dev/null || true
fi

# 8. Ensure stable /boot/vmlinuz and /boot/initrd.img symlinks exist on Slot A
if [ -d /target/boot ]; then
  LATEST_A_KERN=$(ls -1t /target/boot/vmlinuz-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_A_KERN" ]; then
    ln -sf "$(basename "$LATEST_A_KERN")" /target/boot/vmlinuz
    ln -sf "boot/$(basename "$LATEST_A_KERN")" /target/vmlinuz 2>/dev/null || true
  fi
  LATEST_A_INITRD=$(ls -1t /target/boot/initrd.img-* 2>/dev/null | head -n1 || true)
  if [ -n "$LATEST_A_INITRD" ]; then
    ln -sf "$(basename "$LATEST_A_INITRD")" /target/boot/initrd.img
    ln -sf "boot/$(basename "$LATEST_A_INITRD")" /target/initrd.img 2>/dev/null || true
  fi
fi

# Ensure kernel-img.conf exists on /target
cat << 'KCONF_EOF' > /target/etc/kernel-img.conf
do_symlinks = yes
link_in_boot = yes
relative_links = yes
KCONF_EOF

# 9. Configure branded GRUB theme & visual styling (A/B and Rolling modes only; ZBM uses ZFSBootMenu directly)
if [ "$INSTALL_MODE" != "zbm" ]; then
  mkdir -p /target/boot/grub/themes/axonwall /target/etc/axonwall/branding /target/etc/default/grub.d

  SPLASH_IMG="splash.png"
  if [ "${INSTALL_EDITION:-axonwall}" = "vault" ] || [ -f /target/etc/axonwall/.vault-edition ]; then
    SPLASH_IMG="splash-vault.png"
  fi

  for cand in \
    "/target/etc/axonwall/branding/${SPLASH_IMG}" \
    "/etc/axonwall/branding/${SPLASH_IMG}" \
    "/cdrom/boot/grub/live-theme/${SPLASH_IMG}" \
