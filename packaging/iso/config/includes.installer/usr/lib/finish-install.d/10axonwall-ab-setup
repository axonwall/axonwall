      cp -f "$tcand" /target/etc/axonwall/branding/theme.txt 2>/dev/null || true
      THEME_COPIED=1
      break
    fi
  done

  if [ "$THEME_COPIED" = "0" ] || [ ! -s /target/boot/grub/themes/axonwall/theme.txt ]; then
