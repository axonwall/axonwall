#!/bin/sh
set -e

. /usr/share/debconf/confmodule

INSTALL_LOG="/var/log/axonwall-install.log"
mkdir -p /var/log
exec >>"$INSTALL_LOG" 2>&1

swapoff -a 2>/dev/null || true

echo "================================================================================"
echo "[Axonwall Installer] Finalizing A/B Dual-Root, System RAID & ZFS Setup..."
echo "================================================================================"

# Load installer choices recorded by 10initial_auto
PARTITION_MODE="auto"
INSTALL_MODE="ab"
ZFS_MB=0
ZFS_GB=0
ZFS_ALLOC_MODE="none"
SYSTEM_RAID_MODE="single"
SYSTEM_RAID_DISKS=""
ZFS_EXTRA_DISKS=""
ZFS_RAID_TOPOLOGY="auto"
ROOT_FSTYPE="ext4"
DATA_FSTYPE="ext4"
LOGS_ENABLED=0
LOGS_GB=0
LOGS_FSTYPE="xfs"
LUKS_ENABLED=0
LUKS_TPM2=0
LUKS_PASSPHRASE=""
INSTALL_EDITION="axonwall"
K3S_ROLE="server"
K3S_SERVER_URL=""
K3S_JOIN_TOKEN=""
ZFS_ARC_MAX_MB=0

cleanup_secrets() {
  shred -u /var/lib/partman/axonwall-luks.pass /var/lib/partman/axonwall-k3s.token 2>/dev/null || rm -f /var/lib/partman/axonwall-luks.pass /var/lib/partman/axonwall-k3s.token 2>/dev/null || true
  if [ -n "${TEMP_KEY:-}" ] && [ -f "${TEMP_KEY:-}" ]; then
    shred -u "$TEMP_KEY" 2>/dev/null || rm -f "$TEMP_KEY" 2>/dev/null || true
  fi
  rm -f /tmp/axonwall-luks* /tmp/axonwall-k3s* /run/axonwall-luks* /target/run/axonwall-luks* /target/tmp/axonwall-luks* 2>/dev/null || true
  K3S_JOIN_TOKEN=""
  LUKS_PASSPHRASE=""
  unset K3S_JOIN_TOKEN LUKS_PASSPHRASE
}
trap cleanup_secrets EXIT INT TERM

if [ -f /var/lib/partman/axonwall-choices ]; then
  . /var/lib/partman/axonwall-choices
fi

if [ -f /var/lib/partman/axonwall-k3s.token ]; then
  K3S_JOIN_TOKEN="$(cat /var/lib/partman/axonwall-k3s.token 2>/dev/null || true)"
fi
# D-M9 (marker): the canonical edition file is read first, then the
# legacy markers — same order as axonwall-update. A non-empty value
# that is not a known edition fails the install loudly. INSTALL_EDITION
# is final after this block (nothing below reassigns it); the file is
# written here so every d-i install carries it.
_target_edition="$(tr -d ' \t\r\n' < /target/etc/axonwall/edition 2>/dev/null || true)"
case "$_target_edition" in
  axonwall|minimal|vault|k3s-storage)
    if [ -z "${INSTALL_EDITION:-}" ] || [ "${INSTALL_EDITION:-axonwall}" = "axonwall" ]; then
      INSTALL_EDITION="$_target_edition"
    fi
    ;;
  "")
    if [ -z "${INSTALL_EDITION:-}" ] || [ "${INSTALL_EDITION:-axonwall}" = "axonwall" ]; then
      if [ -f /target/etc/axonwall/.k3s-edition ]; then
        INSTALL_EDITION="k3s-storage"
      elif [ -f /target/etc/axonwall/.vault-edition ]; then
        INSTALL_EDITION="vault"
      elif [ -f /target/etc/axonwall/.minimal-edition ]; then
        INSTALL_EDITION="minimal"
      fi
    fi
    ;;
  *)
    echo "[!] ERROR: /target/etc/axonwall/edition contains '${_target_edition}' (expected axonwall, minimal, vault, or k3s-storage); refusing to install with a corrupt edition record." >&2
    exit 1
    ;;
esac
mkdir -p /target/etc/axonwall
printf '%s\n' "${INSTALL_EDITION:-axonwall}" > /target/etc/axonwall/edition

if [ "$PARTITION_MODE" = "rolling" ]; then
  INSTALL_MODE="rolling"
elif [ "$PARTITION_MODE" = "zbm" ]; then
  INSTALL_MODE="zbm"
fi

# Clean SYSTEM_RAID_DISKS of any commas or extra whitespace
if [ -n "$SYSTEM_RAID_DISKS" ]; then
  SYSTEM_RAID_DISKS="$(echo "$SYSTEM_RAID_DISKS" | tr ',' ' ' | tr -s ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
fi

if [ -f /var/lib/partman/axonwall-luks.pass ]; then
  LUKS_PASSPHRASE="$(cat /var/lib/partman/axonwall-luks.pass 2>/dev/null || true)"
fi

is_mounted() {
  grep -qE "[[:space:]]${1%/}[[:space:]]" /proc/mounts 2>/dev/null
}

mount_dev() {
  mnt_path="${1%/}"
  awk -v mp="$mnt_path" '$2 == mp {print $1}' /proc/mounts 2>/dev/null | tail -n1
}

part_dev() {
  disk_dev="$1"
  p_num="$2"
  if echo "$disk_dev" | grep -q 'nvme\|mmcblk\|loop'; then
    echo "${disk_dev}p${p_num}"
  else
    echo "${disk_dev}${p_num}"
  fi
}

# 1. Identify installed block devices on primary disk using exact mountpoint lookups
ROOT_A_DEV=$(mount_dev /target)
if [ -z "$ROOT_A_DEV" ]; then
  ROOT_A_DEV=$(df /target 2>/dev/null | tail -n1 | awk '{print $1}')
fi
ROOT_B_DEV=$(mount_dev /target/mnt/standby)
DATA_DEV=$(mount_dev /target/var/lib/axonwall)
LOGS_DEV=$(mount_dev /target/var/log)
ZFS_DEV=$(mount_dev /target/mnt/tank)

# If partman mounted the staging ZFS partition at /target/mnt/tank, unmount it immediately so it can be wiped for OpenZFS
if [ -n "$ZFS_DEV" ] && is_mounted /target/mnt/tank; then
  umount /target/mnt/tank 2>/dev/null || umount -l /target/mnt/tank 2>/dev/null || true
fi
rmdir /target/mnt/tank 2>/dev/null || true

if [ -z "$TARGET_DISK" ]; then
  TARGET_DISK=$(echo "$ROOT_A_DEV" | sed -E 's/p?[0-9]+$//')
fi

# Fallback detection for Logs, Data, Slot B, and Optional ZFS partition
ALL_PARTS=$(ls "${TARGET_DISK}"* 2>/dev/null | grep -E "${TARGET_DISK}(p?[0-9]+)$" | sort -V || true)
LAST_PART=$(echo "$ALL_PARTS" | tail -n1)
SECOND_LAST_PART=$(echo "$ALL_PARTS" | tail -n2 | head -n1)
THIRD_LAST_PART=$(echo "$ALL_PARTS" | tail -n3 | head -n1)

if [ "$INSTALL_MODE" = "rolling" ] || [ "$INSTALL_MODE" = "zbm" ]; then
  ROOT_B_DEV=""
  DATA_DEV=""
  if [ -z "$ZFS_DEV" ] && { [ "${ZFS_MB:-0}" -gt 0 ] || [ "$INSTALL_MODE" = "zbm" ]; }; then
    if [ -n "$LAST_PART" ] && [ "$LAST_PART" != "$ROOT_A_DEV" ] && [ "$LAST_PART" != "$LOGS_DEV" ]; then
      ZFS_DEV="$LAST_PART"
    fi
  fi
else
  # A/B Dual-Root Mode
  if [ -z "$ROOT_B_DEV" ] || [ "$ROOT_B_DEV" = "$ROOT_A_DEV" ]; then
    if [ "$PARTITION_MODE" = "manual" ]; then
      CANDIDATE_B=$(blkid -L axon_root_b 2>/dev/null || true)
      if [ -n "$CANDIDATE_B" ] && [ -b "$CANDIDATE_B" ]; then
        ROOT_B_DEV="$CANDIDATE_B"
      else
        ROOT_B_DEV=""
      fi
    else
      PART_NUM=$(echo "$ROOT_A_DEV" | grep -oE '[0-9]+$')
      NEXT_NUM=$(( PART_NUM + 1 ))
      ROOT_B_DEV=$(part_dev "$TARGET_DISK" "$NEXT_NUM")
    fi
  fi

  if [ "${ZFS_MB:-0}" -gt 0 ]; then
    [ -z "$ZFS_DEV" ] && ZFS_DEV="$LAST_PART"
    if [ -z "$DATA_DEV" ] || [ "$DATA_DEV" = "$ROOT_A_DEV" ]; then
      DATA_DEV="$SECOND_LAST_PART"
    fi
    if [ "$LOGS_ENABLED" = "1" ] && [ -z "$LOGS_DEV" ]; then
      LOGS_DEV="$THIRD_LAST_PART"
    fi
  else
    if [ -z "$DATA_DEV" ] || [ "$DATA_DEV" = "$ROOT_A_DEV" ]; then
      DATA_DEV="$LAST_PART"
    fi
    if [ "$LOGS_ENABLED" = "1" ] && [ -z "$LOGS_DEV" ]; then
      LOGS_DEV="$SECOND_LAST_PART"
    fi
  fi
fi

echo "[+] Install Mode      : ${INSTALL_MODE}"
echo "[+] Target Disk       : ${TARGET_DISK}"
echo "[+] System RAID Mode  : ${SYSTEM_RAID_MODE} (${SYSTEM_RAID_DISKS:-$TARGET_DISK})"
echo "[+] Root Partition    : ${ROOT_A_DEV} (${ROOT_FSTYPE})"
echo "[+] Slot B (Standby)  : ${ROOT_B_DEV:-<none (${INSTALL_MODE})>} (${ROOT_FSTYPE})"
echo "[+] Persistent Data   : ${DATA_DEV:-<unified on />} (${DATA_FSTYPE}, LUKS2=${LUKS_ENABLED})"
echo "[+] Dedicated Logs    : ${LOGS_DEV:-<none>} (${LOGS_FSTYPE})"
echo "[+] ZFS Partition     : ${ZFS_DEV:-<none>} (${ZFS_GB:-0} GB)"

# 2. Label filesystems and configure LUKS2 Encryption
if [ -b "$ROOT_A_DEV" ]; then
  ROOT_LABEL="axon_root_a"
  if [ "$INSTALL_MODE" = "rolling" ] || [ "$INSTALL_MODE" = "zbm" ]; then
    ROOT_LABEL="axon_root"
  fi
  echo "[+] Setting filesystem label: ${ROOT_A_DEV} -> ${ROOT_LABEL}"
  if [ "$ROOT_FSTYPE" = "xfs" ] && command -v xfs_admin >/dev/null 2>&1; then
    xfs_admin -L "$ROOT_LABEL" "$ROOT_A_DEV" 2>/dev/null || true
  else
    e2label "$ROOT_A_DEV" "$ROOT_LABEL" 2>/dev/null || tune2fs -L "$ROOT_LABEL" "$ROOT_A_DEV" 2>/dev/null || true
  fi
fi

if [ "$INSTALL_MODE" = "ab" ] && [ -b "$ROOT_B_DEV" ]; then
  udevadm settle 2>/dev/null || true
  if is_mounted /target/mnt/standby; then
    echo "[+] Labeling mounted Slot B standby partition: ${ROOT_B_DEV} -> axon_root_b"
    if [ "$ROOT_FSTYPE" != "xfs" ]; then
      e2label "$ROOT_B_DEV" axon_root_b 2>/dev/null || tune2fs -L axon_root_b "$ROOT_B_DEV" 2>/dev/null || true
    fi
  else
    sleep 1
    echo "[+] Formatting Slot B standby partition: ${ROOT_B_DEV} as ${ROOT_FSTYPE}..."
    if [ "$ROOT_FSTYPE" = "xfs" ]; then
      mkfs.xfs -f -L axon_root_b "$ROOT_B_DEV" 2>/dev/null || true
    else
      mkfs.ext4 -F -L axon_root_b "$ROOT_B_DEV" 2>/dev/null || true
      e2label "$ROOT_B_DEV" axon_root_b 2>/dev/null || tune2fs -L axon_root_b "$ROOT_B_DEV" 2>/dev/null || true
    fi
  fi
fi

# Configure dedicated /var/log partition if enabled
if [ "$LOGS_ENABLED" = "1" ] && [ -b "$LOGS_DEV" ] && [ "$LOGS_DEV" != "$ROOT_A_DEV" ]; then
  if is_mounted /target/var/log; then
    echo "[+] Labeling dedicated logs partition: ${LOGS_DEV} -> axon_logs"
    if [ "$LOGS_FSTYPE" != "xfs" ]; then
      e2label "$LOGS_DEV" axon_logs 2>/dev/null || tune2fs -L axon_logs "$LOGS_DEV" 2>/dev/null || true
    fi
  else
    echo "[+] Formatting dedicated logs partition: ${LOGS_DEV} as ${LOGS_FSTYPE}..."
    if [ "$LOGS_FSTYPE" = "xfs" ]; then
      mkfs.xfs -f -L axon_logs "$LOGS_DEV" 2>/dev/null || true
    else
      mkfs.ext4 -F -L axon_logs "$LOGS_DEV" 2>/dev/null || true
    fi
  fi
fi

# Configure LUKS2 Encryption for Persistent Data volume if requested
TARGET_DATA_MAPPER="$DATA_DEV"
if [ "$LUKS_ENABLED" = "1" ] && [ -b "$DATA_DEV" ] && command -v cryptsetup >/dev/null 2>&1; then
  echo "[+] Initializing LUKS2 encryption on ${DATA_DEV}..."

  # Unmount /target/var/lib/axonwall if partman pre-mounted the unencrypted device, staging any existing files
  STAGE_DATA="/tmp/target_axonwall_staged"
  rm -rf "$STAGE_DATA"
  mkdir -p "$STAGE_DATA"
  if is_mounted /target/var/lib/axonwall; then
    echo "[+] Staging existing files from /target/var/lib/axonwall before LUKS formatting..."
    cp -a /target/var/lib/axonwall/. "$STAGE_DATA/" 2>/dev/null || true
    umount /target/var/lib/axonwall 2>/dev/null || true
  fi

  mkdir -p /run
  TEMP_KEY="$(umask 077 && mktemp /run/axonwall-luks.XXXXXX)"
  (
    umask 077
    if [ -n "$LUKS_PASSPHRASE" ]; then
      printf '%s' "$LUKS_PASSPHRASE" > "$TEMP_KEY"
    else
      dd if=/dev/urandom of="$TEMP_KEY" bs=32 count=1 2>/dev/null
    fi
    chmod 0400 "$TEMP_KEY"
  )

  if cryptsetup luksFormat --type luks2 --batch-mode --cipher aes-xts-plain64 -s 512 -d "$TEMP_KEY" "$DATA_DEV"; then
    # D2-M3: a failed open after a successful format used to be
    # swallowed (|| true), leaving no crypttab entry, no mounted
    # data volume, and an fstab entry for a LABEL=axon_data device
    # that was never created — first boot dropped to emergency mode.
    # Fail the install, like the luksFormat branch below. There is
    # nothing to restore onto: the device now carries a LUKS header,
    # so the plain-mount restore in the luksFormat abort cannot work.
    if ! cryptsetup open -d "$TEMP_KEY" "$DATA_DEV" axon_crypt_data 2>/dev/null; then
      echo "[-] ERROR: cryptsetup open failed on ${DATA_DEV} after a successful format; the encrypted data volume cannot be used."
      echo "[-] ERROR: aborting the install rather than shipping a target whose first boot drops to emergency mode."
      exit 1
    fi
    TARGET_DATA_MAPPER="/dev/mapper/axon_crypt_data"

    if [ -b "$TARGET_DATA_MAPPER" ]; then
      if [ "$DATA_FSTYPE" = "xfs" ]; then
        if ! mkfs.xfs -f -L axon_data "$TARGET_DATA_MAPPER" 2>/dev/null; then
          echo "[-] ERROR: mkfs.xfs failed on ${TARGET_DATA_MAPPER}; aborting the install rather than writing crypttab/fstab entries for a volume that was never created."
          exit 1
        fi
      else
        if ! mkfs.ext4 -F -L axon_data "$TARGET_DATA_MAPPER" 2>/dev/null; then
          echo "[-] ERROR: mkfs.ext4 failed on ${TARGET_DATA_MAPPER}; aborting the install rather than writing crypttab/fstab entries for a volume that was never created."
          exit 1
        fi
      fi

      mkdir -p /target/var/lib/axonwall
      if ! mount "$TARGET_DATA_MAPPER" /target/var/lib/axonwall 2>/dev/null; then
        echo "[-] ERROR: failed to mount ${TARGET_DATA_MAPPER} on /target/var/lib/axonwall; aborting the install rather than writing crypttab/fstab entries for a volume that was never mounted."
        exit 1
      fi

      if [ -d "$STAGE_DATA" ] && [ -n "$(ls -A "$STAGE_DATA" 2>/dev/null || true)" ]; then
        cp -a "$STAGE_DATA/." /target/var/lib/axonwall/ 2>/dev/null || true
      fi
      rm -rf "$STAGE_DATA"

      DATA_UUID="$(blkid -s UUID -o value "$DATA_DEV" 2>/dev/null || echo "$DATA_DEV")"
      mkdir -p /target/etc

      TPM2_SUCCESS=0
      if [ "$LUKS_TPM2" = "1" ] && command -v in-target >/dev/null 2>&1; then
        echo "[+] Enrolling hardware TPM 2.0 PCR policy for automated unlock..."
        mkdir -p /target/run
        _enroll_key="$(umask 077 && mktemp /target/run/axonwall-luks-enroll.XXXXXX)"
        ( umask 077 && cp "$TEMP_KEY" "$_enroll_key" && chmod 0400 "$_enroll_key" )
        if in-target systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=0,2,7 --unlock-key-file="/run/$(basename "$_enroll_key")" "$DATA_DEV" 2>/dev/null; then
          TPM2_SUCCESS=1
          echo "[+] Successfully enrolled TPM 2.0 token."
        else
          echo "[-] Warning: TPM 2.0 enrollment failed. Falling back to passphrase unlock at boot."
        fi
        shred -u "$_enroll_key" 2>/dev/null || rm -f "$_enroll_key"
      fi

      if [ "$TPM2_SUCCESS" = "1" ]; then
        echo "axon_crypt_data UUID=${DATA_UUID} none luks,discard,tpm2-device=auto" >> /target/etc/crypttab
      elif [ -z "$LUKS_PASSPHRASE" ]; then
        echo "[+] Persisting root-only LUKS keyfile (/etc/axonwall/luks-data.key) since no passphrase was specified and TPM 2.0 is unavailable..."
        mkdir -p /target/etc/axonwall
        ( umask 077 && cp "$TEMP_KEY" /target/etc/axonwall/luks-data.key )
        chown 0:0 /target/etc/axonwall/luks-data.key 2>/dev/null || true
        chmod 0400 /target/etc/axonwall/luks-data.key
        echo "axon_crypt_data UUID=${DATA_UUID} /etc/axonwall/luks-data.key luks,discard" >> /target/etc/crypttab
      else
        echo "axon_crypt_data UUID=${DATA_UUID} none luks,discard" >> /target/etc/crypttab
      fi
    else
      # D2-M3: cryptsetup open reported success but the mapper node
      # never appeared — the same unusable-volume state as an open
      # failure; abort instead of writing crypttab/fstab entries.
      echo "[-] ERROR: encrypted mapper ${TARGET_DATA_MAPPER} is not a block device after cryptsetup open succeeded; aborting the install."
      exit 1
    fi
  else
    echo "[-] ERROR: cryptsetup luksFormat failed on ${DATA_DEV}; the requested LUKS encryption is NOT in place."
    echo "[-] ERROR: aborting the install rather than silently continuing without encryption and with data unmounted."
    # Best effort: restore the plain mount and the staged files, so no
    # later step writes into slot A's root directory over the data
    # mountpoint (a partially formatted device simply will not mount,
    # in which case this no-ops and the abort below still holds).
    mkdir -p /target/var/lib/axonwall
    if mount "$DATA_DEV" /target/var/lib/axonwall 2>/dev/null; then
      if [ -d "$STAGE_DATA" ] && [ -n "$(ls -A "$STAGE_DATA" 2>/dev/null || true)" ]; then
        cp -a "$STAGE_DATA/." /target/var/lib/axonwall/ 2>/dev/null || true
      fi
    fi
    rm -rf "$STAGE_DATA"
    exit 1
  fi

  shred -u "$TEMP_KEY" 2>/dev/null || rm -f "$TEMP_KEY"
elif [ -b "$DATA_DEV" ] && [ "$DATA_DEV" != "$ROOT_A_DEV" ] && [ "$DATA_DEV" != "$ROOT_B_DEV" ]; then
  echo "[+] Setting filesystem label: ${DATA_DEV} -> axon_data"
  if [ "$DATA_FSTYPE" = "xfs" ] && command -v xfs_admin >/dev/null 2>&1; then
    xfs_admin -L axon_data "$DATA_DEV" 2>/dev/null || true
  else
    e2label "$DATA_DEV" axon_data 2>/dev/null || tune2fs -L axon_data "$DATA_DEV" 2>/dev/null || true
  fi
fi

# Seed Cloud-Init configuration into target if present from install media
if [ -f /var/lib/partman/cloud-config.yaml ]; then
  echo "[+] Copying Cloud-Init seed configuration into /target/var/lib/cloud/seed/nocloud-net/..."
  mkdir -p /target/var/lib/cloud/seed/nocloud-net /target/etc/axonwall
  cp /var/lib/partman/cloud-config.yaml /target/var/lib/cloud/seed/nocloud-net/user-data
  cp /var/lib/partman/cloud-config.yaml /target/etc/axonwall/cloud-config.yaml
  chmod 0600 /target/etc/axonwall/cloud-config.yaml 2>/dev/null || true
  if [ -f /var/lib/partman/meta-data ]; then
    cp /var/lib/partman/meta-data /target/var/lib/cloud/seed/nocloud-net/meta-data
  else
    echo "instance-id: $(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo "axonwall-01")" > /target/var/lib/cloud/seed/nocloud-net/meta-data
  fi
  if [ -f /var/lib/partman/network-config ]; then
    cp /var/lib/partman/network-config /target/var/lib/cloud/seed/nocloud-net/network-config
  fi
  chmod 0600 /target/var/lib/cloud/seed/nocloud-net/*

  # Inject SSH authorized keys for root if specified in cloud-config
  mkdir -p /target/root/.ssh
  chmod 0700 /target/root/.ssh

  # Extract top-level or users: ssh_authorized_keys
  grep -A 20 -E '^\s*ssh_authorized_keys:' /var/lib/partman/cloud-config.yaml 2>/dev/null | \
    grep -E '^\s*-\s*(ssh-|ecdsa-sha2-nistp|sk-)' | sed -e 's/^[[:space:]]*-[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' >> /target/root/.ssh/authorized_keys || true

  # Also check if user admin or root has ssh_authorized_keys
  awk '/^\s*-\s*name:\s*(root|admin)/,/^\s*-\s*name:|[a-z_]:/' /var/lib/partman/cloud-config.yaml 2>/dev/null | \
    grep -E '^\s*-\s*(ssh-|ecdsa-sha2-nistp|sk-)' | sed -e 's/^[[:space:]]*-[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' >> /target/root/.ssh/authorized_keys || true

  if [ -s /target/root/.ssh/authorized_keys ]; then
    # Deduplicate keys and set strict 0600 permissions
    sort -u /target/root/.ssh/authorized_keys > /target/root/.ssh/authorized_keys.tmp
    mv /target/root/.ssh/authorized_keys.tmp /target/root/.ssh/authorized_keys
    chmod 0600 /target/root/.ssh/authorized_keys
    echo "[+] Injected Cloud-Init SSH authorized keys into /target/root/.ssh/authorized_keys"
  fi

  # Apply admin password hash to /target/etc/shadow if provided
  ci_hash="$(grep -A 10 "auth:" /var/lib/partman/cloud-config.yaml 2>/dev/null | grep "admin_password_hash:" | head -n1 | sed -e 's/.*admin_password_hash:[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' || true)"
  if [ -z "$ci_hash" ]; then
    ci_top_pw="$(grep -E '^password:[[:space:]]*' /var/lib/partman/cloud-config.yaml 2>/dev/null | head -n1 | sed -e 's/^password:[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//' || true)"
    case "$ci_top_pw" in
      \$1\$*|\$5\$*|\$6\$*|\$y\$*|\$2a\$*|\$2b\$*|\$2y\$*)
        ci_hash="$ci_top_pw"
        ;;
    esac
  fi
  if [ -n "$ci_hash" ] && [ -f /target/etc/shadow ]; then
    in-target usermod -p "$ci_hash" root 2>/dev/null || true
  fi
fi

# Provision appliance TLS certificate pair early so Web Console (port 2966) is always secure from first boot
mkdir -p /target/etc/axonwall/certs
if [ ! -s /target/etc/axonwall/certs/hub.crt ] || [ ! -s /target/etc/axonwall/certs/hub.key ]; then
  if in-target /usr/local/bin/axonwall-rotate-hub-cert --ensure 2>/dev/null; then
    echo "[+] Generated appliance hub TLS certificate via axonwall-rotate-hub-cert"
  elif in-target openssl req -x509 -newkey rsa:2048 -nodes \
      -keyout /etc/axonwall/certs/hub.key \
      -out /etc/axonwall/certs/hub.crt \
      -days 3650 \
      -subj "/O=Axonwall/OU=Appliance/CN=axonwall" \
      -addext "subjectAltName=DNS:axonwall.local,DNS:localhost,IP:127.0.0.1" 2>/dev/null; then
    echo "[+] Generated fallback self-signed appliance hub TLS certificate via openssl"
  fi
  in-target chown axonwall-controller:axonwall-controller /etc/axonwall/certs/hub.key /etc/axonwall/certs/hub.crt 2>/dev/null || true
  in-target chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
  in-target chmod 0644 /etc/axonwall/certs/hub.crt 2>/dev/null || true
fi

purge_debian_packages() {
  _p_root="$1"
  shift
  [ -x "${_p_root}/usr/bin/dpkg" ] || return 0
  _to_purge=""
  for _p_name in "$@"; do
    _p_st="$(chroot "$_p_root" /usr/bin/dpkg-query -W -f='${Status}' "$_p_name" 2>/dev/null || true)"
    case "$_p_st" in
      *"install ok installed"*) _to_purge="${_to_purge} ${_p_name}" ;;
    esac
  done
  [ -n "$_to_purge" ] || return 0
  if [ -x "${_p_root}/usr/bin/apt-get" ]; then
    # shellcheck disable=SC2086
    DEBIAN_FRONTEND=noninteractive chroot "$_p_root" /usr/bin/apt-get purge -y --auto-remove $_to_purge </dev/null >/dev/null 2>&1 || \
      chroot "$_p_root" /usr/bin/dpkg --purge $_to_purge </dev/null >/dev/null 2>&1 || true
  else
    # shellcheck disable=SC2086
