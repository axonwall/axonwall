GRUB_THEME="/boot/grub/themes/axonwall/theme.txt"
GRUB_BACKGROUND="/boot/grub/themes/axonwall/splash.png"
GRUB_GFXMODE="640x480,800x600,1024x768,auto"
GRUB_GFXPAYLOAD_LINUX="keep"
GRUB_COLOR_NORMAL="light-gray/black"
GRUB_COLOR_HIGHLIGHT="light-green/dark-gray"
CFG_EOF

  # 10. Refresh GRUB configuration
  # D-H3: if update-grub itself fails, the target keeps the stock grub.cfg
  # d-i generated before 40_axonwall_ab was installed -- exactly the
  # outcome the section-7 guard exists to prevent. Fail the install
  # loudly (hook runs under `set -e`) instead of swallowing the failure
  # and printing success with no A/B slot logic.
  in-target update-grub

  if [ "$INSTALL_MODE" = "ab" ] && [ -b "${ROOT_B_DEV:-}" ] && [ "${SYNC_OK:-0}" = "1" ]; then
    STAGE_B_GRUB="/tmp/stage_slot_b_grub"
    mkdir -p "$STAGE_B_GRUB"
    if mount "$ROOT_B_DEV" "$STAGE_B_GRUB" 2>/dev/null; then
      mkdir -p "$STAGE_B_GRUB/etc/grub.d" "$STAGE_B_GRUB/etc/default/grub.d" "$STAGE_B_GRUB/boot/grub"
      [ -f /target/etc/grub.d/40_axonwall_ab ] && cp -af /target/etc/grub.d/40_axonwall_ab "$STAGE_B_GRUB/etc/grub.d/40_axonwall_ab" 2>/dev/null || true
      [ -d /target/etc/default/grub.d ] && cp -af /target/etc/default/grub.d/. "$STAGE_B_GRUB/etc/default/grub.d/" 2>/dev/null || true
      [ -f /target/etc/kernel-img.conf ] && cp -af /target/etc/kernel-img.conf "$STAGE_B_GRUB/etc/kernel-img.conf" 2>/dev/null || true
      [ -d /target/boot/grub ] && cp -af /target/boot/grub/. "$STAGE_B_GRUB/boot/grub/" 2>/dev/null || true
      sync
      umount "$STAGE_B_GRUB" 2>/dev/null || true
    fi
    rmdir "$STAGE_B_GRUB" 2>/dev/null || true
  fi
fi

