#!/bin/sh

. /lib/partman/lib/base.sh

# Only run the first time
if [ -f /var/lib/partman/initial_auto ]; then
	exit 0
fi

. /lib/partman/lib/auto-shared.sh

# Skip if no disks detected and don't run on S/390
if [ -z "$(get_auto_disks)" ] || \
   [ "$(udpkg --print-architecture)" = s390 ]; then
	exit 0
fi

mkdir -p /var/lib/partman
touch /var/lib/partman/initial_auto

# Load Axonwall debconf templates into live cdebconf daemon (and fallback to debconf-loadtemplate)
if [ -f /usr/lib/axonwall/axonwall.templates ]; then
	if type db_x_loadtemplatefile >/dev/null 2>&1; then
		db_x_loadtemplatefile /usr/lib/axonwall/axonwall.templates axonwall 2>/dev/null || true
		db_x_loadtemplatefile /usr/lib/axonwall/axonwall.templates partman 2>/dev/null || true
		db_x_loadtemplatefile /usr/lib/axonwall/axonwall.templates passwd 2>/dev/null || true
		db_x_loadtemplatefile /usr/lib/axonwall/axonwall.templates user-setup 2>/dev/null || true
	else
		env -u DEBIAN_HAS_FRONTEND debconf-loadtemplate axonwall /usr/lib/axonwall/axonwall.templates 2>/dev/null || true
		env -u DEBIAN_HAS_FRONTEND debconf-loadtemplate partman /usr/lib/axonwall/axonwall.templates 2>/dev/null || true
	fi
fi

# Helper to guarantee interactive debconf prompts display even under auto=true priority=critical
ask_critical() {
	db_fset "$1" seen false 2>/dev/null || true
	db_input critical "$1" || true
	db_go || true
}

# Check for attached Cloud-Init or Autoinstall media if not already extracted during file-preseed
if [ ! -s /var/lib/partman/cloud-config.yaml ] && [ -f /usr/lib/axonwall/detect-cloudinit ]; then
	sh /usr/lib/axonwall/detect-cloudinit 2>/dev/null || true
fi

seed_dev="$(cat /var/lib/partman/cloudinit-seed-dev 2>/dev/null || true)"
seed_disk=""
if [ -n "$seed_dev" ]; then
	seed_disk="$(echo "$seed_dev" | sed -E 's/p?[0-9]+$//')"
fi

# See if any autopartition method has been set
method=""
if db_get partman-auto/method && [ "$RET" ]; then
	method="$RET"
fi

# See if any autopartition disks have been set
disks=""
if db_get partman-auto/disk && [ "$RET" ]; then
	disks="$RET"
fi

# Axonwall: Prompt user to select target disk(s) and RAID/ZFS topology if not set
if [ "$method" ] && [ -z "$disks" ]; then
	# Enumerate all candidate block devices for multi-disk RAID & ZFS selection (excluding Cloud-Init seed media)
	all_devs=""
	disk_count=0
	first_auto_partman_disk=""
	first_auto_dev=""
	for d in $(get_auto_disks | cut -f1); do
		[ -d "$d" ] && [ -f "$d/device" ] || continue
		d_dev="$(cat "$d/device" 2>/dev/null || true)"
		if [ -n "$d_dev" ]; then
			if [ -n "$seed_dev" ] && { [ "$d_dev" = "$seed_dev" ] || [ "$d_dev" = "$seed_disk" ]; }; then
				continue
			fi
			if [ -z "$first_auto_dev" ]; then
				first_auto_dev="$d_dev"
				first_auto_partman_disk="$d"
			fi
			disk_count=$(( disk_count + 1 ))
			if [ -z "$all_devs" ]; then
				all_devs="$d_dev"
			else
				all_devs="${all_devs}, ${d_dev}"
			fi
		fi
	done

	system_raid_mode="single"
	system_raid_disks=""
	disk=""
	dev_name=""
	partition_mode="auto"
	install_mode="ab"
	efi_mb=512
	root_fstype="ext4"
	data_fstype="ext4"
	data_alloc_mode="remainder"
	data_gb=16
	logs_enabled=0
	logs_gb=0
	logs_mb=0
	logs_fstype="xfs"
	luks_enabled=0
	luks_tpm2=0
	luks_passphrase=""
	zfs_alloc_mode="none"
	zfs_gb=0
	zfs_mb=0
	zfs_extra_disks=""
	zfs_raid_topology="auto"

	# 1. Unattended Cloud-Init Seed Mode vs Interactive Prompts
	# Only bypass interactive partitioning when unattended zero-touch storage is explicitly requested
	# via kernel cmdline (axonwall.unattended=1) or cloud-config.yaml (storage.unattended: true).
	# Attaching a standard Cloud-Init drive for networking/SSH/credentials still presents the full
	# interactive partitioning and disk selection workflow.
	ci_unattended_storage=0
	if grep -qE 'axonwall\.unattended=(1|true|yes)' /proc/cmdline 2>/dev/null; then
		ci_unattended_storage=1
	elif [ -f /var/lib/partman/cloud-config.yaml ]; then
		if grep -A 12 'storage:' /var/lib/partman/cloud-config.yaml 2>/dev/null | grep -qE '^[[:space:]]*(unattended|auto_partition):[[:space:]]*true'; then
			ci_unattended_storage=1
		fi
	fi

	if [ "$ci_unattended_storage" = "1" ] && [ -f /var/lib/partman/cloud-config.yaml ]; then
		logger -t axonwall-installer "Unattended storage mode requested via Cloud-Init (/var/lib/partman/cloud-config.yaml); applying declarative storage..."
		# Try to parse target disk(s) from cloud-config.yaml or fall back to first detected auto disk
		c_target_disks="$(grep -A 8 'target_disks:' /var/lib/partman/cloud-config.yaml 2>/dev/null | grep -E '^\s*-\s*/dev/' | tr -d ' -"' || true)"
		c_target="$(echo "$c_target_disks" | head -n1)"
		if [ -n "$c_target" ] && [ -b "$c_target" ] && [ "$c_target" != "$seed_dev" ] && [ "$c_target" != "$seed_disk" ]; then
			dev_name="$c_target"
			disk="$(dev_to_partman "$c_target" 2>/dev/null || echo "$c_target")"
		fi

		# Check for declarative system_raid configuration in cloud-config
		if grep -A 6 "system_raid:" /var/lib/partman/cloud-config.yaml 2>/dev/null | grep -q "enabled:\s*true"; then
			if [ -n "$c_target_disks" ]; then
				valid_raid_disks=""
				for d_candidate in $c_target_disks; do
					if [ -b "$d_candidate" ] && [ "$d_candidate" != "$seed_dev" ] && [ "$d_candidate" != "$seed_disk" ]; then
						valid_raid_disks="${valid_raid_disks:+$valid_raid_disks }$d_candidate"
					fi
				done
				v_count=$(echo "$valid_raid_disks" | wc -w | tr -d ' ')
				if [ "$v_count" -ge 2 ]; then
					system_raid_mode="mirror"
					system_raid_disks="$valid_raid_disks"
					first_disk="$(echo "$system_raid_disks" | awk '{print $1}')"
					dev_name="$first_disk"
					disk="$(dev_to_partman "$first_disk" 2>/dev/null || echo "$first_disk")"
					logger -t axonwall-installer "Configured declarative System RAID-1 mirror across: $system_raid_disks"
				fi
			fi
		fi

		# Custom EFI size
		c_efi="$(awk '/efi_size_mb:/ {print $2}' /var/lib/partman/cloud-config.yaml 2>/dev/null | tr -dc '0-9' | head -n1)"
		[ -n "$c_efi" ] && [ "$c_efi" -ge 128 ] && efi_mb="$c_efi"

		# Root partition size
		c_root="$(awk '/slot_a:/,/[a-z_]:/ {if (/size_gb:/) print $2}' /var/lib/partman/cloud-config.yaml 2>/dev/null | tr -dc '0-9' | head -n1)"
		[ -n "$c_root" ] && [ "$c_root" -ge 6 ] && root_gb="$c_root"

		# Root filesystem type
		c_rfstype="$(awk '/slot_a:/,/[a-z_]:/ {if (/filesystem:/) print $2}' /var/lib/partman/cloud-config.yaml 2>/dev/null | tr -dc 'a-z' | head -n1)"
		[ "$c_rfstype" = "xfs" ] && root_fstype="xfs"

		# Swap size
		c_swap="$(awk '/swap:/,/[a-z_]:/ {if (/size_gb:/) print $2}' /var/lib/partman/cloud-config.yaml 2>/dev/null | tr -dc '0-9' | head -n1)"
		[ -n "$c_swap" ] && swap_gb="$c_swap"

		# Dedicated logs partition
		if grep -A 5 "logs:" /var/lib/partman/cloud-config.yaml 2>/dev/null | grep -q "enabled:\s*true"; then
			logs_enabled=1
			c_lgb="$(awk '/logs:/,/[a-z_]:/ {if (/size_gb:/) print $2}' /var/lib/partman/cloud-config.yaml 2>/dev/null | tr -dc '0-9' | head -n1)"
			[ -n "$c_lgb" ] && logs_gb="$c_lgb"
			c_lfstype="$(awk '/logs:/,/[a-z_]:/ {if (/filesystem:/) print $2}' /var/lib/partman/cloud-config.yaml 2>/dev/null | tr -dc 'a-z' | head -n1)"
			[ "$c_lfstype" = "ext4" ] && logs_fstype="ext4"
		fi

		# Encryption (LUKS2 / TPM2)
		if grep -A 6 "encryption:" /var/lib/partman/cloud-config.yaml 2>/dev/null | grep -q "enabled:\s*true"; then
			luks_enabled=1
			if grep -A 6 "encryption:" /var/lib/partman/cloud-config.yaml 2>/dev/null | grep -q "tpm2_auto_unlock:\s*true"; then
				luks_tpm2=1
			fi
			luks_passphrase="$(grep -A 6 "encryption:" /var/lib/partman/cloud-config.yaml 2>/dev/null | grep "passphrase:" | head -n1 | sed -e 's/.*passphrase:[[:space:]]*//' -e 's/^["'\'']//' -e 's/["'\'']$//')"
			if [ "$luks_passphrase" = "CHANGE_ME_ON_DEPLOY" ]; then
				luks_passphrase=""
				[ "$luks_tpm2" = "0" ] && luks_enabled=0
			fi
		fi

		if [ -z "$dev_name" ]; then
			if [ -n "$first_auto_dev" ] && [ -n "$first_auto_partman_disk" ]; then
				disk="$first_auto_partman_disk"
				dev_name="$first_auto_dev"
			else
				db_fset partman-auto/select_disk seen false 2>/dev/null || true
				disk=$(select_auto_disk) || exit 99
				dev_name="$(cat "$disk/device" 2>/dev/null || echo "$disk")"
			fi
			system_raid_mode="single"
			system_raid_disks="$dev_name"
		fi

		dev_base="$(basename "$dev_name")"
		disk_sectors="$(cat "/sys/block/${dev_base}/size" 2>/dev/null || echo 0)"
		disk_size_gb=$(( disk_sectors * 512 / 1024 / 1024 / 1024 ))
		[ "$disk_size_gb" -le 0 ] && disk_size_gb=32

		# Detect ZBM Root-on-ZFS or Rolling Single-Root mode in cloud-config.yaml
		if grep -qE '(layout|layout_mode|install_mode):[[:space:]]*(zbm|zfsbootmenu|root_on_zfs)' /var/lib/partman/cloud-config.yaml 2>/dev/null; then
			install_mode="zbm"
			partition_mode="zbm"
			logger -t axonwall-installer "Cloud-Init requested ZFSBootMenu Root-on-ZFS mode"
		elif grep -qE '(layout|layout_mode|install_mode):[[:space:]]*(rolling|single_root)|ab_slots:[[:space:]]*false' /var/lib/partman/cloud-config.yaml 2>/dev/null; then
			install_mode="rolling"
			partition_mode="rolling"
			logger -t axonwall-installer "Cloud-Init requested Rolling Standard Linux (Single Root / — No A/B Slots)"
		fi

		root_gb="${root_gb:-16}"
		swap_gb="${swap_gb:-2}"
		root_mb=$(( root_gb * 1024 ))
		swap_mb=$(( swap_gb * 1024 ))
		if [ "$install_mode" = "rolling" ]; then
			remaining_gb=$(( disk_size_gb - swap_gb - logs_gb - 1 ))
		else
			remaining_gb=$(( disk_size_gb - (root_gb * 2) - swap_gb - logs_gb - 1 ))
		fi
		[ "$remaining_gb" -lt 4 ] && remaining_gb=4
		data_gb="$remaining_gb"

		# ZFS allocation
		if grep -A 6 "zfs:" /var/lib/partman/cloud-config.yaml 2>/dev/null | grep -q "enabled:\s*true"; then
			zfs_alloc_mode="custom"
			c_zgb="$(awk '/zfs:/,/[a-z_]:/ {if (/system_disk_size_gb:/) print $2}' /var/lib/partman/cloud-config.yaml 2>/dev/null | tr -dc '0-9' | head -n1)"
			if [ -n "$c_zgb" ] && [ "$c_zgb" -gt 0 ]; then
				zfs_gb="$c_zgb"
				data_gb=$(( remaining_gb - zfs_gb ))
				if [ "$install_mode" = "rolling" ]; then
					root_gb="$data_gb"
					[ "$root_gb" -lt 8 ] && root_gb=8
					root_mb=$(( root_gb * 1024 ))
				fi
			fi
		fi
		data_mb=$(( data_gb * 1024 ))
		zfs_mb=$(( zfs_gb * 1024 ))
	else
		# Interactive Mode: Select Partitioning Workflow
		# If cloud-config.yaml hints at zbm or rolling mode, pre-select it as the default choice
		if [ -f /var/lib/partman/cloud-config.yaml ] && grep -qE '(layout|layout_mode|install_mode):[[:space:]]*(zbm|zfsbootmenu|root_on_zfs)' /var/lib/partman/cloud-config.yaml 2>/dev/null; then
			db_set axonwall/partition_mode "ZFSBootMenu Root-on-ZFS (Boot Environments, Snapshots & Full ZFS RAID)" 2>/dev/null || true
		elif [ -f /var/lib/partman/cloud-config.yaml ] && grep -qE '(layout|layout_mode|install_mode):[[:space:]]*(rolling|single_root)|ab_slots:[[:space:]]*false' /var/lib/partman/cloud-config.yaml 2>/dev/null; then
			db_set axonwall/partition_mode "Rolling Standard Linux (Single Root / - No A/B Slots, Full APT Support)" 2>/dev/null || true
		fi
		ask_critical axonwall/partition_mode
		db_get axonwall/partition_mode || true
		case "$RET" in
			"Automated"*|"Express"*)
				partition_mode="auto"
				install_mode="ab"
				;;
			"ZFSBootMenu"*|"Root-on-ZFS"*|"zbm"*)
				partition_mode="zbm"
				install_mode="zbm"
				;;
			"Rolling"*)
				partition_mode="rolling"
				install_mode="rolling"
				;;
			"Guided"*)
				partition_mode="guided"
				install_mode="ab"
				;;
			"Custom"*|"Expert"*|"Wizard"*)
				partition_mode="wizard"
				install_mode="ab"
				;;
			"Manual"*)
				partition_mode="manual"
				install_mode="ab"
				;;
			*)
				partition_mode="auto"
				install_mode="ab"
				;;
		esac

		# If 2 or more physical disks detected, offer System RAID-1 mirror across disks
		if [ "$disk_count" -ge 2 ]; then
			ask_critical axonwall/system_raid_mode
			db_get axonwall/system_raid_mode || true
			case "$RET" in
				"RAID-1"*)
					system_raid_mode="mirror"
					db_subst axonwall/system_raid_disks CHOICES "$all_devs" || true
					ask_critical axonwall/system_raid_disks
					db_get axonwall/system_raid_disks || true
					system_raid_disks="$(echo "$RET" | tr -d ',' | tr -s ' ')"
					sel_raid_count=$(echo "$system_raid_disks" | wc -w | tr -d ' ')
					primary_dev="$(echo "$system_raid_disks" | awk '{print $1}')"
					if [ "$sel_raid_count" -ge 2 ] && [ -n "$primary_dev" ]; then
						dev_name="$primary_dev"
						disk="$(dev_to_partman "$primary_dev" 2>/dev/null || echo "$primary_dev")"
					elif [ "$sel_raid_count" -eq 1 ] && [ -n "$primary_dev" ]; then
						system_raid_mode="single"
						dev_name="$primary_dev"
						disk="$(dev_to_partman "$primary_dev" 2>/dev/null || echo "$primary_dev")"
					else
						system_raid_mode="single"
						system_raid_disks=""
					fi
					;;
				*)
					system_raid_mode="single"
					;;
			esac
		fi

		# If primary disk not yet set (Automated, Rolling, Guided, Manual, or Single-Disk Custom), select disk
		if [ -z "$dev_name" ]; then
			db_fset partman-auto/select_disk seen false 2>/dev/null || true
			disk=$(select_auto_disk) || exit 99
			dev_name="$(cat "$disk/device" 2>/dev/null || echo "$disk")"
			system_raid_mode="single"
			system_raid_disks="$dev_name"
		fi

		dev_base="$(basename "$dev_name")"
		disk_sectors="$(cat "/sys/block/${dev_base}/size" 2>/dev/null || echo 0)"
		disk_size_gb=$(( disk_sectors * 512 / 1024 / 1024 / 1024 ))
		if [ "$disk_size_gb" -le 0 ]; then
			disk_size_gb=32
		fi

		# Handle specific partition modes
		if [ "$partition_mode" = "rolling" ]; then
			# Mode: Rolling Standard Linux (Single Root / — No A/B Slots, Full APT Support)
			ask_critical axonwall/swap_size
			db_get axonwall/swap_size || true
			swap_choice="$RET"

			swap_gb=2
			case "$swap_choice" in
				"No swap"*) swap_gb=0 ;;
				"4 GB"*) swap_gb=4 ;;
				"8 GB"*) swap_gb=8 ;;
				*) swap_gb=2 ;;
			esac
			swap_mb=$(( swap_gb * 1024 ))

			remaining_gb=$(( disk_size_gb - swap_gb - 1 ))
			[ "$remaining_gb" -lt 8 ] && remaining_gb=8

			ask_critical axonwall/zfs_allocation
			db_get axonwall/zfs_allocation || true
			zfs_alloc_choice="$RET"

			zfs_alloc_mode="none"
			zfs_gb=0
			root_gb="$remaining_gb"

			case "$zfs_alloc_choice" in
				"Allocate remaining"*)
					zfs_alloc_mode="remainder"
					if [ "$remaining_gb" -ge 48 ]; then
						root_gb=32
						zfs_gb=$(( remaining_gb - root_gb ))
					elif [ "$remaining_gb" -ge 24 ]; then
						root_gb=16
						zfs_gb=$(( remaining_gb - root_gb ))
					else
						zfs_alloc_mode="none"
						zfs_gb=0
					fi
					;;
				"Split remaining"*)
					zfs_alloc_mode="split"
					root_gb=$(( remaining_gb / 2 ))
					[ "$root_gb" -lt 8 ] && root_gb=8
					zfs_gb=$(( remaining_gb - root_gb ))
					if [ "$zfs_gb" -lt 4 ]; then
						zfs_gb=0
						zfs_alloc_mode="none"
						root_gb="$remaining_gb"
					fi
					;;
				"Custom ZFS"*)
					zfs_alloc_mode="custom"
					ask_critical axonwall/custom_zfs_size
					db_get axonwall/custom_zfs_size || true
					c_val="$(echo "$RET" | tr -dc '0-9')"
					if [ -n "$c_val" ] && [ "$c_val" -ge 1 ] && [ "$remaining_gb" -gt $(( c_val + 8 )) ]; then
						zfs_gb="$c_val"
						root_gb=$(( remaining_gb - zfs_gb ))
					else
						zfs_gb=0
						zfs_alloc_mode="none"
					fi
					;;
				*)
					zfs_alloc_mode="none"
					zfs_gb=0
					root_gb="$remaining_gb"
					;;
			esac

			root_mb=$(( root_gb * 1024 ))
			data_gb=0
			data_mb=0
			zfs_mb=$(( zfs_gb * 1024 ))
		elif [ "$partition_mode" = "auto" ]; then
			# Mode 1: Express Automated Partitioning (Zero Questions, Optimal Sizing)
			if [ "$disk_size_gb" -lt 30 ]; then
				root_gb=8
				swap_gb=1
			elif [ "$disk_size_gb" -le 120 ]; then
				root_gb=16
				swap_gb=2
			else
				root_gb=32
				swap_gb=4
			fi

			max_allowed_gb=$(( (disk_size_gb - 4) / 2 ))
			[ "$max_allowed_gb" -lt 6 ] && max_allowed_gb=6
			if [ "$root_gb" -gt "$max_allowed_gb" ] && [ "$disk_size_gb" -ge 16 ]; then
				root_gb="$max_allowed_gb"
			fi

			root_mb=$(( root_gb * 1024 ))
			swap_mb=$(( swap_gb * 1024 ))
			remaining_gb=$(( disk_size_gb - (root_gb * 2) - swap_gb - 1 ))
			[ "$remaining_gb" -lt 2 ] && remaining_gb=2
			data_gb="$remaining_gb"
			data_mb=$(( data_gb * 1024 ))
			data_alloc_mode="remainder"
			zfs_alloc_mode="none"
			zfs_gb=0
			zfs_mb=0
		elif [ "$partition_mode" = "guided" ] || [ "$partition_mode" = "manual" ]; then
			# Mode 2 & Mode 4: Guided / Manual (Prompt Root Size & Swap Size)
			if [ "$disk_size_gb" -lt 30 ]; then
				db_set axonwall/root_size "8 GB per slot (Compact - 16-32 GB embedded/eMMC)"
			fi

			ask_critical axonwall/root_size
			db_get axonwall/root_size || true
			root_choice="$RET"

			root_gb=16
			case "$root_choice" in
				8*|"Compact"*)
					root_gb=8
					;;
				32*|"Expanded"*)
					root_gb=32
					;;
				"Custom"*)
					ask_critical axonwall/custom_root_size
					db_get axonwall/custom_root_size || true
					val="$(echo "$RET" | tr -dc '0-9')"
					if [ -n "$val" ] && [ "$val" -ge 6 ]; then
						root_gb="$val"
					else
						root_gb=16
					fi
					;;
				*)
					root_gb=16
					;;
			esac

			max_allowed_gb=$(( (disk_size_gb - 4) / 2 ))
			[ "$max_allowed_gb" -lt 6 ] && max_allowed_gb=6
			if [ "$root_gb" -gt "$max_allowed_gb" ] && [ "$disk_size_gb" -ge 16 ]; then
				root_gb="$max_allowed_gb"
			fi

			ask_critical axonwall/swap_size
			db_get axonwall/swap_size || true
			swap_choice="$RET"

			swap_gb=2
			case "$swap_choice" in
				"No swap"*)
					swap_gb=0
					;;
				"4 GB"*)
					swap_gb=4
					;;
				"8 GB"*)
					swap_gb=8
					;;
				*)
					swap_gb=2
					;;
			esac

			root_mb=$(( root_gb * 1024 ))
			swap_mb=$(( swap_gb * 1024 ))
			remaining_gb=$(( disk_size_gb - (root_gb * 2) - swap_gb - 1 ))
			[ "$remaining_gb" -lt 2 ] && remaining_gb=2
			data_gb="$remaining_gb"
			data_mb=$(( data_gb * 1024 ))
			data_alloc_mode="remainder"
			zfs_alloc_mode="none"
			zfs_gb=0
			zfs_mb=0
		elif [ "$partition_mode" = "wizard" ]; then
			# Mode 3: Custom Storage Wizard
			ask_critical axonwall/custom_efi_size
			db_get axonwall/custom_efi_size || true
			c_efi="$(echo "$RET" | tr -dc '0-9')"
			if [ -n "$c_efi" ] && [ "$c_efi" -ge 128 ]; then
				efi_mb="$c_efi"
			fi

			ask_critical axonwall/root_fstype
			db_get axonwall/root_fstype || true
			case "$RET" in
				*"xfs"*) root_fstype="xfs" ;;
				*) root_fstype="ext4" ;;
			esac

			if [ "$disk_size_gb" -lt 30 ]; then
				db_set axonwall/root_size "8 GB per slot (Compact - 16-32 GB embedded/eMMC)"
			fi

			ask_critical axonwall/root_size
			db_get axonwall/root_size || true
			root_choice="$RET"

			root_gb=16
			case "$root_choice" in
				8*|"Compact"*)
					root_gb=8
					;;
				32*|"Expanded"*)
					root_gb=32
					;;
				"Custom"*)
					ask_critical axonwall/custom_root_size
					db_get axonwall/custom_root_size || true
					val="$(echo "$RET" | tr -dc '0-9')"
					if [ -n "$val" ] && [ "$val" -ge 6 ]; then
						root_gb="$val"
					else
						root_gb=16
					fi
					;;
				*)
					root_gb=16
					;;
			esac

			max_allowed_gb=$(( (disk_size_gb - 4) / 2 ))
			[ "$max_allowed_gb" -lt 6 ] && max_allowed_gb=6
			if [ "$root_gb" -gt "$max_allowed_gb" ] && [ "$disk_size_gb" -ge 16 ]; then
				root_gb="$max_allowed_gb"
			fi

			ask_critical axonwall/swap_size
			db_get axonwall/swap_size || true
			swap_choice="$RET"

			swap_gb=2
			case "$swap_choice" in
				"No swap"*)
					swap_gb=0
					;;
				"4 GB"*)
					swap_gb=4
					;;
				"8 GB"*)
					swap_gb=8
					;;
				*)
					swap_gb=2
					;;
			esac

			ask_critical axonwall/separate_log_partition
			db_get axonwall/separate_log_partition || true
			if [ "$RET" = "true" ]; then
				logs_enabled=1
				ask_critical axonwall/custom_log_size
				db_get axonwall/custom_log_size || true
				l_val="$(echo "$RET" | tr -dc '0-9')"
				logs_gb="${l_val:-20}"
				ask_critical axonwall/log_fstype
				db_get axonwall/log_fstype || true
				case "$RET" in
					*"ext4"*) logs_fstype="ext4" ;;
					*) logs_fstype="xfs" ;;
				esac
			fi

			ask_critical axonwall/data_alloc_mode
			db_get axonwall/data_alloc_mode || true
			case "$RET" in
				*"Explicit"*)
					data_alloc_mode="explicit"
					ask_critical axonwall/custom_data_size
					db_get axonwall/custom_data_size || true
					d_val="$(echo "$RET" | tr -dc '0-9')"
					data_gb="${d_val:-32}"
					;;
			esac

			ask_critical axonwall/data_fstype
			db_get axonwall/data_fstype || true
			case "$RET" in
				*"xfs"*) data_fstype="xfs" ;;
				*) data_fstype="ext4" ;;
			esac

			ask_critical axonwall/encryption_enabled
			db_get axonwall/encryption_enabled || true
			if [ "$RET" = "true" ]; then
				luks_enabled=1
				ask_critical axonwall/encryption_passphrase
				db_get axonwall/encryption_passphrase || true
				luks_passphrase="$RET"
				ask_critical axonwall/tpm2_unlock
				db_get axonwall/tpm2_unlock || true
				[ "$RET" = "true" ] && luks_tpm2=1
			fi

			root_mb=$(( root_gb * 1024 ))
			swap_mb=$(( swap_gb * 1024 ))

			remaining_gb=$(( disk_size_gb - (root_gb * 2) - swap_gb - logs_gb - 1 ))
			if [ "$remaining_gb" -lt 4 ]; then
				remaining_gb=4
			fi

			ask_critical axonwall/zfs_allocation
			db_get axonwall/zfs_allocation || true
			zfs_alloc_choice="$RET"

			zfs_alloc_mode="remainder"
			zfs_gb=0
			data_gb=16
			if [ "$remaining_gb" -lt 24 ]; then
				data_gb=8
			fi

			case "$zfs_alloc_choice" in
				"Allocate remaining"*)
					zfs_alloc_mode="remainder"
					if [ "$remaining_gb" -gt "$data_gb" ]; then
						zfs_gb=$(( remaining_gb - data_gb ))
					else
						zfs_gb=0
						zfs_alloc_mode="none"
					fi
					;;
				"Split remaining"*)
					zfs_alloc_mode="split"
					data_gb=$(( remaining_gb / 2 ))
					if [ "$data_gb" -lt 4 ]; then
						data_gb=4
					fi
					zfs_gb=$(( remaining_gb - data_gb ))
					if [ "$zfs_gb" -lt 2 ]; then
						zfs_gb=0
						zfs_alloc_mode="none"
					fi
					;;
				"Custom ZFS"*)
					zfs_alloc_mode="custom"
					ask_critical axonwall/custom_zfs_size
					db_get axonwall/custom_zfs_size || true
					c_val="$(echo "$RET" | tr -dc '0-9')"
					if [ -n "$c_val" ] && [ "$c_val" -ge 1 ]; then
						max_zfs_gb=$(( remaining_gb - 4 ))
						if [ "$max_zfs_gb" -lt 1 ]; then
							max_zfs_gb=1
						fi
						if [ "$c_val" -gt "$max_zfs_gb" ]; then
							zfs_gb="$max_zfs_gb"
						else
							zfs_gb="$c_val"
						fi
						data_gb=$(( remaining_gb - zfs_gb ))
					else
						zfs_gb=0
						zfs_alloc_mode="none"
					fi
					;;
				*)
					zfs_alloc_mode="none"
					zfs_gb=0
					data_gb="$remaining_gb"
					;;
			esac

			data_mb=$(( data_gb * 1024 ))
			zfs_mb=$(( zfs_gb * 1024 ))
		fi

		# Offer any remaining secondary disks for the 'tank' OpenZFS storage pool across all non-manual modes
		if [ "$partition_mode" != "manual" ]; then
			extra_candidates=""
			for d in $(get_auto_disks | cut -f1); do
				[ -d "$d" ] && [ -f "$d/device" ] || continue
				d_dev="$(cat "$d/device" 2>/dev/null || true)"
				if [ -n "$seed_dev" ] && { [ "$d_dev" = "$seed_dev" ] || [ "$d_dev" = "$seed_disk" ]; }; then
					continue
				fi
				is_sys=0
				for s_dev in $system_raid_disks; do
					if [ "$d_dev" = "$s_dev" ]; then
						is_sys=1
						break
					fi
				done
				if [ "$is_sys" -eq 0 ] && [ -n "$d_dev" ]; then
					if [ -z "$extra_candidates" ]; then
						extra_candidates="$d_dev"
					else
						extra_candidates="${extra_candidates}, ${d_dev}"
					fi
				fi
			done

			zfs_extra_disks=""
			if [ -n "$extra_candidates" ]; then
				db_subst axonwall/zfs_extra_disks CHOICES "$extra_candidates" || true
				ask_critical axonwall/zfs_extra_disks
				db_get axonwall/zfs_extra_disks || true
				zfs_extra_disks="$(echo "$RET" | tr -d ',' | tr -s ' ')"
			fi

			zfs_vdev_count=0
			if [ "$zfs_mb" -gt 0 ]; then
				for _s in $system_raid_disks; do
					zfs_vdev_count=$(( zfs_vdev_count + 1 ))
				done
			fi
			for _e in $zfs_extra_disks; do
				zfs_vdev_count=$(( zfs_vdev_count + 1 ))
			done

			zfs_raid_topology="auto"
			if [ "$zfs_vdev_count" -ge 1 ]; then
				ask_critical axonwall/zfs_raid_topology
				db_get axonwall/zfs_raid_topology || true
				case "$RET" in
					"Stripe"*) zfs_raid_topology="stripe" ;;
					"Mirror"*) zfs_raid_topology="mirror" ;;
					"RAID-Z1"*) zfs_raid_topology="raidz1" ;;
					"RAID-Z2"*) zfs_raid_topology="raidz2" ;;
					"RAID-Z3"*) zfs_raid_topology="raidz3" ;;
					"dRAID1"*) zfs_raid_topology="draid1" ;;
					"dRAID2"*) zfs_raid_topology="draid2" ;;
					*) zfs_raid_topology="auto" ;;
				esac
			fi
		fi
	fi

	disks="$dev_name"
	db_set partman-auto/disk "$dev_name"

	if [ -n "$dev_name" ]; then
		db_set grub-installer/bootdev "$dev_name" 2>/dev/null || true
		db_set grub-installer/choose_bootdev "$dev_name" 2>/dev/null || true
	fi

	# Default to modern GPT partition table layout
	db_set partman-partitioning/default_label "gpt" 2>/dev/null || true
	db_set partman-partitioning/choose_label "gpt" 2>/dev/null || true

	# 7. Persist installer partition & RAID choices for finish-install hook
	logs_mb=$(( logs_gb * 1024 ))
	mkdir -p /var/lib/partman
	chmod 0700 /var/lib/partman

	# Write sensitive passphrase to a dedicated mode-0600 file
	if [ -n "$luks_passphrase" ]; then
		printf '%s' "$luks_passphrase" > /var/lib/partman/axonwall-luks.pass
		chmod 0600 /var/lib/partman/axonwall-luks.pass
	fi

	sh_esc() {
		printf "'%s'" "$(echo "$1" | sed "s/'/'\\\\''/g")"
	}

	cat << EOF > /var/lib/partman/axonwall-choices
PARTITION_MODE=$(sh_esc "${partition_mode}")
INSTALL_MODE=$(sh_esc "${install_mode}")
ROOT_GB=${root_gb}
ROOT_MB=${root_mb}
ROOT_FSTYPE=$(sh_esc "${root_fstype}")
EFI_MB=${efi_mb}
SWAP_GB=${swap_gb}
SWAP_MB=${swap_mb}
DATA_GB=${data_gb}
DATA_MB=${data_mb}
DATA_FSTYPE=$(sh_esc "${data_fstype}")
DATA_ALLOC_MODE=$(sh_esc "${data_alloc_mode}")
LOGS_ENABLED=${logs_enabled}
LOGS_GB=${logs_gb}
LOGS_MB=${logs_mb}
LOGS_FSTYPE=$(sh_esc "${logs_fstype}")
LUKS_ENABLED=${luks_enabled}
LUKS_TPM2=${luks_tpm2}
ZFS_ALLOC_MODE=$(sh_esc "${zfs_alloc_mode}")
ZFS_GB=${zfs_gb}
ZFS_MB=${zfs_mb}
TARGET_DISK=$(sh_esc "${dev_name}")
SYSTEM_RAID_MODE=$(sh_esc "${system_raid_mode}")
SYSTEM_RAID_DISKS=$(sh_esc "${system_raid_disks}")
ZFS_EXTRA_DISKS=$(sh_esc "${zfs_extra_disks}")
ZFS_RAID_TOPOLOGY=$(sh_esc "${zfs_raid_topology}")
EOF
	chmod 0600 /var/lib/partman/axonwall-choices

	# 8. Dynamically construct partition recipe (ZFSBootMenu Root-on-ZFS vs Rolling Single-Root vs A/B Dual-Root)
	if [ "$install_mode" = "zbm" ]; then
		cat << RECIPE_ZBM > /tmp/axonwall-ab-recipe
axonwall-ab ::
	1 1 1 free
		\$iflabel{ gpt }
		\$reusemethod{ }
		method{ biosgrub } .
	${efi_mb} ${efi_mb} ${efi_mb} free
		\$primary{ }
		\$iflabel{ msdos gpt }
		\$reusemethod{ }
		method{ efi }
		format{ } .
	1024 10000 -1 ext4
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ext4 }
		mountpoint{ / } .
RECIPE_ZBM
	elif [ "$install_mode" = "rolling" ]; then
		cat << RECIPE_ROLLING_HEADER > /tmp/axonwall-ab-recipe
axonwall-ab ::
	1 1 1 free
		\$iflabel{ gpt }
		\$reusemethod{ }
		method{ biosgrub } .
	${efi_mb} ${efi_mb} ${efi_mb} free
		\$primary{ }
		\$iflabel{ msdos gpt }
		\$reusemethod{ }
		method{ efi }
		format{ } .
RECIPE_ROLLING_HEADER

		if [ "$swap_mb" -gt 0 ]; then
			cat << SWAP_ROLLING_BLOCK >> /tmp/axonwall-ab-recipe
	512 ${swap_mb} ${swap_mb} linux-swap
		method{ swap }
		format{ } .
SWAP_ROLLING_BLOCK
		fi

		if [ "$logs_enabled" -eq 1 ] && [ "$logs_mb" -gt 0 ]; then
			cat << LOGS_ROLLING_BLOCK >> /tmp/axonwall-ab-recipe
	512 ${logs_mb} ${logs_mb} ${logs_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${logs_fstype} }
		mountpoint{ /var/log } .
LOGS_ROLLING_BLOCK
		fi

		if [ "$zfs_mb" -gt 0 ]; then
			if [ "$zfs_alloc_mode" = "custom" ]; then
				cat << ROOT_ZFS_CUSTOM_BLOCK >> /tmp/axonwall-ab-recipe
	4096 ${root_mb} ${root_mb} ${root_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${root_fstype} }
		mountpoint{ / } .
	1024 ${zfs_mb} ${zfs_mb} ext4
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ext4 } .
ROOT_ZFS_CUSTOM_BLOCK
			else
				cat << ROOT_ZFS_REM_BLOCK >> /tmp/axonwall-ab-recipe
	4096 ${root_mb} ${root_mb} ${root_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${root_fstype} }
		mountpoint{ / } .
	1024 10000 -1 ext4
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ext4 } .
ROOT_ZFS_REM_BLOCK
			fi
		else
			cat << ROOT_FULL_BLOCK >> /tmp/axonwall-ab-recipe
	4096 10000 -1 ${root_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${root_fstype} }
		mountpoint{ / } .
ROOT_FULL_BLOCK
		fi
	else
		cat << RECIPE_CONTENT > /tmp/axonwall-ab-recipe
axonwall-ab ::
	1 1 1 free
		\$iflabel{ gpt }
		\$reusemethod{ }
		method{ biosgrub } .
	${efi_mb} ${efi_mb} ${efi_mb} free
		\$primary{ }
		\$iflabel{ msdos gpt }
		\$reusemethod{ }
		method{ efi }
		format{ } .
	4096 ${root_mb} ${root_mb} ${root_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${root_fstype} }
		mountpoint{ / } .
	4096 ${root_mb} ${root_mb} ${root_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${root_fstype} }
		mountpoint{ /mnt/standby } .
RECIPE_CONTENT

		if [ "$swap_mb" -gt 0 ]; then
			cat << SWAP_BLOCK >> /tmp/axonwall-ab-recipe
	512 ${swap_mb} ${swap_mb} linux-swap
		method{ swap }
		format{ } .
SWAP_BLOCK
		fi

		if [ "$logs_enabled" -eq 1 ] && [ "$logs_mb" -gt 0 ]; then
			cat << LOGS_BLOCK >> /tmp/axonwall-ab-recipe
	512 ${logs_mb} ${logs_mb} ${logs_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${logs_fstype} }
		mountpoint{ /var/log } .
LOGS_BLOCK
		fi

		if [ "$zfs_mb" -gt 0 ]; then
			if [ "$zfs_alloc_mode" = "custom" ] || [ "$data_alloc_mode" = "explicit" ]; then
				cat << DATA_ZFS_CUSTOM_BLOCK >> /tmp/axonwall-ab-recipe
	512 ${data_mb} ${data_mb} ${data_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${data_fstype} }
		mountpoint{ /var/lib/axonwall } .
	1024 ${zfs_mb} ${zfs_mb} ext4
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ext4 } .
DATA_ZFS_CUSTOM_BLOCK
			else
				cat << DATA_ZFS_REM_BLOCK >> /tmp/axonwall-ab-recipe
	512 ${data_mb} ${data_mb} ${data_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${data_fstype} }
		mountpoint{ /var/lib/axonwall } .
	1024 10000 -1 ext4
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ext4 } .
DATA_ZFS_REM_BLOCK
			fi
		else
			if [ "$data_alloc_mode" = "explicit" ]; then
				cat << DATA_EXPLICIT_BLOCK >> /tmp/axonwall-ab-recipe
	512 ${data_mb} ${data_mb} ${data_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${data_fstype} }
		mountpoint{ /var/lib/axonwall } .
DATA_EXPLICIT_BLOCK
			else
				cat << DATA_BLOCK >> /tmp/axonwall-ab-recipe
	512 10000 -1 ${data_fstype}
		method{ format }
		format{ }
		use_filesystem{ }
		filesystem{ ${data_fstype} }
		mountpoint{ /var/lib/axonwall } .
DATA_BLOCK
			fi
		fi
	fi

	cp /tmp/axonwall-ab-recipe /tmp/expert_recipe 2>/dev/null || true
	for rdir in /lib/partman/recipes /lib/partman/recipes-amd64 /lib/partman/recipes-amd64-efi; do
		mkdir -p "$rdir"
		cp /tmp/axonwall-ab-recipe "${rdir}/30axonwall-ab" 2>/dev/null || true
	done

	# CRITICAL: Do NOT store the multi-line recipe string into debconf partman-auto/expert_recipe!
	# In the cdebconf text protocol, unescaped newlines terminate the SET command early,
	# truncating the recipe to just 'axonwall-ab ::' and destroying all partition definitions.
	# We clear expert_recipe and point expert_recipe_file directly to /tmp/axonwall-ab-recipe.
	db_reset partman-auto/expert_recipe 2>/dev/null || true
	db_set partman-auto/expert_recipe "" 2>/dev/null || true
	db_set partman-auto/expert_recipe_file "/tmp/axonwall-ab-recipe" 2>/dev/null || true
	db_set partman-auto/choose_recipe "axonwall-ab" 2>/dev/null || true

	# Perform autopartitioning directly on the primary chosen disk
	autopartition "$disk"
	status=$?

	if [ "$partition_mode" = "manual" ]; then
		# Manual mode: Let operator edit partitions interactively in Debian partman UI
		db_reset partman/choose_partition 2>/dev/null || true
		db_fset partman/choose_partition seen false 2>/dev/null || true
		db_set partman/confirm false 2>/dev/null || true
		db_fset partman/confirm seen false 2>/dev/null || true
		db_set partman/confirm_nooverwrite false 2>/dev/null || true
		db_fset partman/confirm_nooverwrite seen false 2>/dev/null || true
		# Exiting 0 tells partman display.d loop to advance to 60choose_partition (the manual editor)
		exit 0
	else
		# Automated, Guided, or Custom Wizard: Auto-commit and advance straight to base installation
		db_set partman/choose_partition "finish" 2>/dev/null || true
		db_fset partman/choose_partition seen true 2>/dev/null || true
		db_set partman/confirm true 2>/dev/null || true
		db_fset partman/confirm seen true 2>/dev/null || true
		db_set partman/confirm_nooverwrite true 2>/dev/null || true
		db_fset partman/confirm_nooverwrite seen true 2>/dev/null || true

		# In partman display.d loop:
		#   $s || { exitcode=$?; if [ $exitcode -ge 100 ]; then break; else continue 2; fi }
		# Exiting with code >= 100 signals successful completion and advances straight to check.d/commit.d
		if [ $status -eq 0 ]; then
			exit 100
		fi
		rm -f /var/lib/partman/initial_auto
		exit $status
	fi
fi

# If both method and disks are already preseeded, proceed with autopartition
if [ "$method" ] && [ "$disks" ]; then
	case "$method" in
	    regular)
		for disk in $disks; do
			if [ -d "$disk" ] && [ -f "$disk/device" ]; then
				autopartition "$disk"
				exit 100
			fi
			id=$(dev_to_partman "$disk") || true
			if [ -z "$id" ]; then
				id="$disk"
			fi
			if [ "$id" ]; then
				autopartition "$id"
				exit 100
			fi
		done
		exit 1
		;;
	    lvm)
		search-path autopartition-lvm || exit 1
		ids=""
		for disk in $disks; do
			id=$(dev_to_partman "$disk") || true
			if [ -z "$id" ]; then
				id="$disk"
			fi
			ids="${ids:+$ids }$id"
		done
		if [ "$ids" ]; then
			autopartition-lvm "$ids"
			exit 0
		fi
		exit 1
		;;
	    crypto)
		search-path autopartition-crypto || exit 1
		for disk in $disks; do
			id=$(dev_to_partman "$disk") || true
			if [ -z "$id" ]; then
				id="$disk"
			fi
			if [ "$id" ]; then
				autopartition-crypto "$id"
				exit 0
			fi
		done
		exit 1
		;;
	    raid)
		ids=""
		for disk in $disks; do
			id=$(dev_to_partman "$disk") || true
			if [ -z "$id" ]; then
				id="$disk"
			fi
			ids="${ids:+$ids }$id"
		done
		auto_init_disks $ids || exit $?
		autopartition "$ids"
		exit 0
		;;
	    *)
		logger -t partman-auto "Unsupported method '$method'"
		exit 1
		;;
	esac
fi

qfile=/lib/partman/automatically_partition/question
echo "partman-auto/init_automatically_partition" >$qfile
code=99 # signals a retry
while [ $code = 99 ]; do
	ask_user /lib/partman/automatically_partition
	code=$?
done
if [ $code -gt 0 ] && [ $code -lt 100 ]; then
	rm -f /var/lib/partman/initial_auto # try again
fi
echo "partman-auto/automatically_partition" >$qfile
exit $code
