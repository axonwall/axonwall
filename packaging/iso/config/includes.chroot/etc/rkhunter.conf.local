# =============================================================================
# Axonwall Rootkit Hunter (rkhunter) Local Hardening Configuration
# File: /etc/rkhunter.conf.local
# =============================================================================
MIRRORS_MODE=0
UPDATE_MIRRORS=1
WEB_CMD=""
AUTO_X_DETECT=1
ALLOW_SSH_ROOT_USER=no
ALLOW_SSH_PROT_V1=0
ENABLE_TESTS=ALL
DISABLE_TESTS=suspscan,deleted_files
HASH_CMD=SHA256
PKGMGR=DPKG
ALLOWDEVFILE=/dev/shm/axonwall-*
SYSLOG_ON_WARNING=1
