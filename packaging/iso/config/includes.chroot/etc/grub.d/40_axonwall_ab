#!/bin/sh
# Axonwall A/B Dual-Root Bootloader Script with Automated Watchdog Fallback
# Automatically generated by Axonwall packaging system

# Skip A/B Dual-Root GRUB menu generation on Rolling Single-Root installations
if [ -f /etc/axonwall/install-mode ] && grep -qi 'rolling' /etc/axonwall/install-mode 2>/dev/null; then
  exit 0
fi
if [ ! -e /dev/disk/by-label/axon_root_b ] && ! blkid -L axon_root_b >/dev/null 2>&1; then
  exit 0
fi

cat << 'EOF'
# Load GRUB environment variables
load_env -f /boot/grub/grubenv

# Set defaults if grubenv variables are unset
if [ -z "${active_slot}" ]; then
    set active_slot="A"
fi
if [ -z "${bootcount}" ]; then
    set bootcount=0
fi
if [ -z "${bootlimit}" ]; then
    set bootlimit=3
fi

# Fallback evaluation: If boot attempts exceed bootlimit, switch slots automatically
if [ "${bootcount}" -ge "${bootlimit}" ]; then
    echo "================================================================================"
    echo "AXONWALL WATCHDOG ALERT: Boot limit exceeded on Slot ${active_slot} (${bootcount}/${bootlimit})"
    echo "Triggering automated fallback to alternate slot to prevent appliance lockout..."
    echo "================================================================================"
    sleep 2
    if [ "${active_slot}" = "A" ]; then
        set active_slot="B"
    else
        set active_slot="A"
    fi
    set bootcount=0
    save_env -f /boot/grub/grubenv active_slot bootcount
fi

# Increment bootcount for the upcoming boot attempt.
# Upon successful boot, axonwalld watchdog resets bootcount=0.
if [ "${bootcount}" = "0" ]; then
    set bootcount=1
elif [ "${bootcount}" = "1" ]; then
    set bootcount=2
elif [ "${bootcount}" = "2" ]; then
    set bootcount=3
else
    set bootcount=3
fi
save_env -f /boot/grub/grubenv bootcount

# Configure boot entries based on active slot
if [ "${active_slot}" = "A" ]; then
    set default="axonwall-slot-a"
    set timeout=3

    menuentry "Axonwall OS (Slot A - Primary Active)" --class debian --class gnu-linux --class gnu --class os --id axonwall-slot-a {
        insmod gzio
        insmod part_gpt
        insmod ext2
        insmod regexp
        search --no-floppy --label --set=root axon_root_a
        set kfile=""
        if [ -f /boot/vmlinuz ]; then
            set kfile="/boot/vmlinuz"
        elif [ -f /vmlinuz ]; then
            set kfile="/vmlinuz"
        else
            for f in /boot/vmlinuz* /vmlinuz*; do
                if [ -f "$f" ]; then
                    set kfile="$f"
                fi
            done
        fi
        set ifile=""
        if [ -f /boot/initrd.img ]; then
            set ifile="/boot/initrd.img"
        elif [ -f /initrd.img ]; then
            set ifile="/initrd.img"
        else
            for f in /boot/initrd.img* /boot/initramfs* /initrd.img*; do
                if [ -f "$f" ]; then
                    set ifile="$f"
                fi
            done
        fi
        if [ -z "$kfile" ]; then
            set kfile="/boot/vmlinuz"
        fi
        if [ -z "$ifile" ]; then
            set ifile="/boot/initrd.img"
        fi
        linux ${kfile} root=LABEL=axon_root_a ro quiet console=tty0 console=ttyS0,115200 slot=A
        initrd ${ifile}
    }

    menuentry "Axonwall OS (Slot B - Alternate Standby)" --class debian --class gnu-linux --class gnu --class os --id axonwall-slot-b {
        insmod gzio
        insmod part_gpt
        insmod ext2
        insmod regexp
        search --no-floppy --label --set=root axon_root_b
        set kfile=""
        if [ -f /boot/vmlinuz ]; then
            set kfile="/boot/vmlinuz"
        elif [ -f /vmlinuz ]; then
            set kfile="/vmlinuz"
        else
            for f in /boot/vmlinuz* /vmlinuz*; do
                if [ -f "$f" ]; then
                    set kfile="$f"
                fi
            done
        fi
        set ifile=""
        if [ -f /boot/initrd.img ]; then
            set ifile="/boot/initrd.img"
        elif [ -f /initrd.img ]; then
            set ifile="/initrd.img"
        else
            for f in /boot/initrd.img* /boot/initramfs* /initrd.img*; do
                if [ -f "$f" ]; then
                    set ifile="$f"
                fi
            done
        fi
        if [ -z "$kfile" ]; then
            set kfile="/boot/vmlinuz"
        fi
        if [ -z "$ifile" ]; then
            set ifile="/boot/initrd.img"
        fi
        linux ${kfile} root=LABEL=axon_root_b ro quiet console=tty0 console=ttyS0,115200 slot=B
        initrd ${ifile}
    }
else
    set default="axonwall-slot-b"
    set timeout=3

    menuentry "Axonwall OS (Slot B - Primary Active)" --class debian --class gnu-linux --class gnu --class os --id axonwall-slot-b {
        insmod gzio
        insmod part_gpt
        insmod ext2
        insmod regexp
        search --no-floppy --label --set=root axon_root_b
        set kfile=""
        if [ -f /boot/vmlinuz ]; then
            set kfile="/boot/vmlinuz"
        elif [ -f /vmlinuz ]; then
            set kfile="/vmlinuz"
        else
            for f in /boot/vmlinuz* /vmlinuz*; do
                if [ -f "$f" ]; then
                    set kfile="$f"
                fi
            done
        fi
        set ifile=""
        if [ -f /boot/initrd.img ]; then
            set ifile="/boot/initrd.img"
        elif [ -f /initrd.img ]; then
            set ifile="/initrd.img"
        else
            for f in /boot/initrd.img* /boot/initramfs* /initrd.img*; do
                if [ -f "$f" ]; then
                    set ifile="$f"
                fi
            done
        fi
        if [ -z "$kfile" ]; then
            set kfile="/boot/vmlinuz"
        fi
        if [ -z "$ifile" ]; then
            set ifile="/boot/initrd.img"
        fi
        linux ${kfile} root=LABEL=axon_root_b ro quiet console=tty0 console=ttyS0,115200 slot=B
        initrd ${ifile}
    }

    menuentry "Axonwall OS (Slot A - Alternate Standby)" --class debian --class gnu-linux --class gnu --class os --id axonwall-slot-a {
        insmod gzio
        insmod part_gpt
        insmod ext2
        insmod regexp
        search --no-floppy --label --set=root axon_root_a
        set kfile=""
        if [ -f /boot/vmlinuz ]; then
            set kfile="/boot/vmlinuz"
        elif [ -f /vmlinuz ]; then
            set kfile="/vmlinuz"
        else
            for f in /boot/vmlinuz* /vmlinuz*; do
                if [ -f "$f" ]; then
                    set kfile="$f"
                fi
            done
        fi
        set ifile=""
        if [ -f /boot/initrd.img ]; then
            set ifile="/boot/initrd.img"
        elif [ -f /initrd.img ]; then
            set ifile="/initrd.img"
        else
            for f in /boot/initrd.img* /boot/initramfs* /initrd.img*; do
                if [ -f "$f" ]; then
                    set ifile="$f"
                fi
            done
        fi
        if [ -z "$kfile" ]; then
            set kfile="/boot/vmlinuz"
        fi
        if [ -z "$ifile" ]; then
            set ifile="/boot/initrd.img"
        fi
        linux ${kfile} root=LABEL=axon_root_a ro quiet console=tty0 console=ttyS0,115200 slot=A
        initrd ${ifile}
    }
fi
EOF
