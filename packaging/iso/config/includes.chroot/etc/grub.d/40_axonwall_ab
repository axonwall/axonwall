#!/bin/sh
# Axonwall A/B Dual-Root Bootloader Script with Automated Watchdog Fallback
# Automatically generated by Axonwall packaging system

cat << 'EOF'
# Load GRUB environment variables
load_env -f /boot/grub/grubenv

# Set defaults if grubenv variables are unset
if [ -z "${active_slot}" ]; then
    set active_slot="A"
fi
if [ -z "${bootcount}" ]; then
    set bootcount=0
fi
if [ -z "${bootlimit}" ]; then
    set bootlimit=3
fi

# Fallback evaluation: If boot attempts exceed bootlimit, switch slots automatically
if [ "${bootcount}" -ge "${bootlimit}" ]; then
    echo "================================================================================"
    echo "AXONWALL WATCHDOG ALERT: Boot limit exceeded on Slot ${active_slot} (${bootcount}/${bootlimit})"
    echo "Triggering automated fallback to alternate slot to prevent appliance lockout..."
    echo "================================================================================"
    sleep 2
    if [ "${active_slot}" = "A" ]; then
        set active_slot="B"
    else
        set active_slot="A"
    fi
    set bootcount=0
    save_env -f /boot/grub/grubenv active_slot bootcount
fi

# Increment bootcount for the upcoming boot attempt.
# Upon successful boot, axonwalld watchdog resets bootcount=0.
eval "set bootcount=${bootcount}+1"
save_env -f /boot/grub/grubenv bootcount

# Configure boot entries based on active slot
if [ "${active_slot}" = "A" ]; then
    set default="0"
    set timeout=3

    menuentry "Axonwall OS (Slot A - Primary Active)" --class debian --class gnu-linux --class gnu --class os {
        insmod gzio
        insmod part_gpt
        insmod ext2
        search --no-floppy --label --set=root axon_root_a
        linux /boot/vmlinuz root=LABEL=axon_root_a ro quiet console=tty0 console=ttyS0,115200 slot=A
        initrd /boot/initrd.img
    }

    menuentry "Axonwall OS (Slot B - Alternate Standby)" --class debian --class gnu-linux --class gnu --class os {
        insmod gzio
        insmod part_gpt
        insmod ext2
        search --no-floppy --label --set=root axon_root_b
        linux /boot/vmlinuz root=LABEL=axon_root_b ro quiet console=tty0 console=ttyS0,115200 slot=B
        initrd /boot/initrd.img
    }
else
    set default="0"
    set timeout=3

    menuentry "Axonwall OS (Slot B - Primary Active)" --class debian --class gnu-linux --class gnu --class os {
        insmod gzio
        insmod part_gpt
        insmod ext2
        search --no-floppy --label --set=root axon_root_b
        linux /boot/vmlinuz root=LABEL=axon_root_b ro quiet console=tty0 console=ttyS0,115200 slot=B
        initrd /boot/initrd.img
    }

    menuentry "Axonwall OS (Slot A - Alternate Standby)" --class debian --class gnu-linux --class gnu --class os {
        insmod gzio
        insmod part_gpt
        insmod ext2
        search --no-floppy --label --set=root axon_root_a
        linux /boot/vmlinuz root=LABEL=axon_root_a ro quiet console=tty0 console=ttyS0,115200 slot=A
        initrd /boot/initrd.img
    }
fi
EOF
