[Unit]
Description=Axonwall Firstboot Appliance Provisioner
After=network.target cloud-init.service
Before=axonwall-controller.service axonwall-ui.service headscale.service
ConditionPathExists=/etc/axonwall/.firstboot
ConditionKernelCommandLine=!axonwall_install=1
ConditionKernelCommandLine=!axonwall.install=1
ConditionKernelCommandLine=!axonwall.unattended=1

[Service]
Type=oneshot
ExecStart=/usr/local/bin/axonwall-firstboot
RemainAfterExit=yes
# Firstboot now clones the booted root slot to the standby slot on cloud
# images (step 1.1 in axonwall-firstboot), an rsync of ~1 GB that alone
# can exceed systemd's 90 s default start timeout on slow disks; 15 min
# bounds the whole run while leaving room for that copy.
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
