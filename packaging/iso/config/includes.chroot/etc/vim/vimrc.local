" ==============================================================================
" Axonwall Appliance Modern VIM Configuration (/etc/vim/vimrc.local)
" Optimized for editing /etc/axonwall/*.yaml, nftables rulesets, and logs
" ==============================================================================

syntax on
filetype plugin indent on

set nocompatible
set encoding=utf-8
set background=dark
set number
set ruler
set showcmd
set showmode
set laststatus=2
set wildmenu
set wildmode=longest:full,full
set scrolloff=4
set sidescrolloff=8
set hidden
set backspace=indent,eol,start

" Search ergonomics
set incsearch
set hlsearch
set ignorecase
set smartcase

" 2-space soft-tab indentation standard (prevents YAML tab errors in /etc/axonwall/*.yaml)
set expandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set autoindent
set smartindent

" Statusline showing filename, modified flag, filetype, and line/col
set statusline=%F%m%r%h%w\ [%{&ff}/%Y]\ %=[Line:\ %l/%L,\ Col:\ %c]\ (%p%%)

" Restore cursor to last known position when reopening a file
if has("autocmd")
  au BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
  au FileType yaml,yml setlocal ts=2 sts=2 sw=2 expandtab
endif
