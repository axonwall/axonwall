#!/bin/sh
# ==============================================================================
# Axonwall Appliance Firmware & System Updater (Debian 13 Dual-Root A/B)
# ==============================================================================
set -eu

usage() {
  cat << 'USAGE_EOF'
Usage: axonwall-update [--slot A|B] [--version <ver>] [--channel <name>] [--rolling] [--zbm|--zfsbootmenu] [--btrfs|--snapper] [--apt|--apt-upgrade] [--allow-unsigned] [--allow-downgrade]
  --slot A|B          Target dual-root slot (default B)
  --version <ver>     Release version to stage (required for ZBM updates)
  --channel <name>    Release channel (default stable)
  --rolling           In-place rolling update (single-root)
  --zbm               ZFSBootMenu Boot Environment update
  --btrfs             Btrfs + Snapper pre/post snapshot update
  --apt               Also run an APT upgrade
  --allow-unsigned    Allow SHA-256 + TLS verification when no release signing key is installed
  --allow-downgrade   Allow installing a version older than /etc/axonwall/version
USAGE_EOF
}

cleanup_work_dir() {
  _rc=$?
  set +e
  trap - EXIT INT TERM
  if [ -n "${WORK_DIR:-}" ] && [ -d "${WORK_DIR}" ]; then
    if [ -r /proc/mounts ]; then
      _mpts="$(awk -v p="${WORK_DIR}/" 'index($2, p) == 1 {print $2}' /proc/mounts 2>/dev/null || true)"
      for _mp in $_mpts; do
        umount "$_mp" 2>/dev/null || umount -l "$_mp" 2>/dev/null || true
      done
    fi
    for _mp in "${ZBM_STAGE_MNT:-}" "${STAGE_DIR:-}" "${SLOT_A_MNT:-}"; do
      if [ -n "$_mp" ] && [ -d "$_mp" ]; then
        if command -v mountpoint >/dev/null 2>&1 && mountpoint -q "$_mp" 2>/dev/null; then
          umount "$_mp" 2>/dev/null || umount -l "$_mp" 2>/dev/null || true
        fi
      fi
    done
    _still_mounted=0
    if [ -r /proc/mounts ] && awk -v p="${WORK_DIR}/" 'index($2, p) == 1 {found=1} END {exit !found}' /proc/mounts 2>/dev/null; then
      _still_mounted=1
    fi
    if [ "$_still_mounted" = "0" ]; then
      rm -rf "${WORK_DIR}" 2>/dev/null || true
    else
      echo "[!] WARNING: leaving ${WORK_DIR} because a submount could not be unmounted." >&2
    fi
  fi
  return "$_rc"
}

validate_semver() {
  _vs_ver="$1"
  [ -n "$_vs_ver" ] || return 1
  case "$_vs_ver" in
    *..*|*[[:space:]]*|*/*) return 1 ;;
  esac
  printf '%s\n' "$_vs_ver" | LC_ALL=C awk '
    BEGIN { ok = 0 }
    NR > 1 { ok = 0; exit 1 }
    /^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$/ { ok = 1 }
    END { exit (ok && NR == 1) ? 0 : 1 }
  '
}

# Compare two validated semantic versions; prints -1 (a<b), 0 (a==b), or 1 (a>b).
semver_compare() {
  _sc_a="$1"
  _sc_b="$2"
  LC_ALL=C awk -v a="$_sc_a" -v b="$_sc_b" '
    function cmp_str(x, y) {
      if (x == y) return 0
      return (x < y) ? -1 : 1
    }
    BEGIN {
      ha = index(a, "-")
      if (ha > 0) { core_a = substr(a, 1, ha - 1); pre_a = substr(a, ha + 1) }
      else { core_a = a; pre_a = "" }

      hb = index(b, "-")
      if (hb > 0) { core_b = substr(b, 1, hb - 1); pre_b = substr(b, hb + 1) }
      else { core_b = b; pre_b = "" }

      na = split(core_a, ca, ".")
      nb = split(core_b, cb, ".")
      max_n = (na > nb) ? na : nb
      for (i = 1; i <= max_n; i++) {
        va = (i <= na) ? ca[i] : "0"
        vb = (i <= nb) ? cb[i] : "0"
        if (va ~ /^[0-9]+$/ && vb ~ /^[0-9]+$/) {
          if (va + 0 < vb + 0) { print -1; exit 0 }
          if (va + 0 > vb + 0) { print 1; exit 0 }
        } else {
          r = cmp_str(va, vb)
          if (r != 0) { print r; exit 0 }
        }
      }

      if (pre_a == "" && pre_b == "") { print 0; exit 0 }
      if (pre_a == "" && pre_b != "") { print 1; exit 0 }
      if (pre_a != "" && pre_b == "") { print -1; exit 0 }

      npa = split(pre_a, pa, ".")
      npb = split(pre_b, pb, ".")
      min_p = (npa < npb) ? npa : npb
      for (i = 1; i <= min_p; i++) {
        if (pa[i] == pb[i]) continue
        numa = (pa[i] ~ /^[0-9]+$/)
        numb = (pb[i] ~ /^[0-9]+$/)
        if (numa && numb) {
          print (pa[i] + 0 < pb[i] + 0) ? -1 : 1
          exit 0
        }
        if (numa && !numb) { print -1; exit 0 }
        if (!numa && numb) { print 1; exit 0 }
        print cmp_str(pa[i], pb[i])
        exit 0
      }
      if (npa < npb) { print -1; exit 0 }
      if (npa > npb) { print 1; exit 0 }
      print 0
    }
  '
}

check_downgrade() {
  _cd_target="$1"
  _cd_running="$2"
  _cd_allow="${3:-0}"
  [ -n "$_cd_target" ] || return 0
  if [ -z "$_cd_running" ] || [ "$_cd_running" = "unknown" ]; then
    return 0
  fi
  if ! validate_semver "$_cd_running"; then
    echo "[!] WARNING: /etc/axonwall/version ('${_cd_running}') is not a valid semantic version; skipping downgrade check." >&2
    return 0
  fi
  _cd_cmp="$(semver_compare "$_cd_target" "$_cd_running")" || return 1
  if [ "$_cd_cmp" = "-1" ]; then
    if [ "$_cd_allow" = "1" ]; then
      echo "[!] Warning: --allow-downgrade specified; allowing downgrade from v${_cd_running} to v${_cd_target}." >&2
      return 0
    fi
    echo "[-] ERROR: refusing to downgrade from v${_cd_running} to v${_cd_target} (pass --allow-downgrade to override)." >&2
    return 1
  fi
  return 0
}

# Verify a .sha256 manifest is strictly 1 line matching:
#   ^[0-9a-f]{64}  <exact expected filename>$
# Prints the validated 64-char hex digest on success.
verify_sha256_manifest() {
  _vsm_sha_file="$1"
  _vsm_expected_name="$2"
  [ -f "$_vsm_sha_file" ] || return 1
  case "$_vsm_expected_name" in
    ""|*/*|*[[:space:]]*) return 1 ;;
  esac
  # Reject embedded NUL bytes and non-printable/control bytes (including CR and tabs).
  _vsm_bytes="$(wc -c < "$_vsm_sha_file" 2>/dev/null | tr -d ' ')"
  _vsm_nonul_bytes="$(tr -d '\000' < "$_vsm_sha_file" 2>/dev/null | wc -c | tr -d ' ')"
  [ -n "$_vsm_bytes" ] && [ "$_vsm_bytes" = "$_vsm_nonul_bytes" ] || return 1
  if LC_ALL=C grep -q '[^ -~]' "$_vsm_sha_file" 2>/dev/null; then
    return 1
  fi
  LC_ALL=C awk -v expected="$_vsm_expected_name" '
    BEGIN { bad = 0 }
    NR > 1 { bad = 1; exit 1 }
    {
      if (length($0) != 66 + length(expected)) { bad = 1; exit 1 }
      if (substr($0, 65, 2) != "  ") { bad = 1; exit 1 }
      h = substr($0, 1, 64)
      if (h !~ /^[0-9a-f]+$/ || length(h) != 64) { bad = 1; exit 1 }
      fname = substr($0, 67)
      if (index(fname, "/") > 0 || fname != expected) { bad = 1; exit 1 }
      print h
    }
    END { if (bad || NR != 1) exit 1 }
  ' "$_vsm_sha_file"
}

# Atomically install a binary or symlink onto a target directory using a private
# temp file on the same filesystem + mv -f so running fds keep their old inode.
atomic_install_bin() {
  _aib_src="$1"
  _aib_dir="${2%/}"
  _aib_name="${3:-$(basename "$_aib_src")}"
  _aib_dst="${_aib_dir}/${_aib_name}"

  mkdir -p "$_aib_dir" 2>/dev/null || return 1

  if [ -L "$_aib_src" ]; then
    _aib_target="$(readlink "$_aib_src" 2>/dev/null || true)"
    [ -n "$_aib_target" ] || return 1
    _aib_tmpdir="$(mktemp -d "${_aib_dir}/.${_aib_name}.tmp.$$.XXXXXX" 2>/dev/null || true)"
    if [ -z "$_aib_tmpdir" ] || [ ! -d "$_aib_tmpdir" ]; then
      return 1
    fi
    chmod 0700 "$_aib_tmpdir" 2>/dev/null || true
    if ! ln -s "$_aib_target" "${_aib_tmpdir}/item" 2>/dev/null || ! mv -f "${_aib_tmpdir}/item" "$_aib_dst" 2>/dev/null; then
      rm -rf "$_aib_tmpdir" 2>/dev/null || true
      return 1
    fi
    rmdir "$_aib_tmpdir" 2>/dev/null || rm -rf "$_aib_tmpdir" 2>/dev/null || true
    return 0
  fi

  _aib_tmp="$(mktemp "${_aib_dir}/.${_aib_name}.tmp.$$.XXXXXX" 2>/dev/null || true)"
  if [ -z "$_aib_tmp" ] || [ ! -f "$_aib_tmp" ]; then
    return 1
  fi
  if ! cp "$_aib_src" "$_aib_tmp" 2>/dev/null; then
    rm -f "$_aib_tmp" 2>/dev/null || true
    return 1
  fi
  if ! chmod 0755 "$_aib_tmp" 2>/dev/null; then
    rm -f "$_aib_tmp" 2>/dev/null || true
    return 1
  fi
  if ! mv -f "$_aib_tmp" "$_aib_dst" 2>/dev/null; then
    rm -f "$_aib_tmp" 2>/dev/null || true
    return 1
  fi
  return 0
}

# D-M9 (round-3): flavor-specific update channel. The updater used to
# download the NGFW `axonwall_${VER}_amd64.deb` on every box, so a vault
# or k3s-storage update reintroduced exactly the daemon/UI/controller
# payload those flavors deliberately strip ("ABSENT, not disabled").
# Josh's decision (2026-11-12): flavor-specific package/channel — the
# updater requests `axonwall-<edition>_${VER}_amd64.deb` for vault and
# k3s-storage, and the NGFW package for the axonwall edition. It never
# falls back to the NGFW package: a failed flavor download leaves
# DEB_TMP empty and the E-M1 guard below aborts the update.
# Detection reads, in order: (1) the canonical edition file
# /etc/axonwall/edition, written by every install path (TUI installer,
# d-i hook, firstboots, .deb postinst, image builders); (2) the legacy
# edition markers the TUI installer writes into the installed slot and
# the ISO builders write into the image (/etc/axonwall/.vault-edition,
# /etc/axonwall/.k3s-edition); (3) the `axonwall.edition=` /
# `axonwall_edition=` kernel cmdline the installers also read; (4) on a
# legacy box with no signal at all, the NGFW daemon binary as positive
# evidence — and only then. A box with no signal and no NGFW payload
# fails closed with an error telling the operator to create the
# edition file. The updater NEVER silently defaults to the NGFW
# package: that silent default is the D-M9 hazard.
detect_edition() {
  # 1. Canonical edition file (D-M9 marker): /etc/axonwall/edition
  # holds the edition name on one line. It is written by every
  # install path (TUI installer, d-i hook, firstboots, .deb postinst,
  # image builders) and is the signal this updater trusts first, so
  # there is no question during updates. A file that exists but is
  # empty (or whitespace-only) counts as no signal and falls through
  # to the legacy signals below; a non-empty value that is not a known
  # edition fails closed rather than guessing.
  if [ -f /etc/axonwall/edition ]; then
    _file_edition="$(tr -d ' \t\r\n' < /etc/axonwall/edition 2>/dev/null || true)"
    if [ -n "$_file_edition" ]; then
      case "$_file_edition" in
        axonwall|minimal|vault|k3s-storage) ;;
        *)
          echo "[-] ERROR: /etc/axonwall/edition contains '${_file_edition}' (expected axonwall, minimal, vault, or k3s-storage); fix the file and re-run the updater." >&2
          exit 1
          ;;
      esac
      # A legacy marker contradicting the canonical file means a
      # corrupt/manual state — fail closed rather than guess which
      # record is right. (Agreement is the normal case: the install
      # paths write both.)
      _contradiction=0
      if [ "$_file_edition" = "vault" ] && { [ -f /etc/axonwall/.k3s-edition ] || [ -f /etc/axonwall/.minimal-edition ]; }; then _contradiction=1; fi
      if [ "$_file_edition" = "k3s-storage" ] && { [ -f /etc/axonwall/.vault-edition ] || [ -f /etc/axonwall/.minimal-edition ]; }; then _contradiction=1; fi
      if [ "$_file_edition" = "minimal" ] && { [ -f /etc/axonwall/.vault-edition ] || [ -f /etc/axonwall/.k3s-edition ]; }; then _contradiction=1; fi
      if [ "$_file_edition" = "axonwall" ] && { [ -f /etc/axonwall/.vault-edition ] || [ -f /etc/axonwall/.k3s-edition ] || [ -f /etc/axonwall/.minimal-edition ]; }; then _contradiction=1; fi
      if [ "$_contradiction" = "1" ]; then
        echo "[-] ERROR: /etc/axonwall/edition says '${_file_edition}' but a legacy edition marker disagrees; the installed edition is ambiguous. Remove the wrong marker and re-run the updater." >&2
        exit 1
      fi
      echo "$_file_edition"
      return 0
    fi
  fi
  # 2. Legacy markers (written by the installers/builders before the
  # edition file existed). Multiple present is a corrupt state —
  # the installers remove the other markers in each branch.
  _vault_marker=0
  _k3s_marker=0
  _minimal_marker=0
  [ -f /etc/axonwall/.vault-edition ] && _vault_marker=1
  [ -f /etc/axonwall/.k3s-edition ] && _k3s_marker=1
  [ -f /etc/axonwall/.minimal-edition ] && _minimal_marker=1
  if [ "$((_vault_marker + _k3s_marker + _minimal_marker))" -gt 1 ]; then
    echo "[-] ERROR: multiple conflicting edition markers exist under /etc/axonwall/; the installed edition is ambiguous. Remove the wrong marker(s) and re-run the updater." >&2
    exit 1
  fi
  if [ "$_vault_marker" = "1" ]; then
    echo "vault"
    return 0
  fi
  if [ "$_k3s_marker" = "1" ]; then
    echo "k3s-storage"
    return 0
  fi
  if [ "$_minimal_marker" = "1" ]; then
    echo "minimal"
    return 0
  fi
  # 3. Kernel cmdline, the same source the TUI installer reads when no
  # marker is present. Fail closed on conflicting or unknown tokens.
  if grep -qsE '(^|[[:space:]])(axonwall_edition|axonwall\.edition)=[^[:space:]]+' /proc/cmdline 2>/dev/null; then
    _cmdline_editions="$(grep -oE '(^|[[:space:]])(axonwall_edition|axonwall\.edition)=[^[:space:]]+' /proc/cmdline 2>/dev/null | sed -E 's/^[[:space:]]*[^=]+=//' | sort -u)"
    _cmdline_count="$(printf '%s\n' "$_cmdline_editions" | grep -c . || true)"
    if [ "$_cmdline_count" -gt 1 ]; then
      echo "[-] ERROR: conflicting edition tokens in /proc/cmdline ($(printf '%s' "$_cmdline_editions" | tr '\n' ' ')); refusing to guess which package to fetch." >&2
      exit 1
    fi
    case "$_cmdline_editions" in
      axonwall|minimal|vault|k3s-storage)
        echo "$_cmdline_editions"
        return 0
        ;;
      *)
        echo "[-] ERROR: unknown edition '${_cmdline_editions}' in kernel cmdline (expected axonwall, minimal, vault, or k3s-storage); refusing to guess which package to fetch." >&2
        exit 1
        ;;
    esac
  fi
  # 4. No edition signal at all. This is a legacy box: it predates the
  # edition file, has no legacy markers (the NGFW edition never wrote
  # one), and no cmdline edition. Do NOT silently default to the NGFW
  # package — that is the D-M9 hazard. Default to axonwall ONLY on
  # positive NGFW evidence: the daemon binary, which the flavors
  # deliberately strip and the flavor packages never ship, so a clean
  # flavor box can never satisfy this test. (The one false positive is
  # a flavor box already contaminated by a pre-fix NGFW .deb install —
  # it already runs the NGFW payload, so continuing as NGFW is at
  # least self-consistent.) The warning is loud, on purpose: the
  # operator should create /etc/axonwall/edition to record it.
  if [ -x /usr/sbin/axonwalld ]; then
    echo "[!] WARNING: no edition signal found (no /etc/axonwall/edition, no legacy marker, no axonwall.edition kernel cmdline), but the NGFW daemon is present, so assuming axonwall. Create /etc/axonwall/edition containing the edition name to record it explicitly." >&2
    echo "axonwall"
    return 0
  fi
  echo "[-] ERROR: cannot determine the installed edition: no /etc/axonwall/edition, no legacy marker (.minimal-edition/.vault-edition/.k3s-edition), no axonwall.edition kernel cmdline, and no NGFW payload (/usr/sbin/axonwalld absent). Create /etc/axonwall/edition containing one of axonwall, minimal, vault, k3s-storage and re-run the updater." >&2
  exit 1
}

# Helper: Extract .deb payload to a destination directory (Debian & Alpine)
extract_deb() {
  deb_file="$1"
  dest_dir="$2"

  if command -v dpkg-deb >/dev/null 2>&1; then
    dpkg-deb -x "$deb_file" "$dest_dir" 2>/dev/null && return 0
  fi

  if [ -n "${WORK_DIR:-}" ] && [ -d "${WORK_DIR}" ]; then
    deb_tmp_dir="$(mktemp -d "${WORK_DIR}/deb-XXXXXX" 2>/dev/null || true)"
  else
    deb_tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/axonwall-deb-XXXXXX" 2>/dev/null || true)"
  fi
  if [ -z "$deb_tmp_dir" ] || [ ! -d "$deb_tmp_dir" ]; then
    return 1
  fi
  chmod 0700 "$deb_tmp_dir" 2>/dev/null || true

  data_tar=""
  # Prefer POSIX/BusyBox ar (Alpine vault & k3s-storage omit Node and dpkg-deb).
  if command -v ar >/dev/null 2>&1; then
    _ar_members="$(ar -t "$deb_file" 2>/dev/null || ar t "$deb_file" 2>/dev/null || true)"
    _ar_member="$(printf '%s\n' "$_ar_members" | grep -E '^data\.tar(\.(gz|xz|zst|bz2))?$' | head -n1 || true)"
    if [ -n "$_ar_member" ]; then
      if (ar -p "$deb_file" "$_ar_member" > "${deb_tmp_dir}/${_ar_member}" 2>/dev/null || ar p "$deb_file" "$_ar_member" > "${deb_tmp_dir}/${_ar_member}" 2>/dev/null) && [ -s "${deb_tmp_dir}/${_ar_member}" ]; then
        chmod 0600 "${deb_tmp_dir}/${_ar_member}" 2>/dev/null || true
        data_tar="${deb_tmp_dir}/${_ar_member}"
      else
        rm -f "${deb_tmp_dir}/${_ar_member}" 2>/dev/null || true
      fi
    fi
  fi

  if [ -z "$data_tar" ] && command -v node >/dev/null 2>&1; then
    data_tar="$(node -e '
      const fs = require("fs");
      const buf = fs.readFileSync(process.argv[1]);
      let off = 8;
      while (off + 60 <= buf.length) {
        const name = buf.slice(off, off + 16).toString("ascii").trim().replace(/\/$/, "");
        const size = parseInt(buf.slice(off + 48, off + 58).toString("ascii").trim(), 10);
        off += 60;
        if (/^data\.tar(\.(gz|xz|zst|bz2))?$/.test(name)) {
          const out = process.argv[2] + "/" + name;
          fs.writeFileSync(out, buf.slice(off, off + size), { mode: 0o600 });
          console.log(out);
          process.exit(0);
        }
        off += size + (size % 2);
      }
      process.exit(1);
    ' "$deb_file" "$deb_tmp_dir" 2>/dev/null || true)"
  fi

  if [ -n "$data_tar" ] && [ -f "$data_tar" ]; then
    # Fail closed if tar cannot list the archive (corrupt or unsupported compression)
    if ! tar -tf "$data_tar" >/dev/null 2>&1; then
      echo "[!] Update package payload archive is unreadable or corrupt; refusing to extract." >&2
      rm -rf "$deb_tmp_dir"
      return 1
    fi
    # Tar-slip guard (audit D-S07)
    if tar -tf "$data_tar" 2>/dev/null | grep -qE '^/|(^|/)\.\.(/|$)'; then
      echo "[!] Update package contains unsafe paths; refusing to extract." >&2
      rm -rf "$deb_tmp_dir"
      return 1
    fi
    # Reject hardlinks, device nodes, FIFOs, and unknown member types
    # unconditionally, and validate every symlink target so legitimate
    # in-tree relative links (generate-zbm, zbm-kcl, kubectl/crictl/ctr
    # -> k3s) extract cleanly on Alpine while absolute, escaping, or
    # traversed links fail closed.
    if tar -tvf "$data_tar" 2>/dev/null | grep -qE '^[hbcp]'; then
      echo "[!] Update package contains disallowed tar members (hardlink/device/FIFO); refusing to extract." >&2
      rm -rf "$deb_tmp_dir"
      return 1
    fi
    if ! tar -tvf "$data_tar" 2>/dev/null | awk '
      BEGIN { bad = 0; nsym = 0; nmem = 0 }
      {
        line = $0
        ftype = substr(line, 1, 1)
        if (ftype == "h" || ftype ~ /^[bcp]$/ || ftype !~ /^[-dl]$/) { bad = 1; exit 1 }
        rest = line
        if (!sub(/^[^ \t]+[ \t]+[^ \t]+[ \t]+([0-9]+,[ \t]*[0-9]+|[0-9]+)[ \t]+[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][ \t]+[0-9][0-9]:[0-9][0-9](:[0-9][0-9])?[ \t]+/, "", rest)) {
          bad = 1; exit 1
        }
        if (ftype == "l") {
          idx = index(rest, " -> ")
          if (idx == 0) { bad = 1; exit 1 }
          member = substr(rest, 1, idx - 1)
          target = substr(rest, idx + 4)
          if (member == "" || target == "" || substr(target, 1, 1) == "/") { bad = 1; exit 1 }
          sub(/^\.\//, "", member)
          sub(/\/+$/, "", member)
          nm = split(member, mp, "/")
          depth = 0
          for (i = 1; i < nm; i++) {
            if (mp[i] == "" || mp[i] == ".") continue
            if (mp[i] == "..") { bad = 1; exit 1 }
            depth++
          }
          nt = split(target, tp, "/")
          for (i = 1; i <= nt; i++) {
            if (tp[i] == "" || tp[i] == ".") continue
            if (tp[i] == "..") {
              depth--
              if (depth < 0) { bad = 1; exit 1 }
            } else {
              depth++
            }
          }
          syms[nsym++] = member
        } else {
          mpath = rest
          sub(/^\.\//, "", mpath)
          sub(/\/+$/, "", mpath)
          members[nmem++] = mpath
        }
      }
      END {
        if (bad) exit 1
        for (s = 0; s < nsym; s++) {
          prefix = syms[s] "/"
          plen = length(prefix)
          for (m = 0; m < nmem; m++) {
            if (members[m] == syms[s] || substr(members[m], 1, plen) == prefix) exit 1
          }
          for (s2 = 0; s2 < nsym; s2++) {
            if (s2 != s && substr(syms[s2], 1, plen) == prefix) exit 1
          }
        }
      }
    '; then
      echo "[!] Update package contains unsafe tar members; refusing to extract." >&2
      rm -rf "$deb_tmp_dir"
      return 1
    fi
    _tar_perm_flag=""
    if tar --help 2>&1 | grep -q -- '--no-same-permissions'; then
      _tar_perm_flag="--no-same-permissions"
    fi
    if tar --help 2>&1 | grep -q -- '--no-same-owner'; then
      tar --no-same-owner --no-same-permissions -xf "$data_tar" -C "$dest_dir" 2>/dev/null || {
        rm -rf "$deb_tmp_dir"
        return 1
      }
    else
      tar ${_tar_perm_flag} -oxf "$data_tar" -C "$dest_dir" 2>/dev/null || {
        rm -rf "$deb_tmp_dir"
        return 1
      }
    fi
    find "$dest_dir" -type f \( -perm -4000 -o -perm -2000 \) -exec chmod ug-s {} + 2>/dev/null || true
    rm -rf "$deb_tmp_dir"
    return 0
  fi

  rm -rf "$deb_tmp_dir"
  return 1
}

# Sync static non-secret /etc/axonwall assets into both target root and persistent bind-mount
sync_static_etc_axonwall() {
  src_etc="$1"
  dst_etc="$2"
  [ -d "$src_etc" ] || return 0
  mkdir -p "$dst_etc" 2>/dev/null || true
  for item in nvim yara branding starship.toml release-signing.pub; do
    if [ -e "${src_etc}/${item}" ]; then
      cp -af "${src_etc}/${item}" "${dst_etc}/" 2>/dev/null || true
    fi
  done
  if [ -d "${src_etc}/release-signing.d" ]; then
    mkdir -p "${dst_etc}/release-signing.d" 2>/dev/null || true
    for _dst_pub in "${dst_etc}/release-signing.d/"*.pub; do
      [ -e "$_dst_pub" ] || [ -L "$_dst_pub" ] || continue
      _pub_name="$(basename "$_dst_pub")"
      if [ ! -e "${src_etc}/release-signing.d/${_pub_name}" ]; then
        rm -f "$_dst_pub" 2>/dev/null || true
      fi
    done
    for _src_kentry in "${src_etc}/release-signing.d/"*; do
      [ -e "$_src_kentry" ] || [ -L "$_src_kentry" ] || continue
      cp -af "$_src_kentry" "${dst_etc}/release-signing.d/" 2>/dev/null || true
    done
  fi
}

# Ensure Debian batcat/fdfind and ZBM symlinks exist in target /usr/local/bin
ensure_cli_symlinks() {
  target_root="${1:-/}"
  target_root="${target_root%/}"
  mkdir -p "${target_root}/usr/local/bin" 2>/dev/null || true
  if [ -x "${target_root}/usr/bin/batcat" ] && [ ! -e "${target_root}/usr/local/bin/bat" ] && [ ! -e "${target_root}/usr/bin/bat" ]; then
    ln -sf /usr/bin/batcat "${target_root}/usr/local/bin/bat" 2>/dev/null || true
  fi
  if [ -x "${target_root}/usr/bin/fdfind" ] && [ ! -e "${target_root}/usr/local/bin/fd" ] && [ ! -e "${target_root}/usr/bin/fd" ]; then
    ln -sf /usr/bin/fdfind "${target_root}/usr/local/bin/fd" 2>/dev/null || true
  fi
  if [ -x "${target_root}/usr/local/bin/axonwall-zbm-theme" ]; then
    [ -e "${target_root}/usr/local/bin/generate-zbm" ] || ln -sf /usr/local/bin/axonwall-zbm-theme "${target_root}/usr/local/bin/generate-zbm" 2>/dev/null || true
    [ -e "${target_root}/usr/local/bin/zbm-kcl" ] || ln -sf /usr/local/bin/axonwall-zbm-theme "${target_root}/usr/local/bin/zbm-kcl" 2>/dev/null || true
  fi
}

# Apply extracted .deb staging tree onto a destination root (standby slot or live root)
# E2-2: copy failures are load-bearing, not cosmetic. Every copy used
# to return success unconditionally (|| true), so a disk-full or I/O
# error mid-overlay staged a partial tree that was then armed as the
# new version. Track failures and return non-zero; every caller treats
# a non-zero return as fatal. mkdir/chown/chmod and the static-asset
# sync stay best-effort (they cannot leave a half-copied package tree).
apply_staged_tree() {
  pkg_stage="$1"
  dest_root="${2:-/}"
  dest_root="${dest_root%/}"
  _apply_failed=0

  if [ -d "${pkg_stage}/opt/axonwall" ]; then
    mkdir -p "${dest_root}/opt/axonwall"
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --delete "${pkg_stage}/opt/axonwall/" "${dest_root}/opt/axonwall/" 2>/dev/null || _apply_failed=1
    else
      rm -rf "${dest_root}/opt/axonwall"
      cp -a "${pkg_stage}/opt/axonwall" "${dest_root}/opt/axonwall" 2>/dev/null || _apply_failed=1
    fi
    chown -R root:root "${dest_root}/opt/axonwall" 2>/dev/null || true
    chmod -R go-w "${dest_root}/opt/axonwall" 2>/dev/null || true
  fi

  if [ -d "${pkg_stage}/usr/sbin" ]; then
    mkdir -p "${dest_root}/usr/sbin" 2>/dev/null || true
    for sbin_f in "${pkg_stage}/usr/sbin/"*; do
      if [ -e "$sbin_f" ] || [ -L "$sbin_f" ]; then
        bname="$(basename "$sbin_f")"
        atomic_install_bin "$sbin_f" "${dest_root}/usr/sbin" "$bname" 2>/dev/null || _apply_failed=1
      fi
    done
  fi

  if [ -d "${pkg_stage}/usr/local/bin" ]; then
    mkdir -p "${dest_root}/usr/local/bin" 2>/dev/null || true
    for bin_f in "${pkg_stage}/usr/local/bin/"*; do
      if [ -e "$bin_f" ] || [ -L "$bin_f" ]; then
        bname="$(basename "$bin_f")"
        if [ -z "$dest_root" ] && [ "$bname" = "axonwall-update" ] && [ -f "$bin_f" ] && [ ! -L "$bin_f" ] && ! sh -n "$bin_f" 2>/dev/null; then
          _apply_failed=1
          continue
        fi
        atomic_install_bin "$bin_f" "${dest_root}/usr/local/bin" "$bname" 2>/dev/null || _apply_failed=1
      fi
    done
  fi

  for sub in usr/lib/axonwall usr/lib/sysusers.d usr/lib/tmpfiles.d usr/share/oh-my-zsh usr/share/axonwall usr/share/plymouth/themes/axonwall lib/systemd/system/plymouth-quit.service.d lib/systemd/system/plymouth-quit-wait.service.d etc/zsh etc/zfsbootmenu etc/modprobe.d etc/modules-load.d etc/sysctl.d etc/vim; do
    if [ -d "${pkg_stage}/${sub}" ]; then
      mkdir -p "${dest_root}/${sub}" 2>/dev/null || true
      cp -af "${pkg_stage}/${sub}/." "${dest_root}/${sub}/" 2>/dev/null || _apply_failed=1
    fi
  done

  for cfg_f in etc/tmux.conf etc/rkhunter.conf.local; do
    if [ -f "${pkg_stage}/${cfg_f}" ]; then
      mkdir -p "$(dirname "${dest_root}/${cfg_f}")" 2>/dev/null || true
      cp -af "${pkg_stage}/${cfg_f}" "${dest_root}/${cfg_f}" 2>/dev/null || _apply_failed=1
    fi
  done

  if [ -d "${pkg_stage}/lib/systemd/system" ]; then
    mkdir -p "${dest_root}/lib/systemd/system" 2>/dev/null || true
    # Loop (not a bare glob copy): a package with services but no
    # timers must not fail the overlay on the unmatched *.timer glob.
    for unit_f in "${pkg_stage}/lib/systemd/system/"*.service "${pkg_stage}/lib/systemd/system/"*.timer; do
      if [ -e "$unit_f" ]; then
        bunit="$(basename "$unit_f")"
        # D-M9: k3s.service must never land on a vault box (the vault
        # has no k3s at all) — but on a k3s-storage box the staged unit
        # IS the flavor's own k3s.service: the D-M9 updater fetches the
        # flavor .deb, and the NGFW .deb Conflicts-blocks the flavor
        # packages at dpkg. Skipping it here (as main's fc576368 did
        # for both flavor markers) would silently drop flavor unit
        # updates on every k3s-storage update.
        if [ "$bunit" = "k3s.service" ] && { [ -f "${dest_root}/etc/axonwall/.vault-edition" ] || [ -f "${dest_root}/etc/axonwall/.minimal-edition" ]; }; then
          continue
        fi
        cp -af "$unit_f" "${dest_root}/lib/systemd/system/" 2>/dev/null || _apply_failed=1
        if [ -f "${dest_root}/etc/systemd/system/${bunit}" ] && [ ! -L "${dest_root}/etc/systemd/system/${bunit}" ]; then
          cp -af "$unit_f" "${dest_root}/etc/systemd/system/${bunit}" 2>/dev/null || _apply_failed=1
        fi
      fi
    done
  fi

  if [ -d "${pkg_stage}/etc/axonwall" ]; then
    sync_static_etc_axonwall "${pkg_stage}/etc/axonwall" "${dest_root}/etc/axonwall"
    if [ -d /var/lib/axonwall/etc-axonwall ]; then
      sync_static_etc_axonwall "${pkg_stage}/etc/axonwall" /var/lib/axonwall/etc-axonwall
    fi
  fi

  if [ -d "${pkg_stage}/var/lib/axonwall/core-k3s" ]; then
    _dest_ed="$(tr -d ' \t\r\n' < "${dest_root}/etc/axonwall/edition" 2>/dev/null || tr -d ' \t\r\n' < /etc/axonwall/edition 2>/dev/null || true)"
    if [ ! -f "${dest_root}/etc/axonwall/.vault-edition" ] && [ ! -f "${dest_root}/etc/axonwall/.minimal-edition" ] && [ "$_dest_ed" != "vault" ] && [ "$_dest_ed" != "minimal" ]; then
      # Never mutate live /var/lib/axonwall/core-k3s when staging an offline ZBM BE or A/B slot;
      # store it under usr/lib/axonwall inside dest_root instead so rollbacks/failures leave the
      # running node untouched and do not write 70MB+ behind a persistent /var/lib/axonwall mount.
      if [ -n "${dest_root}" ] && [ "${dest_root}" != "/" ]; then
        _kdir="${dest_root}/usr/lib/axonwall"
      else
        _kdir="/var/lib/axonwall"
      fi
      mkdir -p "$_kdir" 2>/dev/null || _apply_failed=1
      if [ -d "$_kdir" ]; then
        _ktmp="${_kdir}/.core-k3s.staging.$$"
        _kold="${_kdir}/.core-k3s.old.$$"
        _ktgt="${_kdir}/core-k3s"
        rm -rf "$_ktmp" "$_kold" 2>/dev/null || true
        if cp -a "${pkg_stage}/var/lib/axonwall/core-k3s" "$_ktmp" 2>/dev/null; then
          if [ -e "$_ktgt" ]; then
            mv "$_ktgt" "$_kold" 2>/dev/null || { rm -rf "$_ktmp"; _apply_failed=1; }
          fi
          if [ ! -e "$_ktgt" ]; then
            if mv "$_ktmp" "$_ktgt" 2>/dev/null; then
              rm -rf "$_kold" 2>/dev/null || true
            else
              [ -e "$_kold" ] && mv "$_kold" "$_ktgt" 2>/dev/null || true
              rm -rf "$_ktmp" 2>/dev/null || true
              _apply_failed=1
            fi
          fi
        else
          rm -rf "$_ktmp" 2>/dev/null || true
          _apply_failed=1
        fi
      fi
    fi
  fi

  ensure_cli_symlinks "${dest_root}"

  if [ "$_apply_failed" != "0" ]; then
    return 1
  fi
  return 0
}

reload_edition_services() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
    _units=""
    case "$EDITION" in
      vault)
        _units="seaweedfs.service"
        ;;
      k3s-storage)
        for _ku in k3s.service k3s-agent.service; do
          if systemctl is-active --quiet "$_ku" 2>/dev/null || systemctl is-enabled --quiet "$_ku" 2>/dev/null; then
            _units="${_units} ${_ku}"
          fi
        done
        _units="${_units# }"
        ;;
      minimal)
        _units="axonwalld.service axonwall-controller.service axonwall-ui.service"
        ;;
      axonwall|*)
        _units="axonwalld.service axonwall-controller.service axonwall-ui.service"
        if systemctl is-active --quiet headscale.service 2>/dev/null || systemctl is-enabled --quiet headscale.service 2>/dev/null; then
          _units="${_units} headscale.service"
        fi
        ;;
    esac
    if [ -n "$_units" ]; then
      echo "[+] Scheduling asynchronous reload of Axonwall services (${_units})..."
      nohup sh -c "sleep 3 && systemctl try-restart ${_units}" >/dev/null 2>&1 &
    fi
  elif command -v rc-service >/dev/null 2>&1; then
    _rc_units=""
    case "$EDITION" in
      vault)
        _rc_units="seaweedfs"
        ;;
      k3s-storage)
        for _ku in k3s k3s-agent; do
          if rc-service "$_ku" status >/dev/null 2>&1; then
            _rc_units="${_rc_units} ${_ku}"
          fi
        done
        _rc_units="${_rc_units# }"
        ;;
      minimal|axonwall|*)
        _rc_units="axonwalld axonwall-controller axonwall-ui"
        ;;
    esac
    if [ -n "$_rc_units" ]; then
      echo "[+] Scheduling asynchronous reload of OpenRC services (${_rc_units})..."
      nohup sh -c "sleep 3 && for _s in ${_rc_units}; do rc-service \"\$_s\" status >/dev/null 2>&1 && rc-service \"\$_s\" restart; done" >/dev/null 2>&1 &
    fi
  fi
}

# Helper: Resolve partition block device by label
resolve_label_dev() {
  label="$1"
  if [ -e "/dev/disk/by-label/${label}" ]; then
    echo "/dev/disk/by-label/${label}"
    return 0
  fi
  if command -v findfs >/dev/null 2>&1; then
    dev="$(findfs "LABEL=${label}" 2>/dev/null || true)"
    if [ -n "$dev" ] && [ -b "$dev" ]; then
      echo "$dev"
      return 0
    fi
  fi
  if command -v blkid >/dev/null 2>&1; then
    dev="$(blkid -L "${label}" 2>/dev/null || true)"
    if [ -n "$dev" ] && [ -b "$dev" ]; then
      echo "$dev"
      return 0
    fi
  fi
  echo ""
}

# Helper: Update GRUB environment file with active_slot and reset bootcount
# Returns non-zero when the write did not happen, so arming callers (E1)
# can fail closed instead of claiming an armed slot. Best-effort callers
# inside staging keep ignoring the result.
update_grubenv_file() {
  env_path="$1"
  slot="$2"
  mkdir -p "$(dirname "$env_path")" 2>/dev/null || return 1
  if ! command -v grub-editenv >/dev/null 2>&1; then
    return 1
  fi
  if [ ! -f "$env_path" ]; then
    grub-editenv "$env_path" create 2>/dev/null || return 1
  fi
  grub-editenv "$env_path" set "active_slot=${slot}" bootcount=0 bootlimit=3 2>/dev/null || return 1
  return 0
}

# E5 (suspect variant): the adjacent-partition fallback used to
# relabel any block device on `[ -b ]` alone -- including the ext4
# data partition, which the staging step would then rsync-clone
# over. Only relabel a candidate that is an ext4 filesystem whose
# contents already look like a standby rootfs (the same markers the
# staging step uses to decide a rootfs is present: /sbin/init, /etc,
# /lib/modules). The check mounts the candidate read-only on a
# throwaway directory and unmounts it again; anything else is left
# untouched and TARGET_DEV stays empty, so the update aborts
# instead of guessing.
candidate_is_standby_rootfs() {
  _cand="$1"
  _fstype="$(blkid -o value -s TYPE "$_cand" 2>/dev/null || true)"
  [ "$_fstype" = "ext4" ] || return 1
  if [ -n "${WORK_DIR:-}" ] && [ -d "${WORK_DIR}" ]; then
    _probe="$(mktemp -d "${WORK_DIR}/probe.XXXXXX" 2>/dev/null || true)"
  else
    return 1
  fi
  [ -n "$_probe" ] && [ -d "$_probe" ] || return 1
  if mount -o ro "$_cand" "$_probe" 2>/dev/null; then
    if [ -e "${_probe}/sbin/init" ] && [ -d "${_probe}/etc" ] && [ -d "${_probe}/lib/modules" ]; then
      umount "$_probe" 2>/dev/null || true
      rmdir "$_probe" 2>/dev/null || true
      return 0
    fi
    umount "$_probe" 2>/dev/null || true
  fi
  rmdir "$_probe" 2>/dev/null || true
  return 1
}

restart_quiesced_k3s() {
  if [ -n "${_stopped_k3s_sysd:-}" ]; then
    for _u in $_stopped_k3s_sysd; do
      echo "[+] Restarting quiesced systemd unit: ${_u}..."
      systemctl start "$_u" 2>/dev/null || echo "[!] WARNING: failed to restart ${_u}" >&2
    done
    _stopped_k3s_sysd=""
  fi
  if [ -n "${_stopped_k3s_rc:-}" ]; then
    for _u in $_stopped_k3s_rc; do
      echo "[+] Restarting quiesced OpenRC service: ${_u}..."
      rc-service "$_u" start 2>/dev/null || echo "[!] WARNING: failed to restart ${_u}" >&2
    done
    _stopped_k3s_rc=""
  fi
}

zbm_cleanup_fail() {
  if [ -n "${ZBM_STAGE_MNT:-}" ] && [ -d "${ZBM_STAGE_MNT}" ]; then
    umount "${ZBM_STAGE_MNT}" 2>/dev/null || umount -l "${ZBM_STAGE_MNT}" 2>/dev/null || true
    rmdir "${ZBM_STAGE_MNT}" 2>/dev/null || true
  fi
  [ -n "${PKG_STAGE:-}" ] && rm -rf "${PKG_STAGE}" 2>/dev/null || true
  if [ -n "${TARGET_BE_TMP_DS:-}" ] && zfs list -H -o name "$TARGET_BE_TMP_DS" >/dev/null 2>&1; then
    zfs destroy -r "$TARGET_BE_TMP_DS" 2>/dev/null || true
  fi
  restart_quiesced_k3s
}

main() {
  TARGET_SLOT="B"
  TARGET_VERSION=""
  VERSION_GIVEN=0
  UPDATE_CHANNEL="stable"
  FORCE_ROLLING=0
  FORCE_ZBM=0
  FORCE_BTRFS=0
  APT_UPGRADE=0
  ALLOW_UNSIGNED=0
  ALLOW_DOWNGRADE=0

  WORK_DIR=""
  ZBM_STAGE_MNT=""
  STAGE_DIR=""
  SLOT_A_MNT=""
  PKG_STAGE=""
  TARGET_BE_TMP_DS=""
  _stopped_k3s_sysd=""
  _stopped_k3s_rc=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --slot)
        [ $# -ge 2 ] || { echo "[-] Error: --slot requires an argument (A or B)." >&2; exit 1; }
        TARGET_SLOT="$2"
        shift 2
        ;;
      --version)
        [ $# -ge 2 ] || { echo "[-] Error: --version requires an argument." >&2; exit 1; }
        TARGET_VERSION="$2"
        VERSION_GIVEN=1
        shift 2
        ;;
      --channel)
        [ $# -ge 2 ] || { echo "[-] Error: --channel requires an argument." >&2; exit 1; }
        UPDATE_CHANNEL="$2"
        shift 2
        ;;
      --rolling)
        FORCE_ROLLING=1
        shift
        ;;
      --zbm|--zfsbootmenu)
        FORCE_ZBM=1
        shift
        ;;
      --btrfs|--snapper)
        FORCE_BTRFS=1
        shift
        ;;
      --apt|--apt-upgrade)
        APT_UPGRADE=1
        shift
        ;;
      --allow-unsigned)
        ALLOW_UNSIGNED=1
        shift
        ;;
      --allow-downgrade)
        ALLOW_DOWNGRADE=1
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        # D-L1: unknown options used to be silently swallowed, so a typo
        # like `--versoin 0.11.68 --slo C` ran a version-less update of
        # the default slot B and exited 0. Fail loudly instead.
        echo "[-] Error: unknown option '$1'. Valid options: --slot, --version, --channel, --rolling, --zbm, --btrfs, --apt, --allow-unsigned, --allow-downgrade, --help." >&2
        exit 1
        ;;
    esac
  done

  CLEAN_VER="${TARGET_VERSION#v}"
  if [ "$VERSION_GIVEN" = "1" ] && [ -z "$CLEAN_VER" ]; then
    echo "[-] ERROR: --version requires a valid semantic version (e.g. 0.16.3)." >&2
    exit 1
  fi
  if [ -n "$CLEAN_VER" ] && ! validate_semver "$CLEAN_VER"; then
    echo "[-] ERROR: invalid --version '${TARGET_VERSION}' (must match ^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$ without '..' or path separators)." >&2
    exit 1
  fi

  # Note: command substitution runs in a subshell, so a bare call would
  # swallow detect_edition's exit 1 — the `|| exit 1` makes the failure
  # propagate to this script.
  EDITION="$(detect_edition)" || exit 1

  # D-L3: "unknown" when the version file is absent -- the running
  # version is genuinely unknown then; a stale literal (0.8.13) fed
  # slot_versions.json and the download-abort comparison a wrong value.
  RUNNING_VER="unknown"
  if [ -f /etc/axonwall/version ]; then
    _raw_running_ver="$(head -n1 /etc/axonwall/version | tr -d '\r\n ')"
    _raw_running_ver="${_raw_running_ver#v}"
    if [ -n "$_raw_running_ver" ]; then
      RUNNING_VER="$_raw_running_ver"
    fi
  fi

  if [ -n "$CLEAN_VER" ] && [ "$RUNNING_VER" != "unknown" ]; then
    check_downgrade "$CLEAN_VER" "$RUNNING_VER" "$ALLOW_DOWNGRADE" || exit 1
  fi

  ZBM_MODE=0
  if [ "$FORCE_ZBM" = "1" ]; then
    ZBM_MODE=1
  elif [ -f /etc/axonwall/install-mode ] && grep -qiE 'zbm|zfsbootmenu' /etc/axonwall/install-mode 2>/dev/null; then
    ZBM_MODE=1
  elif [ -f /var/lib/axonwall/install-mode ] && grep -qiE 'zbm|zfsbootmenu' /var/lib/axonwall/install-mode 2>/dev/null; then
    ZBM_MODE=1
  elif grep -qs -E 'zfs=zroot/ROOT|boot=zfs' /proc/cmdline 2>/dev/null; then
    ZBM_MODE=1
  elif command -v findmnt >/dev/null 2>&1 && findmnt -n -o FSTYPE / 2>/dev/null | grep -q 'zfs'; then
    ZBM_MODE=1
  fi

  BTRFS_MODE=0
  if [ "$ZBM_MODE" = "1" ]; then
    BTRFS_MODE=0
  elif [ "$FORCE_BTRFS" = "1" ]; then
    BTRFS_MODE=1
  elif [ -f /etc/axonwall/install-mode ] && grep -qiE 'btrfs|snapper' /etc/axonwall/install-mode 2>/dev/null; then
    BTRFS_MODE=1
  elif [ -f /var/lib/axonwall/install-mode ] && grep -qiE 'btrfs|snapper' /var/lib/axonwall/install-mode 2>/dev/null; then
    BTRFS_MODE=1
  elif grep -qs -E 'axon_btrfs|rootfstype=btrfs|subvol=@' /proc/cmdline 2>/dev/null; then
    BTRFS_MODE=1
  elif command -v findmnt >/dev/null 2>&1 && findmnt -n -o FSTYPE / 2>/dev/null | grep -q 'btrfs'; then
    BTRFS_MODE=1
  fi

  ROLLING_MODE=0
  if [ "$ZBM_MODE" = "1" ] || [ "$BTRFS_MODE" = "1" ]; then
    ROLLING_MODE=0
  elif [ "$FORCE_ROLLING" = "1" ]; then
    ROLLING_MODE=1
  elif [ -f /etc/axonwall/install-mode ] && grep -qi 'rolling' /etc/axonwall/install-mode 2>/dev/null; then
    ROLLING_MODE=1
  elif [ -f /var/lib/axonwall/install-mode ] && grep -qi 'rolling' /var/lib/axonwall/install-mode 2>/dev/null; then
    ROLLING_MODE=1
  elif [ ! -e /dev/disk/by-label/axon_root_a ] && [ ! -e /dev/disk/by-label/axon_root_b ] && ! grep -qs -E 'slot=[AB]|axon_root_[ab]' /proc/cmdline 2>/dev/null; then
    ROLLING_MODE=1
  fi

  TARGET_SLOT="$(printf '%s' "$TARGET_SLOT" | tr '[:lower:]' '[:upper:]')"
  if [ "$TARGET_SLOT" != "A" ] && [ "$TARGET_SLOT" != "B" ]; then
    if [ "$ROLLING_MODE" = "1" ] || [ "$ZBM_MODE" = "1" ] || [ "$BTRFS_MODE" = "1" ]; then
      TARGET_SLOT="A"
    else
      echo "[-] Error: Invalid target slot '${TARGET_SLOT}'. Must be 'A' or 'B'." >&2
      exit 1
    fi
  fi

  WORK_DIR="$(mktemp -d /run/axonwall-update.XXXXXX 2>/dev/null || true)"
  if [ -z "$WORK_DIR" ] || [ ! -d "$WORK_DIR" ]; then
    echo "[-] ERROR: failed to create secure workspace under /run." >&2
    exit 1
  fi
  chmod 0700 "$WORK_DIR"
  trap 'cleanup_work_dir' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  echo "================================================================================"
  echo "Axonwall Appliance Firmware Updater"
  if [ "$ZBM_MODE" = "1" ]; then
    echo "  Install Mode  : ZFSBootMenu Root-on-ZFS (Boot Environments & Snapshots)"
  elif [ "$BTRFS_MODE" = "1" ]; then
    echo "  Install Mode  : Btrfs + Snapper Root (CoW Pre/Post Snapshots)"
  elif [ "$ROLLING_MODE" = "1" ]; then
    echo "  Install Mode  : Rolling Standard Linux (Single-Root /)"
  else
    echo "  Install Mode  : Dual-Root A/B (Target: Slot ${TARGET_SLOT})"
  fi
  echo "  Target Version: ${TARGET_VERSION:-latest}"
  echo "  Channel       : ${UPDATE_CHANNEL}"
  echo "  Edition       : ${EDITION}"
  echo "================================================================================"

  # Pre-Update OpenLDAP Directory Backup (protects against MDB version skew on rollback)
  if command -v slapcat >/dev/null 2>&1 && [ -d /var/lib/axonwall/ldap/config/cn=config ]; then
    BACKUP_TS="$(date -u +"%Y%m%dT%H%M%SZ" 2>/dev/null || echo "latest")"
    mkdir -p /var/lib/axonwall/ldap/backups 2>/dev/null || true
    echo "[+] Creating pre-update OpenLDAP LDIF snapshot in /var/lib/axonwall/ldap/backups/..."
    # D-M8: this snapshot is what makes rollback possible after an
    # LDAP-breaking update. A failed slapcat used to be swallowed (|| true)
    # and the update proceeded with no snapshot at all. Fail closed: abort
    # the update when either database cannot be dumped or its LDIF is
    # missing afterwards. (An empty data LDIF is a valid backup of an empty
    # directory, so existence — not size — is the check.)
    _ldap_backup_failed=0
    _ldap_config_ldif="/var/lib/axonwall/ldap/backups/pre-update-slot-${TARGET_SLOT}-config-${BACKUP_TS}.ldif"
    _ldap_data_ldif="/var/lib/axonwall/ldap/backups/pre-update-slot-${TARGET_SLOT}-data-${BACKUP_TS}.ldif"
    if ! slapcat -F /var/lib/axonwall/ldap/config -n 0 -l "$_ldap_config_ldif"; then
      echo "[-] ERROR: slapcat failed to dump the OpenLDAP config database (cn=config)." >&2
      _ldap_backup_failed=1
    fi
    if ! slapcat -F /var/lib/axonwall/ldap/config -n 1 -l "$_ldap_data_ldif"; then
      echo "[-] ERROR: slapcat failed to dump the OpenLDAP data database." >&2
      _ldap_backup_failed=1
    fi
    if [ "$_ldap_backup_failed" -eq 0 ]; then
      chmod 0600 "$_ldap_config_ldif" "$_ldap_data_ldif" 2>/dev/null || true
      if [ ! -f "$_ldap_config_ldif" ] || [ ! -f "$_ldap_data_ldif" ]; then
        echo "[-] ERROR: pre-update OpenLDAP LDIF snapshot is incomplete (missing LDIF file)." >&2
        _ldap_backup_failed=1
      fi
    fi
    if [ "$_ldap_backup_failed" -eq 1 ]; then
      echo "[-] ERROR: refusing to update without a pre-update LDAP snapshot; rollback after an LDAP-breaking update would have nothing to restore. Fix slapcat/LDAP and re-run the updater." >&2
      exit 1
    fi
  fi

  # 1. Detect target block device (skip when in Rolling Single-Root mode)
  TARGET_LABEL="axon_root_b"
  if [ "$TARGET_SLOT" = "A" ]; then
    TARGET_LABEL="axon_root_a"
  fi
  TARGET_DEV=""
  if [ "$ROLLING_MODE" != "1" ] && [ "$ZBM_MODE" != "1" ] && [ "$BTRFS_MODE" != "1" ]; then
    TARGET_DEV="$(resolve_label_dev "$TARGET_LABEL")"
  fi

  if [ -z "$TARGET_DEV" ] && [ "$ROLLING_MODE" != "1" ] && [ "$ZBM_MODE" != "1" ] && [ "$BTRFS_MODE" != "1" ]; then
    # Fallback: identify unlabelled standby partition adjacent to running root partition
    RUNNING_ROOT="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
    if [ -b "$RUNNING_ROOT" ]; then
      ROOT_DISK="$(echo "$RUNNING_ROOT" | sed -E 's/p?[0-9]+$//')"
      ROOT_PART_NUM="$(echo "$RUNNING_ROOT" | grep -oE '[0-9]+$')"
      if [ "$TARGET_SLOT" = "B" ] && [ -n "$ROOT_PART_NUM" ]; then
        SIBLING_DEV=""
        if echo "$RUNNING_ROOT" | grep -q 'nvme\|mmcblk\|loop'; then
          SIBLING_DEV="${ROOT_DISK}p$(( ROOT_PART_NUM + 1 ))"
        else
          SIBLING_DEV="${ROOT_DISK}$(( ROOT_PART_NUM + 1 ))"
        fi
        if [ -b "$SIBLING_DEV" ]; then
          if candidate_is_standby_rootfs "$SIBLING_DEV"; then
            echo "[!] Auto-labeling unlabelled standby partition ${SIBLING_DEV} as ${TARGET_LABEL}..."
            e2label "$SIBLING_DEV" "$TARGET_LABEL" 2>/dev/null || tune2fs -L "$TARGET_LABEL" "$SIBLING_DEV" 2>/dev/null || true
            TARGET_DEV="$(resolve_label_dev "$TARGET_LABEL")"
          else
            echo "[-] ERROR: adjacent partition ${SIBLING_DEV} does not look like a standby rootfs (not ext4, or missing /sbin/init, /etc, /lib/modules); refusing to relabel it as ${TARGET_LABEL}." >&2
          fi
        fi
      elif [ "$TARGET_SLOT" = "A" ] && [ -n "$ROOT_PART_NUM" ] && [ "$ROOT_PART_NUM" -gt 1 ]; then
        SIBLING_DEV=""
        if echo "$RUNNING_ROOT" | grep -q 'nvme\|mmcblk\|loop'; then
          SIBLING_DEV="${ROOT_DISK}p$(( ROOT_PART_NUM - 1 ))"
        else
          SIBLING_DEV="${ROOT_DISK}$(( ROOT_PART_NUM - 1 ))"
        fi
        if [ -b "$SIBLING_DEV" ]; then
          if candidate_is_standby_rootfs "$SIBLING_DEV"; then
            echo "[!] Auto-labeling unlabelled standby partition ${SIBLING_DEV} as ${TARGET_LABEL}..."
            e2label "$SIBLING_DEV" "$TARGET_LABEL" 2>/dev/null || tune2fs -L "$TARGET_LABEL" "$SIBLING_DEV" 2>/dev/null || true
            TARGET_DEV="$(resolve_label_dev "$TARGET_LABEL")"
          else
            echo "[-] ERROR: adjacent partition ${SIBLING_DEV} does not look like a standby rootfs (not ext4, or missing /sbin/init, /etc, /lib/modules); refusing to relabel it as ${TARGET_LABEL}." >&2
          fi
        fi
      fi
    fi
  fi

  # 2. Attempt to fetch release package from GitHub Releases if online
  DEB_TMP=""
  if [ -n "$CLEAN_VER" ] && command -v curl >/dev/null 2>&1; then
    # D-M9: flavor-specific package name. The axonwall edition keeps the
    # historic NGFW artifact name; vault and k3s-storage request their
    # own package. There is deliberately no fallback to the NGFW package
    # anywhere below — a failed flavor download leaves DEB_TMP empty and
    # the E-M1 guard aborts the update instead of staging the wrong
    # edition's payload.
    case "$EDITION" in
      vault) DEB_BASE="axonwall-vault" ;;
      k3s-storage) DEB_BASE="axonwall-k3s-storage" ;;
      minimal) DEB_BASE="axonwall-minimal" ;;
      *) DEB_BASE="axonwall" ;;
    esac
    EXPECTED_DEB_NAME="${DEB_BASE}_${CLEAN_VER}_amd64.deb"
    DEB_URL="https://github.com/axonwall/axonwall/releases/download/v${CLEAN_VER}/${EXPECTED_DEB_NAME}"
    SHA_URL="${DEB_URL}.sha256"
    SIG_URL="${SHA_URL}.sig"
    RELEASE_PUBKEY="/etc/axonwall/release-signing.pub"
    CANDIDATE_DEB="${WORK_DIR}/${EXPECTED_DEB_NAME}"
    echo "[+] Checking release artifact: ${DEB_URL}"
    if curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --connect-timeout 10 --max-time 180 -o "${CANDIDATE_DEB}" "${DEB_URL}" 2>/dev/null; then
      # Fail closed: the .deb is only ever used after verification. A
      # checksum that cannot be fetched discards the download -- a
      # missing checksum must never mean "unverified is fine" for code
      # that will run as root.
      if ! curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --connect-timeout 10 --max-time 30 -o "${CANDIDATE_DEB}.sha256" "${SHA_URL}" 2>/dev/null; then
        echo "[-] ERROR: could not fetch SHA-256 checksum for ${DEB_URL}; discarding unverified download." >&2
        rm -f "${CANDIDATE_DEB}"
        exit 1
      fi
      if ! EXPECTED_HASH="$(verify_sha256_manifest "${CANDIDATE_DEB}.sha256" "${EXPECTED_DEB_NAME}")"; then
        echo "[-] ERROR: SHA-256 manifest validation failed (expected 1 line binding ${EXPECTED_DEB_NAME}); discarding download." >&2
        rm -f "${CANDIDATE_DEB}" "${CANDIDATE_DEB}.sha256"
        exit 1
      fi
      ACTUAL_HASH="$(sha256sum "${CANDIDATE_DEB}" | awk '{print $1}')"
      if [ -z "$EXPECTED_HASH" ] || [ "$EXPECTED_HASH" != "$ACTUAL_HASH" ]; then
        echo "[-] ERROR: SHA-256 mismatch for downloaded package ${EXPECTED_DEB_NAME}; discarding download." >&2
        rm -f "${CANDIDATE_DEB}" "${CANDIDATE_DEB}.sha256"
        exit 1
      fi
      # E-M2 (round-3): verify the detached signature against the
      # release-signing keyring — the legacy single pubkey plus any
      # additional anchors in /etc/axonwall/release-signing.d/. The
      # old code trusted exactly one key, so a release signed with a
      # new key could never be downloaded (the new anchor ships
      # inside the package the old key cannot verify) and rotation
      # bricked updates fleet-wide until the pubkey was replaced out
      # of band on every box. With a keyring, a transition release
      # signed by the OLD key delivers the NEW anchor into the
      # keyring, and the following release can be signed by the new
      # key. See release-signing.d/README.md for the procedure.
      # (Unmatched globs stay literal under /bin/sh; the -s test
      # below skips them, so an empty keyring dir is safe.)
      _sig_ok=0
      _have_key=0
      for _pubkey in "$RELEASE_PUBKEY" /etc/axonwall/release-signing.d/*.pub /usr/share/axonwall/release-signing.pub /usr/share/axonwall/release-signing.d/*.pub; do
        [ -s "$_pubkey" ] && _have_key=1 && break
      done
      if [ "$_have_key" = "1" ]; then
        if curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --connect-timeout 10 --max-time 30 -o "${CANDIDATE_DEB}.sha256.sig" "${SIG_URL}" 2>/dev/null; then
          for _pubkey in "$RELEASE_PUBKEY" /etc/axonwall/release-signing.d/*.pub /usr/share/axonwall/release-signing.pub /usr/share/axonwall/release-signing.d/*.pub; do
            [ -s "$_pubkey" ] || continue
            if openssl dgst -sha256 -verify "$_pubkey" -signature "${CANDIDATE_DEB}.sha256.sig" "${CANDIDATE_DEB}.sha256" >/dev/null 2>&1; then
              _sig_ok=1
              break
            fi
          done
        fi
        if [ "$_sig_ok" = "1" ]; then
          echo "[+] Verified SHA-256 integrity hash and release signature: ${ACTUAL_HASH}"
          DEB_TMP="${CANDIDATE_DEB}"
        else
          echo "[-] ERROR: release signature verification failed for ${DEB_URL}; discarding download." >&2
          rm -f "${CANDIDATE_DEB}" "${CANDIDATE_DEB}.sha256" "${CANDIDATE_DEB}.sha256.sig"
          exit 1
        fi
      elif [ "$ALLOW_UNSIGNED" = "1" ]; then
        echo "[!] Warning: no release signing key installed (--allow-unsigned given); relying on SHA-256 + TLS only."
        echo "[+] Verified SHA-256 integrity hash: ${ACTUAL_HASH}"
        DEB_TMP="${CANDIDATE_DEB}"
      else
        echo "[-] ERROR: no release signing key found (checked ${RELEASE_PUBKEY}, /etc/axonwall/release-signing.d/*.pub, /usr/share/axonwall/release-signing.pub, /usr/share/axonwall/release-signing.d/*.pub); refusing unsigned update (pass --allow-unsigned to override)." >&2
        rm -f "${CANDIDATE_DEB}" "${CANDIDATE_DEB}.sha256" "${CANDIDATE_DEB}.sha256.sig"
        exit 1
      fi
    else
      rm -f "${CANDIDATE_DEB}" 2>/dev/null || true
    fi
  fi

  # Capture active slot before mounting or modifying anything
  RUNNING_ACTIVE_SLOT="A"
  if grep -qs -E 'axon_root_b|slot=B' /proc/cmdline 2>/dev/null; then
    RUNNING_ACTIVE_SLOT="B"
  fi

  # E-M1 (round-3): a missing /etc/axonwall/version must fail closed, not
  # proceed. The old condition required the file to exist before aborting
  # on a failed download / bad signature, so a box without the file silently
  # staged the running tree and armed it as the requested new version.
  if [ -z "$DEB_TMP" ] && [ -n "$CLEAN_VER" ] && [ "$CLEAN_VER" != "$RUNNING_VER" ]; then
    echo "[-] ERROR: Could not download or verify release package for v${CLEAN_VER} (currently running v${RUNNING_VER}). Aborting firmware update." >&2
    exit 1
  fi

# 3. Check if running in ZFSBootMenu, Dual-Root, or Rolling Single-Disk mode
if [ "$ZBM_MODE" = "1" ]; then
  # E10: the ZBM path used to run with an empty --version, minting a
  # version-less Boot Environment (axonwall-), writing an empty
  # version file into the staged BE, and recording a BE dataset name
  # in a version field. The daemon always passes a version (it
  # defaults an empty one to the installed version before invoking
  # this script), so refusing here only blocks direct CLI misuse.
  if [ -z "$CLEAN_VER" ]; then
    echo "[-] ERROR: --version is required for ZBM updates; refusing to create a version-less Boot Environment." >&2
    exit 1
  fi
  echo "[+] Running in ZFSBootMenu Root-on-ZFS mode. Performing atomic snapshot & clone Boot Environment update..."
  POOL_NAME="zroot"
  PARENT_DS="${POOL_NAME}/ROOT"

  # Detect currently mounted running BE
  CURRENT_BE_DS="$(findmnt -n -o SOURCE / 2>/dev/null || awk '$2 == "/" {print $1}' /proc/mounts 2>/dev/null || true)"
  if [ -z "$CURRENT_BE_DS" ] || ! echo "$CURRENT_BE_DS" | grep -q "${PARENT_DS}/"; then
    CURRENT_BE_DS="$(zpool get -H -o value bootfs ${POOL_NAME} 2>/dev/null || true)"
  fi
  CURRENT_BE="$(basename "$CURRENT_BE_DS")"
  if [ -z "$CURRENT_BE" ] || [ "$CURRENT_BE" = "ROOT" ]; then
    CURRENT_BE="axonwall-$(cat /etc/axonwall/version 2>/dev/null || echo "current")"
  fi

  TARGET_BE="axonwall-${CLEAN_VER}"
  TARGET_BE_DS="${PARENT_DS}/${TARGET_BE}"
  _snap_ts="$(date -u +%Y%m%d%H%M%S)"
  PRE_SNAP="${CURRENT_BE_DS}@pre-update-v${CLEAN_VER}-${_snap_ts}"

  echo "[+] Active Boot Environment : ${CURRENT_BE_DS} (${CURRENT_BE})"
  echo "[+] Target Boot Environment : ${TARGET_BE_DS} (${TARGET_BE})"

  # E11: refuse a same-version re-update. Without this, a re-run for
  # the running version reaches the recreate path below, which runs
  # `zfs destroy -r` on the target BE -- and when the target IS the
  # running BE, that destroys the live root (the destroy failure is
  # swallowed with `|| true`, so the script would carry on). Whether
  # ZFS refuses destroying a mounted BE is unproven on a live ZBM
  # box; this guard is safe regardless of that answer, so fail
  # closed here. Both the name and the full dataset path are
  # compared: the name catches the normal case, the path catches a
  # renamed or relocated running BE.
  if [ "$TARGET_BE" = "$CURRENT_BE" ] || [ "$TARGET_BE_DS" = "$CURRENT_BE_DS" ]; then
    echo "[-] ERROR: target Boot Environment ${TARGET_BE_DS} is the running Boot Environment (same version ${CLEAN_VER}); refusing same-version re-update." >&2
    exit 1
  fi

  if command -v zfs >/dev/null 2>&1; then
    _stopped_k3s_sysd=""
    _stopped_k3s_rc=""
    ZBM_STAGE_MNT="${WORK_DIR}/zbm-stage"
    PKG_STAGE=""
    TARGET_BE_TMP="${TARGET_BE}.tmp"
    TARGET_BE_TMP_DS="${PARENT_DS}/${TARGET_BE_TMP}"

    # Quiesce K3s (etcd / SQLite WAL on zroot/ROOT/*) before snapshot/clone
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
      for _ku in k3s.service k3s-agent.service; do
        if systemctl is-active --quiet "$_ku" 2>/dev/null; then
          echo "[+] Quiescing ${_ku} before ZFS snapshot..."
          if systemctl stop "$_ku" 2>/dev/null; then
            _stopped_k3s_sysd="${_stopped_k3s_sysd} ${_ku}"
          fi
        fi
      done
    elif command -v rc-service >/dev/null 2>&1; then
      for _ku in k3s k3s-agent; do
        if rc-service "$_ku" status >/dev/null 2>&1; then
          echo "[+] Quiescing OpenRC ${_ku} before ZFS snapshot..."
          if rc-service "$_ku" stop 2>/dev/null; then
            _stopped_k3s_rc="${_stopped_k3s_rc} ${_ku}"
          fi
        fi
      done
    fi

    if zfs list -H -o name -t snapshot "$PRE_SNAP" >/dev/null 2>&1; then
      echo "[+] Snapshot ${PRE_SNAP} already exists, reusing."
    else
      echo "[+] Creating pre-update snapshot: ${PRE_SNAP}..."
      if ! zfs snapshot "$PRE_SNAP"; then
        echo "[-] ERROR: Failed to create pre-update snapshot ${PRE_SNAP}." >&2
        zbm_cleanup_fail
        exit 1
      fi
    fi

    # E2-13: clone to a temporary BE name FIRST and only destroy the
    # old target once the clone has succeeded. The old order destroyed
    # the target (which may be the current fallback_be) and then
    # cloned; a clone failure (pool full, transient ZFS error) aborted
    # under `set -e` with the target gone and fallback_be dangling.
    # A stale tmp dataset can only come from an earlier interrupted
    # run — it is never armed or referenced — so remove it first.
    if zfs list -H -o name "$TARGET_BE_TMP_DS" >/dev/null 2>&1; then
      echo "[!] Removing stale temporary Boot Environment ${TARGET_BE_TMP_DS} from an earlier interrupted update..."
      zfs destroy -r "$TARGET_BE_TMP_DS" 2>/dev/null || true
    fi

    echo "[+] Cloning ${PRE_SNAP} -> ${TARGET_BE_TMP_DS}..."
    if ! zfs clone -o canmount=noauto -o mountpoint=/ "$PRE_SNAP" "$TARGET_BE_TMP_DS"; then
      echo "[-] ERROR: Failed to clone ${PRE_SNAP} -> ${TARGET_BE_TMP_DS}." >&2
      zbm_cleanup_fail
      exit 1
    fi

    rm -rf "${ZBM_STAGE_MNT}"
    mkdir -p "${ZBM_STAGE_MNT}"
    if ! mount -t zfs -o zfsutil "$TARGET_BE_TMP_DS" "${ZBM_STAGE_MNT}"; then
      echo "[-] ERROR: Failed to mount ${TARGET_BE_TMP_DS} at ${ZBM_STAGE_MNT} (mount -t zfs -o zfsutil failed); the Boot Environment is NOT armed." >&2
      zbm_cleanup_fail
      exit 1
    fi

    if [ -n "$DEB_TMP" ] && [ -f "$DEB_TMP" ]; then
      echo "[+] Extracting firmware payload into ${TARGET_BE_DS}..."
      PKG_STAGE="${WORK_DIR}/pkg-stage"
      rm -rf "${PKG_STAGE}"
      mkdir -p "${PKG_STAGE}"
      if ! extract_deb "${DEB_TMP}" "${PKG_STAGE}"; then
        echo "[-] ERROR: Failed to extract firmware archive ${DEB_TMP}." >&2
        zbm_cleanup_fail
        exit 1
      fi
      if ! apply_staged_tree "${PKG_STAGE}" "${ZBM_STAGE_MNT}"; then
        echo "[-] ERROR: Failed to apply firmware payload into ${TARGET_BE_DS} (staged copy failed); the Boot Environment is NOT armed." >&2
        zbm_cleanup_fail
        exit 1
      fi
      rm -rf "${PKG_STAGE}"
      PKG_STAGE=""
      if [ -d "${ZBM_STAGE_MNT}/etc/axonwall" ] && [ -d /var/lib/axonwall/etc-axonwall ]; then
        sync_static_etc_axonwall "${ZBM_STAGE_MNT}/etc/axonwall" /var/lib/axonwall/etc-axonwall
      fi
      ensure_cli_symlinks "${ZBM_STAGE_MNT}"
      if [ -d "${ZBM_STAGE_MNT}/usr/local/bin" ]; then
        for bin_f in "${ZBM_STAGE_MNT}/usr/local/bin/"*; do
          if [ -e "$bin_f" ] || [ -L "$bin_f" ]; then
            bname="$(basename "$bin_f")"
            if [ ! -e "/usr/local/bin/${bname}" ] || [ "$bname" = "axonwall-update" ]; then
              if [ "$bname" = "axonwall-update" ] && [ -f "$bin_f" ] && [ ! -L "$bin_f" ] && ! sh -n "$bin_f" 2>/dev/null; then
                echo "[!] WARNING: staged axonwall-update failed sh -n syntax check; keeping live /usr/local/bin/axonwall-update." >&2
                continue
              fi
              atomic_install_bin "$bin_f" "/usr/local/bin" "$bname" 2>/dev/null || true
            fi
          fi
        done
      fi
      ensure_cli_symlinks "/"
    elif [ -d /opt/axonwall ]; then
      mkdir -p "${ZBM_STAGE_MNT}/opt/axonwall" 2>/dev/null || true
      # E-H3 (round-3): a failed local sync must fail the update, not
      # arm a BE whose /opt/axonwall was never copied. The old code
      # swallowed rsync/cp failures with `|| true` and the ZBM path has
      # no staging gate, so a disk-full copy still wrote the new version
      # and armed the BE as success. Mirror the .deb path above: abort
      # and destroy the temp BE on failure.
      ZBM_SYNC_OK=1
      if command -v rsync >/dev/null 2>&1; then
        rsync -a --delete /opt/axonwall/ "${ZBM_STAGE_MNT}/opt/axonwall/" 2>/dev/null || ZBM_SYNC_OK=0
      else
        cp -a /opt/axonwall/. "${ZBM_STAGE_MNT}/opt/axonwall/" 2>/dev/null || ZBM_SYNC_OK=0
      fi
      if [ "$ZBM_SYNC_OK" != "1" ]; then
        echo "[-] ERROR: Failed to sync /opt/axonwall into ${TARGET_BE_DS} (local sync failed); the Boot Environment is NOT armed." >&2
        zbm_cleanup_fail
        exit 1
      fi
    fi

    mkdir -p "${ZBM_STAGE_MNT}/etc/axonwall" "${ZBM_STAGE_MNT}/var/lib/axonwall"
    echo "$CLEAN_VER" > "${ZBM_STAGE_MNT}/etc/axonwall/version"
    echo "zbm" > "${ZBM_STAGE_MNT}/etc/axonwall/install-mode"
    echo "zbm" > "${ZBM_STAGE_MNT}/var/lib/axonwall/install-mode"

    SV_TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")"
    # E10: slotB is a version field, never a BE dataset name. Derive
    # the running BE's version from its name (axonwall-<version>);
    # fall back to the running version when the name carries no
    # usable version (e.g. the "current" fallback above).
    CURRENT_BE_VER="${CURRENT_BE#axonwall-}"
    if [ "$CURRENT_BE_VER" = "$CURRENT_BE" ] || [ -z "$CURRENT_BE_VER" ] || [ "$CURRENT_BE_VER" = "current" ]; then
      CURRENT_BE_VER="$RUNNING_VER"
    fi
    SV_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s",\n  "updatedAt": "%s"\n}\n' "$CLEAN_VER" "$CURRENT_BE_VER" "$SV_TIMESTAMP")"
    printf '%s' "$SV_JSON" > "${ZBM_STAGE_MNT}/etc/axonwall/slot_versions.json" 2>/dev/null || true

    if [ -d "${ZBM_STAGE_MNT}/boot" ]; then
      LATEST_KERN="$(ls -1t "${ZBM_STAGE_MNT}/boot/vmlinuz-"* 2>/dev/null | head -n1 || true)"
      if [ -n "$LATEST_KERN" ]; then
        ln -sf "$(basename "$LATEST_KERN")" "${ZBM_STAGE_MNT}/boot/vmlinuz" 2>/dev/null || true
        ln -sf "boot/$(basename "$LATEST_KERN")" "${ZBM_STAGE_MNT}/vmlinuz" 2>/dev/null || true
      fi
      LATEST_INITRD="$(ls -1t "${ZBM_STAGE_MNT}/boot/initrd.img-"* "${ZBM_STAGE_MNT}/boot/initramfs-"* 2>/dev/null | grep -vE '\.(bak|old)$' | head -n1 || true)"
      if [ -n "$LATEST_INITRD" ]; then
        ln -sf "$(basename "$LATEST_INITRD")" "${ZBM_STAGE_MNT}/boot/initrd.img" 2>/dev/null || true
        ln -sf "boot/$(basename "$LATEST_INITRD")" "${ZBM_STAGE_MNT}/initrd.img" 2>/dev/null || true
      fi
    fi

    if ! umount "${ZBM_STAGE_MNT}"; then
      echo "[-] ERROR: Failed to cleanly unmount ${ZBM_STAGE_MNT}; refusing to rename staged Boot Environment." >&2
      zbm_cleanup_fail
      exit 1
    fi
    rmdir "${ZBM_STAGE_MNT}" 2>/dev/null || true
    ZBM_STAGE_MNT=""

    if zfs list -H -o name "$TARGET_BE_DS" >/dev/null 2>&1; then
      echo "[!] Target Boot Environment ${TARGET_BE_DS} already exists. Replacing it with the new clone..."
      _prom_iter=0
      while [ "$_prom_iter" -lt 16 ]; do
        _dep_clones="$(zfs list -H -o name,origin -t filesystem -r "${POOL_NAME}" 2>/dev/null | awk -v p="${TARGET_BE_DS}@" 'index($2, p) == 1 {print $1}' || true)"
        [ -n "$_dep_clones" ] || break
        _promote_ds=""
        if printf '%s\n' "$_dep_clones" | grep -qxF "$CURRENT_BE_DS"; then
          _promote_ds="$CURRENT_BE_DS"
        else
          _promote_ds="$(printf '%s\n' "$_dep_clones" | tail -n1)"
        fi
        echo "[+] Promoting dependent clone ${_promote_ds} before replacing ${TARGET_BE_DS}..."
        if ! zfs promote "$_promote_ds"; then
          echo "[-] ERROR: Failed to promote dependent clone ${_promote_ds} before replacing ${TARGET_BE_DS}." >&2
          zbm_cleanup_fail
          exit 1
        fi
        _prom_iter=$((_prom_iter + 1))
      done
      if ! zfs destroy -r "$TARGET_BE_DS"; then
        echo "[-] ERROR: Failed to destroy existing Boot Environment ${TARGET_BE_DS}; discarding staged clone." >&2
        zbm_cleanup_fail
        exit 1
      fi
    fi
    if ! zfs rename "$TARGET_BE_TMP_DS" "$TARGET_BE_DS"; then
      echo "[-] ERROR: Failed to rename ${TARGET_BE_TMP_DS} -> ${TARGET_BE_DS}." >&2
      zbm_cleanup_fail
      exit 1
    fi

    echo "[+] Arming ZFSBootMenu bootfs and autonomous watchdog..."
    # E2: every arming step is checked. On any failure, restore the
    # previous bootfs, print an error, and exit non-zero — never claim
    # the Boot Environment is armed.
    # E2-5: snapshot every arming property before touching them, so
    # the rollback below restores all of them (the daemon's E3 fix
    # does the same). Restoring bootfs alone left active_be pointing
    # at the new BE while bootfs pointed at the old one, and the
    # watchdog hook then counted healthy boots of the old BE against
    # the new BE and spuriously rolled back days later.
    PREV_BOOTFS="$(zpool get -H -o value bootfs "${POOL_NAME}" 2>/dev/null || true)"
    PREV_FALLBACK_BE="$(zfs get -H -o value org.axonwall:fallback_be "${PARENT_DS}" 2>/dev/null || true)"
    PREV_ACTIVE_BE="$(zfs get -H -o value org.axonwall:active_be "${PARENT_DS}" 2>/dev/null || true)"
    PREV_BOOTCOUNT="$(zfs get -H -o value org.axonwall:bootcount "${PARENT_DS}" 2>/dev/null || true)"
    PREV_BOOTLIMIT="$(zfs get -H -o value org.axonwall:bootlimit "${PARENT_DS}" 2>/dev/null || true)"
    ZBM_ARM_OK=1
    zpool set bootfs="${TARGET_BE_DS}" "${POOL_NAME}" 2>/dev/null || ZBM_ARM_OK=0
    zfs set org.axonwall:fallback_be="${CURRENT_BE_DS}" "${PARENT_DS}" 2>/dev/null || ZBM_ARM_OK=0
    zfs set org.axonwall:active_be="${TARGET_BE_DS}" "${PARENT_DS}" 2>/dev/null || ZBM_ARM_OK=0
    zfs set org.axonwall:bootcount=0 "${PARENT_DS}" 2>/dev/null || ZBM_ARM_OK=0
    zfs set org.axonwall:bootlimit=3 "${PARENT_DS}" 2>/dev/null || ZBM_ARM_OK=0
    if [ "$ZBM_ARM_OK" != "1" ]; then
      echo "[-] ERROR: Failed to arm Boot Environment ${TARGET_BE} (one or more zpool/zfs arming steps failed); the Boot Environment is NOT armed." >&2
      if [ -n "$PREV_BOOTFS" ] && [ "$PREV_BOOTFS" != "-" ]; then
        zpool set bootfs="${PREV_BOOTFS}" "${POOL_NAME}" 2>/dev/null || echo "[!] WARNING: Failed to roll back bootfs to ${PREV_BOOTFS} after arming failure." >&2
      fi
      # A prior value of "-" (or empty/unreadable) means the property
      # was unset: inherit clears whatever the failed arming set,
      # mirroring the daemon's E3 rollback.
      for _rb in "org.axonwall:fallback_be|${PREV_FALLBACK_BE}" "org.axonwall:active_be|${PREV_ACTIVE_BE}" "org.axonwall:bootcount|${PREV_BOOTCOUNT}" "org.axonwall:bootlimit|${PREV_BOOTLIMIT}"; do
        _rb_prop="${_rb%%|*}"
        _rb_prev="${_rb#*|}"
        if [ -n "$_rb_prev" ] && [ "$_rb_prev" != "-" ]; then
          zfs set "${_rb_prop}=${_rb_prev}" "${PARENT_DS}" 2>/dev/null || echo "[!] WARNING: Failed to roll back ${_rb_prop} to ${_rb_prev} after arming failure." >&2
        else
          zfs inherit "$_rb_prop" "${PARENT_DS}" 2>/dev/null || true
        fi
      done
      restart_quiesced_k3s
      exit 1
    fi

    restart_quiesced_k3s

    printf '%s' "$SV_JSON" > /etc/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$SV_JSON" > /var/lib/axonwall/slot_versions.json 2>/dev/null || true

    echo "[✓] Boot Environment ${TARGET_BE} successfully staged and armed. Reboot to activate."
  else
    # E2 family: ZBM mode with no zfs tools stages nothing; failing closed
    # here keeps the script from printing success at the end for no work.
    echo "[-] ERROR: ZFSBootMenu mode requested but the zfs tools are not available; no Boot Environment was staged or armed." >&2
    exit 1
  fi
elif [ -n "$TARGET_DEV" ] && [ -e "$TARGET_DEV" ]; then
  # E5 (confirmed): refuse to stage onto the running root. Running
  # on slot B and updating --slot B used to mount the live root a
  # second time and rsync --delete onto the live system. Compare
  # canonical device paths, since the target resolves through
  # /dev/disk/by-label/* while findmnt reports the plain node.
  # (The UI always passes the standby slot, so this trigger is
  # CLI-only; the guard still applies to every caller.) This check
  # sits here, at the only place TARGET_DEV is mounted, so the ZBM
  # path -- which never mounts TARGET_DEV -- is unaffected.
  _running_root="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  if [ -n "$_running_root" ] && [ -b "$_running_root" ]; then
    _target_canon="$(readlink -f "$TARGET_DEV" 2>/dev/null || echo "$TARGET_DEV")"
    _running_canon="$(readlink -f "$_running_root" 2>/dev/null || echo "$_running_root")"
    if [ "$_target_canon" = "$_running_canon" ]; then
      echo "[-] ERROR: target device ${TARGET_DEV} is the running root device (${_running_root}); refusing to update the live system in place. Pass the standby slot." >&2
      exit 1
    fi
  fi
  echo "[+] Detected Dual-Root target partition: ${TARGET_DEV} (${TARGET_LABEL})"
  echo "[+] Mounting standby partition to staging directory..."
  STAGE_DIR="${WORK_DIR}/slot-${TARGET_SLOT}"
  mkdir -p "${STAGE_DIR}"
  # E1: staging-success flag. Only the mount-ok block below may set it;
  # the grubenv arming after that block is gated on it.
  STAGING_OK=0
  STAGING_RSYNCS_FAILED=0
  SV_JSON=""
  mount "${TARGET_DEV}" "${STAGE_DIR}" 2>/dev/null || true

  # If mounting succeeds, synchronize root filesystem or extract downloaded release package
  if grep -qs " ${STAGE_DIR} " /proc/mounts || (command -v mountpoint >/dev/null 2>&1 && mountpoint -q "${STAGE_DIR}"); then
    # Self-heal base OS rootfs on standby slot if missing /sbin, /bin, /etc, or /lib/modules
    if [ ! -e "${STAGE_DIR}/sbin/init" ] || [ ! -d "${STAGE_DIR}/etc" ] || [ ! -d "${STAGE_DIR}/lib/modules" ]; then
      echo "[+] Standby partition is missing base OS rootfs; cloning running root filesystem to Slot ${TARGET_SLOT}..."
      if command -v rsync >/dev/null 2>&1; then
        rsync -aAX \
          --exclude=/proc/* \
          --exclude=/sys/* \
          --exclude=/dev/* \
          --exclude=/run/* \
          --exclude=/tmp/* \
          --exclude=/mnt/* \
          --exclude=/media/* \
          --exclude=/lost+found \
          --exclude=/var/lib/axonwall/* \
          --exclude=/home/* \
          --exclude=/boot/efi/* \
          --exclude=/etc/machine-id \
          --exclude=/etc/ssh/ssh_host_* \
          --exclude=/var/lib/dbus/machine-id \
          --exclude=/var/lib/cloud/data \
          --exclude=/var/lib/cloud/instance \
          --exclude=/var/lib/cloud/instances \
          / "${STAGE_DIR}/" 2>/dev/null || STAGING_RSYNCS_FAILED=1
      else
        # D-M1: mirror the rsync excludes -- the old loop copied /home
        # and /var (including live /var/lib/axonwall state) verbatim.
        for sys_dir in bin etc lib lib64 opt root sbin usr var; do
          if [ -d "/${sys_dir}" ]; then
            # E-M5 (round-3): a failed cp fallback must feed the E1
            # staging gate exactly like the rsync branch above; the
            # old `|| true` left STAGING_RSYNCS_FAILED clear and a
            # partial clone could still pass the gate on markers alone.
            cp -a "/${sys_dir}" "${STAGE_DIR}/" 2>/dev/null || STAGING_RSYNCS_FAILED=1
          fi
        done
      fi
      # D-M1: sanitize machine identity on the staged copy, exactly as
      # the firstboot clone does, so the standby generates its own
      # machine-id, SSH host keys and cloud-init state on its first
      # boot. Also drops any live /var/lib/axonwall state the cp
      # fallback carried over (the rsync branch already excludes it,
      # and a pre-existing partial staged tree may still hold it).
      : > "${STAGE_DIR}/etc/machine-id" 2>/dev/null || true
      rm -f "${STAGE_DIR}/var/lib/dbus/machine-id" "${STAGE_DIR}"/etc/ssh/ssh_host_* 2>/dev/null || true
      rm -rf "${STAGE_DIR}/var/lib/cloud/data" "${STAGE_DIR}/var/lib/cloud/instance" "${STAGE_DIR}/var/lib/cloud/instances" 2>/dev/null || true
      rm -rf "${STAGE_DIR}/var/lib/axonwall" 2>/dev/null || true
      rm -rf "${STAGE_DIR}/home" 2>/dev/null || true
      mkdir -p "${STAGE_DIR}/dev" "${STAGE_DIR}/proc" "${STAGE_DIR}/sys" "${STAGE_DIR}/run" "${STAGE_DIR}/tmp" "${STAGE_DIR}/boot" "${STAGE_DIR}/home" "${STAGE_DIR}/var/lib/axonwall" 2>/dev/null || true
    fi

    # Ensure /etc/fstab on target slot points to the correct root label, has no /mnt/standby mount, and bind-mounts /var/lib/axonwall/home -> /home
    if [ -f "${STAGE_DIR}/etc/fstab" ]; then
      sed -i -E 's|^[^#[:space:]]+([[:space:]]+/[[:space:]]+)|LABEL='"${TARGET_LABEL}"'\1|' "${STAGE_DIR}/etc/fstab" 2>/dev/null || true
      sed -i '\#/mnt/standby#d' "${STAGE_DIR}/etc/fstab" 2>/dev/null || true
      if ! grep -q '/var/lib/axonwall/home' "${STAGE_DIR}/etc/fstab"; then
        echo "/var/lib/axonwall/home  /home  none  bind  0  0" >> "${STAGE_DIR}/etc/fstab"
      fi
    fi

    # Self-heal /boot on target slot if kernel or initramfs/initrd is missing
    mkdir -p "${STAGE_DIR}/boot" 2>/dev/null || true
    if ! ls "${STAGE_DIR}/boot"/vmlinuz-* >/dev/null 2>&1; then
      echo "[+] Synchronizing kernel and boot artifacts from running /boot to Slot ${TARGET_SLOT}..."
      if [ -d /boot ] && ls /boot/vmlinuz-* >/dev/null 2>&1; then
        for bf in /boot/vmlinuz* /boot/initrd* /boot/initramfs* /boot/System.map* /boot/config*; do
          if [ -e "$bf" ]; then
            cp -a "$bf" "${STAGE_DIR}/boot/" 2>/dev/null || true
          fi
        done
        if [ -d /boot/grub ] && [ ! -d "${STAGE_DIR}/boot/grub" ]; then
          cp -a /boot/grub "${STAGE_DIR}/boot/" 2>/dev/null || true
        fi
      fi
    fi

    echo "[+] Updating application packages on standby partition..."
    if [ -n "$DEB_TMP" ] && [ -f "$DEB_TMP" ]; then
      PKG_STAGE="${WORK_DIR}/pkg-stage"
      rm -rf "${PKG_STAGE}"
      mkdir -p "${PKG_STAGE}"
      if extract_deb "${DEB_TMP}" "${PKG_STAGE}"; then
        # E2-2: a failed overlay must fail the update, not stage a
        # partial tree that the E1 gate then arms as the new version.
        # Unmount before exiting so no standby mount is left behind.
        if ! apply_staged_tree "${PKG_STAGE}" "${STAGE_DIR}"; then
          echo "[-] ERROR: Failed to apply firmware payload onto Slot ${TARGET_SLOT} (staged copy failed); refusing to arm it." >&2
          rm -rf "${PKG_STAGE}"
          umount "${STAGE_DIR}" 2>/dev/null || true
          rmdir "${STAGE_DIR}" 2>/dev/null || true
          exit 1
        fi
        if [ -f "${STAGE_DIR}/usr/local/bin/axonwall-update" ]; then
          if sh -n "${STAGE_DIR}/usr/local/bin/axonwall-update" 2>/dev/null; then
            atomic_install_bin "${STAGE_DIR}/usr/local/bin/axonwall-update" "/usr/local/bin" "axonwall-update" 2>/dev/null || true
          elif [ -f /usr/local/bin/axonwall-update ]; then
            atomic_install_bin "/usr/local/bin/axonwall-update" "${STAGE_DIR}/usr/local/bin" "axonwall-update" 2>/dev/null || true
          fi
        fi
        if [ -d "${PKG_STAGE}/usr/local/bin" ]; then
          for bin_f in "${PKG_STAGE}/usr/local/bin/"*; do
            if [ -e "$bin_f" ] || [ -L "$bin_f" ]; then
              bname="$(basename "$bin_f")"
              if [ ! -e "/usr/local/bin/${bname}" ]; then
                atomic_install_bin "$bin_f" "/usr/local/bin" "$bname" 2>/dev/null || true
              fi
            fi
          done
        fi
        ensure_cli_symlinks "/"
      else
        # E2-1: mirror the ZBM branch — a verified .deb that fails to
        # extract must fail the update, not silently skip the apply
        # and let the version write + E1 gate arm the stale slot as
        # the new version. Unmount before exiting so no standby
        # mount is left behind.
        echo "[-] ERROR: Failed to extract firmware archive ${DEB_TMP}; refusing to arm Slot ${TARGET_SLOT}." >&2
        rm -rf "${PKG_STAGE}"
        umount "${STAGE_DIR}" 2>/dev/null || true
        rmdir "${STAGE_DIR}" 2>/dev/null || true
        exit 1
      fi
      rm -rf "${PKG_STAGE}"
    elif [ -d /opt/axonwall ]; then
      mkdir -p "${STAGE_DIR}/opt/axonwall" 2>/dev/null || true
      if command -v rsync >/dev/null 2>&1; then
        rsync -a --delete /opt/axonwall/ "${STAGE_DIR}/opt/axonwall/" 2>/dev/null || STAGING_RSYNCS_FAILED=1
      else
        # E-M5 (round-3): same as the base-rootfs clone above — a
        # failed cp fallback must set the staging-failure flag, or the
        # E1 gate arms a half-staged slot on markers alone.
        cp -a /opt/axonwall/. "${STAGE_DIR}/opt/axonwall/" 2>/dev/null || STAGING_RSYNCS_FAILED=1
      fi
    fi

    if [ -n "$CLEAN_VER" ]; then
      mkdir -p "${STAGE_DIR}/etc/axonwall" 2>/dev/null || true
      echo "$CLEAN_VER" > "${STAGE_DIR}/etc/axonwall/version" 2>/dev/null || true

      # Accurately compute and persist per-slot versions
      EXISTING_SV_A=""
      EXISTING_SV_B=""
      if [ -f /var/lib/axonwall/slot_versions.json ]; then
        EXISTING_SV_A="$(grep -oE '"slotA"[[:space:]]*:[[:space:]]*"[^"]+"' /var/lib/axonwall/slot_versions.json 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' || true)"
        EXISTING_SV_B="$(grep -oE '"slotB"[[:space:]]*:[[:space:]]*"[^"]+"' /var/lib/axonwall/slot_versions.json 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' || true)"
      fi

      if [ "$TARGET_SLOT" = "A" ]; then
        SV_A="$CLEAN_VER"
        if [ "$RUNNING_ACTIVE_SLOT" = "B" ]; then
          SV_B="$RUNNING_VER"
        else
          SV_B="${EXISTING_SV_B:-$RUNNING_VER}"
        fi
      else
        SV_B="$CLEAN_VER"
        if [ "$RUNNING_ACTIVE_SLOT" = "A" ]; then
          SV_A="$RUNNING_VER"
        else
          SV_A="${EXISTING_SV_A:-$RUNNING_VER}"
        fi
      fi

      SV_TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")"
      SV_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s",\n  "updatedAt": "%s"\n}\n' "$SV_A" "$SV_B" "$SV_TIMESTAMP")"

      # Write to staged target rootfs; live /etc/axonwall and /var/lib/axonwall
      # slot_versions.json are written only after STAGING_OK and GRUB arming succeed.
      printf '%s' "$SV_JSON" > "${STAGE_DIR}/etc/axonwall/slot_versions.json" 2>/dev/null || true
    fi

    # Ensure stable kernel & initrd/initramfs symlinks exist on target slot (Debian & Alpine)
    if [ -d "${STAGE_DIR}/boot" ]; then
      LATEST_SLOT_KERN="$(ls -1t "${STAGE_DIR}/boot"/vmlinuz-* 2>/dev/null | head -n1 || true)"
      if [ -n "$LATEST_SLOT_KERN" ]; then
        ln -sf "$(basename "$LATEST_SLOT_KERN")" "${STAGE_DIR}/boot/vmlinuz"
        ln -sf "boot/$(basename "$LATEST_SLOT_KERN")" "${STAGE_DIR}/vmlinuz" 2>/dev/null || true
      fi
      LATEST_SLOT_INITRD="$(ls -1t "${STAGE_DIR}/boot"/initrd.img-* "${STAGE_DIR}/boot"/initramfs-* 2>/dev/null | head -n1 || true)"
      if [ -n "$LATEST_SLOT_INITRD" ]; then
        ln -sf "$(basename "$LATEST_SLOT_INITRD")" "${STAGE_DIR}/boot/initrd.img"
        ln -sf "boot/$(basename "$LATEST_SLOT_INITRD")" "${STAGE_DIR}/initrd.img" 2>/dev/null || true
      fi
    fi

    # E2-3: there is deliberately no grubenv write on the target
    # partition before this gate. The old pre-gate write armed the
    # GRUB-visible grubenv in the B->A direction before staging was
    # proven complete, so a failed staging still booted the half-
    # staged slot. The arming block after the gate writes the running
    # grubenv plus the slot-A mirror, which covers both directions.
    # E1 staging-success gate: only a staged slot with a real rootfs
    # (etc + init), a kernel, and no failed staging rsync may ever be
    # armed. A stale or partial tree fails here, not at next boot.
    if [ "$STAGING_RSYNCS_FAILED" != "1" ] && [ -d "${STAGE_DIR}/etc" ] && [ -e "${STAGE_DIR}/sbin/init" ] && ls "${STAGE_DIR}/boot"/vmlinuz-* >/dev/null 2>&1; then
      STAGING_OK=1
    else
      echo "[-] ERROR: Staged Slot ${TARGET_SLOT} is not a complete bootable rootfs (missing etc, sbin/init, or kernel, or a staging copy failed); refusing to arm it." >&2
    fi

    umount "${STAGE_DIR}" 2>/dev/null || true
    rmdir "${STAGE_DIR}" 2>/dev/null || true
  fi

  # E1: never arm a slot whose staging did not complete. The mount-ok
  # block above is the only place staging happens; anything else means
  # the standby slot was never updated.
  if [ "$STAGING_OK" != "1" ]; then
    echo "[-] ERROR: Standby Slot ${TARGET_SLOT} staging did not complete (mount failure or incomplete staged tree); refusing to arm it. The previous boot target is unchanged." >&2
    umount "${STAGE_DIR}" 2>/dev/null || true
    rmdir "${STAGE_DIR}" 2>/dev/null || true
    exit 1
  fi

  # Also ensure running rootfs has valid /boot/vmlinuz and /boot/initrd.img symlinks
  if [ -d /boot ]; then
    RUN_KERN="$(ls -1t /boot/vmlinuz-* 2>/dev/null | head -n1 || true)"
    if [ -n "$RUN_KERN" ] && [ ! -e /boot/vmlinuz ]; then
      ln -sf "$(basename "$RUN_KERN")" /boot/vmlinuz 2>/dev/null || true
    fi
    RUN_INITRD="$(ls -1t /boot/initrd.img-* /boot/initramfs-* 2>/dev/null | head -n1 || true)"
    if [ -n "$RUN_INITRD" ] && [ ! -e /boot/initrd.img ]; then
      ln -sf "$(basename "$RUN_INITRD")" /boot/initrd.img 2>/dev/null || true
    fi
  fi

  # Only update /etc/axonwall/version on the running rootfs if the target slot is the currently active slot
  ACTIVE_SLOT="A"
  if grep -qs -E 'axon_root_b|slot=B' /proc/cmdline 2>/dev/null; then
    ACTIVE_SLOT="B"
  fi
  if [ "$TARGET_SLOT" = "$ACTIVE_SLOT" ] && [ -n "$CLEAN_VER" ] && [ -d /etc/axonwall ]; then
    echo "$CLEAN_VER" > /etc/axonwall/version 2>/dev/null || true
  fi

  # Arm GRUB boot watchdog for next boot on current /boot/grub/grubenv (and Slot A's grubenv if running on Slot B)
  echo "[+] Arming GRUB boot watchdog on /boot/grub/grubenv..."
  # E1: check the arming call's result — a failed grubenv write must fail
  # the update, not print success for an unarmed slot.
  if ! update_grubenv_file "/boot/grub/grubenv" "${TARGET_SLOT}"; then
    echo "[-] ERROR: Failed to arm GRUB boot watchdog for Slot ${TARGET_SLOT} (grubenv write failed); the previous boot target is unchanged." >&2
    exit 1
  fi
  # E2-4: running on B, GRUB reads slot A's grubenv, so this mirror
  # IS the arming — the primary write above went to B's grubenv,
  # which GRUB never reads. A mount or write failure here must fail
  # the update, not warn and exit 0 for a slot that was never armed.
  if [ "$ACTIVE_SLOT" = "B" ]; then
    SLOT_A_DEV="$(resolve_label_dev "axon_root_a")"
    MIRROR_OK=0
    if [ -n "$SLOT_A_DEV" ] && [ -b "$SLOT_A_DEV" ]; then
      SLOT_A_MNT="${WORK_DIR}/grubenv-slot-a"
      mkdir -p "$SLOT_A_MNT" 2>/dev/null || true
      if mount "$SLOT_A_DEV" "$SLOT_A_MNT" 2>/dev/null; then
        if [ -d "$SLOT_A_MNT/boot/grub" ]; then
          if update_grubenv_file "$SLOT_A_MNT/boot/grub/grubenv" "${TARGET_SLOT}"; then
            MIRROR_OK=1
          fi
        else
          echo "[-] ERROR: Slot A has no /boot/grub directory; cannot mirror the GRUB environment." >&2
        fi
        umount "$SLOT_A_MNT" 2>/dev/null || true
      else
        echo "[-] ERROR: Failed to mount Slot A (${SLOT_A_DEV}) to mirror the GRUB environment." >&2
      fi
      rmdir "$SLOT_A_MNT" 2>/dev/null || true
    else
      echo "[-] ERROR: Slot A device (label axon_root_a) could not be resolved; cannot mirror the GRUB environment." >&2
    fi
    if [ "$MIRROR_OK" != "1" ]; then
      echo "[-] ERROR: Failed to mirror the GRUB environment to Slot A; Slot ${TARGET_SLOT} was NOT armed for next boot (GRUB reads Slot A's grubenv). The previous boot target is unchanged." >&2
      exit 1
    fi
  fi
  if [ -n "$SV_JSON" ]; then
    mkdir -p /etc/axonwall /var/lib/axonwall 2>/dev/null || true
    printf '%s' "$SV_JSON" > /etc/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$SV_JSON" > /var/lib/axonwall/slot_versions.json 2>/dev/null || true
  fi
elif [ "$BTRFS_MODE" = "1" ]; then
  echo "[+] Running in Btrfs + Snapper Root mode. Taking pre-update snapshot before in-place upgrade..."
  mkdir -p /etc/axonwall /var/lib/axonwall 2>/dev/null || true

  PRE_SNAP_ID=""
  SNAP_DESC_VER="${CLEAN_VER:-update}"
  if command -v snapper >/dev/null 2>&1; then
    PRE_SNAP_ID="$(snapper -c root create --type pre --print-number --cleanup-algorithm number --description "Pre-update Axonwall v${SNAP_DESC_VER}" 2>/dev/null | tr -dc '0-9' || true)"
  fi
  if [ -z "$PRE_SNAP_ID" ] && [ -x /usr/local/bin/axonwall-btrfs-grub ]; then
    PRE_SNAP_ID="$(/usr/local/bin/axonwall-btrfs-grub create-snapshot --type pre --description "Pre-update Axonwall v${SNAP_DESC_VER}" 2>/dev/null | tr -dc '0-9' || true)"
  fi
  if [ -z "$PRE_SNAP_ID" ]; then
    echo "[-] ERROR: Failed to create pre-update Btrfs/Snapper snapshot; aborting update before modifying root subvolume @." >&2
    exit 1
  fi
  echo "[+] Created pre-update Snapper snapshot #${PRE_SNAP_ID}."

  if [ "$APT_UPGRADE" = "1" ] || [ "${AXONWALL_APT_UPGRADE:-0}" = "1" ]; then
    if command -v apt-get >/dev/null 2>&1; then
      echo "[+] Updating Debian APT repositories and upgrading system packages..."
      if ! DEBIAN_FRONTEND=noninteractive apt-get update -y; then
        echo "[-] ERROR: apt-get update failed; system packages were NOT upgraded (pre-update snapshot #${PRE_SNAP_ID} preserved)." >&2
        exit 1
      fi
      if ! DEBIAN_FRONTEND=noninteractive apt-get -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" upgrade -y; then
        echo "[-] ERROR: apt-get upgrade failed; pre-update snapshot #${PRE_SNAP_ID} is available for rollback." >&2
        exit 1
      fi
    fi
  fi

  if [ -n "$DEB_TMP" ] && [ -f "$DEB_TMP" ]; then
    PKG_STAGE="${WORK_DIR}/pkg-stage"
    rm -rf "${PKG_STAGE}"
    mkdir -p "${PKG_STAGE}"
    if ! extract_deb "${DEB_TMP}" "${PKG_STAGE}"; then
      echo "[-] ERROR: Failed to extract firmware archive ${DEB_TMP}; the update did NOT complete." >&2
      rm -rf "${PKG_STAGE}"
      exit 1
    fi
    if ! apply_staged_tree "${PKG_STAGE}" "/"; then
      echo "[-] ERROR: Failed to apply firmware payload onto Btrfs @ subvolume; rollback available via Snapper snapshot #${PRE_SNAP_ID}." >&2
      rm -rf "${PKG_STAGE}"
      exit 1
    fi
    if [ -d "${PKG_STAGE}/usr/local/bin" ]; then
      for bin_f in "${PKG_STAGE}/usr/local/bin/"*; do
        if [ -e "$bin_f" ] || [ -L "$bin_f" ]; then
          bname="$(basename "$bin_f")"
          if [ ! -e "/usr/local/bin/${bname}" ] || [ "$bname" = "axonwall-update" ] || [ "$bname" = "axonwall-btrfs-grub" ]; then
            if [ "$bname" = "axonwall-update" ] && [ -f "$bin_f" ] && [ ! -L "$bin_f" ] && ! sh -n "$bin_f" 2>/dev/null; then
              echo "[!] WARNING: staged axonwall-update failed sh -n syntax check; keeping live /usr/local/bin/axonwall-update." >&2
              continue
            fi
            atomic_install_bin "$bin_f" "/usr/local/bin" "$bname" 2>/dev/null || true
          fi
        fi
      done
    fi
    ensure_cli_symlinks "/"
    rm -rf "${PKG_STAGE}"
  fi

  if [ -n "$CLEAN_VER" ]; then
    echo "$CLEAN_VER" > /etc/axonwall/version 2>/dev/null || true
    echo "btrfs" > /etc/axonwall/install-mode 2>/dev/null || true
    echo "btrfs" > /var/lib/axonwall/install-mode 2>/dev/null || true
    SV_TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")"
    SV_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "Snapper #%s",\n  "updatedAt": "%s"\n}\n' "$CLEAN_VER" "$PRE_SNAP_ID" "$SV_TIMESTAMP")"
    printf '%s' "$SV_JSON" > /etc/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$SV_JSON" > /var/lib/axonwall/slot_versions.json 2>/dev/null || true
  fi

  POST_SNAP_ID=""
  if command -v snapper >/dev/null 2>&1; then
    POST_SNAP_ID="$(snapper -c root create --type post --pre-number "$PRE_SNAP_ID" --print-number --cleanup-algorithm number --description "Post-update Axonwall v${SNAP_DESC_VER}" 2>/dev/null | tr -dc '0-9' || true)"
  fi
  if [ -z "$POST_SNAP_ID" ] && [ -x /usr/local/bin/axonwall-btrfs-grub ]; then
    POST_SNAP_ID="$(/usr/local/bin/axonwall-btrfs-grub create-snapshot --type post --pre-number "$PRE_SNAP_ID" --description "Post-update Axonwall v${SNAP_DESC_VER}" 2>/dev/null | tr -dc '0-9' || true)"
  fi
  if [ -x /usr/local/bin/axonwall-btrfs-grub ]; then
    /usr/local/bin/axonwall-btrfs-grub sync 2>/dev/null || true
  fi

  if [ -n "$DEB_TMP" ] && [ -f "$DEB_TMP" ]; then
    reload_edition_services
  fi
  echo "[✓] Btrfs + Snapper update complete (pre=#${PRE_SNAP_ID}, post=#${POST_SNAP_ID:-n/a}); GRUB snapshot menu refreshed."
elif [ "$ROLLING_MODE" != "1" ] && ( [ -e "/dev/disk/by-label/axon_root_a" ] || [ -e "/dev/disk/by-label/axon_root_b" ] || grep -qs -E 'slot=[AB]' /proc/cmdline ); then
  echo "[-] ERROR: Appliance is configured for Dual-Root A/B, but target block device for Slot ${TARGET_SLOT} could not be resolved." >&2
  exit 1
else
  echo "[+] Running in Rolling Standard Linux (Single-Root /) mode. Performing in-place update..."
  mkdir -p /etc/axonwall /var/lib/axonwall 2>/dev/null || true

  if [ "$APT_UPGRADE" = "1" ] || [ "${AXONWALL_APT_UPGRADE:-0}" = "1" ]; then
    if command -v apt-get >/dev/null 2>&1; then
      echo "[+] Updating Debian APT repositories and upgrading system packages..."
      # R4-E-M1: in the --apt-only flow the apt upgrade IS the update,
      # so a failed update or upgrade must fail the update, not fall
      # through to the success echo. The old `|| true` form discarded
      # both statuses. A failed update aborts before the upgrade (no
      # upgrading from stale lists); either failure exits 1 with no
      # version stamp and no success message.
      if ! DEBIAN_FRONTEND=noninteractive apt-get update -y; then
        echo "[-] ERROR: apt-get update failed; system packages were NOT upgraded." >&2
        exit 1
      fi
      if ! DEBIAN_FRONTEND=noninteractive apt-get -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" upgrade -y; then
        echo "[-] ERROR: apt-get upgrade failed; system packages were NOT upgraded." >&2
        exit 1
      fi
    fi
  fi

  if [ -n "$DEB_TMP" ] && [ -f "$DEB_TMP" ]; then
    PKG_STAGE="${WORK_DIR}/pkg-stage"
    rm -rf "${PKG_STAGE}"
    mkdir -p "${PKG_STAGE}"
    # E2-1: mirror the ZBM branch — a failed extraction must fail the
    # update, not silently skip the apply and print success.
    if ! extract_deb "${DEB_TMP}" "${PKG_STAGE}"; then
      echo "[-] ERROR: Failed to extract firmware archive ${DEB_TMP}; the update did NOT complete." >&2
      rm -rf "${PKG_STAGE}"
      exit 1
    fi
    # E2-2: a failed in-place overlay must fail the update, not
    # print success for a half-updated live root.
    if ! apply_staged_tree "${PKG_STAGE}" "/"; then
      echo "[-] ERROR: Failed to apply firmware payload in place (staged copy failed); the update did NOT complete." >&2
      rm -rf "${PKG_STAGE}"
      exit 1
    fi
    rm -rf "${PKG_STAGE}"

    # Schedule asynchronous service restart after HTTP response finishes so we do not kill axonwall-ui mid-request
    reload_edition_services
  fi

  # E2-1: the version file is written only after a successful apply.
  # It used to be written before the extract attempt, so a failed
  # extraction still stamped the new version on the live root.
  if [ -n "$CLEAN_VER" ]; then
    echo "$CLEAN_VER" > /etc/axonwall/version 2>/dev/null || true
    SV_TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")"
    SV_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "Rolling",\n  "updatedAt": "%s"\n}\n' "$CLEAN_VER" "$SV_TIMESTAMP")"
    printf '%s' "$SV_JSON" > /etc/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$SV_JSON" > /var/lib/axonwall/slot_versions.json 2>/dev/null || true
  fi
fi

rm -f "${DEB_TMP:-}" "${DEB_TMP:-}.sha256" "${DEB_TMP:-}.sha256.sig" 2>/dev/null || true
echo "[+] Firmware update process completed successfully."
}

main "$@"; exit $?
