#!/bin/sh
# ==============================================================================
# Axonwall Appliance Firmware & System Updater (Debian 13 Dual-Root A/B)
# ==============================================================================
set -eu

TARGET_SLOT="B"
TARGET_VERSION=""
UPDATE_CHANNEL="stable"
FORCE_ROLLING=0
FORCE_ZBM=0
APT_UPGRADE=0

while [ $# -gt 0 ]; do
  case "$1" in
    --slot)
      TARGET_SLOT="${2:-B}"
      shift 2
      ;;
    --version)
      TARGET_VERSION="${2:-}"
      shift 2
      ;;
    --channel)
      UPDATE_CHANNEL="${2:-stable}"
      shift 2
      ;;
    --rolling)
      FORCE_ROLLING=1
      shift
      ;;
    --zbm|--zfsbootmenu)
      FORCE_ZBM=1
      shift
      ;;
    --apt|--apt-upgrade)
      APT_UPGRADE=1
      shift
      ;;
    *)
      shift
      ;;
  esac
done

ZBM_MODE=0
if [ "$FORCE_ZBM" = "1" ]; then
  ZBM_MODE=1
elif [ -f /etc/axonwall/install-mode ] && grep -qiE 'zbm|zfsbootmenu' /etc/axonwall/install-mode 2>/dev/null; then
  ZBM_MODE=1
elif [ -f /var/lib/axonwall/install-mode ] && grep -qiE 'zbm|zfsbootmenu' /var/lib/axonwall/install-mode 2>/dev/null; then
  ZBM_MODE=1
elif grep -qs -E 'zfs=zroot/ROOT|boot=zfs' /proc/cmdline 2>/dev/null; then
  ZBM_MODE=1
elif command -v findmnt >/dev/null 2>&1 && findmnt -n -o FSTYPE / 2>/dev/null | grep -q 'zfs'; then
  ZBM_MODE=1
fi

ROLLING_MODE=0
if [ "$ZBM_MODE" = "1" ]; then
  ROLLING_MODE=0
elif [ "$FORCE_ROLLING" = "1" ]; then
  ROLLING_MODE=1
elif [ -f /etc/axonwall/install-mode ] && grep -qi 'rolling' /etc/axonwall/install-mode 2>/dev/null; then
  ROLLING_MODE=1
elif [ -f /var/lib/axonwall/install-mode ] && grep -qi 'rolling' /var/lib/axonwall/install-mode 2>/dev/null; then
  ROLLING_MODE=1
elif [ ! -e /dev/disk/by-label/axon_root_a ] && [ ! -e /dev/disk/by-label/axon_root_b ] && ! grep -qs -E 'slot=[AB]|axon_root_[ab]' /proc/cmdline 2>/dev/null; then
  ROLLING_MODE=1
fi

TARGET_SLOT="$(printf '%s' "$TARGET_SLOT" | tr '[:lower:]' '[:upper:]')"
if [ "$TARGET_SLOT" != "A" ] && [ "$TARGET_SLOT" != "B" ]; then
  if [ "$ROLLING_MODE" = "1" ] || [ "$ZBM_MODE" = "1" ]; then
    TARGET_SLOT="A"
  else
    echo "[-] Error: Invalid target slot '${TARGET_SLOT}'. Must be 'A' or 'B'." >&2
    exit 1
  fi
fi

echo "================================================================================"
echo "Axonwall Appliance Firmware Updater"
if [ "$ZBM_MODE" = "1" ]; then
  echo "  Install Mode  : ZFSBootMenu Root-on-ZFS (Boot Environments & Snapshots)"
elif [ "$ROLLING_MODE" = "1" ]; then
  echo "  Install Mode  : Rolling Standard Linux (Single-Root /)"
else
  echo "  Install Mode  : Dual-Root A/B (Target: Slot ${TARGET_SLOT})"
fi
echo "  Target Version: ${TARGET_VERSION:-latest}"
echo "  Channel       : ${UPDATE_CHANNEL}"
echo "================================================================================"

# Pre-Update OpenLDAP Directory Backup (protects against MDB version skew on rollback)
if command -v slapcat >/dev/null 2>&1 && [ -d /var/lib/axonwall/ldap/config/cn=config ]; then
  BACKUP_TS="$(date -u +"%Y%m%dT%H%M%SZ" 2>/dev/null || echo "latest")"
  mkdir -p /var/lib/axonwall/ldap/backups 2>/dev/null || true
  echo "[+] Creating pre-update OpenLDAP LDIF snapshot in /var/lib/axonwall/ldap/backups/..."
  slapcat -F /var/lib/axonwall/ldap/config -n 0 -l "/var/lib/axonwall/ldap/backups/pre-update-slot-${TARGET_SLOT}-config-${BACKUP_TS}.ldif" 2>/dev/null || true
  slapcat -F /var/lib/axonwall/ldap/config -n 1 -l "/var/lib/axonwall/ldap/backups/pre-update-slot-${TARGET_SLOT}-data-${BACKUP_TS}.ldif" 2>/dev/null || true
  chmod 0600 "/var/lib/axonwall/ldap/backups/pre-update-slot-${TARGET_SLOT}-"*.ldif 2>/dev/null || true
fi

# Helper: Extract .deb payload to a destination directory on Debian
extract_deb() {
  deb_file="$1"
  dest_dir="$2"

  if command -v dpkg-deb >/dev/null 2>&1; then
    dpkg-deb -x "$deb_file" "$dest_dir" 2>/dev/null && return 0
  fi

  if command -v node >/dev/null 2>&1; then
    deb_tmp_dir="$(mktemp -d /tmp/axonwall-deb-XXXXXX 2>/dev/null || true)"
    if [ -z "$deb_tmp_dir" ] || [ ! -d "$deb_tmp_dir" ]; then
      return 1
    fi
    chmod 0700 "$deb_tmp_dir" 2>/dev/null || true
    data_tar="$(node -e '
      const fs = require("fs");
      const buf = fs.readFileSync(process.argv[1]);
      let off = 8;
      while (off + 60 <= buf.length) {
        const name = buf.slice(off, off + 16).toString("ascii").trim().replace(/\/$/, "");
        const size = parseInt(buf.slice(off + 48, off + 58).toString("ascii").trim(), 10);
        off += 60;
        if (/^data\.tar(\.(gz|xz|zst|bz2))?$/.test(name)) {
          const out = process.argv[2] + "/" + name;
          fs.writeFileSync(out, buf.slice(off, off + size), { mode: 0o600 });
          console.log(out);
          process.exit(0);
        }
        off += size + (size % 2);
      }
      process.exit(1);
    ' "$deb_file" "$deb_tmp_dir" 2>/dev/null || true)"

    if [ -n "$data_tar" ] && [ -f "$data_tar" ]; then
      # Tar-slip guard (audit D-S07)
      if tar -tf "$data_tar" 2>/dev/null | grep -qE '^/|(^|/)\.\.(/|$)'; then
        echo "[!] Update package contains unsafe paths; refusing to extract." >&2
        rm -rf "$deb_tmp_dir"
        return 1
      fi
      # R2: tar -xf honors symlink/hardlink members, so a crafted
      # data.tar could plant links pointing outside the staging
      # tree, which later rsync/cp steps would follow. Reject link
      # members before extraction. This fallback runs only when
      # dpkg-deb is absent, and a malicious .deb must first pass
      # the signature check, so a proportionate pre-extraction
      # rejection (rather than a post-extraction audit) suffices.
      # --no-same-owner is defense in depth for the same reason.
      if tar -tvf "$data_tar" 2>/dev/null | grep -qE '^[lh]'; then
        echo "[!] Update package contains link members; refusing to extract." >&2
        rm -rf "$deb_tmp_dir"
        return 1
      fi
      tar --no-same-owner -xf "$data_tar" -C "$dest_dir" 2>/dev/null || {
        rm -rf "$deb_tmp_dir"
        return 1
      }
      rm -rf "$deb_tmp_dir"
      return 0
    fi
    rm -rf "$deb_tmp_dir"
  fi

  return 1
}

# Sync static non-secret /etc/axonwall assets into both target root and persistent bind-mount
sync_static_etc_axonwall() {
  src_etc="$1"
  dst_etc="$2"
  [ -d "$src_etc" ] || return 0
  mkdir -p "$dst_etc" 2>/dev/null || true
  for item in nvim yara branding starship.toml release-signing.pub; do
    if [ -e "${src_etc}/${item}" ]; then
      cp -af "${src_etc}/${item}" "${dst_etc}/" 2>/dev/null || true
    fi
  done
}

# Ensure Debian batcat/fdfind and ZBM symlinks exist in target /usr/local/bin
ensure_cli_symlinks() {
  target_root="${1:-/}"
  target_root="${target_root%/}"
  mkdir -p "${target_root}/usr/local/bin" 2>/dev/null || true
  if [ -x "${target_root}/usr/bin/batcat" ] && [ ! -e "${target_root}/usr/local/bin/bat" ] && [ ! -e "${target_root}/usr/bin/bat" ]; then
    ln -sf /usr/bin/batcat "${target_root}/usr/local/bin/bat" 2>/dev/null || true
  fi
  if [ -x "${target_root}/usr/bin/fdfind" ] && [ ! -e "${target_root}/usr/local/bin/fd" ] && [ ! -e "${target_root}/usr/bin/fd" ]; then
    ln -sf /usr/bin/fdfind "${target_root}/usr/local/bin/fd" 2>/dev/null || true
  fi
  if [ -x "${target_root}/usr/local/bin/axonwall-zbm-theme" ]; then
    [ -e "${target_root}/usr/local/bin/generate-zbm" ] || ln -sf /usr/local/bin/axonwall-zbm-theme "${target_root}/usr/local/bin/generate-zbm" 2>/dev/null || true
    [ -e "${target_root}/usr/local/bin/zbm-kcl" ] || ln -sf /usr/local/bin/axonwall-zbm-theme "${target_root}/usr/local/bin/zbm-kcl" 2>/dev/null || true
  fi
}

# Apply extracted .deb staging tree onto a destination root (standby slot or live root)
# E2-2: copy failures are load-bearing, not cosmetic. Every copy used
# to return success unconditionally (|| true), so a disk-full or I/O
# error mid-overlay staged a partial tree that was then armed as the
# new version. Track failures and return non-zero; every caller treats
# a non-zero return as fatal. mkdir/chown/chmod and the static-asset
# sync stay best-effort (they cannot leave a half-copied package tree).
apply_staged_tree() {
  pkg_stage="$1"
  dest_root="${2:-/}"
  dest_root="${dest_root%/}"
  _apply_failed=0

  if [ -d "${pkg_stage}/opt/axonwall" ]; then
    mkdir -p "${dest_root}/opt/axonwall"
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --delete "${pkg_stage}/opt/axonwall/" "${dest_root}/opt/axonwall/" 2>/dev/null || _apply_failed=1
    else
      rm -rf "${dest_root}/opt/axonwall"
      cp -a "${pkg_stage}/opt/axonwall" "${dest_root}/opt/axonwall" 2>/dev/null || _apply_failed=1
    fi
    chown -R root:root "${dest_root}/opt/axonwall" 2>/dev/null || true
    chmod -R go-w "${dest_root}/opt/axonwall" 2>/dev/null || true
  fi

  if [ -d "${pkg_stage}/usr/sbin" ]; then
    mkdir -p "${dest_root}/usr/sbin" 2>/dev/null || true
    for sbin_f in "${pkg_stage}/usr/sbin/"*; do
      if [ -e "$sbin_f" ] || [ -L "$sbin_f" ]; then
        bname="$(basename "$sbin_f")"
        rm -f "${dest_root}/usr/sbin/${bname}" 2>/dev/null || true
        cp -af "$sbin_f" "${dest_root}/usr/sbin/" 2>/dev/null || _apply_failed=1
        if [ -f "${dest_root}/usr/sbin/${bname}" ] && [ ! -L "${dest_root}/usr/sbin/${bname}" ]; then
          chmod 755 "${dest_root}/usr/sbin/${bname}" 2>/dev/null || true
        fi
      fi
    done
  fi

  if [ -d "${pkg_stage}/usr/local/bin" ]; then
    mkdir -p "${dest_root}/usr/local/bin" 2>/dev/null || true
    for bin_f in "${pkg_stage}/usr/local/bin/"*; do
      if [ -e "$bin_f" ] || [ -L "$bin_f" ]; then
        bname="$(basename "$bin_f")"
        rm -f "${dest_root}/usr/local/bin/${bname}" 2>/dev/null || true
        cp -af "$bin_f" "${dest_root}/usr/local/bin/" 2>/dev/null || _apply_failed=1
        if [ -f "${dest_root}/usr/local/bin/${bname}" ] && [ ! -L "${dest_root}/usr/local/bin/${bname}" ]; then
          chmod 755 "${dest_root}/usr/local/bin/${bname}" 2>/dev/null || true
        fi
      fi
    done
  fi

  for sub in usr/lib/axonwall usr/lib/sysusers.d usr/lib/tmpfiles.d usr/share/oh-my-zsh usr/share/axonwall etc/zsh etc/zfsbootmenu etc/modprobe.d etc/sysctl.d etc/vim; do
    if [ -d "${pkg_stage}/${sub}" ]; then
      mkdir -p "${dest_root}/${sub}" 2>/dev/null || true
      cp -af "${pkg_stage}/${sub}/." "${dest_root}/${sub}/" 2>/dev/null || _apply_failed=1
    fi
  done

  for cfg_f in etc/tmux.conf etc/rkhunter.conf.local; do
    if [ -f "${pkg_stage}/${cfg_f}" ]; then
      mkdir -p "$(dirname "${dest_root}/${cfg_f}")" 2>/dev/null || true
      cp -af "${pkg_stage}/${cfg_f}" "${dest_root}/${cfg_f}" 2>/dev/null || _apply_failed=1
    fi
  done

  if [ -d "${pkg_stage}/lib/systemd/system" ]; then
    mkdir -p "${dest_root}/lib/systemd/system" 2>/dev/null || true
    # Loop (not a bare glob copy): a package with services but no
    # timers must not fail the overlay on the unmatched *.timer glob.
    for unit_f in "${pkg_stage}/lib/systemd/system/"*.service "${pkg_stage}/lib/systemd/system/"*.timer; do
      if [ -e "$unit_f" ]; then
        cp -af "$unit_f" "${dest_root}/lib/systemd/system/" 2>/dev/null || _apply_failed=1
      fi
    done
  fi

  if [ -d "${pkg_stage}/etc/axonwall" ]; then
    sync_static_etc_axonwall "${pkg_stage}/etc/axonwall" "${dest_root}/etc/axonwall"
    if [ -d /var/lib/axonwall/etc-axonwall ]; then
      sync_static_etc_axonwall "${pkg_stage}/etc/axonwall" /var/lib/axonwall/etc-axonwall
    fi
  fi

  ensure_cli_symlinks "${dest_root}"

  if [ "$_apply_failed" != "0" ]; then
    return 1
  fi
  return 0
}

# Helper: Resolve partition block device by label
resolve_label_dev() {
  label="$1"
  if [ -e "/dev/disk/by-label/${label}" ]; then
    echo "/dev/disk/by-label/${label}"
    return 0
  fi
  if command -v findfs >/dev/null 2>&1; then
    dev="$(findfs "LABEL=${label}" 2>/dev/null || true)"
    if [ -n "$dev" ] && [ -b "$dev" ]; then
      echo "$dev"
      return 0
    fi
  fi
  if command -v blkid >/dev/null 2>&1; then
    dev="$(blkid -L "${label}" 2>/dev/null || true)"
    if [ -n "$dev" ] && [ -b "$dev" ]; then
      echo "$dev"
      return 0
    fi
  fi
  echo ""
}

# Helper: Update GRUB environment file with active_slot and reset bootcount
# Returns non-zero when the write did not happen, so arming callers (E1)
# can fail closed instead of claiming an armed slot. Best-effort callers
# inside staging keep ignoring the result.
update_grubenv_file() {
  env_path="$1"
  slot="$2"
  mkdir -p "$(dirname "$env_path")" 2>/dev/null || return 1
  if ! command -v grub-editenv >/dev/null 2>&1; then
    return 1
  fi
  if [ ! -f "$env_path" ]; then
    grub-editenv "$env_path" create 2>/dev/null || return 1
  fi
  grub-editenv "$env_path" set "active_slot=${slot}" bootcount=0 bootlimit=3 2>/dev/null || return 1
  return 0
}

# E5 (suspect variant): the adjacent-partition fallback used to
# relabel any block device on `[ -b ]` alone -- including the ext4
# data partition, which the staging step would then rsync-clone
# over. Only relabel a candidate that is an ext4 filesystem whose
# contents already look like a standby rootfs (the same markers the
# staging step uses to decide a rootfs is present: /sbin/init, /etc,
# /lib/modules). The check mounts the candidate read-only on a
# throwaway directory and unmounts it again; anything else is left
# untouched and TARGET_DEV stays empty, so the update aborts
# instead of guessing.
candidate_is_standby_rootfs() {
  _cand="$1"
  _fstype="$(blkid -o value -s TYPE "$_cand" 2>/dev/null || true)"
  [ "$_fstype" = "ext4" ] || return 1
  _probe="$(mktemp -d /tmp/axonwall-update-probe.XXXXXX 2>/dev/null || true)"
  [ -n "$_probe" ] && [ -d "$_probe" ] || return 1
  if mount -o ro "$_cand" "$_probe" 2>/dev/null; then
    if [ -e "${_probe}/sbin/init" ] && [ -d "${_probe}/etc" ] && [ -d "${_probe}/lib/modules" ]; then
      umount "$_probe" 2>/dev/null || true
      rmdir "$_probe" 2>/dev/null || true
      return 0
    fi
    umount "$_probe" 2>/dev/null || true
  fi
  rmdir "$_probe" 2>/dev/null || true
  return 1
}

# 1. Detect target block device (skip when in Rolling Single-Root mode)
TARGET_LABEL="axon_root_b"
if [ "$TARGET_SLOT" = "A" ]; then
  TARGET_LABEL="axon_root_a"
fi
TARGET_DEV=""
if [ "$ROLLING_MODE" != "1" ]; then
  TARGET_DEV="$(resolve_label_dev "$TARGET_LABEL")"
fi

if [ -z "$TARGET_DEV" ] && [ "$ROLLING_MODE" != "1" ]; then
  # Fallback: identify unlabelled standby partition adjacent to running root partition
  RUNNING_ROOT="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  if [ -b "$RUNNING_ROOT" ]; then
    ROOT_DISK="$(echo "$RUNNING_ROOT" | sed -E 's/p?[0-9]+$//')"
    ROOT_PART_NUM="$(echo "$RUNNING_ROOT" | grep -oE '[0-9]+$')"
    if [ "$TARGET_SLOT" = "B" ] && [ -n "$ROOT_PART_NUM" ]; then
      SIBLING_DEV=""
      if echo "$RUNNING_ROOT" | grep -q 'nvme\|mmcblk\|loop'; then
        SIBLING_DEV="${ROOT_DISK}p$(( ROOT_PART_NUM + 1 ))"
      else
        SIBLING_DEV="${ROOT_DISK}$(( ROOT_PART_NUM + 1 ))"
      fi
      if [ -b "$SIBLING_DEV" ]; then
        if candidate_is_standby_rootfs "$SIBLING_DEV"; then
          echo "[!] Auto-labeling unlabelled standby partition ${SIBLING_DEV} as ${TARGET_LABEL}..."
          e2label "$SIBLING_DEV" "$TARGET_LABEL" 2>/dev/null || tune2fs -L "$TARGET_LABEL" "$SIBLING_DEV" 2>/dev/null || true
          TARGET_DEV="$(resolve_label_dev "$TARGET_LABEL")"
        else
          echo "[-] ERROR: adjacent partition ${SIBLING_DEV} does not look like a standby rootfs (not ext4, or missing /sbin/init, /etc, /lib/modules); refusing to relabel it as ${TARGET_LABEL}." >&2
        fi
      fi
    elif [ "$TARGET_SLOT" = "A" ] && [ -n "$ROOT_PART_NUM" ] && [ "$ROOT_PART_NUM" -gt 1 ]; then
      SIBLING_DEV=""
      if echo "$RUNNING_ROOT" | grep -q 'nvme\|mmcblk\|loop'; then
        SIBLING_DEV="${ROOT_DISK}p$(( ROOT_PART_NUM - 1 ))"
      else
        SIBLING_DEV="${ROOT_DISK}$(( ROOT_PART_NUM - 1 ))"
      fi
      if [ -b "$SIBLING_DEV" ]; then
        if candidate_is_standby_rootfs "$SIBLING_DEV"; then
          echo "[!] Auto-labeling unlabelled standby partition ${SIBLING_DEV} as ${TARGET_LABEL}..."
          e2label "$SIBLING_DEV" "$TARGET_LABEL" 2>/dev/null || tune2fs -L "$TARGET_LABEL" "$SIBLING_DEV" 2>/dev/null || true
          TARGET_DEV="$(resolve_label_dev "$TARGET_LABEL")"
        else
          echo "[-] ERROR: adjacent partition ${SIBLING_DEV} does not look like a standby rootfs (not ext4, or missing /sbin/init, /etc, /lib/modules); refusing to relabel it as ${TARGET_LABEL}." >&2
        fi
      fi
    fi
  fi
fi

# 2. Attempt to fetch release package from GitHub Releases if online
CLEAN_VER="${TARGET_VERSION#v}"
DEB_TMP=""
if [ -n "$CLEAN_VER" ] && command -v curl >/dev/null 2>&1; then
  DEB_URL="https://github.com/axonwall/axonwall/releases/download/v${CLEAN_VER}/axonwall_${CLEAN_VER}_amd64.deb"
  SHA_URL="${DEB_URL}.sha256"
  SIG_URL="${SHA_URL}.sig"
  RELEASE_PUBKEY="/etc/axonwall/release-signing.pub"
  CANDIDATE_DEB="/tmp/axonwall_${CLEAN_VER}_amd64.deb"
  echo "[+] Checking release artifact: ${DEB_URL}"
  if curl -fsSL --connect-timeout 10 --max-time 180 -o "${CANDIDATE_DEB}" "${DEB_URL}" 2>/dev/null; then
    # Fail closed: the .deb is only ever used after verification. A
    # checksum that cannot be fetched discards the download -- a
    # missing checksum must never mean "unverified is fine" for code
    # that will run as root.
    if ! curl -fsSL --connect-timeout 10 --max-time 30 -o "${CANDIDATE_DEB}.sha256" "${SHA_URL}" 2>/dev/null; then
      echo "[-] ERROR: could not fetch SHA-256 checksum for ${DEB_URL}; discarding unverified download."
      rm -f "${CANDIDATE_DEB}"
    else
      EXPECTED_HASH="$(awk '{print $1}' "${CANDIDATE_DEB}.sha256" | head -n 1)"
      ACTUAL_HASH="$(sha256sum "${CANDIDATE_DEB}" | awk '{print $1}')"
      if [ -z "$EXPECTED_HASH" ] || [ "$EXPECTED_HASH" != "$ACTUAL_HASH" ]; then
        echo "[-] Warning: SHA-256 mismatch for downloaded package, falling back to local image sync."
        rm -f "${CANDIDATE_DEB}" "${CANDIDATE_DEB}.sha256"
      elif [ -s "$RELEASE_PUBKEY" ]; then
        # A release signing key is provisioned: the checksum itself
        # must carry a valid detached signature (${SHA_URL}.sig, made
        # by the release workflow) before the package is accepted.
        if curl -fsSL --connect-timeout 10 --max-time 30 -o "${CANDIDATE_DEB}.sha256.sig" "${SIG_URL}" 2>/dev/null \
          && openssl dgst -sha256 -verify "$RELEASE_PUBKEY" -signature "${CANDIDATE_DEB}.sha256.sig" "${CANDIDATE_DEB}.sha256" >/dev/null 2>&1; then
          echo "[+] Verified SHA-256 integrity hash and release signature: ${ACTUAL_HASH}"
          DEB_TMP="${CANDIDATE_DEB}"
        else
          echo "[-] ERROR: release signature verification failed for ${DEB_URL}; discarding download."
          rm -f "${CANDIDATE_DEB}" "${CANDIDATE_DEB}.sha256" "${CANDIDATE_DEB}.sha256.sig"
        fi
      else
        echo "[!] Warning: no release signing key at ${RELEASE_PUBKEY}; relying on SHA-256 + TLS only."
        echo "[+] Verified SHA-256 integrity hash: ${ACTUAL_HASH}"
        DEB_TMP="${CANDIDATE_DEB}"
      fi
    fi
  fi
fi

# Capture running version and active slot before mounting or modifying anything
RUNNING_ACTIVE_SLOT="A"
if grep -qs -E 'axon_root_b|slot=B' /proc/cmdline 2>/dev/null; then
  RUNNING_ACTIVE_SLOT="B"
fi
RUNNING_VER="0.8.13"
if [ -f /etc/axonwall/version ]; then
  RUNNING_VER="$(head -n1 /etc/axonwall/version | tr -d '\r\n ')"
fi

if [ -z "$DEB_TMP" ] && [ -n "$CLEAN_VER" ] && [ -f /etc/axonwall/version ] && [ "$CLEAN_VER" != "$RUNNING_VER" ]; then
  echo "[-] ERROR: Could not download or verify release package for v${CLEAN_VER} (currently running v${RUNNING_VER}). Aborting firmware update." >&2
  exit 1
fi

# 3. Check if running in ZFSBootMenu, Dual-Root, or Rolling Single-Disk mode
if [ "$ZBM_MODE" = "1" ]; then
  # E10: the ZBM path used to run with an empty --version, minting a
  # version-less Boot Environment (axonwall-), writing an empty
  # version file into the staged BE, and recording a BE dataset name
  # in a version field. The daemon always passes a version (it
  # defaults an empty one to the installed version before invoking
  # this script), so refusing here only blocks direct CLI misuse.
  if [ -z "$CLEAN_VER" ]; then
    echo "[-] ERROR: --version is required for ZBM updates; refusing to create a version-less Boot Environment." >&2
    exit 1
  fi
  echo "[+] Running in ZFSBootMenu Root-on-ZFS mode. Performing atomic snapshot & clone Boot Environment update..."
  POOL_NAME="zroot"
  PARENT_DS="${POOL_NAME}/ROOT"

  # Detect currently mounted running BE
  CURRENT_BE_DS="$(findmnt -n -o SOURCE / 2>/dev/null || awk '$2 == "/" {print $1}' /proc/mounts 2>/dev/null || true)"
  if [ -z "$CURRENT_BE_DS" ] || ! echo "$CURRENT_BE_DS" | grep -q "${PARENT_DS}/"; then
    CURRENT_BE_DS="$(zpool get -H -o value bootfs ${POOL_NAME} 2>/dev/null || true)"
  fi
  CURRENT_BE="$(basename "$CURRENT_BE_DS")"
  if [ -z "$CURRENT_BE" ] || [ "$CURRENT_BE" = "ROOT" ]; then
    CURRENT_BE="axonwall-$(cat /etc/axonwall/version 2>/dev/null || echo "current")"
  fi

  TARGET_BE="axonwall-${CLEAN_VER}"
  TARGET_BE_DS="${PARENT_DS}/${TARGET_BE}"
  PRE_SNAP="${CURRENT_BE_DS}@pre-update-v${CLEAN_VER}"

  echo "[+] Active Boot Environment : ${CURRENT_BE_DS} (${CURRENT_BE})"
  echo "[+] Target Boot Environment : ${TARGET_BE_DS} (${TARGET_BE})"

  # E11: refuse a same-version re-update. Without this, a re-run for
  # the running version reaches the recreate path below, which runs
  # `zfs destroy -r` on the target BE -- and when the target IS the
  # running BE, that destroys the live root (the destroy failure is
  # swallowed with `|| true`, so the script would carry on). Whether
  # ZFS refuses destroying a mounted BE is unproven on a live ZBM
  # box; this guard is safe regardless of that answer, so fail
  # closed here. Both the name and the full dataset path are
  # compared: the name catches the normal case, the path catches a
  # renamed or relocated running BE.
  if [ "$TARGET_BE" = "$CURRENT_BE" ] || [ "$TARGET_BE_DS" = "$CURRENT_BE_DS" ]; then
    echo "[-] ERROR: target Boot Environment ${TARGET_BE_DS} is the running Boot Environment (same version ${CLEAN_VER}); refusing same-version re-update." >&2
    exit 1
  fi

  if command -v zfs >/dev/null 2>&1; then
    if zfs list -H -o name -t snapshot "$PRE_SNAP" >/dev/null 2>&1; then
      echo "[+] Snapshot ${PRE_SNAP} already exists, reusing."
    else
      echo "[+] Creating pre-update snapshot: ${PRE_SNAP}..."
      zfs snapshot "$PRE_SNAP"
    fi

    if zfs list -H -o name "$TARGET_BE_DS" >/dev/null 2>&1; then
      echo "[!] Target Boot Environment ${TARGET_BE_DS} already exists. Recreating clone..."
      zfs destroy -r "$TARGET_BE_DS" 2>/dev/null || true
    fi

    echo "[+] Cloning ${PRE_SNAP} -> ${TARGET_BE_DS}..."
    zfs clone -o canmount=noauto -o mountpoint=/ "$PRE_SNAP" "$TARGET_BE_DS"

    ZBM_STAGE_MNT="/tmp/axonwall-zbm-stage-${CLEAN_VER}"
    rm -rf "${ZBM_STAGE_MNT}"
    mkdir -p "${ZBM_STAGE_MNT}"
    mount -t zfs "$TARGET_BE_DS" "${ZBM_STAGE_MNT}"

    if [ -n "$DEB_TMP" ] && [ -f "$DEB_TMP" ]; then
      echo "[+] Extracting firmware payload into ${TARGET_BE_DS}..."
      PKG_STAGE="/tmp/axonwall-stage-${CLEAN_VER}"
      rm -rf "${PKG_STAGE}"
      mkdir -p "${PKG_STAGE}"
      if ! extract_deb "${DEB_TMP}" "${PKG_STAGE}"; then
        echo "[-] ERROR: Failed to extract firmware archive ${DEB_TMP}." >&2
        rm -rf "${PKG_STAGE}"
        umount -l "${ZBM_STAGE_MNT}" 2>/dev/null || true
        rmdir "${ZBM_STAGE_MNT}" 2>/dev/null || true
        exit 1
      fi
      if ! apply_staged_tree "${PKG_STAGE}" "${ZBM_STAGE_MNT}"; then
        echo "[-] ERROR: Failed to apply firmware payload into ${TARGET_BE_DS} (staged copy failed); the Boot Environment is NOT armed." >&2
        rm -rf "${PKG_STAGE}"
        umount -l "${ZBM_STAGE_MNT}" 2>/dev/null || true
        rmdir "${ZBM_STAGE_MNT}" 2>/dev/null || true
        exit 1
      fi
      rm -rf "${PKG_STAGE}"
      if [ -d "${ZBM_STAGE_MNT}/etc/axonwall" ] && [ -d /var/lib/axonwall/etc-axonwall ]; then
        sync_static_etc_axonwall "${ZBM_STAGE_MNT}/etc/axonwall" /var/lib/axonwall/etc-axonwall
      fi
      ensure_cli_symlinks "${ZBM_STAGE_MNT}"
      if [ -d "${ZBM_STAGE_MNT}/usr/local/bin" ]; then
        for bin_f in "${ZBM_STAGE_MNT}/usr/local/bin/"*; do
          if [ -e "$bin_f" ] || [ -L "$bin_f" ]; then
            bname="$(basename "$bin_f")"
            if [ ! -e "/usr/local/bin/${bname}" ] || [ "$bname" = "axonwall-update" ]; then
              cp -af "$bin_f" /usr/local/bin/ 2>/dev/null || true
              if [ -f "/usr/local/bin/${bname}" ] && [ ! -L "/usr/local/bin/${bname}" ]; then
                chmod 755 "/usr/local/bin/${bname}" 2>/dev/null || true
              fi
            fi
          fi
        done
      fi
      ensure_cli_symlinks "/"
    elif [ -d /opt/axonwall ]; then
      mkdir -p "${ZBM_STAGE_MNT}/opt/axonwall" 2>/dev/null || true
      if command -v rsync >/dev/null 2>&1; then
        rsync -a --delete /opt/axonwall/ "${ZBM_STAGE_MNT}/opt/axonwall/" 2>/dev/null || true
      else
        cp -a /opt/axonwall/. "${ZBM_STAGE_MNT}/opt/axonwall/" 2>/dev/null || true
      fi
    fi

    mkdir -p "${ZBM_STAGE_MNT}/etc/axonwall" "${ZBM_STAGE_MNT}/var/lib/axonwall"
    echo "$CLEAN_VER" > "${ZBM_STAGE_MNT}/etc/axonwall/version"
    echo "zbm" > "${ZBM_STAGE_MNT}/etc/axonwall/install-mode"
    echo "zbm" > "${ZBM_STAGE_MNT}/var/lib/axonwall/install-mode"

    SV_TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")"
    # E10: slotB is a version field, never a BE dataset name. Derive
    # the running BE's version from its name (axonwall-<version>);
    # fall back to the running version when the name carries no
    # usable version (e.g. the "current" fallback above).
    CURRENT_BE_VER="${CURRENT_BE#axonwall-}"
    if [ "$CURRENT_BE_VER" = "$CURRENT_BE" ] || [ -z "$CURRENT_BE_VER" ] || [ "$CURRENT_BE_VER" = "current" ]; then
      CURRENT_BE_VER="$RUNNING_VER"
    fi
    SV_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s",\n  "updatedAt": "%s"\n}\n' "$CLEAN_VER" "$CURRENT_BE_VER" "$SV_TIMESTAMP")"
    printf '%s' "$SV_JSON" > "${ZBM_STAGE_MNT}/etc/axonwall/slot_versions.json" 2>/dev/null || true
    printf '%s' "$SV_JSON" > "${ZBM_STAGE_MNT}/var/lib/axonwall/slot_versions.json" 2>/dev/null || true

    if [ -d "${ZBM_STAGE_MNT}/boot" ]; then
      LATEST_KERN="$(ls -1t "${ZBM_STAGE_MNT}/boot/vmlinuz-"* 2>/dev/null | head -n1 || true)"
      if [ -n "$LATEST_KERN" ]; then
        ln -sf "$(basename "$LATEST_KERN")" "${ZBM_STAGE_MNT}/boot/vmlinuz" 2>/dev/null || true
        ln -sf "boot/$(basename "$LATEST_KERN")" "${ZBM_STAGE_MNT}/vmlinuz" 2>/dev/null || true
      fi
      LATEST_INITRD="$(ls -1t "${ZBM_STAGE_MNT}/boot/initrd.img-"* 2>/dev/null | head -n1 || true)"
      if [ -n "$LATEST_INITRD" ]; then
        ln -sf "$(basename "$LATEST_INITRD")" "${ZBM_STAGE_MNT}/boot/initrd.img" 2>/dev/null || true
        ln -sf "boot/$(basename "$LATEST_INITRD")" "${ZBM_STAGE_MNT}/initrd.img" 2>/dev/null || true
      fi
    fi

    umount -l "${ZBM_STAGE_MNT}" 2>/dev/null || true
    rmdir "${ZBM_STAGE_MNT}" 2>/dev/null || true

    echo "[+] Arming ZFSBootMenu bootfs and autonomous watchdog..."
    # E2: every arming step is checked. On any failure, restore the
    # previous bootfs, print an error, and exit non-zero — never claim
    # the Boot Environment is armed.
    PREV_BOOTFS="$(zpool get -H -o value bootfs "${POOL_NAME}" 2>/dev/null || true)"
    ZBM_ARM_OK=1
    zpool set bootfs="${TARGET_BE_DS}" "${POOL_NAME}" 2>/dev/null || ZBM_ARM_OK=0
    zfs set org.axonwall:fallback_be="${CURRENT_BE_DS}" "${PARENT_DS}" 2>/dev/null || ZBM_ARM_OK=0
    zfs set org.axonwall:active_be="${TARGET_BE_DS}" "${PARENT_DS}" 2>/dev/null || ZBM_ARM_OK=0
    zfs set org.axonwall:bootcount=0 "${PARENT_DS}" 2>/dev/null || ZBM_ARM_OK=0
    zfs set org.axonwall:bootlimit=3 "${PARENT_DS}" 2>/dev/null || ZBM_ARM_OK=0
    if [ "$ZBM_ARM_OK" != "1" ]; then
      echo "[-] ERROR: Failed to arm Boot Environment ${TARGET_BE} (one or more zpool/zfs arming steps failed); the Boot Environment is NOT armed." >&2
      if [ -n "$PREV_BOOTFS" ]; then
        zpool set bootfs="${PREV_BOOTFS}" "${POOL_NAME}" 2>/dev/null || true
      fi
      exit 1
    fi

    printf '%s' "$SV_JSON" > /etc/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$SV_JSON" > /var/lib/axonwall/slot_versions.json 2>/dev/null || true

    echo "[✓] Boot Environment ${TARGET_BE} successfully staged and armed. Reboot to activate."
  else
    # E2 family: ZBM mode with no zfs tools stages nothing; failing closed
    # here keeps the script from printing success at the end for no work.
    echo "[-] ERROR: ZFSBootMenu mode requested but the zfs tools are not available; no Boot Environment was staged or armed." >&2
    exit 1
  fi
elif [ -n "$TARGET_DEV" ] && [ -e "$TARGET_DEV" ]; then
  # E5 (confirmed): refuse to stage onto the running root. Running
  # on slot B and updating --slot B used to mount the live root a
  # second time and rsync --delete onto the live system. Compare
  # canonical device paths, since the target resolves through
  # /dev/disk/by-label/* while findmnt reports the plain node.
  # (The UI always passes the standby slot, so this trigger is
  # CLI-only; the guard still applies to every caller.) This check
  # sits here, at the only place TARGET_DEV is mounted, so the ZBM
  # path -- which never mounts TARGET_DEV -- is unaffected.
  _running_root="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  if [ -n "$_running_root" ] && [ -b "$_running_root" ]; then
    _target_canon="$(readlink -f "$TARGET_DEV" 2>/dev/null || echo "$TARGET_DEV")"
    _running_canon="$(readlink -f "$_running_root" 2>/dev/null || echo "$_running_root")"
    if [ "$_target_canon" = "$_running_canon" ]; then
      echo "[-] ERROR: target device ${TARGET_DEV} is the running root device (${_running_root}); refusing to update the live system in place. Pass the standby slot." >&2
      exit 1
    fi
  fi
  echo "[+] Detected Dual-Root target partition: ${TARGET_DEV} (${TARGET_LABEL})"
  echo "[+] Mounting standby partition to staging directory..."
  STAGE_DIR="/tmp/axonwall-update-slot-${TARGET_SLOT}"
  mkdir -p "${STAGE_DIR}"
  # E1: staging-success flag. Only the mount-ok block below may set it;
  # the grubenv arming after that block is gated on it.
  STAGING_OK=0
  STAGING_RSYNCS_FAILED=0
  mount "${TARGET_DEV}" "${STAGE_DIR}" 2>/dev/null || true

  # If mounting succeeds, synchronize root filesystem or extract downloaded release package
  if grep -qs " ${STAGE_DIR} " /proc/mounts || (command -v mountpoint >/dev/null 2>&1 && mountpoint -q "${STAGE_DIR}"); then
    # Self-heal base OS rootfs on standby slot if missing /sbin, /bin, /etc, or /lib/modules
    if [ ! -e "${STAGE_DIR}/sbin/init" ] || [ ! -d "${STAGE_DIR}/etc" ] || [ ! -d "${STAGE_DIR}/lib/modules" ]; then
      echo "[+] Standby partition is missing base OS rootfs; cloning running root filesystem to Slot ${TARGET_SLOT}..."
      if command -v rsync >/dev/null 2>&1; then
        rsync -aAX \
          --exclude=/proc/* \
          --exclude=/sys/* \
          --exclude=/dev/* \
          --exclude=/run/* \
          --exclude=/tmp/* \
          --exclude=/mnt/* \
          --exclude=/media/* \
          --exclude=/lost+found \
          --exclude=/var/lib/axonwall/* \
          --exclude=/home/* \
          --exclude=/boot/efi/* \
          / "${STAGE_DIR}/" 2>/dev/null || STAGING_RSYNCS_FAILED=1
      else
        for sys_dir in bin etc home lib lib64 opt root sbin usr var; do
          if [ -d "/${sys_dir}" ]; then
            cp -a "/${sys_dir}" "${STAGE_DIR}/" 2>/dev/null || true
          fi
        done
      fi
      mkdir -p "${STAGE_DIR}/dev" "${STAGE_DIR}/proc" "${STAGE_DIR}/sys" "${STAGE_DIR}/run" "${STAGE_DIR}/tmp" "${STAGE_DIR}/boot" "${STAGE_DIR}/home" "${STAGE_DIR}/var/lib/axonwall" 2>/dev/null || true
    fi

    # Ensure /etc/fstab on target slot points to the correct root label, has no /mnt/standby mount, and bind-mounts /var/lib/axonwall/home -> /home
    if [ -f "${STAGE_DIR}/etc/fstab" ]; then
      sed -i -E 's|^[^#[:space:]]+([[:space:]]+/[[:space:]]+)|LABEL='"${TARGET_LABEL}"'\1|' "${STAGE_DIR}/etc/fstab" 2>/dev/null || true
      sed -i '\#/mnt/standby#d' "${STAGE_DIR}/etc/fstab" 2>/dev/null || true
      if ! grep -q '/var/lib/axonwall/home' "${STAGE_DIR}/etc/fstab"; then
        echo "/var/lib/axonwall/home  /home  none  bind  0  0" >> "${STAGE_DIR}/etc/fstab"
      fi
    fi

    # Self-heal /boot on target slot if kernel or initramfs/initrd is missing
    mkdir -p "${STAGE_DIR}/boot" 2>/dev/null || true
    if ! ls "${STAGE_DIR}/boot"/vmlinuz-* >/dev/null 2>&1; then
      echo "[+] Synchronizing kernel and boot artifacts from running /boot to Slot ${TARGET_SLOT}..."
      if [ -d /boot ] && ls /boot/vmlinuz-* >/dev/null 2>&1; then
        for bf in /boot/vmlinuz* /boot/initrd* /boot/initramfs* /boot/System.map* /boot/config*; do
          if [ -e "$bf" ]; then
            cp -a "$bf" "${STAGE_DIR}/boot/" 2>/dev/null || true
          fi
        done
        if [ -d /boot/grub ] && [ ! -d "${STAGE_DIR}/boot/grub" ]; then
          cp -a /boot/grub "${STAGE_DIR}/boot/" 2>/dev/null || true
        fi
      fi
    fi

    echo "[+] Updating application packages on standby partition..."
    if [ -n "$DEB_TMP" ] && [ -f "$DEB_TMP" ]; then
      PKG_STAGE="/tmp/axonwall-stage-${CLEAN_VER}"
      rm -rf "${PKG_STAGE}"
      mkdir -p "${PKG_STAGE}"
      if extract_deb "${DEB_TMP}" "${PKG_STAGE}"; then
        # E2-2: a failed overlay must fail the update, not stage a
        # partial tree that the E1 gate then arms as the new version.
        # Unmount before exiting so no standby mount is left behind.
        if ! apply_staged_tree "${PKG_STAGE}" "${STAGE_DIR}"; then
          echo "[-] ERROR: Failed to apply firmware payload onto Slot ${TARGET_SLOT} (staged copy failed); refusing to arm it." >&2
          rm -rf "${PKG_STAGE}"
          umount "${STAGE_DIR}" 2>/dev/null || true
          rmdir "${STAGE_DIR}" 2>/dev/null || true
          exit 1
        fi
        if [ -f "${STAGE_DIR}/usr/local/bin/axonwall-update" ]; then
          if sh -n "${STAGE_DIR}/usr/local/bin/axonwall-update" 2>/dev/null; then
            cp -f "${STAGE_DIR}/usr/local/bin/axonwall-update" /usr/local/bin/axonwall-update 2>/dev/null || true
            chmod 755 /usr/local/bin/axonwall-update 2>/dev/null || true
          else
            cp -f /usr/local/bin/axonwall-update "${STAGE_DIR}/usr/local/bin/axonwall-update" 2>/dev/null || true
          fi
        fi
        if [ -d "${PKG_STAGE}/usr/local/bin" ]; then
          for bin_f in "${PKG_STAGE}/usr/local/bin/"*; do
            if [ -e "$bin_f" ] || [ -L "$bin_f" ]; then
              bname="$(basename "$bin_f")"
              if [ ! -e "/usr/local/bin/${bname}" ]; then
                cp -af "$bin_f" /usr/local/bin/ 2>/dev/null || true
                if [ -f "/usr/local/bin/${bname}" ] && [ ! -L "/usr/local/bin/${bname}" ]; then
                  chmod 755 "/usr/local/bin/${bname}" 2>/dev/null || true
                fi
              fi
            fi
          done
        fi
        ensure_cli_symlinks "/"
      fi
      rm -rf "${PKG_STAGE}"
    elif [ -d /opt/axonwall ]; then
      mkdir -p "${STAGE_DIR}/opt/axonwall" 2>/dev/null || true
      if command -v rsync >/dev/null 2>&1; then
        rsync -a --delete /opt/axonwall/ "${STAGE_DIR}/opt/axonwall/" 2>/dev/null || STAGING_RSYNCS_FAILED=1
      else
        cp -a /opt/axonwall/. "${STAGE_DIR}/opt/axonwall/" 2>/dev/null || true
      fi
    fi

    if [ -n "$CLEAN_VER" ]; then
      mkdir -p "${STAGE_DIR}/etc/axonwall" 2>/dev/null || true
      echo "$CLEAN_VER" > "${STAGE_DIR}/etc/axonwall/version" 2>/dev/null || true

      # Accurately compute and persist per-slot versions
      EXISTING_SV_A=""
      EXISTING_SV_B=""
      if [ -f /var/lib/axonwall/slot_versions.json ]; then
        EXISTING_SV_A="$(grep -oE '"slotA"[[:space:]]*:[[:space:]]*"[^"]+"' /var/lib/axonwall/slot_versions.json 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' || true)"
        EXISTING_SV_B="$(grep -oE '"slotB"[[:space:]]*:[[:space:]]*"[^"]+"' /var/lib/axonwall/slot_versions.json 2>/dev/null | sed -E 's/.*"([^"]+)"$/\1/' || true)"
      fi

      if [ "$TARGET_SLOT" = "A" ]; then
        SV_A="$CLEAN_VER"
        if [ "$RUNNING_ACTIVE_SLOT" = "B" ]; then
          SV_B="$RUNNING_VER"
        else
          SV_B="${EXISTING_SV_B:-$RUNNING_VER}"
        fi
      else
        SV_B="$CLEAN_VER"
        if [ "$RUNNING_ACTIVE_SLOT" = "A" ]; then
          SV_A="$RUNNING_VER"
        else
          SV_A="${EXISTING_SV_A:-$RUNNING_VER}"
        fi
      fi

      SV_TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")"
      SV_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "%s",\n  "updatedAt": "%s"\n}\n' "$SV_A" "$SV_B" "$SV_TIMESTAMP")"

      # Write to target rootfs
      printf '%s' "$SV_JSON" > "${STAGE_DIR}/etc/axonwall/slot_versions.json" 2>/dev/null || true

      # Write to running rootfs and shared data partition
      mkdir -p /etc/axonwall /var/lib/axonwall 2>/dev/null || true
      printf '%s' "$SV_JSON" > /etc/axonwall/slot_versions.json 2>/dev/null || true
      printf '%s' "$SV_JSON" > /var/lib/axonwall/slot_versions.json 2>/dev/null || true
    fi

    # Ensure stable kernel & initrd/initramfs symlinks exist on target slot (Debian & Alpine)
    if [ -d "${STAGE_DIR}/boot" ]; then
      LATEST_SLOT_KERN="$(ls -1t "${STAGE_DIR}/boot"/vmlinuz-* 2>/dev/null | head -n1 || true)"
      if [ -n "$LATEST_SLOT_KERN" ]; then
        ln -sf "$(basename "$LATEST_SLOT_KERN")" "${STAGE_DIR}/boot/vmlinuz"
        ln -sf "boot/$(basename "$LATEST_SLOT_KERN")" "${STAGE_DIR}/vmlinuz" 2>/dev/null || true
      fi
      LATEST_SLOT_INITRD="$(ls -1t "${STAGE_DIR}/boot"/initrd.img-* "${STAGE_DIR}/boot"/initramfs-* 2>/dev/null | head -n1 || true)"
      if [ -n "$LATEST_SLOT_INITRD" ]; then
        ln -sf "$(basename "$LATEST_SLOT_INITRD")" "${STAGE_DIR}/boot/initrd.img"
        ln -sf "boot/$(basename "$LATEST_SLOT_INITRD")" "${STAGE_DIR}/initrd.img" 2>/dev/null || true
      fi
    fi

    # Also update grubenv on the target partition if /boot/grub exists there
    if [ -d "${STAGE_DIR}/boot/grub" ]; then
      update_grubenv_file "${STAGE_DIR}/boot/grub/grubenv" "${TARGET_SLOT}"
    fi

    # E1 staging-success gate: only a staged slot with a real rootfs
    # (etc + init), a kernel, and no failed staging rsync may ever be
    # armed. A stale or partial tree fails here, not at next boot.
    if [ "$STAGING_RSYNCS_FAILED" != "1" ] && [ -d "${STAGE_DIR}/etc" ] && [ -e "${STAGE_DIR}/sbin/init" ] && ls "${STAGE_DIR}/boot"/vmlinuz-* >/dev/null 2>&1; then
      STAGING_OK=1
    else
      echo "[-] ERROR: Staged Slot ${TARGET_SLOT} is not a complete bootable rootfs (missing etc, sbin/init, or kernel, or a staging copy failed); refusing to arm it." >&2
    fi

    umount "${STAGE_DIR}" 2>/dev/null || true
    rmdir "${STAGE_DIR}" 2>/dev/null || true
  fi

  # E1: never arm a slot whose staging did not complete. The mount-ok
  # block above is the only place staging happens; anything else means
  # the standby slot was never updated.
  if [ "$STAGING_OK" != "1" ]; then
    echo "[-] ERROR: Standby Slot ${TARGET_SLOT} staging did not complete (mount failure or incomplete staged tree); refusing to arm it. The previous boot target is unchanged." >&2
    umount "${STAGE_DIR}" 2>/dev/null || true
    rmdir "${STAGE_DIR}" 2>/dev/null || true
    exit 1
  fi

  # Also ensure running rootfs has valid /boot/vmlinuz and /boot/initrd.img symlinks
  if [ -d /boot ]; then
    RUN_KERN="$(ls -1t /boot/vmlinuz-* 2>/dev/null | head -n1 || true)"
    if [ -n "$RUN_KERN" ] && [ ! -e /boot/vmlinuz ]; then
      ln -sf "$(basename "$RUN_KERN")" /boot/vmlinuz 2>/dev/null || true
    fi
    RUN_INITRD="$(ls -1t /boot/initrd.img-* /boot/initramfs-* 2>/dev/null | head -n1 || true)"
    if [ -n "$RUN_INITRD" ] && [ ! -e /boot/initrd.img ]; then
      ln -sf "$(basename "$RUN_INITRD")" /boot/initrd.img 2>/dev/null || true
    fi
  fi

  # Only update /etc/axonwall/version on the running rootfs if the target slot is the currently active slot
  ACTIVE_SLOT="A"
  if grep -qs -E 'axon_root_b|slot=B' /proc/cmdline 2>/dev/null; then
    ACTIVE_SLOT="B"
  fi
  if [ "$TARGET_SLOT" = "$ACTIVE_SLOT" ] && [ -n "$CLEAN_VER" ] && [ -d /etc/axonwall ]; then
    echo "$CLEAN_VER" > /etc/axonwall/version 2>/dev/null || true
  fi

  # Arm GRUB boot watchdog for next boot on current /boot/grub/grubenv (and Slot A's grubenv if running on Slot B)
  echo "[+] Arming GRUB boot watchdog on /boot/grub/grubenv..."
  # E1: check the arming call's result — a failed grubenv write must fail
  # the update, not print success for an unarmed slot.
  if ! update_grubenv_file "/boot/grub/grubenv" "${TARGET_SLOT}"; then
    echo "[-] ERROR: Failed to arm GRUB boot watchdog for Slot ${TARGET_SLOT} (grubenv write failed); the previous boot target is unchanged." >&2
    exit 1
  fi
  if [ "$ACTIVE_SLOT" = "B" ]; then
    SLOT_A_DEV="$(resolve_label_dev "axon_root_a")"
    if [ -n "$SLOT_A_DEV" ] && [ -b "$SLOT_A_DEV" ]; then
      SLOT_A_MNT="/tmp/axonwall-grubenv-slot-a"
      mkdir -p "$SLOT_A_MNT" 2>/dev/null || true
      if mount "$SLOT_A_DEV" "$SLOT_A_MNT" 2>/dev/null; then
        if [ -d "$SLOT_A_MNT/boot/grub" ]; then
          update_grubenv_file "$SLOT_A_MNT/boot/grub/grubenv" "${TARGET_SLOT}" || echo "[!] WARNING: Failed to update the Slot A grubenv copy; the primary grubenv was armed." >&2
        fi
        umount "$SLOT_A_MNT" 2>/dev/null || true
      fi
      rmdir "$SLOT_A_MNT" 2>/dev/null || true
    fi
  fi
elif [ "$ROLLING_MODE" != "1" ] && ( [ -e "/dev/disk/by-label/axon_root_a" ] || [ -e "/dev/disk/by-label/axon_root_b" ] || grep -qs -E 'slot=[AB]' /proc/cmdline ); then
  echo "[-] ERROR: Appliance is configured for Dual-Root A/B, but target block device for Slot ${TARGET_SLOT} could not be resolved." >&2
  exit 1
else
  echo "[+] Running in Rolling Standard Linux (Single-Root /) mode. Performing in-place update..."
  mkdir -p /etc/axonwall /var/lib/axonwall 2>/dev/null || true

  if [ "$APT_UPGRADE" = "1" ] || [ "${AXONWALL_APT_UPGRADE:-0}" = "1" ]; then
    if command -v apt-get >/dev/null 2>&1; then
      echo "[+] Updating Debian APT repositories and upgrading system packages..."
      DEBIAN_FRONTEND=noninteractive apt-get update -y || true
      DEBIAN_FRONTEND=noninteractive apt-get -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" upgrade -y || true
    fi
  fi

  if [ -n "$CLEAN_VER" ]; then
    echo "$CLEAN_VER" > /etc/axonwall/version 2>/dev/null || true
    SV_TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")"
    SV_JSON="$(printf '{\n  "slotA": "%s",\n  "slotB": "Rolling",\n  "updatedAt": "%s"\n}\n' "$CLEAN_VER" "$SV_TIMESTAMP")"
    printf '%s' "$SV_JSON" > /etc/axonwall/slot_versions.json 2>/dev/null || true
    printf '%s' "$SV_JSON" > /var/lib/axonwall/slot_versions.json 2>/dev/null || true
  fi

  if [ -n "$DEB_TMP" ] && [ -f "$DEB_TMP" ]; then
    PKG_STAGE="/tmp/axonwall-stage-${CLEAN_VER}"
    rm -rf "${PKG_STAGE}"
    mkdir -p "${PKG_STAGE}"
    if extract_deb "${DEB_TMP}" "${PKG_STAGE}"; then
      # E2-2: a failed in-place overlay must fail the update, not
      # print success for a half-updated live root.
      if ! apply_staged_tree "${PKG_STAGE}" "/"; then
        echo "[-] ERROR: Failed to apply firmware payload in place (staged copy failed); the update did NOT complete." >&2
        rm -rf "${PKG_STAGE}"
        exit 1
      fi
    fi
    rm -rf "${PKG_STAGE}"

    # Schedule asynchronous service restart after HTTP response finishes so we do not kill axonwall-ui mid-request
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload 2>/dev/null || true
      echo "[+] Scheduling asynchronous reload of Axonwall services..."
      nohup sh -c 'sleep 3 && systemctl try-restart axonwalld.service axonwall-controller.service axonwall-ui.service' >/dev/null 2>&1 &
    fi
  fi
fi

rm -f "${DEB_TMP:-}" "${DEB_TMP:-}.sha256" "${DEB_TMP:-}.sha256.sig" 2>/dev/null || true
echo "[+] Firmware update process completed successfully."
