#!/usr/bin/env bash
# ==============================================================================
# Axonwall ZFSBootMenu Visual Theme & Styling Management Utility
# ==============================================================================
set -euo pipefail

COLOR_RESET="\033[0m"
COLOR_BOLD="\033[1m"
COLOR_EMERALD="\033[38;2;52;211;153m"
COLOR_CYAN="\033[38;2;6;182;212m"
COLOR_SLATE="\033[38;2;148;163;184m"
COLOR_RED="\033[38;2;244;63;94m"

ZBM_CONFIG="/etc/zfsbootmenu/config.yaml"
ZBM_SPLASH="/etc/zfsbootmenu/splash.bmp"
ZBM_HOOK_DIR="/etc/zfsbootmenu/hooks"
ZBM_THEME_HOOK="${ZBM_HOOK_DIR}/early-setup.d/15-axonwall-theme.sh"
ESP_MOUNT="/boot/efi"
ESP_ZBM_DIR="${ESP_MOUNT}/EFI/ZBM"
ESP_ZBM_HOOKS="${ESP_ZBM_DIR}/hooks"
ESP_UKI="${ESP_ZBM_DIR}/VMLINUZ.EFI"
ESP_SYSLINUX="${ESP_ZBM_DIR}/syslinux.cfg"

show_banner() {
  printf "${COLOR_EMERALD}${COLOR_BOLD}Axonwall ZFSBootMenu Theme Manager${COLOR_RESET}\n"
  printf "${COLOR_SLATE}Root-on-ZFS Bootloader Visual Styling, Fonts & Palettes${COLOR_RESET}\n\n"
}

usage() {
  show_banner
  cat << EOF
Usage: axonwall-zbm-theme [COMMAND] [OPTIONS]

Commands:
  status                Show current boot splash, console font, and color theme
  set-font <font>       Set console font (e.g. ter-132b, ter-v32b, ter-v28b, ter-v24b, default)
  set-splash <file>     Install custom boot splash image (.bmp or .png)
  set-palette <scheme>  Switch 16-color ANSI console palette
                        Available: axonwall (default), cyber-cyan, dracula, nord, monokai
  apply                 Re-theme and sync ZFSBootMenu UKI and EFI hooks

Options:
  -h, --help            Show this help text
EOF
}

cmd_status() {
  show_banner
  printf " ${COLOR_BOLD}Configuration Files:${COLOR_RESET}\n"
  printf "   ZBM Config    : %s %s\n" "$ZBM_CONFIG" "$([ -f "$ZBM_CONFIG" ] && printf '[OK]' || printf '[MISSING]')"
  printf "   Splash Image  : %s %s\n" "$ZBM_SPLASH" "$([ -f "$ZBM_SPLASH" ] && printf '[OK]' || printf '[MISSING]')"
  printf "   Theme Hook    : %s %s\n" "$ZBM_THEME_HOOK" "$([ -f "$ZBM_THEME_HOOK" ] && printf '[OK]' || printf '[MISSING]')"
  printf "   Installed UKI : %s %s\n" "$ESP_UKI" "$([ -f "$ESP_UKI" ] && printf '[OK]' || printf '[MISSING]')"
  echo ""

  if [ -f "$ESP_UKI" ] && command -v objcopy >/dev/null 2>&1; then
    printf " ${COLOR_BOLD}Installed UKI (.EFI) Inspection:${COLOR_RESET}\n"
    if objdump -h "$ESP_UKI" 2>/dev/null | grep -q '\.splash'; then
      printf "   Splash Section: ${COLOR_EMERALD}Embedded (.splash section present)${COLOR_RESET}\n"
    else
      printf "   Splash Section: ${COLOR_SLATE}None (fallback text only)${COLOR_RESET}\n"
    fi

    KCL_TMP=$(mktemp)
    if objcopy --dump-section .cmdline="$KCL_TMP" "$ESP_UKI" 2>/dev/null; then
      KCL_STR=$(tr -d '\0' < "$KCL_TMP" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      printf "   Kernel Cmdline: %s\n" "$KCL_STR"
      CUR_FONT=$(echo "$KCL_STR" | grep -o 'rd\.vconsole\.font=[^ ]*' | cut -d= -f2 || true)
      printf "   Active Font   : ${COLOR_CYAN}%s${COLOR_RESET}\n" "${CUR_FONT:-default (autosize)}"
    fi
    rm -f "$KCL_TMP"
  fi
  echo ""
}

cmd_set_font() {
  local font="${1:-}"
  if [ -z "$font" ]; then
    printf "${COLOR_RED}Error: Font face name required (e.g. ter-132b, ter-v32b, ter-v28b, ter-v24b, default)${COLOR_RESET}\n"
    exit 1
  fi

  show_banner
  printf "[+] Updating target console font to: %s\n" "$font"

  # Update /etc/zfsbootmenu/config.yaml
  if [ -f "$ZBM_CONFIG" ]; then
    if [ "$font" = "default" ]; then
      sed -i -E 's/rd\.vconsole\.font=[^ "]+//g' "$ZBM_CONFIG"
    else
      if grep -q "rd\.vconsole\.font=" "$ZBM_CONFIG"; then
        sed -i -E "s/rd\.vconsole\.font=[^ \"']+/rd.vconsole.font=${font}/g" "$ZBM_CONFIG"
      else
        sed -i -E "s/(CommandLine:[[:space:]]*\"[^\"]*)/\1 rd.vconsole.font=${font}/" "$ZBM_CONFIG"
      fi
    fi
  fi

  # Update syslinux.cfg if present
  if [ -f "$ESP_SYSLINUX" ]; then
    if [ "$font" = "default" ]; then
      sed -i -E 's/rd\.vconsole\.font=[^ "]+//g' "$ESP_SYSLINUX"
    else
      if grep -q "rd\.vconsole\.font=" "$ESP_SYSLINUX"; then
        sed -i -E "s/rd\.vconsole\.font=[^ \"']+/rd.vconsole.font=${font}/g" "$ESP_SYSLINUX"
      else
        sed -i -E "s/(APPEND[[:space:]]+[^\r\n]*)/\1 rd.vconsole.font=${font}/" "$ESP_SYSLINUX"
      fi
    fi
  fi

  # Patch UKI directly if present
  if [ -f "$ESP_UKI" ] && [ -x /usr/lib/axonwall/theme-zbm-uki.py ]; then
    printf "[+] Re-patching installed UKI with target font...\n"
    python3 /usr/lib/axonwall/theme-zbm-uki.py "$ESP_UKI" -o "$ESP_UKI" -s "$ZBM_SPLASH" -f "$font"
  fi

  printf "${COLOR_EMERALD}[✓] Console font updated successfully.${COLOR_RESET}\n"
}

cmd_set_splash() {
  local src="${1:-}"
  if [ -z "$src" ] || [ ! -f "$src" ]; then
    printf "${COLOR_RED}Error: Splash image file not found: %s${COLOR_RESET}\n" "$src"
    exit 1
  fi

  show_banner
  printf "[+] Processing splash image: %s\n" "$src"

  mkdir -p /etc/zfsbootmenu "$ESP_ZBM_DIR"
  case "$src" in
    *.bmp)
      cp -f "$src" "$ZBM_SPLASH"
      ;;
    *.png|*.jpg|*.jpeg)
      if command -v convert >/dev/null 2>&1; then
        convert "$src" -type truecolor -compress none "$ZBM_SPLASH"
      elif command -v magick >/dev/null 2>&1; then
        magick "$src" -type truecolor -compress none "$ZBM_SPLASH"
      else
        printf "${COLOR_RED}Error: ImageMagick (convert/magick) required to convert %s to .bmp${COLOR_RESET}\n" "$src"
        exit 1
      fi
      ;;
    *)
      printf "${COLOR_RED}Error: Unsupported image format. Use .bmp or .png${COLOR_RESET}\n"
      exit 1
      ;;
  esac

  cp -f "$ZBM_SPLASH" "${ESP_ZBM_DIR}/splash.bmp" 2>/dev/null || true

  # Re-embed into UKI if python tool exists
  if [ -f "$ESP_UKI" ] && [ -x /usr/lib/axonwall/theme-zbm-uki.py ]; then
    printf "[+] Embedding new splash bitmap into UEFI UKI (.splash section)...\n"
    python3 /usr/lib/axonwall/theme-zbm-uki.py "$ESP_UKI" -o "$ESP_UKI" -s "$ZBM_SPLASH"
  fi

  printf "${COLOR_EMERALD}[✓] Splash screen updated successfully.${COLOR_RESET}\n"
}

cmd_set_palette() {
  local scheme="${1:-axonwall}"
  show_banner

  # 16-color ANSI hex sequences: 0=bg, 1=red, 2=green, 3=yellow, 4=blue, 5=magenta, 6=cyan, 7=fg
  # 8=brblack, 9=brred, A=brgreen, B=bryellow, C=brblue, D=brmagenta, E=brcyan, F=brwhite
  local seq=""
  local fzf_opts=""

  case "$scheme" in
    axonwall|default)
      printf "[+] Applying Axonwall Cyber-Slate & Emerald palette...\n"
      seq="P0090e1a\033]P1f43f5e\033]P210b981\033]P3f59e0b\033]P40284c7\033]P58b5cf6\033]P606b6d4\033]P7cbd5e1\033]P81e293b\033]P9fb7185\033]PA34d399\033]PBfbbf24\033]PC38bdf8\033]PDa78bfa\033]PE22d3ee\033]PFf8fafc"
      fzf_opts="--color=bg+:#111c2e,bg:#090e1a,spinner:#34d399,hl:#34d399,fg:#cbd5e1,header:#06b6d4,info:#38bdf8,pointer:#34d399,marker:#34d399,fg+:#f8fafc,prompt:#34d399,hl+:#22d3ee,border:#1e3a47"
      ;;
    cyber-cyan)
      printf "[+] Applying Cyber-Cyan palette...\n"
      seq="P003131e\033]P1f43f5e\033]P206b6d4\033]P3f59e0b\033]P40284c7\033]P58b5cf6\033]P638bdf8\033]P7e0f2fe\033]P80f293d\033]P9fb7185\033]PA22d3ee\033]PBfbbf24\033]PC7dd3fc\033]PDa78bfa\033]PEa5f3fc\033]PFf0f9ff"
      fzf_opts="--color=bg+:#0b263b,bg:#03131e,spinner:#22d3ee,hl:#22d3ee,fg:#e0f2fe,header:#38bdf8,info:#7dd3fc,pointer:#22d3ee,marker:#22d3ee,fg+:#f0f9ff,prompt:#38bdf8,hl+:#a5f3fc,border:#164e63"
      ;;
    nord)
      printf "[+] Applying Nord palette...\n"
      seq="P02e3440\033]P1bf616a\033]P2a3be8c\033]P3ebcb8b\033]P481a1c1\033]P5b48ead\033]P688c0d0\033]P7e5e9f0\033]P84c566a\033]P9d08770\033]PAa3be8c\033]PBebcb8b\033]PC81a1c1\033]PDb48ead\033]PE8fbcbb\033]PFeceff4"
      fzf_opts="--color=bg+:#3b4252,bg:#2e3440,spinner:#88c0d0,hl:#81a1c1,fg:#e5e9f0,header:#88c0d0,info:#81a1c1,pointer:#88c0d0,marker:#88c0d0,fg+:#eceff4,prompt:#81a1c1,hl+:#8fbcbb,border:#4c566a"
      ;;
    dracula)
      printf "[+] Applying Dracula palette...\n"
      seq="P0282a36\033]P1ff5555\033]P250fa7b\033]P3f1fa8c\033]P4bd93f9\033]P5ff79c6\033]P68be9fd\033]P7f8f8f2\033]P86272a4\033]P9ff6e6e\033]PA69ff94\033]PBffffa5\033]PCd6acff\033]PDff92df\033]PEa4ffff\033]PFffffff"
      fzf_opts="--color=bg+:#44475a,bg:#282a36,spinner:#50fa7b,hl:#50fa7b,fg:#f8f8f2,header:#bd93f9,info:#ff79c6,pointer:#50fa7b,marker:#50fa7b,fg+:#ffffff,prompt:#8be9fd,hl+:#a4ffff,border:#6272a4"
      ;;
    monokai)
      printf "[+] Applying Monokai palette...\n"
      seq="P0272822\033]P1f92672\033]P2a6e22e\033]P3f4bf75\033]P466d9ef\033]P5ae81ff\033]P6a1efe4\033]P7f8f8f2\033]P875715e\033]P9fd971f\033]PAa6e22e\033]PBe6db74\033]PC66d9ef\033]PDae81ff\033]PEa1efe4\033]PFf9f8f5"
      fzf_opts="--color=bg+:#3e3d32,bg:#272822,spinner:#a6e22e,hl:#a6e22e,fg:#f8f8f2,header:#66d9ef,info:#fd971f,pointer:#a6e22e,marker:#a6e22e,fg+:#f9f8f5,prompt:#a6e22e,hl+:#a1efe4,border:#75715e"
      ;;
    *)
      printf "${COLOR_RED}Error: Unknown color palette '%s'. Available: axonwall, cyber-cyan, nord, dracula, monokai${COLOR_RESET}\n" "$scheme"
      exit 1
      ;;
  esac

  mkdir -p "${ZBM_HOOK_DIR}/early-setup.d" "${ESP_ZBM_HOOKS}/early-setup.d"

  cat << HOOK_EOF > "$ZBM_THEME_HOOK"
#!/bin/bash
# Axonwall ZFSBootMenu Visual Theme Hook (${scheme})
TERM_DEV="\${control_term:-/dev/tty1}"
[ -c "\$TERM_DEV" ] || TERM_DEV="/dev/tty0"

if [ -c "\$TERM_DEV" ]; then
  printf '\033]${seq}' > "\$TERM_DEV" 2>/dev/null || true
  printf '\033[2J\033[H' > "\$TERM_DEV" 2>/dev/null || true
fi

FZF_AXONWALL_OPTS="${fzf_opts}"
export FZF_DEFAULT_OPTS="\${FZF_AXONWALL_OPTS}"

if [ -f /etc/zfsbootmenu.conf ] && ! grep -q "FZF_DEFAULT_OPTS" /etc/zfsbootmenu.conf 2>/dev/null; then
  printf '\nexport FZF_DEFAULT_OPTS="%s"\n' "\${FZF_AXONWALL_OPTS}" >> /etc/zfsbootmenu.conf 2>/dev/null || true
fi

if [ -x /usr/bin/setfont ]; then
  for font in \\
    /usr/share/zfsbootmenu/fonts/ter-v32b.psf \\
    /usr/share/zfsbootmenu/fonts/ter-v28b.psf \\
    /usr/share/zfsbootmenu/fonts/ter-v24b.psf \\
    /usr/share/kbd/consolefonts/Lat2-Terminus16.psfu.gz; do
    if [ -f "\$font" ]; then
      setfont "\$font" >/dev/null 2>&1 && break
    fi
  done
fi
exit 0
HOOK_EOF

  chmod +x "$ZBM_THEME_HOOK"
  cp -f "$ZBM_THEME_HOOK" "${ESP_ZBM_HOOKS}/early-setup.d/15-axonwall-theme.sh" 2>/dev/null || true
  chmod +x "${ESP_ZBM_HOOKS}/early-setup.d/15-axonwall-theme.sh" 2>/dev/null || true

  printf "${COLOR_EMERALD}[✓] Palette '%s' applied to local hooks and EFI partition.${COLOR_RESET}\n" "$scheme"
}

cmd_apply() {
  show_banner
  printf "[+] Synchronizing ZFSBootMenu assets and hooks to EFI partition...\n"

  mkdir -p "${ESP_ZBM_DIR}" "${ESP_ZBM_HOOKS}/early-setup.d" "${ESP_ZBM_HOOKS}/setup.d"
  [ -f "$ZBM_SPLASH" ] && cp -f "$ZBM_SPLASH" "${ESP_ZBM_DIR}/splash.bmp"
  [ -f "$ZBM_THEME_HOOK" ] && cp -f "$ZBM_THEME_HOOK" "${ESP_ZBM_HOOKS}/early-setup.d/15-axonwall-theme.sh"
  [ -f "${ZBM_HOOK_DIR}/setup.d/20-axonwall-watchdog.sh" ] && cp -f "${ZBM_HOOK_DIR}/setup.d/20-axonwall-watchdog.sh" "${ESP_ZBM_HOOKS}/setup.d/20-axonwall-watchdog.sh"

  chmod +x "${ESP_ZBM_HOOKS}"/*/*.sh 2>/dev/null || true

  if command -v generate-zbm >/dev/null 2>&1; then
    printf "[+] Running generate-zbm to rebuild UKI bundle...\n"
    generate-zbm
  elif [ -f "$ESP_UKI" ] && [ -x /usr/lib/axonwall/theme-zbm-uki.py ]; then
    printf "[+] Re-theming existing UKI using theme-zbm-uki...\n"
    python3 /usr/lib/axonwall/theme-zbm-uki.py "$ESP_UKI" -o "$ESP_UKI" -s "$ZBM_SPLASH"
  fi

  printf "${COLOR_EMERALD}[✓] All theme assets and hooks synced.${COLOR_RESET}\n"
}

case "${1:-status}" in
  status) cmd_status ;;
  set-font) shift; cmd_set_font "${1:-}" ;;
  set-splash) shift; cmd_set_splash "${1:-}" ;;
  set-palette) shift; cmd_set_palette "${1:-}" ;;
  apply) cmd_apply ;;
  -h|--help|help) usage ;;
  *)
    printf "${COLOR_RED}Error: Unknown command '%s'${COLOR_RESET}\n\n" "$1"
    usage
    exit 1
    ;;
esac
