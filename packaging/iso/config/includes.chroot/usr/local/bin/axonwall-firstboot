#!/usr/bin/env bash
# ==============================================================================
# Axonwall Appliance Firstboot Provisioner
# ==============================================================================
set -euo pipefail

MARKER="/etc/axonwall/.firstboot"

if [[ ! -f "$MARKER" ]]; then
  exit 0
fi

echo "[Axonwall Firstboot] Initializing network appliance..."

# 1. Apply kernel performance tuning
# sysctl --system exits non-zero on unknown keys (e.g. nf_conntrack_* before the
# module is loaded); under `set -e` that previously aborted the whole script.
modprobe nf_conntrack 2>/dev/null || true
modprobe tcp_bbr 2>/dev/null || true
sysctl --system || true

# 1.1 Process Cloud-Init configuration (#cloud-config) if present
mkdir -p /etc/axonwall
if [[ ! -s /var/lib/cloud/seed/nocloud-net/user-data && ! -s /var/lib/cloud/instance/user-data.txt && ! -s /etc/axonwall/cloud-config.yaml ]]; then
  modprobe isofs vfat sr_mod sd_mod virtio_blk virtio_scsi 2>/dev/null || true
  _ci_devs=""
  for _lbl in cidata CIDATA AXONCFG axoncfg cloud-init CLOUD-INIT config-2 CONFIG-2; do
    _d="$(blkid -L "$_lbl" 2>/dev/null || true)"
    [[ -n "$_d" && -b "$_d" ]] && _ci_devs="$_ci_devs $_d"
  done
  for _sr in /dev/sr0 /dev/sr1; do
    [[ -b "$_sr" ]] && _ci_devs="$_ci_devs $_sr"
  done
  for _cdev in $_ci_devs; do
    mkdir -p /run/axonwall-ci-mnt
    if mount -o ro "$_cdev" /run/axonwall-ci-mnt 2>/dev/null || mount -t iso9660 -o ro "$_cdev" /run/axonwall-ci-mnt 2>/dev/null || mount -t vfat -o ro "$_cdev" /run/axonwall-ci-mnt 2>/dev/null; then
      for _ud in user-data USER-DATA user_data user_dat. USER_DAT. "user_dat.;1" "USER_DAT.;1" cloud-config.yaml openstack/latest/user_data; do
        if [[ -s "/run/axonwall-ci-mnt/$_ud" ]]; then
          mkdir -p /var/lib/cloud/seed/nocloud-net
          cp "/run/axonwall-ci-mnt/$_ud" /var/lib/cloud/seed/nocloud-net/user-data
          chmod 0600 /var/lib/cloud/seed/nocloud-net/user-data
          for _md in meta-data META-DATA meta_data meta_dat. META_DAT. "meta_dat.;1" "META_DAT.;1"; do
            [[ -s "/run/axonwall-ci-mnt/$_md" ]] && cp "/run/axonwall-ci-mnt/$_md" /var/lib/cloud/seed/nocloud-net/meta-data && break
          done
          for _nc in network-config NETWORK-CONFIG network_config net_cfg. NET_CFG. "net_cfg.;1" "NET_CFG.;1"; do
            [[ -s "/run/axonwall-ci-mnt/$_nc" ]] && cp "/run/axonwall-ci-mnt/$_nc" /var/lib/cloud/seed/nocloud-net/network-config && break
          done
          umount /run/axonwall-ci-mnt 2>/dev/null || true
          break 2
        fi
      done
      umount /run/axonwall-ci-mnt 2>/dev/null || true
    fi
  done
  rmdir /run/axonwall-ci-mnt 2>/dev/null || true
fi
if [[ -x /usr/local/bin/axonwall-cloud-init ]]; then
  echo "[Axonwall Firstboot] Checking for cloud-init provisioning metadata..."
  /usr/local/bin/axonwall-cloud-init --no-apply 2>&1 || true
fi

# Detect Host Mode (core-firewall disabled via cloud-init or system.yaml)
HOST_MODE=0
for _cfg_file in /etc/axonwall/conf.d/99-cloudinit.yaml /etc/axonwall/system.yaml /var/lib/cloud/seed/nocloud-net/user-data /var/lib/cloud/seed/nocloud/user-data /etc/axonwall/cloud-config.yaml; do
  if [[ -f "$_cfg_file" ]] && grep -qE 'firewallEnabled:[[:space:]]*false' "$_cfg_file" 2>/dev/null; then
    HOST_MODE=1
    break
  fi
done
if [[ "$HOST_MODE" == "1" ]]; then
  echo "[Axonwall Firstboot] Host Mode detected (core-firewall disabled) — skipping router LAN gateway & WAN lockdown defaults..."
  LAN_DEFAULT_MODE="dhcp"
  LAN_DEFAULT_IPV4=""
  LAN_DEFAULT_DHCP="false"
else
  LAN_DEFAULT_MODE="static"
  LAN_DEFAULT_IPV4="192.168.1.1/24"
  LAN_DEFAULT_DHCP="true"
fi

# 2. Identify physical NICs (excluding loopback and virtual/tunnel netdevs)
INTERFACES=($(ip -o link show | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -vE '^(lo|wg.*|tailscale.*|tun.*|tap.*|sit.*|ip6tnl.*|gre.*|gretap.*|erspan.*|ip_vti.*|ip6_vti.*|ip6gre.*|docker.*|veth.*|br-.*|virbr.*|dummy.*|bond.*|pimreg)$' || true))
WAN_IF="${INTERFACES[0]:-eth0}"
LAN_IF="${INTERFACES[1]:-}"
OPT1_IF="${INTERFACES[2]:-}"
OPT2_IF="${INTERFACES[3]:-}"

echo "[Axonwall Firstboot] Detected WAN: ${WAN_IF}, LAN: ${LAN_IF:-<none>}, OPT1: ${OPT1_IF:-<none>}, OPT2: ${OPT2_IF:-<none>}"

mkdir -p /etc/axonwall
cat << CONF_EOF > /etc/axonwall/interfaces.conf
WAN_INTERFACE=${WAN_IF}
WAN_MODE=dhcp
WAN_IPV4_ADDRESS=
WAN_IPV4_GATEWAY=
WAN_DNS1=1.1.1.1
WAN_DNS2=8.8.8.8
LAN_INTERFACE=${LAN_IF}
LAN_MODE=${LAN_DEFAULT_MODE}
LAN_IPV4_ADDRESS=${LAN_DEFAULT_IPV4}
LAN_DHCP_ENABLED=${LAN_DEFAULT_DHCP}
OPT1_INTERFACE=${OPT1_IF}
OPT1_MODE=dhcp
OPT1_IPV4_ADDRESS=
OPT2_INTERFACE=${OPT2_IF}
OPT2_MODE=dhcp
OPT2_IPV4_ADDRESS=
IFACE_WAN_NAME=wan
IFACE_WAN_DEVICE=${WAN_IF}
IFACE_WAN_ROLE=wan
IFACE_WAN_MODE=dhcp
IFACE_WAN_IPV4_ADDRESS=
IFACE_WAN_IPV4_GATEWAY=
IFACE_WAN_DHCP_SERVER=false
CONF_EOF

ALL_IFACE_NAMES="wan"
if [[ -n "$LAN_IF" ]]; then
  ALL_IFACE_NAMES="${ALL_IFACE_NAMES},lan"
  cat << CONF_LAN_EOF >> /etc/axonwall/interfaces.conf
IFACE_LAN_NAME=lan
IFACE_LAN_DEVICE=${LAN_IF}
IFACE_LAN_ROLE=lan
IFACE_LAN_MODE=${LAN_DEFAULT_MODE}
IFACE_LAN_IPV4_ADDRESS=${LAN_DEFAULT_IPV4}
IFACE_LAN_IPV4_GATEWAY=
IFACE_LAN_DHCP_SERVER=${LAN_DEFAULT_DHCP}
CONF_LAN_EOF
fi

for (( idx=2; idx<${#INTERFACES[@]}; idx++ )); do
  _opt_num=$(( idx - 1 ))
  _opt_name="opt${_opt_num}"
  _opt_key="OPT${_opt_num}"
  _opt_dev="${INTERFACES[$idx]}"
  [[ -z "$_opt_dev" ]] && continue
  ALL_IFACE_NAMES="${ALL_IFACE_NAMES},${_opt_name}"
  cat << CONF_OPT_EOF >> /etc/axonwall/interfaces.conf
IFACE_${_opt_key}_NAME=${_opt_name}
IFACE_${_opt_key}_DEVICE=${_opt_dev}
IFACE_${_opt_key}_ROLE=lan
IFACE_${_opt_key}_MODE=dhcp
IFACE_${_opt_key}_IPV4_ADDRESS=
IFACE_${_opt_key}_IPV4_GATEWAY=
IFACE_${_opt_key}_DHCP_SERVER=false
CONF_OPT_EOF
done
echo "AXONWALL_INTERFACES=${ALL_IFACE_NAMES}" >> /etc/axonwall/interfaces.conf

# Ensure /etc/network/interfaces is populated persistently
mkdir -p /etc/network /etc/network/interfaces.d
cat << IFACES_EOF > /etc/network/interfaces
# /etc/network/interfaces -- Generated by Axonwall
auto lo
iface lo inet loopback

# WAN Interface
auto ${WAN_IF}
iface ${WAN_IF} inet dhcp

IFACES_EOF

if [[ -n "$LAN_IF" ]]; then
  if [[ "$HOST_MODE" == "1" ]]; then
cat << IFACES_LAN_EOF >> /etc/network/interfaces
# LAN Interface (Host Mode — DHCP Client)
auto ${LAN_IF}
iface ${LAN_IF} inet dhcp

IFACES_LAN_EOF
  else
cat << IFACES_LAN_EOF >> /etc/network/interfaces
# LAN Interface
auto ${LAN_IF}
iface ${LAN_IF} inet static
    address 192.168.1.1
    netmask 255.255.255.0

IFACES_LAN_EOF
  fi
fi

for (( idx=2; idx<${#INTERFACES[@]}; idx++ )); do
  _opt_num=$(( idx - 1 ))
  _opt_dev="${INTERFACES[$idx]}"
  [[ -z "$_opt_dev" ]] && continue
  cat << IFACES_OPT_EOF >> /etc/network/interfaces
# OPT${_opt_num} Interface
auto ${_opt_dev}
iface ${_opt_dev} inet dhcp

IFACES_OPT_EOF
done

rm -f /etc/network/interfaces.d/axonwall 2>/dev/null || true

start_dhcp_if_missing() {
  local _if="$1"
  [[ -z "$_if" ]] && return 0
  ip link show "$_if" &>/dev/null || return 0
  ip link set up dev "$_if" 2>/dev/null || true
  if ip -4 addr show dev "$_if" 2>/dev/null | grep -q 'inet '; then
    return 0
  fi
  if command -v dhcpcd &>/dev/null; then
    dhcpcd -4 "$_if" &>/dev/null || true
  elif command -v dhclient &>/dev/null; then
    dhclient -1 -v "$_if" &>/dev/null || true
  fi
}

# Bring up WAN interface and acquire DHCP lease if not already configured
start_dhcp_if_missing "$WAN_IF"

# 3. Configure default LAN IP on a real second NIC (static 192.168.1.1/24 in NGFW mode, DHCP in Host Mode)
if [[ -n "$LAN_IF" ]] && ip link show "$LAN_IF" &>/dev/null; then
  if [[ "$HOST_MODE" == "1" ]]; then
    start_dhcp_if_missing "$LAN_IF"
  else
    ip addr add 192.168.1.1/24 dev "$LAN_IF" 2>/dev/null || true
    ip link set up dev "$LAN_IF" || true
  fi
fi

# Configure OPT1, OPT2, and any additional physical NICs as non-authoritative interfaces (link up, DHCP client)
for (( idx=2; idx<${#INTERFACES[@]}; idx++ )); do
  _opt_num=$(( idx - 1 ))
  _opt_dev="${INTERFACES[$idx]}"
  if [[ -n "$_opt_dev" ]] && ip link show "$_opt_dev" &>/dev/null; then
    start_dhcp_if_missing "$_opt_dev"
    echo "[Axonwall Firstboot] OPT${_opt_num} interface ($_opt_dev) brought UP (Non-authoritative / attached network)"
  fi
done

# 4. Bootstrap baseline lockdown nftables ruleset
if [[ -f /usr/share/axonwall/lockdown.nft ]]; then
  INTERNAL_HAS_LINK=0
  if [[ "$HOST_MODE" != "1" ]]; then
    for _attempt in 1 2 3; do
      for (( idx=1; idx<${#INTERFACES[@]}; idx++ )); do
        _int_if="${INTERFACES[$idx]}"
        if [[ -n "$_int_if" ]] && [[ "$(cat "/sys/class/net/${_int_if}/carrier" 2>/dev/null || echo 0)" == "1" ]]; then
          INTERNAL_HAS_LINK=1
          break 2
        fi
      done
      [[ ${#INTERFACES[@]} -le 1 ]] && break
      sleep 1
    done
  fi
  if [[ "$HOST_MODE" != "1" && -n "$WAN_IF" && "$WAN_IF" != "wan0" ]]; then
    if ! grep -q "\"${WAN_IF}\"" /usr/share/axonwall/lockdown.nft; then
      sed -i "s/elements = { [^}]* }/elements = { \"wan0\", \"${WAN_IF}\" }/" /usr/share/axonwall/lockdown.nft || true
    fi
  else
    sed -i 's/elements = { [^}]* }/elements = { "wan0" }/' /usr/share/axonwall/lockdown.nft || true
  fi
  nft -f /usr/share/axonwall/lockdown.nft || true
fi

# 5. Initialize Axonwall System User & Environment
echo "[Axonwall Firstboot] Setting up permissions and environment..."
if ! id -u axonwall &>/dev/null; then
  groupadd -r axonwall 2>/dev/null || true
  useradd -r -g axonwall -s /usr/sbin/nologin -d /var/lib/axonwall -m axonwall 2>/dev/null || true
fi

# Service-identity split (audit B-12): separate controller user + shared api group
groupadd -r axonwall-api 2>/dev/null || true
groupadd -r axonwall-controller 2>/dev/null || true
if ! id -u axonwall-controller &>/dev/null; then
  useradd -r -g axonwall-controller -s /usr/sbin/nologin -d /var/lib/axonwall axonwall-controller 2>/dev/null || true
fi
usermod -a -G axonwall-api axonwall 2>/dev/null || true
usermod -a -G axonwall-api axonwall-controller 2>/dev/null || true

# Headscale identity split (B-12 follow-up): headscale runs as its own user
groupadd -r axonwall-headscale 2>/dev/null || true
if ! id -u axonwall-headscale &>/dev/null; then
  useradd -r -g axonwall-headscale -s /usr/sbin/nologin -d /var/lib/axonwall axonwall-headscale 2>/dev/null || true
fi

# Provision the hub TLS PKI (audit B-14): an on-box appliance CA plus a
# CA-issued hub leaf, via the shared provisioning tool. --ensure is
# idempotent and never disturbs an operator CA. The inline fallback is
# the previous self-signed generation, used only if the tool is missing.
mkdir -p /etc/axonwall/certs
if command -v axonwall-rotate-hub-cert >/dev/null 2>&1; then
  echo "[Axonwall Firstboot] Provisioning appliance TLS PKI (CA + hub leaf)..."
  axonwall-rotate-hub-cert --ensure || true
elif [[ ! -s /etc/axonwall/certs/hub.crt || ! -s /etc/axonwall/certs/hub.key ]]; then
  echo "[Axonwall Firstboot] Generating appliance TLS certificate..."
  SAN="DNS:$(hostname),DNS:axonwall.local,DNS:localhost,IP:127.0.0.1"
  for ip in $(hostname -I 2>/dev/null || true); do SAN="${SAN},IP:${ip}"; done
  openssl req -x509 -newkey rsa:2048 -nodes \
    -keyout /etc/axonwall/certs/hub.key \
    -out /etc/axonwall/certs/hub.crt \
    -days 3650 \
    -subj "/O=Axonwall/OU=Appliance/CN=$(hostname)" \
    -addext "subjectAltName=${SAN}" || true
fi
# Always fix ownership: the controller (its own user since B-12) reads the key
chown root:axonwall-api /etc/axonwall /etc/axonwall/certs 2>/dev/null || true
chown axonwall-controller:axonwall-controller /etc/axonwall/certs/hub.key /etc/axonwall/certs/hub.crt 2>/dev/null || true
chmod 1770 /etc/axonwall 2>/dev/null || true
chmod 750 /etc/axonwall/certs 2>/dev/null || true
chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
chmod 0644 /etc/axonwall/certs/hub.crt 2>/dev/null || true

# Initialize persistent directories on /var/lib/axonwall (Headscale, OpenLDAP, HA PKI, shared /home)
mkdir -p /var/lib/axonwall/headscale /var/lib/axonwall/bundles /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops /var/lib/axonwall/captures /var/lib/axonwall/backups /var/cache/axonwall-ui /run/headscale
mkdir -p /var/lib/axonwall/home /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups
mkdir -p /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki
chown root:axonwall-api /var/lib/axonwall 2>/dev/null || true
chown -R axonwall:axonwall /var/cache/axonwall-ui 2>/dev/null || true
chmod 0750 /var/cache/axonwall-ui 2>/dev/null || true
chown -R axonwall:axonwall-api /var/lib/axonwall/bundles /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops /var/lib/axonwall/captures /var/lib/axonwall/backups 2>/dev/null || true
chmod 3775 /var/lib/axonwall /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops /var/lib/axonwall/captures /var/lib/axonwall/backups 2>/dev/null || true
for f in /var/lib/axonwall/state.json /var/lib/axonwall/slot_versions.json /var/lib/axonwall/session-epoch /var/lib/axonwall/revoked-jtis /var/lib/axonwall/.password_changed /var/lib/axonwall/mcp-keys.json /var/lib/axonwall/mcp-settings.json /var/lib/axonwall/mcp-audit.jsonl; do
  if [[ -e "$f" ]]; then
    chown axonwall:axonwall-api "$f" 2>/dev/null || true
    chmod 0660 "$f" 2>/dev/null || true
  fi
done
chown -R axonwall-headscale:axonwall-headscale /var/lib/axonwall/headscale 2>/dev/null || true
chmod 1775 /var/lib/axonwall 2>/dev/null || true
chmod 0755 /var/lib/axonwall/home 2>/dev/null || true
chown root:root /var/lib/axonwall/home 2>/dev/null || true
chown -R root:root /var/lib/axonwall/secrets 2>/dev/null || true
chmod 0700 /var/lib/axonwall/secrets /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki 2>/dev/null || true
if id -u openldap &>/dev/null; then
  chown -R openldap:openldap /var/lib/axonwall/ldap 2>/dev/null || true
  chmod 0750 /var/lib/axonwall/ldap /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups 2>/dev/null || true
fi
chown axonwall-headscale:axonwall-api /run/headscale 2>/dev/null || true
chown root:axonwall-api /etc/headscale/config.yaml 2>/dev/null || true
chmod 0640 /etc/headscale/config.yaml 2>/dev/null || true
chmod 770 /var/lib/axonwall/headscale /run/headscale 2>/dev/null || true

# Register /usr/local/bin/axonwall-opshell in /etc/shells
if [[ -f /etc/shells ]] && ! grep -qxF '/usr/local/bin/axonwall-opshell' /etc/shells; then
  echo '/usr/local/bin/axonwall-opshell' >> /etc/shells
fi
if [[ -f /etc/sudoers.d/axonwall ]]; then
  chown root:root /etc/sudoers.d/axonwall 2>/dev/null || true
  chmod 0440 /etc/sudoers.d/axonwall 2>/dev/null || true
fi

# Migrate any existing /home/* into /var/lib/axonwall/home and bind-mount /home (only when /var/lib/axonwall is a separate partition in A/B mode)
if mountpoint -q /var/lib/axonwall 2>/dev/null || [[ -e /dev/disk/by-label/axon_root_b ]]; then
  if ! mountpoint -q /home 2>/dev/null; then
    if [[ -d /home ]] && [[ -n "$(ls -A /home 2>/dev/null || true)" ]]; then
      cp -a /home/. /var/lib/axonwall/home/ 2>/dev/null || true
    fi
    chown root:root /var/lib/axonwall/home 2>/dev/null || true
    chmod 0755 /var/lib/axonwall/home 2>/dev/null || true
    mount --bind /var/lib/axonwall/home /home 2>/dev/null || true
  fi
  if [[ -f /etc/fstab ]] && ! grep -q '/var/lib/axonwall/home' /etc/fstab; then
    echo '/var/lib/axonwall/home  /home  none  bind  0  0' >> /etc/fstab
  fi
fi
chown root:root /var/lib/axonwall/home /home 2>/dev/null || true
chmod 0755 /var/lib/axonwall/home /home 2>/dev/null || true

# Bootstrap OpenZFS pool ('zroot' for ZFSBootMenu or 'tank' for NAS/OpenEBS) if recorded by installer
if [[ -s /var/lib/axonwall/install-zfs.json ]] && command -v zpool &>/dev/null; then
  modprobe zfs 2>/dev/null || true
  _zfs_pool="$(jq -r '.poolName // "tank"' /var/lib/axonwall/install-zfs.json 2>/dev/null || echo "tank")"
  _zfs_topo="$(jq -r '.topology // "stripe"' /var/lib/axonwall/install-zfs.json 2>/dev/null || echo "stripe")"
  _zfs_vdevs="$(jq -r '(.vdevs // []) | join(" ")' /var/lib/axonwall/install-zfs.json 2>/dev/null || true)"
  if [[ -n "$_zfs_pool" && -n "$_zfs_vdevs" ]]; then
    if ! zpool list -H "$_zfs_pool" &>/dev/null; then
      zpool import -f "$_zfs_pool" 2>/dev/null || true
    fi
    if ! zpool list -H "$_zfs_pool" &>/dev/null; then
      _topo_arg=""
      [[ "$_zfs_topo" != "stripe" && "$_zfs_topo" != "auto" && -n "$_zfs_topo" ]] && _topo_arg="$_zfs_topo"
      if [[ "$_zfs_pool" == "zroot" ]]; then
        echo "[Axonwall Firstboot] Creating ZFSBootMenu Root-on-ZFS pool 'zroot' (${_zfs_topo}: ${_zfs_vdevs})..."
        # shellcheck disable=SC2086
        if zpool create -f -o ashift=12 -o autotrim=on -O compression=lz4 -O acltype=posixacl -O xattr=sa -O normalization=formD -O canmount=off -O mountpoint=none zroot $_topo_arg $_zfs_vdevs 2>/dev/null; then
          _app_ver="$(head -n1 /etc/axonwall/version 2>/dev/null | tr -d '\r\n ' || echo "0.11.32")"
          [[ -z "$_app_ver" ]] && _app_ver="0.11.32"
          _init_be="zroot/ROOT/axonwall-${_app_ver}"
          zfs create -o canmount=off -o mountpoint=none zroot/ROOT 2>/dev/null || true
          zfs create -o canmount=noauto -o mountpoint=/ "$_init_be" 2>/dev/null || true
          zfs create -o mountpoint=/mnt/tank zroot/tank 2>/dev/null || true
          zpool set "bootfs=${_init_be}" zroot 2>/dev/null || true
          zfs set "org.axonwall:active_be=${_init_be}" zroot/ROOT 2>/dev/null || true
          zfs set "org.axonwall:fallback_be=${_init_be}" zroot/ROOT 2>/dev/null || true
          zfs set "org.axonwall:bootcount=0" zroot/ROOT 2>/dev/null || true
          zfs set "org.axonwall:bootlimit=3" zroot/ROOT 2>/dev/null || true
          zfs set "org.axonwall:topology=${_zfs_topo}" zroot/ROOT 2>/dev/null || true
          zfs snapshot "${_init_be}@factory-initial" 2>/dev/null || true
        fi
      else
        echo "[Axonwall Firstboot] Creating OpenZFS storage pool '${_zfs_pool}' (${_zfs_topo}: ${_zfs_vdevs})..."
        # shellcheck disable=SC2086
        zpool create -f -o ashift=12 -o autotrim=on -O compression=lz4 -O acltype=posixacl -O xattr=sa -O normalization=formD -O mountpoint=/mnt/tank "$_zfs_pool" $_topo_arg $_zfs_vdevs 2>/dev/null || true
      fi
    fi
  fi
fi

# Generate secure random appliance secrets if absent
if [[ ! -s /etc/axonwall/axonwall.env ]]; then
  echo "[Axonwall Firstboot] Generating unique appliance security tokens and credentials..."
  JWT_SECRET=$(openssl rand -hex 32)
  
  INSTALL_PASS=""
  if [[ -f /etc/axonwall/admin.env ]]; then
    INSTALL_PASS=$(grep '^LOCAL_ADMIN_PASSWORD=' /etc/axonwall/admin.env | cut -d= -f2- || true)
  fi
  ADMIN_PASS="${INSTALL_PASS:-${LOCAL_ADMIN_PASSWORD:-$(openssl rand -hex 16 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n')}}"

  cat << ENV_EOF > /etc/axonwall/axonwall.env
JWT_SECRET=${JWT_SECRET}
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=${ADMIN_PASS}
AGENT_SOCKET_PATH=/run/axonwall/agent.sock
AGENT_API_SOCKET=/run/axonwall/agent-api.sock
ENV_EOF

  if [[ ! -f /etc/axonwall/.password_changed && "$ADMIN_PASS" != scrypt\$* ]]; then
    echo "$ADMIN_PASS" > /etc/axonwall/initial-admin-password
    chmod 0600 /etc/axonwall/initial-admin-password
    chown root:root /etc/axonwall/initial-admin-password
  else
    echo "[Axonwall Firstboot] Administrator credentials established during installation."
  fi
fi

if [[ ! -s /etc/axonwall/controller.env ]]; then
  ZTP_TOKEN=$(openssl rand -hex 16)
  cat << ENV_EOF > /etc/axonwall/controller.env
AXONWALL_ZTP_TOKEN=${ZTP_TOKEN}
ENV_EOF
fi

if [[ -f /etc/axonwall/admin.env ]]; then
  chown axonwall:axonwall-api /etc/axonwall/admin.env 2>/dev/null || true
  chmod 0660 /etc/axonwall/admin.env 2>/dev/null || true
fi
if [[ -f /var/lib/axonwall/etc-axonwall/admin.env ]]; then
  chown axonwall:axonwall-api /var/lib/axonwall/etc-axonwall/admin.env 2>/dev/null || true
  chmod 0660 /var/lib/axonwall/etc-axonwall/admin.env 2>/dev/null || true
fi
chmod 0600 /etc/axonwall/axonwall.env 2>/dev/null || true
chown axonwall /etc/axonwall/axonwall.env 2>/dev/null || true
if [[ -f /etc/axonwall/controller.env ]]; then
  chown root:axonwall-controller /etc/axonwall/controller.env 2>/dev/null || true
  chmod 0640 /etc/axonwall/controller.env 2>/dev/null || true
fi

# Ensure immutable root ownership of Axonwall application code directory
chown -R root:root /opt/axonwall 2>/dev/null || true
chmod -R go-w /opt/axonwall 2>/dev/null || true

# Initialize etckeeper if installed
if command -v etckeeper &>/dev/null; then
  if [[ ! -d /etc/.git ]]; then
    echo "[Axonwall Firstboot] Initializing etckeeper for /etc configuration tracking..."
    etckeeper init || true
    etckeeper commit "Initial etckeeper commit for Axonwall appliance" || true
  fi
fi

# Ensure SSH host keys are generated
if command -v ssh-keygen &>/dev/null; then
  ssh-keygen -A >/dev/null 2>&1 || true
fi

# Configure VIM as standard editor & vi via update-alternatives, and ZSH as default interactive shell
for vim_bin in /usr/bin/vim.basic /usr/bin/vim.nox /usr/bin/vim.tiny /usr/bin/vim; do
  if [[ -x "$vim_bin" ]] && command -v update-alternatives &>/dev/null; then
    update-alternatives --set editor "$vim_bin" >/dev/null 2>&1 || true
    update-alternatives --set vi "$vim_bin" >/dev/null 2>&1 || true
    update-alternatives --set view "$vim_bin" >/dev/null 2>&1 || true
    break
  fi
done

if [[ -x /usr/bin/zsh ]]; then
  if [[ -f /etc/shells ]] && ! grep -qxF '/usr/bin/zsh' /etc/shells; then
    echo '/usr/bin/zsh' >> /etc/shells
  fi
  if [[ -f /etc/zsh/zshrc ]] && ! grep -q '/etc/zsh/axonwall.zsh' /etc/zsh/zshrc; then
    printf '\n# Load Axonwall ZSH environment\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' >> /etc/zsh/zshrc
  fi
  mkdir -p /etc/skel
  if [[ ! -f /etc/skel/.zshrc ]]; then
    printf '# Axonwall Default User ZSH Profile\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' > /etc/skel/.zshrc
  fi
  if [[ ! -f /root/.zshrc ]]; then
    printf '# Axonwall Root ZSH Profile\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' > /root/.zshrc
  fi
  chsh -s /usr/bin/zsh root 2>/dev/null || usermod -s /usr/bin/zsh root 2>/dev/null || true

  # Set /usr/bin/zsh as default shell for any existing local interactive shell users (UID 1000..59999)
  if [[ -f /etc/passwd ]]; then
    while IFS=: read -r uname uid gid homedir; do
      [[ -z "$uname" ]] && continue
      usermod -s /usr/bin/zsh "$uname" 2>/dev/null || true
      if [[ -n "$homedir" && -d "$homedir" && ! -f "${homedir}/.zshrc" ]]; then
        cp /etc/skel/.zshrc "${homedir}/.zshrc" 2>/dev/null || true
        chown "${uid}:${gid}" "${homedir}/.zshrc" 2>/dev/null || true
      fi
    done < <(awk -F: '($3 >= 1000 && $3 < 60000 && ($7 == "/bin/bash" || $7 == "/bin/sh")) {print $1 ":" $3 ":" $4 ":" $6}' /etc/passwd)
  fi

  if [[ -f /etc/default/useradd ]]; then
    if grep -q '^SHELL=' /etc/default/useradd; then
      sed -i 's|^SHELL=.*|SHELL=/usr/bin/zsh|' /etc/default/useradd 2>/dev/null || true
    else
      echo 'SHELL=/usr/bin/zsh' >> /etc/default/useradd 2>/dev/null || true
    fi
  fi
  if [[ -f /etc/adduser.conf ]]; then
    if grep -q '^DSHELL=' /etc/adduser.conf; then
      sed -i 's|^DSHELL=.*|DSHELL=/usr/bin/zsh|' /etc/adduser.conf 2>/dev/null || true
    else
      echo 'DSHELL=/usr/bin/zsh' >> /etc/adduser.conf 2>/dev/null || true
    fi
  fi
fi

if [[ -f /etc/default/sysstat ]]; then
  sed -i 's/^ENABLED="false"/ENABLED="true"/' /etc/default/sysstat 2>/dev/null || true
fi

# 6. Remove marker and trigger services
# Marker is removed first so ConditionPathExists doesn't loop or block
rm -f "$MARKER"

systemctl daemon-reload
systemctl enable axonwalld axonwall-controller axonwall-ui headscale ssh chrony sysstat || true
# Start/restart axonwalld synchronously before axonwallctl apply so the agent socket stays live during apply
systemctl try-restart axonwalld || true
systemctl restart --no-block axonwall-ui axonwall-controller headscale ssh chrony || true

if [[ -x /usr/local/bin/axonwallctl ]]; then
  echo "[Axonwall Firstboot] Compiling declarative YAML configuration..."
  /usr/local/bin/axonwallctl apply 2>&1 || true
elif command -v axonwallctl &>/dev/null; then
  echo "[Axonwall Firstboot] Compiling declarative YAML configuration..."
  axonwallctl apply 2>&1 || true
fi

PRIMARY_IP=""
for _cand_if in "$LAN_IF" "$OPT1_IF" "$OPT2_IF" "$WAN_IF"; do
  if [[ -n "$_cand_if" ]]; then
    PRIMARY_IP=$(ip -4 addr show dev "$_cand_if" 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n 1 || true)
    [[ -n "$PRIMARY_IP" ]] && break
  fi
done
PRIMARY_IP="${PRIMARY_IP:-192.168.1.1}"

cat << ISSUE_EOF > /etc/issue
================================================================================
Axonwall Appliance (Debian 13)
Web Console (LAN): https://${PRIMARY_IP}:2966
WAN Inbound      : Blocked by default (Anti-Lockout enabled on LAN only)
Appliance Console: Login with administrator credentials
================================================================================
\n \l

ISSUE_EOF

echo "================================================================================"
echo "[Axonwall Firstboot] Provisioning complete."
echo "  Web Management Console (LAN): https://${PRIMARY_IP}:2966"
echo "  WAN Inbound Access          : BLOCKED by default"
echo "  Default Administrator       : admin"
echo "  Appliance Console           : Login authentication enabled"
echo "================================================================================"
