#!/usr/bin/env bash
# ==============================================================================
# Axonwall Appliance Firstboot Provisioner
# ==============================================================================
set -euo pipefail

MARKER="/etc/axonwall/.firstboot"

if [[ ! -f "$MARKER" ]]; then
  exit 0
fi

echo "[Axonwall Firstboot] Initializing network appliance..."

# 1. Apply kernel performance tuning
# sysctl --system exits non-zero on unknown keys (e.g. nf_conntrack_* before the
# module is loaded); under `set -e` that previously aborted the whole script.
modprobe nf_conntrack 2>/dev/null || true
modprobe tcp_bbr 2>/dev/null || true
sysctl --system || true

# 1.1 Process Cloud-Init configuration (#cloud-config) if present
mkdir -p /etc/axonwall
if [[ -x /usr/local/bin/axonwall-cloud-init ]]; then
  echo "[Axonwall Firstboot] Checking for cloud-init provisioning metadata..."
  /usr/local/bin/axonwall-cloud-init --no-apply 2>&1 || true
fi

# 2. Identify Primary LAN & WAN NICs, plus optional OPT1 & OPT2 NICs
INTERFACES=($(ip -o link show | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -vx 'lo' | head -n 4 || true))
WAN_IF="${INTERFACES[0]:-eth0}"
LAN_IF="${INTERFACES[1]:-}"
OPT1_IF="${INTERFACES[2]:-}"
OPT2_IF="${INTERFACES[3]:-}"

echo "[Axonwall Firstboot] Detected WAN: ${WAN_IF}, LAN: ${LAN_IF:-<none>}, OPT1: ${OPT1_IF:-<none>}, OPT2: ${OPT2_IF:-<none>}"

mkdir -p /etc/axonwall
cat << CONF_EOF > /etc/axonwall/interfaces.conf
WAN_INTERFACE=${WAN_IF}
WAN_MODE=dhcp
WAN_IPV4_ADDRESS=
WAN_IPV4_GATEWAY=
WAN_DNS1=1.1.1.1
WAN_DNS2=8.8.8.8
LAN_INTERFACE=${LAN_IF}
LAN_MODE=static
LAN_IPV4_ADDRESS=192.168.1.1/24
LAN_DHCP_ENABLED=true
OPT1_INTERFACE=${OPT1_IF}
OPT1_MODE=dhcp
OPT1_IPV4_ADDRESS=
OPT2_INTERFACE=${OPT2_IF}
OPT2_MODE=dhcp
OPT2_IPV4_ADDRESS=
CONF_EOF

# Ensure /etc/network/interfaces is populated persistently
mkdir -p /etc/network /etc/network/interfaces.d
cat << IFACES_EOF > /etc/network/interfaces
# /etc/network/interfaces -- Generated by Axonwall
auto lo
iface lo inet loopback

# WAN Interface
auto ${WAN_IF}
iface ${WAN_IF} inet dhcp

IFACES_EOF

if [[ -n "$LAN_IF" ]]; then
cat << IFACES_LAN_EOF >> /etc/network/interfaces
# LAN Interface
auto ${LAN_IF}
iface ${LAN_IF} inet static
    address 192.168.1.1
    netmask 255.255.255.0

IFACES_LAN_EOF
fi

if [[ -n "$OPT1_IF" ]]; then
cat << IFACES_OPT1_EOF >> /etc/network/interfaces
# OPT1 Interface
auto ${OPT1_IF}
iface ${OPT1_IF} inet dhcp

IFACES_OPT1_EOF
fi

if [[ -n "$OPT2_IF" ]]; then
cat << IFACES_OPT2_EOF >> /etc/network/interfaces
# OPT2 Interface
auto ${OPT2_IF}
iface ${OPT2_IF} inet dhcp

IFACES_OPT2_EOF
fi

cp /etc/network/interfaces /etc/network/interfaces.d/axonwall 2>/dev/null || true

# 3. Configure default LAN static IP (192.168.1.1/24) only on a real second NIC
if [[ -n "$LAN_IF" ]] && ip link show "$LAN_IF" &>/dev/null; then
  ip addr add 192.168.1.1/24 dev "$LAN_IF" || true
  ip link set up dev "$LAN_IF" || true
fi

# Configure OPT1 and OPT2 as non-authoritative interfaces (link up, NO Kea DHCP server)
if [[ -n "$OPT1_IF" ]] && ip link show "$OPT1_IF" &>/dev/null; then
  ip link set up dev "$OPT1_IF" || true
  if command -v dhclient &>/dev/null; then
    dhclient -1 -v "$OPT1_IF" &>/dev/null || true
  fi
  echo "[Axonwall Firstboot] OPT1 interface ($OPT1_IF) brought UP (Non-authoritative / attached network)"
fi

if [[ -n "$OPT2_IF" ]] && ip link show "$OPT2_IF" &>/dev/null; then
  ip link set up dev "$OPT2_IF" || true
  if command -v dhclient &>/dev/null; then
    dhclient -1 -v "$OPT2_IF" &>/dev/null || true
  fi
  echo "[Axonwall Firstboot] OPT2 interface ($OPT2_IF) brought UP (Non-authoritative / attached network)"
fi

# 4. Bootstrap baseline lockdown nftables ruleset
if [[ -f /usr/share/axonwall/lockdown.nft ]]; then
  INTERNAL_HAS_LINK=0
  for _int_if in "$LAN_IF" "$OPT1_IF" "$OPT2_IF"; do
    if [[ -n "$_int_if" ]] && [[ "$(cat "/sys/class/net/${_int_if}/carrier" 2>/dev/null || echo 0)" == "1" ]]; then
      INTERNAL_HAS_LINK=1
      break
    fi
  done
  if [[ "$INTERNAL_HAS_LINK" == "1" && -n "$WAN_IF" && "$WAN_IF" != "wan0" ]]; then
    if ! grep -q "\"${WAN_IF}\"" /usr/share/axonwall/lockdown.nft; then
      sed -i "s/elements = { [^}]* }/elements = { \"wan0\", \"${WAN_IF}\" }/" /usr/share/axonwall/lockdown.nft || true
    fi
  else
    sed -i 's/elements = { [^}]* }/elements = { "wan0" }/' /usr/share/axonwall/lockdown.nft || true
  fi
  nft -f /usr/share/axonwall/lockdown.nft || true
fi

# 5. Initialize Axonwall System User & Environment
echo "[Axonwall Firstboot] Setting up permissions and environment..."
if ! id -u axonwall &>/dev/null; then
  groupadd -r axonwall 2>/dev/null || true
  useradd -r -g axonwall -s /usr/sbin/nologin -d /var/lib/axonwall -m axonwall 2>/dev/null || true
fi

# Service-identity split (audit B-12): separate controller user + shared api group
groupadd -r axonwall-api 2>/dev/null || true
groupadd -r axonwall-controller 2>/dev/null || true
if ! id -u axonwall-controller &>/dev/null; then
  useradd -r -g axonwall-controller -s /usr/sbin/nologin -d /var/lib/axonwall axonwall-controller 2>/dev/null || true
fi
usermod -a -G axonwall-api axonwall 2>/dev/null || true
usermod -a -G axonwall-api axonwall-controller 2>/dev/null || true

# Generate a per-appliance TLS certificate (never ship a shared private key in the ISO)
mkdir -p /etc/axonwall/certs
if [[ ! -s /etc/axonwall/certs/hub.crt || ! -s /etc/axonwall/certs/hub.key ]]; then
  echo "[Axonwall Firstboot] Generating appliance TLS certificate..."
  SAN="DNS:$(hostname),DNS:axonwall.local,DNS:localhost,IP:127.0.0.1"
  for ip in $(hostname -I 2>/dev/null || true); do SAN="${SAN},IP:${ip}"; done
  openssl req -x509 -newkey rsa:2048 -nodes \
    -keyout /etc/axonwall/certs/hub.key \
    -out /etc/axonwall/certs/hub.crt \
    -days 3650 \
    -subj "/O=Axonwall/OU=Appliance/CN=$(hostname)" \
    -addext "subjectAltName=${SAN}" || true
fi
# Always fix ownership: the controller (its own user since B-12) reads the key
chown root:axonwall-api /etc/axonwall /etc/axonwall/certs 2>/dev/null || true
chown axonwall-controller:axonwall-controller /etc/axonwall/certs/hub.key /etc/axonwall/certs/hub.crt 2>/dev/null || true
chmod 0770 /etc/axonwall 2>/dev/null || true
chmod 750 /etc/axonwall/certs 2>/dev/null || true
chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
chmod 0644 /etc/axonwall/certs/hub.crt 2>/dev/null || true

# Initialize persistent directories on /var/lib/axonwall (Headscale, OpenLDAP, HA PKI, shared /home)
mkdir -p /var/lib/axonwall/headscale /var/lib/axonwall/bundles /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops /run/headscale
mkdir -p /var/lib/axonwall/home /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups
mkdir -p /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki
chown root:axonwall-api /var/lib/axonwall 2>/dev/null || true
chown -R axonwall:axonwall-api /var/lib/axonwall/bundles /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops 2>/dev/null || true
for f in /var/lib/axonwall/state.json /var/lib/axonwall/slot_versions.json /var/lib/axonwall/session-epoch /var/lib/axonwall/revoked-jtis /var/lib/axonwall/.password_changed; do
  if [[ -e "$f" ]]; then
    chown axonwall:axonwall-api "$f" 2>/dev/null || true
  fi
done
chown -R axonwall:axonwall /var/lib/axonwall/headscale 2>/dev/null || true
chmod 0775 /var/lib/axonwall 2>/dev/null || true
chmod 0755 /var/lib/axonwall/home 2>/dev/null || true
chown root:root /var/lib/axonwall/home 2>/dev/null || true
chown -R root:root /var/lib/axonwall/secrets 2>/dev/null || true
chmod 0700 /var/lib/axonwall/secrets /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki 2>/dev/null || true
if id -u openldap &>/dev/null; then
  chown -R openldap:openldap /var/lib/axonwall/ldap 2>/dev/null || true
  chmod 0750 /var/lib/axonwall/ldap /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups 2>/dev/null || true
fi
chown axonwall:axonwall-api /run/headscale 2>/dev/null || true
chmod 770 /var/lib/axonwall/headscale /run/headscale 2>/dev/null || true

# Register /usr/local/bin/axonwall-opshell in /etc/shells
if [[ -f /etc/shells ]] && ! grep -qxF '/usr/local/bin/axonwall-opshell' /etc/shells; then
  echo '/usr/local/bin/axonwall-opshell' >> /etc/shells
fi
if [[ -f /etc/sudoers.d/axonwall ]]; then
  chown root:root /etc/sudoers.d/axonwall 2>/dev/null || true
  chmod 0440 /etc/sudoers.d/axonwall 2>/dev/null || true
fi

# Migrate any existing /home/* into /var/lib/axonwall/home and bind-mount /home
if ! mountpoint -q /home 2>/dev/null; then
  if [[ -d /home ]] && [[ -n "$(ls -A /home 2>/dev/null || true)" ]]; then
    cp -a /home/. /var/lib/axonwall/home/ 2>/dev/null || true
  fi
  chown root:root /var/lib/axonwall/home 2>/dev/null || true
  chmod 0755 /var/lib/axonwall/home 2>/dev/null || true
  mount --bind /var/lib/axonwall/home /home 2>/dev/null || true
fi
chown root:root /var/lib/axonwall/home /home 2>/dev/null || true
chmod 0755 /var/lib/axonwall/home /home 2>/dev/null || true
if [[ -f /etc/fstab ]] && ! grep -q '/var/lib/axonwall/home' /etc/fstab; then
  echo '/var/lib/axonwall/home  /home  none  bind  0  0' >> /etc/fstab
fi

# Generate secure random appliance secrets if absent
if [[ ! -s /etc/axonwall/axonwall.env ]]; then
  echo "[Axonwall Firstboot] Generating unique appliance security tokens and credentials..."
  JWT_SECRET=$(openssl rand -hex 32)
  ZTP_TOKEN=$(openssl rand -hex 16)
  
  INSTALL_PASS=""
  if [[ -f /etc/axonwall/admin.env ]]; then
    INSTALL_PASS=$(grep '^LOCAL_ADMIN_PASSWORD=' /etc/axonwall/admin.env | cut -d= -f2- || true)
  fi
  ADMIN_PASS="${INSTALL_PASS:-${LOCAL_ADMIN_PASSWORD:-$(openssl rand -hex 16 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n')}}"

  cat << ENV_EOF > /etc/axonwall/axonwall.env
JWT_SECRET=${JWT_SECRET}
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=${ADMIN_PASS}
AGENT_SOCKET_PATH=/run/axonwall/agent.sock
AGENT_API_SOCKET=/run/axonwall/agent-api.sock
ENV_EOF

  cat << ENV_EOF > /etc/axonwall/controller.env
AXONWALL_ZTP_TOKEN=${ZTP_TOKEN}
ENV_EOF

  if [[ ! -f /etc/axonwall/.password_changed ]]; then
    echo "$ADMIN_PASS" > /etc/axonwall/initial-admin-password
    chmod 0600 /etc/axonwall/initial-admin-password
    chown root:root /etc/axonwall/initial-admin-password
  else
    echo "[Axonwall Firstboot] Administrator credentials established during installation."
  fi
fi

if [[ -f /etc/axonwall/admin.env ]]; then
  chown axonwall /etc/axonwall/admin.env 2>/dev/null || true
  chmod 0600 /etc/axonwall/admin.env 2>/dev/null || true
fi
chmod 0600 /etc/axonwall/axonwall.env 2>/dev/null || true
chown axonwall /etc/axonwall/axonwall.env 2>/dev/null || true
if [[ -f /etc/axonwall/controller.env ]]; then
  chown root:axonwall-controller /etc/axonwall/controller.env 2>/dev/null || true
  chmod 0640 /etc/axonwall/controller.env 2>/dev/null || true
fi

# Ensure proper ownership of Axonwall application directory (Next.js writes .next/cache)
chown -R axonwall:axonwall-api /opt/axonwall 2>/dev/null || true

# Initialize etckeeper if installed
if command -v etckeeper &>/dev/null; then
  if [[ ! -d /etc/.git ]]; then
    echo "[Axonwall Firstboot] Initializing etckeeper for /etc configuration tracking..."
    etckeeper init || true
    etckeeper commit "Initial etckeeper commit for Axonwall appliance" || true
  fi
fi

# Ensure SSH host keys are generated
if command -v ssh-keygen &>/dev/null; then
  ssh-keygen -A >/dev/null 2>&1 || true
fi

# Configure VIM as standard editor & vi via update-alternatives, and ZSH as default interactive shell
for vim_bin in /usr/bin/vim.basic /usr/bin/vim.nox /usr/bin/vim.tiny /usr/bin/vim; do
  if [[ -x "$vim_bin" ]] && command -v update-alternatives &>/dev/null; then
    update-alternatives --set editor "$vim_bin" >/dev/null 2>&1 || true
    update-alternatives --set vi "$vim_bin" >/dev/null 2>&1 || true
    update-alternatives --set view "$vim_bin" >/dev/null 2>&1 || true
    break
  fi
done

if [[ -x /usr/bin/zsh ]]; then
  if [[ -f /etc/shells ]] && ! grep -qxF '/usr/bin/zsh' /etc/shells; then
    echo '/usr/bin/zsh' >> /etc/shells
  fi
  if [[ -f /etc/zsh/zshrc ]] && ! grep -q '/etc/zsh/axonwall.zsh' /etc/zsh/zshrc; then
    printf '\n# Load Axonwall ZSH environment\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' >> /etc/zsh/zshrc
  fi
  mkdir -p /etc/skel
  if [[ ! -f /etc/skel/.zshrc ]]; then
    printf '# Axonwall Default User ZSH Profile\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' > /etc/skel/.zshrc
  fi
  if [[ ! -f /root/.zshrc ]]; then
    printf '# Axonwall Root ZSH Profile\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' > /root/.zshrc
  fi
  chsh -s /usr/bin/zsh root 2>/dev/null || usermod -s /usr/bin/zsh root 2>/dev/null || true

  # Set /usr/bin/zsh as default shell for any existing local interactive shell users (UID 1000..59999)
  if [[ -f /etc/passwd ]]; then
    while IFS=: read -r uname uid gid homedir; do
      [[ -z "$uname" ]] && continue
      usermod -s /usr/bin/zsh "$uname" 2>/dev/null || true
      if [[ -n "$homedir" && -d "$homedir" && ! -f "${homedir}/.zshrc" ]]; then
        cp /etc/skel/.zshrc "${homedir}/.zshrc" 2>/dev/null || true
        chown "${uid}:${gid}" "${homedir}/.zshrc" 2>/dev/null || true
      fi
    done < <(awk -F: '($3 >= 1000 && $3 < 60000 && ($7 == "/bin/bash" || $7 == "/bin/sh")) {print $1 ":" $3 ":" $4 ":" $6}' /etc/passwd)
  fi

  if [[ -f /etc/default/useradd ]]; then
    if grep -q '^SHELL=' /etc/default/useradd; then
      sed -i 's|^SHELL=.*|SHELL=/usr/bin/zsh|' /etc/default/useradd 2>/dev/null || true
    else
      echo 'SHELL=/usr/bin/zsh' >> /etc/default/useradd 2>/dev/null || true
    fi
  fi
  if [[ -f /etc/adduser.conf ]]; then
    if grep -q '^DSHELL=' /etc/adduser.conf; then
      sed -i 's|^DSHELL=.*|DSHELL=/usr/bin/zsh|' /etc/adduser.conf 2>/dev/null || true
    else
      echo 'DSHELL=/usr/bin/zsh' >> /etc/adduser.conf 2>/dev/null || true
    fi
  fi
fi

if [[ -f /etc/default/sysstat ]]; then
  sed -i 's/^ENABLED="false"/ENABLED="true"/' /etc/default/sysstat 2>/dev/null || true
fi

# 6. Remove marker and trigger services
# Marker is removed first so ConditionPathExists doesn't loop or block
rm -f "$MARKER"

systemctl daemon-reload
systemctl enable axonwalld axonwall-controller axonwall-ui headscale ssh chrony sysstat || true
# Use non-blocking restarts so firstboot does not deadlock with services ordered After=axonwall-firstboot.service
systemctl try-restart --no-block axonwalld || true
systemctl restart --no-block axonwall-ui axonwall-controller headscale ssh chrony || true

if command -v axonwallctl &>/dev/null; then
  echo "[Axonwall Firstboot] Compiling declarative YAML configuration..."
  axonwallctl apply 2>&1 || true
fi

LAN_IP=""
if [[ -n "$LAN_IF" ]]; then
  LAN_IP=$(ip -4 addr show dev "$LAN_IF" 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n 1)
fi
PRIMARY_IP="${LAN_IP:-192.168.1.1}"

cat << ISSUE_EOF > /etc/issue
================================================================================
Axonwall Appliance (Debian 13)
Web Console (LAN): https://${PRIMARY_IP}:2966
WAN Inbound      : Blocked by default (Anti-Lockout enabled on LAN only)
Appliance Console: Login with administrator credentials
================================================================================
\n \l

ISSUE_EOF

echo "================================================================================"
echo "[Axonwall Firstboot] Provisioning complete."
echo "  Web Management Console (LAN): https://${PRIMARY_IP}:2966"
echo "  WAN Inbound Access          : BLOCKED by default"
echo "  Default Administrator       : admin"
echo "  Appliance Console           : Login authentication enabled"
echo "================================================================================"
