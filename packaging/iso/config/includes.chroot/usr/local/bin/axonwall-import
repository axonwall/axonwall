#!/usr/bin/env bash
# ==============================================================================
# Axonwall Multi-Vendor Firewall Importer CLI
# Supports pfSense, OPNsense, VyOS/EdgeOS, MikroTik RouterOS, Linux iptables
# ==============================================================================
set -euo pipefail

CONFIG_FILE=""
VENDOR="auto"
DO_APPLY=false
OUT_JSON=""
OUT_NFT=""
API_HOST="http://127.0.0.1:3000"

show_help() {
  cat << EOF
Axonwall Firewall Migration Importer CLI

Usage:
  axonwall-import [options] [config_file]
  cat config.xml | axonwall-import [options]

Options:
  -f, --file PATH        Path to source configuration file (.xml, .boot, .rsc, .v4)
  -v, --vendor VENDOR    Target vendor (auto, pfsense, opnsense, vyos, mikrotik, iptables)
  -a, --apply            Apply converted configuration to live firewall (arms 120s rollback)
  --json PATH            Save converted Axonwall DesiredState JSON to file
  --nft PATH             Save compiled Linux nftables ruleset (.nft) to file
  --api-url URL          Axonwall API URL (default: http://127.0.0.1:3000)
  -h, --help             Show this help message

Examples:
  axonwall-import -f /root/pfsense-backup.xml
  axonwall-import -f /root/vyos-config.boot --apply
  axonwall-import -f /root/mikrotik.rsc --json state.json --nft ruleset.nft
  cat /etc/iptables/rules.v4 | axonwall-import -v iptables
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -f|--file)
      CONFIG_FILE="$2"
      shift 2
      ;;
    -v|--vendor)
      VENDOR="$2"
      shift 2
      ;;
    -a|--apply)
      DO_APPLY=true
      shift
      ;;
    --json)
      OUT_JSON="$2"
      shift 2
      ;;
    --nft)
      OUT_NFT="$2"
      shift 2
      ;;
    --api-url)
      API_HOST="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      if [[ -z "$CONFIG_FILE" && -f "$1" ]]; then
        CONFIG_FILE="$1"
        shift
      else
        echo "Unknown option: $1" >&2
        show_help
        exit 1
      fi
      ;;
  esac
done

# Read configuration content
CONFIG_CONTENT=""
if [[ -n "$CONFIG_FILE" ]]; then
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: Configuration file not found: $CONFIG_FILE" >&2
    exit 1
  fi
  CONFIG_CONTENT="$(cat "$CONFIG_FILE")"
elif [[ ! -t 0 ]]; then
  CONFIG_CONTENT="$(cat)"
else
  echo "Error: No configuration file provided and no input piped from stdin." >&2
  show_help
  exit 1
fi

if [[ -z "$CONFIG_CONTENT" ]]; then
  echo "Error: Configuration input is empty." >&2
  exit 1
fi

echo "================================================================================"
echo "Axonwall Firewall Migration Importer"
echo "  Vendor Mode : ${VENDOR}"
echo "  Live Apply  : ${DO_APPLY}"
echo "================================================================================"

# Build JSON payload using jq if available or python
JSON_PAYLOAD=$(python3 -c "
import json, sys
data = {
    'config': sys.stdin.read(),
    'vendor': '$VENDOR',
    'apply': $( $DO_APPLY && echo "True" || echo "False" ),
    'confirmTimeoutSeconds': 120
}
print(json.dumps(data))
" <<< "$CONFIG_CONTENT")

echo "[+] Parsing and converting configuration..."
RESPONSE=$(curl -s -S -X POST "${API_HOST}/api/v1/import" \
  -H "Content-Type: application/json" \
  -d "$JSON_PAYLOAD")

STATUS=$(python3 -c "import json, sys; res = json.loads(sys.stdin.read()); print(res.get('status', 'error'))" <<< "$RESPONSE" 2>/dev/null || echo "error")

if [[ "$STATUS" != "ok" ]]; then
  ERR=$(python3 -c "import json, sys; res = json.loads(sys.stdin.read()); print(res.get('error', 'Unknown error'))" <<< "$RESPONSE" 2>/dev/null || echo "$RESPONSE")
  echo "[-] Import Failed: $ERR" >&2
  exit 1
fi

# Print translation report
python3 -c "
import json, sys
data = json.loads(sys.stdin.read())
rep = data.get('report', {})

print(f\"[✓] Detected / Specified Vendor : {rep.get('vendor', '').upper()}\")
print(f\"[✓] Source Format              : {rep.get('sourceFormat', 'Unknown')}\")
print(\"\n--- Extraction Metrics ---\")
print(f\"  • Interfaces        : {rep.get('interfacesCount', 0)}\")
print(f\"  • VLANs             : {rep.get('vlansCount', 0)}\")
print(f\"  • Aliases / Groups  : {rep.get('aliasesCount', 0)}\")
print(f\"  • Filter Rules      : {rep.get('rulesCount', 0)}\")
print(f\"  • NAT Rules         : {rep.get('natRulesCount', 0)}\")
print(f\"  • DHCP Pools        : {rep.get('dhcpSubnetsCount', 0)}\")
print(f\"  • DNS Overrides     : {rep.get('dnsOverridesCount', 0)}\")
print(f\"  • Static Routes     : {rep.get('routesCount', 0)}\")

warnings = rep.get('warnings', [])
if warnings:
    print(f\"\n[!] Vendor Warnings ({len(warnings)}):\")
    for w in warnings:
        print(f\"  * {w}\")

if data.get('applied'):
    print(\"\n[✓] Live Apply: Configuration APPLIED to system!\")
    print(\"    Watchdog safety rollback armed for 120s.\")
" <<< "$RESPONSE")

# Write out files if requested
if [[ -n "$OUT_JSON" ]]; then
  python3 -c "
import json, sys
data = json.loads(sys.stdin.read())
with open('$OUT_JSON', 'w') as f:
    json.dump(data.get('report', {}).get('state', {}), f, indent=2)
" <<< "$RESPONSE"
  echo "[+] DesiredState JSON saved to: $OUT_JSON"
fi

if [[ -n "$OUT_NFT" ]]; then
  python3 -c "
import json, sys
data = json.loads(sys.stdin.read())
with open('$OUT_NFT', 'w') as f:
    f.write(data.get('compiledNft', ''))
" <<< "$RESPONSE"
  echo "[+] Compiled Linux nftables ruleset saved to: $OUT_NFT"
fi

echo "================================================================================"
echo "Migration conversion complete."
