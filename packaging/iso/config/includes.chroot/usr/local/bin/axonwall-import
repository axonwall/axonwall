#!/bin/sh
# ==============================================================================
# Axonwall Multi-Vendor Firewall Importer CLI
# Supports pfSense, OPNsense, VyOS/EdgeOS, MikroTik RouterOS, Linux iptables
# Compatible with both Debian and Alpine Linux
# ==============================================================================
set -eu

CONFIG_FILE=""
VENDOR="auto"
DO_APPLY="false"
OUT_JSON=""
OUT_NFT=""
API_HOST="http://127.0.0.1:3000"
API_HOST_EXPLICIT="false"
API_TOKEN="${AXONWALL_API_TOKEN:-}"
API_COOKIE="${AXONWALL_COOKIE:-}"

show_help() {
  cat << EOF
Axonwall Firewall Migration Importer CLI

Usage:
  axonwall-import [options] [config_file]
  cat config.xml | axonwall-import [options]

Options:
  -f, --file PATH        Path to source configuration file (.xml, .boot, .rsc, .v4)
  -v, --vendor VENDOR    Target vendor (auto, pfsense, opnsense, vyos, mikrotik, iptables)
  -a, --apply            Apply converted configuration to live firewall (arms 120s rollback)
  --json PATH            Save converted Axonwall DesiredState JSON to file
  --nft PATH             Save compiled Linux nftables ruleset (.nft) to file
  --api-url URL          Axonwall API URL (default: http://127.0.0.1:3000)
  --token TOKEN          Bearer JWT / API token for authenticated /api/v1/import requests
  --cookie COOKIE        Session cookie (value or 'axonwall_session=...') for /api/v1/import
  -h, --help             Show this help message

Examples:
  axonwall-import -f /root/pfsense-backup.xml
  axonwall-import -f /root/vyos-config.boot --apply
  axonwall-import -f /root/mikrotik.rsc --json state.json --nft ruleset.nft
  cat /etc/iptables/rules.v4 | axonwall-import -v iptables --token "\$TOKEN"
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--file)
      CONFIG_FILE="$2"
      shift 2
      ;;
    -v|--vendor)
      VENDOR="$2"
      shift 2
      ;;
    -a|--apply)
      DO_APPLY="true"
      shift
      ;;
    --json)
      OUT_JSON="$2"
      shift 2
      ;;
    --nft)
      OUT_NFT="$2"
      shift 2
      ;;
    --api-url)
      API_HOST="$2"
      API_HOST_EXPLICIT="true"
      shift 2
      ;;
    --token)
      API_TOKEN="$2"
      shift 2
      ;;
    --cookie)
      API_COOKIE="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      if [ -z "$CONFIG_FILE" ] && [ -f "$1" ]; then
        CONFIG_FILE="$1"
        shift
      else
        echo "Unknown option: $1" >&2
        show_help
        exit 1
      fi
      ;;
  esac
done

# Read configuration content
CONFIG_CONTENT=""
if [ -n "$CONFIG_FILE" ]; then
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Configuration file not found: $CONFIG_FILE" >&2
    exit 1
  fi
  CONFIG_CONTENT="$(cat "$CONFIG_FILE")"
elif [ ! -t 0 ]; then
  CONFIG_CONTENT="$(cat)"
else
  echo "Error: No configuration file provided and no input piped from stdin." >&2
  show_help
  exit 1
fi

if [ -z "$CONFIG_CONTENT" ]; then
  echo "Error: Configuration input is empty." >&2
  exit 1
fi

echo "================================================================================"
echo "Axonwall Firewall Migration Importer"
echo "  Vendor Mode : ${VENDOR}"
echo "  Live Apply  : ${DO_APPLY}"
echo "================================================================================"

echo "[+] Parsing and converting configuration..."
RESPONSE=""
if [ -z "$API_TOKEN" ] && [ -z "$API_COOKIE" ] && [ "$API_HOST_EXPLICIT" = "false" ]; then
  # Local direct execution via @axonwall/lib (+ authenticated agent Unix socket / axonwallctl for --apply)
  # avoids an unauthenticated HTTP 401 against localhost /api/v1/import.
  RESPONSE="$(printf '%s' "$CONFIG_CONTENT" | node -e '
const fs = require("fs");
const path = require("path");
const http = require("http");

const isNonRoot = typeof process.getuid === "function" && process.getuid() !== 0;
const devLibOverride = isNonRoot
  ? (process.env.AXONWALL_DEV_LIB_DIR || process.env.AXONWALL_LIB_DIR || "").trim()
  : "";
const libCandidates = [
  ...(devLibOverride ? [path.resolve(devLibOverride)] : []),
  "/opt/axonwall/packages/axonwall_lib",
  "/opt/axonwall/node_modules/@axonwall/lib",
  "/opt/axonwall/apps/axonwall/node_modules/@axonwall/lib",
];

async function loadLib() {
  for (const base of libCandidates) {
    try {
      if (!path.isAbsolute(base) || !fs.existsSync(base)) continue;
      const imp = await import(path.join(base, "dist/import/index.js"));
      const nft = await import(path.join(base, "dist/compile/nft/index.js"));
      if (imp.importFirewallConfig && nft.compileNftables) return { imp, nft };
    } catch {}
  }
  const pnpmRoot = "/opt/axonwall/node_modules/.pnpm";
  if (fs.existsSync(pnpmRoot)) {
    for (const ent of fs.readdirSync(pnpmRoot)) {
      if (ent.startsWith("@axonwall+lib")) {
        const pkgDir = path.join(pnpmRoot, ent, "node_modules/@axonwall/lib");
        try {
          const imp = await import(path.join(pkgDir, "dist/import/index.js"));
          const nft = await import(path.join(pkgDir, "dist/compile/nft/index.js"));
          if (imp.importFirewallConfig && nft.compileNftables) return { imp, nft };
        } catch {}
      }
    }
  }
  return null;
}

function readAgentToken() {
  if (process.env.AXONWALL_AGENT_TOKEN && process.env.AXONWALL_AGENT_TOKEN.trim()) {
    return process.env.AXONWALL_AGENT_TOKEN.trim();
  }
  for (const p of [process.env.AXONWALL_AGENT_TOKEN_FILE, "/etc/axonwall/agent.token", "/var/lib/axonwall/agent.token"]) {
    if (!p) continue;
    try {
      const v = fs.readFileSync(p, "utf8").trim();
      if (v) return v;
    } catch {}
  }
  return "";
}

function applyViaAgentSocket(files, confirmTimeoutSeconds) {
  const sockPath = ["/run/axonwall/agent-api.sock", "/run/axonwall/agent.sock"].find((p) => fs.existsSync(p));
  if (!sockPath) {
    return Promise.reject(new Error("Agent Unix socket not found (/run/axonwall/agent-api.sock or /run/axonwall/agent.sock). Pass --token/--cookie to use the HTTP API instead."));
  }
  const token = readAgentToken();
  const payload = JSON.stringify({ files, confirmTimeoutSeconds });
  return new Promise((resolve, reject) => {
    const r = http.request({
      socketPath: sockPath,
      path: "/v1/apply",
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Content-Length": Buffer.byteLength(payload),
        ...(token ? { "X-Axonwall-Agent-Token": token } : {}),
      },
    }, (res) => {
      let body = "";
      res.on("data", (c) => body += c);
      res.on("end", () => {
        if (res.statusCode >= 200 && res.statusCode < 300) {
          try { resolve(JSON.parse(body)); } catch { resolve({ raw: body }); }
        } else {
          reject(new Error(`Agent /v1/apply HTTP ${res.statusCode}: ${body}`));
        }
      });
    });
    r.on("error", reject);
    r.write(payload);
    r.end();
  });
}

(async () => {
  const configText = fs.readFileSync(0, "utf8");
  const vendorArg = process.argv[1];
  const doApply = process.argv[2] === "true";
  const libs = await loadLib();
  if (!libs) {
    process.exit(42);
  }
  const vendor = vendorArg && vendorArg !== "auto" ? vendorArg : undefined;
  const report = libs.imp.importFirewallConfig(configText, vendor);
  const { nftScript } = libs.nft.compileNftables(report.state);
  let applyResult = null;
  if (doApply) {
    applyResult = await applyViaAgentSocket(
      [{ path: "/etc/nftables.conf", content: nftScript, fileMode: 0o600 }],
      120
    );
  }
  console.log(JSON.stringify({ status: "ok", report, compiledNft: nftScript, applied: doApply, applyResult }));
})().catch((err) => {
  console.log(JSON.stringify({ status: "error", error: err && err.message ? err.message : String(err) }));
  process.exit(1);
});
' "$VENDOR" "$DO_APPLY" 2>/dev/null || true)"
fi

if [ -z "$RESPONSE" ]; then
  TMP_IMP_SRC=""
  TMP_IMP_BODY=""
  cleanup_import_tmp() {
    rm -f "${TMP_IMP_SRC:-}" "${TMP_IMP_BODY:-}"
  }
  trap cleanup_import_tmp EXIT INT TERM

  if [ -z "$API_TOKEN" ] && [ -z "$API_COOKIE" ] && [ "$API_HOST_EXPLICIT" = "false" ] && [ -x /usr/local/bin/axonwallctl ]; then
    TMP_IMP_SRC="$(umask 077 && mktemp /tmp/axonwall-import-XXXXXX)"
    ( umask 077 && printf '%s' "$CONFIG_CONTENT" > "$TMP_IMP_SRC" && chmod 0600 "$TMP_IMP_SRC" )
    rc=0
    if [ "$VENDOR" != "auto" ]; then
      if [ "$DO_APPLY" = "true" ]; then
        /usr/local/bin/axonwallctl import "$TMP_IMP_SRC" --vendor "$VENDOR" --apply || rc=$?
      else
        /usr/local/bin/axonwallctl import "$TMP_IMP_SRC" --vendor "$VENDOR" || rc=$?
      fi
    else
      if [ "$DO_APPLY" = "true" ]; then
        /usr/local/bin/axonwallctl import "$TMP_IMP_SRC" --apply || rc=$?
      else
        /usr/local/bin/axonwallctl import "$TMP_IMP_SRC" || rc=$?
      fi
    fi
    exit "$rc"
  fi

  TMP_IMP_BODY="$(umask 077 && mktemp /tmp/axonwall-import-XXXXXX)"
  chmod 0600 "$TMP_IMP_BODY"
  printf '%s' "$CONFIG_CONTENT" | node -e '
const fs = require("fs");
const config = fs.readFileSync(0, "utf8");
console.log(JSON.stringify({
  config,
  vendor: process.argv[1],
  apply: process.argv[2] === "true",
  confirmTimeoutSeconds: 120,
}));
' "$VENDOR" "$DO_APPLY" > "$TMP_IMP_BODY"

  CURL_CFG="$(AXONWALL_CURL_TOKEN="$API_TOKEN" AXONWALL_CURL_COOKIE="$API_COOKIE" node -e '
const esc = (s) => {
  if (/[\r\n\0]/.test(s)) {
    console.error("Error: Auth token/cookie contains invalid control characters.");
    process.exit(2);
  }
  return s.replace(/\\/g, "\\\\").replace(/"/g, "\\\"");
};
const lines = ["header = \"Content-Type: application/json\""];
const tok = process.env.AXONWALL_CURL_TOKEN || "";
if (tok) {
  lines.push(`header = "Authorization: Bearer ${esc(tok)}"`);
}
const cki = process.env.AXONWALL_CURL_COOKIE || "";
if (cki) {
  const cookieVal = cki.includes("=") ? cki : `axonwall_session=${cki}`;
  lines.push(`header = "Cookie: ${esc(cookieVal)}"`);
}
process.stdout.write(lines.join("\n") + "\n");
')"
  RESPONSE="$(printf '%s' "$CURL_CFG" | curl -s -S -X POST --config - --data-binary "@${TMP_IMP_BODY}" -- "${API_HOST}/api/v1/import")"
  CURL_CFG=""
fi

printf '%s' "$RESPONSE" | node -e '
const fs = require("fs");
let data;
try {
  data = JSON.parse(fs.readFileSync(0, "utf8"));
} catch (e) {
  console.error("[-] Import Failed: Invalid response from server");
  process.exit(1);
}
if (data.status !== "ok") {
  console.error("[-] Import Failed:", data.error || "Unknown error");
  process.exit(1);
}
const rep = data.report || {};
console.log(`[✓] Detected / Specified Vendor : ${String(rep.vendor || "").toUpperCase()}`);
console.log(`[✓] Source Format              : ${rep.sourceFormat || "Unknown"}`);
console.log("\n--- Extraction Metrics ---");
console.log(`  • Interfaces        : ${rep.interfacesCount || 0}`);
console.log(`  • VLANs             : ${rep.vlansCount || 0}`);
console.log(`  • Aliases / Groups  : ${rep.aliasesCount || 0}`);
console.log(`  • Filter Rules      : ${rep.rulesCount || 0}`);
console.log(`  • NAT Rules         : ${rep.natRulesCount || 0}`);
console.log(`  • DHCP Pools        : ${rep.dhcpSubnetsCount || 0}`);
console.log(`  • DNS Overrides     : ${rep.dnsOverridesCount || 0}`);
console.log(`  • Static Routes     : ${rep.routesCount || 0}`);
if (Array.isArray(rep.warnings) && rep.warnings.length > 0) {
  console.log(`\n[!] Vendor Warnings (${rep.warnings.length}):`);
  for (const w of rep.warnings) {
    console.log(`  * ${w}`);
  }
}
if (data.applied) {
  console.log("\n[✓] Live Apply: Configuration APPLIED to system!");
  console.log("    Watchdog safety rollback armed for 120s.");
}
const outJson = process.argv[1];
const outNft = process.argv[2];
if (outJson) {
  fs.writeFileSync(outJson, JSON.stringify((rep && rep.state) || {}, null, 2));
  console.log(`[+] DesiredState JSON saved to: ${outJson}`);
}
if (outNft) {
  fs.writeFileSync(outNft, data.compiledNft || "");
  console.log(`[+] Compiled Linux nftables ruleset saved to: ${outNft}`);
}
' "$OUT_JSON" "$OUT_NFT"

echo "================================================================================"
echo "Migration conversion complete."
