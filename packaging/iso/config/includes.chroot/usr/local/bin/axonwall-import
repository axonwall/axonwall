#!/bin/sh
# ==============================================================================
# Axonwall Multi-Vendor Firewall Importer CLI
# Supports pfSense, OPNsense, VyOS/EdgeOS, MikroTik RouterOS, Linux iptables
# Compatible with both Debian and Alpine Linux
# ==============================================================================
set -eu

CONFIG_FILE=""
VENDOR="auto"
DO_APPLY="false"
OUT_JSON=""
OUT_NFT=""
API_HOST="http://127.0.0.1:3000"

show_help() {
  cat << EOF
Axonwall Firewall Migration Importer CLI

Usage:
  axonwall-import [options] [config_file]
  cat config.xml | axonwall-import [options]

Options:
  -f, --file PATH        Path to source configuration file (.xml, .boot, .rsc, .v4)
  -v, --vendor VENDOR    Target vendor (auto, pfsense, opnsense, vyos, mikrotik, iptables)
  -a, --apply            Apply converted configuration to live firewall (arms 120s rollback)
  --json PATH            Save converted Axonwall DesiredState JSON to file
  --nft PATH             Save compiled Linux nftables ruleset (.nft) to file
  --api-url URL          Axonwall API URL (default: http://127.0.0.1:3000)
  -h, --help             Show this help message

Examples:
  axonwall-import -f /root/pfsense-backup.xml
  axonwall-import -f /root/vyos-config.boot --apply
  axonwall-import -f /root/mikrotik.rsc --json state.json --nft ruleset.nft
  cat /etc/iptables/rules.v4 | axonwall-import -v iptables
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--file)
      CONFIG_FILE="$2"
      shift 2
      ;;
    -v|--vendor)
      VENDOR="$2"
      shift 2
      ;;
    -a|--apply)
      DO_APPLY="true"
      shift
      ;;
    --json)
      OUT_JSON="$2"
      shift 2
      ;;
    --nft)
      OUT_NFT="$2"
      shift 2
      ;;
    --api-url)
      API_HOST="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      if [ -z "$CONFIG_FILE" ] && [ -f "$1" ]; then
        CONFIG_FILE="$1"
        shift
      else
        echo "Unknown option: $1" >&2
        show_help
        exit 1
      fi
      ;;
  esac
done

# Read configuration content
CONFIG_CONTENT=""
if [ -n "$CONFIG_FILE" ]; then
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Configuration file not found: $CONFIG_FILE" >&2
    exit 1
  fi
  CONFIG_CONTENT="$(cat "$CONFIG_FILE")"
elif [ ! -t 0 ]; then
  CONFIG_CONTENT="$(cat)"
else
  echo "Error: No configuration file provided and no input piped from stdin." >&2
  show_help
  exit 1
fi

if [ -z "$CONFIG_CONTENT" ]; then
  echo "Error: Configuration input is empty." >&2
  exit 1
fi

echo "================================================================================"
echo "Axonwall Firewall Migration Importer"
echo "  Vendor Mode : ${VENDOR}"
echo "  Live Apply  : ${DO_APPLY}"
echo "================================================================================"

JSON_PAYLOAD="$(printf '%s' "$CONFIG_CONTENT" | node -e '
const fs = require("fs");
const config = fs.readFileSync(0, "utf8");
console.log(JSON.stringify({
  config,
  vendor: process.argv[1],
  apply: process.argv[2] === "true",
  confirmTimeoutSeconds: 120,
}));
' "$VENDOR" "$DO_APPLY")"

echo "[+] Parsing and converting configuration..."
RESPONSE="$(printf '%s' "$JSON_PAYLOAD" | curl -s -S -X POST "${API_HOST}/api/v1/import" \
  -H "Content-Type: application/json" \
  --data-binary @-)"

printf '%s' "$RESPONSE" | node -e '
const fs = require("fs");
let data;
try {
  data = JSON.parse(fs.readFileSync(0, "utf8"));
} catch (e) {
  console.error("[-] Import Failed: Invalid response from server");
  process.exit(1);
}
if (data.status !== "ok") {
  console.error("[-] Import Failed:", data.error || "Unknown error");
  process.exit(1);
}
const rep = data.report || {};
console.log(`[✓] Detected / Specified Vendor : ${String(rep.vendor || "").toUpperCase()}`);
console.log(`[✓] Source Format              : ${rep.sourceFormat || "Unknown"}`);
console.log("\n--- Extraction Metrics ---");
console.log(`  • Interfaces        : ${rep.interfacesCount || 0}`);
console.log(`  • VLANs             : ${rep.vlansCount || 0}`);
console.log(`  • Aliases / Groups  : ${rep.aliasesCount || 0}`);
console.log(`  • Filter Rules      : ${rep.rulesCount || 0}`);
console.log(`  • NAT Rules         : ${rep.natRulesCount || 0}`);
console.log(`  • DHCP Pools        : ${rep.dhcpSubnetsCount || 0}`);
console.log(`  • DNS Overrides     : ${rep.dnsOverridesCount || 0}`);
console.log(`  • Static Routes     : ${rep.routesCount || 0}`);
if (Array.isArray(rep.warnings) && rep.warnings.length > 0) {
  console.log(`\n[!] Vendor Warnings (${rep.warnings.length}):`);
  for (const w of rep.warnings) {
    console.log(`  * ${w}`);
  }
}
if (data.applied) {
  console.log("\n[✓] Live Apply: Configuration APPLIED to system!");
  console.log("    Watchdog safety rollback armed for 120s.");
}
const outJson = process.argv[1];
const outNft = process.argv[2];
if (outJson) {
  fs.writeFileSync(outJson, JSON.stringify((rep && rep.state) || {}, null, 2));
  console.log(`[+] DesiredState JSON saved to: ${outJson}`);
}
if (outNft) {
  fs.writeFileSync(outNft, data.compiledNft || "");
  console.log(`[+] Compiled Linux nftables ruleset saved to: ${outNft}`);
}
' "$OUT_JSON" "$OUT_NFT"

echo "================================================================================"
echo "Migration conversion complete."
