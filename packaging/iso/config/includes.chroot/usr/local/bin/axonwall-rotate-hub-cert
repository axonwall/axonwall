#!/bin/sh
# axonwall-rotate-hub-cert -- provision and rotate the appliance hub TLS
# certificate (audit B-14, Shape 1: on-box appliance CA + short-lived leaf).
#
# Trust states in $CERT_DIR (default /etc/axonwall/certs):
#   1. Appliance CA: ca.crt + ca.key both on-box (generated by --ensure).
#      hub.crt is an 825-day leaf signed by that CA. Rotation and the
#      renewal timer re-issue the leaf from the CA; the CA itself is
#      stable for 10 years, so anything provisioned with ca.crt (the
#      satellite pins it as its root pool; the controller uses it to
#      request client certificates) is unaffected by leaf rotation.
#      The CA key is root-only (0600) -- the network-facing controller
#      never holds it; leaf issuance happens here, as root.
#   2. Operator CA: ca.crt present, ca.key absent (fleet PKI from
#      scripts/generate-mtls-certs.sh, key held off-box). The hub cert
#      is the operator's to issue: this tool REFUSES to replace it with
#      a self-signed one, which would silently break every satellite
#      verifying the hub against that CA.
#   3. Legacy self-signed: no ca.crt at all. The pre-B-14 state. Manual
#      rotation regenerates a self-signed pair as before; --ensure
#      migrates the install to state 1 (the old pair is backed up).
#
# This file is shipped identically in packaging/debian/,
# packaging/alpine/overlay/usr/local/bin/, and the Debian ISO includes
# tree; keep the copies in sync.
#
# Usage:
#   axonwall-rotate-hub-cert [--days N]   rotate/re-issue + restart controller
#   axonwall-rotate-hub-cert --check      print expiry; exit 1 when the
#                                         cert expires within 90 days or
#                                         is already expired (monitoring)
#   axonwall-rotate-hub-cert --ensure     provision CA + leaf if needed
#                                         (firstboot/postinst; idempotent,
#                                         never restarts services)
#   axonwall-rotate-hub-cert --if-needed  renew the leaf only when this is
#                                         an appliance-CA install and the
#                                         leaf expires within 90 days
#                                         (renewal timer; no-op otherwise)
set -u

CERT_DIR="${AXONWALL_CERT_DIR:-/etc/axonwall/certs}"
CRT="$CERT_DIR/hub.crt"
KEY="$CERT_DIR/hub.key"
CA_CRT="$CERT_DIR/ca.crt"
CA_KEY="$CERT_DIR/ca.key"
CA_SRL="$CERT_DIR/ca.srl"
DAYS=""
CHECK=0
MODE="rotate"

while [ $# -gt 0 ]; do
    case "$1" in
        --days) DAYS="$2"; shift 2 ;;
        --check) CHECK=1; shift ;;
        --ensure) MODE="ensure"; shift ;;
        --if-needed) MODE="ifneeded"; shift ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

command -v openssl >/dev/null 2>&1 || { echo "openssl not found" >&2; exit 2; }

san_profile() {
    _hn="$(hostname 2>/dev/null || echo axonwall)"
    _san="DNS:${_hn},DNS:axonwall.local,DNS:localhost,IP:127.0.0.1"
    _ips="$(hostname -I 2>/dev/null || true)"
    if [ -n "$_ips" ]; then
        for _ip in $_ips; do _san="${_san},IP:${_ip}"; done
    else
        _san="${_san},IP:192.168.1.1"
    fi
    echo "$_san"
}

subj_name() { hostname 2>/dev/null || echo axonwall; }

fix_hub_ownership() {
    if getent passwd axonwall-controller >/dev/null 2>&1; then
        chown axonwall-controller:axonwall-controller "$KEY" "$CRT" 2>/dev/null || true
    fi
    chmod 0600 "$KEY"
    chmod 0644 "$CRT"
}

backup_pair() {
    _stamp="$(date +%Y%m%d%H%M%S)"
    if [ -f "$KEY" ]; then cp -a "$KEY" "$KEY.bak-$_stamp" && chmod 0600 "$KEY.bak-$_stamp"; fi
    if [ -f "$CRT" ]; then cp -a "$CRT" "$CRT.bak-$_stamp"; fi
}

pair_matches() {
    # $1=cert $2=key: true when the cert's public key equals the key's.
    [ -s "$1" ] && [ -s "$2" ] || return 1
    _c="$(openssl x509 -in "$1" -pubkey -noout 2>/dev/null)"
    _k="$(openssl pkey -in "$2" -pubout 2>/dev/null)"
    [ -n "$_c" ] && [ "$_c" = "$_k" ]
}

is_selfsigned() {
    _subj="$(openssl x509 -in "$1" -noout -subject 2>/dev/null)"
    _iss="$(openssl x509 -in "$1" -noout -issuer 2>/dev/null)"
    [ -n "$_subj" ] && [ "${_subj#subject}" = "${_iss#issuer}" ]
}

ensure_ca() {
    # Generate the appliance CA when no ca.crt exists. Never overwrites.
    [ -s "$CA_CRT" ] && return 0
    _tmpd="$(mktemp -d)"
    openssl req -x509 -newkey rsa:4096 -nodes \
        -keyout "$_tmpd/ca.key" -out "$_tmpd/ca.crt" \
        -days 3650 -sha256 \
        -subj "/O=Axonwall/OU=Appliance/CN=Axonwall Appliance CA" \
        -addext "basicConstraints=critical,CA:TRUE" \
        -addext "keyUsage=critical,keyCertSign,cRLSign" \
        -addext "subjectKeyIdentifier=hash" >/dev/null 2>&1
    if ! pair_matches "$_tmpd/ca.crt" "$_tmpd/ca.key" \
        || ! openssl verify -CAfile "$_tmpd/ca.crt" "$_tmpd/ca.crt" >/dev/null 2>&1; then
        rm -rf "$_tmpd"
        echo "appliance CA generation failed" >&2
        return 1
    fi
    mv "$_tmpd/ca.key" "$CA_KEY"
    mv "$_tmpd/ca.crt" "$CA_CRT"
    rm -rf "$_tmpd"
    chown root:root "$CA_KEY" "$CA_CRT" 2>/dev/null || true
    chmod 0600 "$CA_KEY"
    chmod 0644 "$CA_CRT"
    echo "generated appliance CA: $CA_CRT (10 years; key root-only at $CA_KEY)"
}

issue_leaf() {
    # Issue hub.crt/hub.key from the on-box CA. $1 = validity days.
    _tmpd="$(mktemp -d)"
    cat > "$_tmpd/leaf.ext" <<EOF
basicConstraints=CA:FALSE
keyUsage=digitalSignature,nonRepudiation,keyEncipherment,dataEncipherment
extendedKeyUsage=serverAuth,clientAuth
authorityKeyIdentifier=keyid,issuer
subjectKeyIdentifier=hash
subjectAltName=$(san_profile)
EOF
    openssl req -new -newkey rsa:2048 -nodes \
        -keyout "$_tmpd/hub.key" -out "$_tmpd/hub.csr" \
        -subj "/O=Axonwall/OU=Appliance/CN=$(subj_name)" >/dev/null 2>&1
    openssl x509 -req -in "$_tmpd/hub.csr" \
        -CA "$CA_CRT" -CAkey "$CA_KEY" -CAserial "$CA_SRL" -CAcreateserial \
        -out "$_tmpd/hub.crt" -days "$1" -sha256 \
        -extfile "$_tmpd/leaf.ext" >/dev/null 2>&1
    if ! pair_matches "$_tmpd/hub.crt" "$_tmpd/hub.key" \
        || ! openssl verify -CAfile "$CA_CRT" "$_tmpd/hub.crt" >/dev/null 2>&1; then
        rm -rf "$_tmpd"
        echo "hub leaf issuance failed (existing pair left untouched)" >&2
        return 1
    fi
    backup_pair
    mv "$_tmpd/hub.key" "$KEY"
    mv "$_tmpd/hub.crt" "$CRT"
    rm -rf "$_tmpd"
    touch "$CA_SRL" && chown root:root "$CA_SRL" 2>/dev/null || true
    chmod 0600 "$CA_SRL" 2>/dev/null || true
    fix_hub_ownership
    echo "new hub certificate (CA-issued, $1 days) expires: $(openssl x509 -in "$CRT" -noout -enddate | cut -d= -f2-)"
}

issue_selfsigned() {
    # Legacy path (no CA): regenerate a self-signed pair. $1 = days.
    _tmpd="$(mktemp -d)"
    openssl req -x509 -newkey rsa:2048 -nodes \
        -keyout "$_tmpd/hub.key" -out "$_tmpd/hub.crt" \
        -days "$1" -subj "/O=Axonwall/OU=Appliance/CN=$(subj_name)" \
        -addext "subjectAltName=$(san_profile)" >/dev/null 2>&1
    if ! pair_matches "$_tmpd/hub.crt" "$_tmpd/hub.key"; then
        rm -rf "$_tmpd"
        echo "openssl certificate generation failed" >&2
        return 1
    fi
    backup_pair
    mv "$_tmpd/hub.key" "$KEY"
    mv "$_tmpd/hub.crt" "$CRT"
    rm -rf "$_tmpd"
    fix_hub_ownership
    echo "new hub certificate (self-signed, $1 days) expires: $(openssl x509 -in "$CRT" -noout -enddate | cut -d= -f2-)"
}

restart_controller() {
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        systemctl restart axonwall-controller 2>/dev/null \
            || echo "note: restart axonwall-controller manually"
    elif command -v rc-service >/dev/null 2>&1; then
        rc-service axonwall-controller restart 2>/dev/null \
            || echo "note: restart axonwall-controller manually"
    else
        echo "note: restart the axonwall-controller service to pick up the new certificate"
    fi
}

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "must run as root" >&2
        exit 2
    fi
}

mkdir -p "$CERT_DIR"

case "$MODE" in
ensure)
    require_root
    if [ -s "$CA_CRT" ]; then
        # A CA is already established (appliance or operator): never
        # regenerate it. Only fill in a missing hub leaf, and only when
        # the CA key is on-box to issue from.
        if [ -s "$CRT" ] && [ -s "$KEY" ]; then
            exit 0
        fi
        if [ -s "$CA_KEY" ]; then
            issue_leaf "${DAYS:-825}" || exit 2
        else
            echo "note: $CA_CRT present without its key (operator CA) and no hub certificate installed; install the operator-issued hub.crt/hub.key into $CERT_DIR" >&2
        fi
        exit 0
    fi
    if [ -s "$CRT" ] && ! is_selfsigned "$CRT"; then
        echo "note: hub certificate was issued by an external CA and no ca.crt is installed; leaving the PKI untouched" >&2
        exit 0
    fi
    # Fresh install, or migration of a legacy self-signed install.
    ensure_ca || exit 2
    issue_leaf "${DAYS:-825}" || exit 2
    exit 0
    ;;
ifneeded)
    require_root
    # Renewal is defined only for appliance-CA installs whose leaf
    # chains to the on-box CA. Every other state is a no-op here;
    # --check remains the alerting path for those.
    [ -s "$CA_CRT" ] && [ -s "$CA_KEY" ] && [ -s "$CRT" ] || exit 0
    openssl verify -CAfile "$CA_CRT" "$CRT" >/dev/null 2>&1 || exit 0
    if openssl x509 -in "$CRT" -noout -checkend 7776000 >/dev/null 2>&1; then
        exit 0
    fi
    echo "hub certificate expires within 90 days; renewing from the appliance CA"
    issue_leaf "${DAYS:-825}" || exit 2
    restart_controller
    exit 0
    ;;
esac

# rotate / --check
if [ ! -s "$CRT" ]; then
    echo "no hub certificate at $CRT" >&2
    exit 2
fi

enddate="$(openssl x509 -in "$CRT" -noout -enddate 2>/dev/null | cut -d= -f2-)"
echo "current hub certificate expires: ${enddate:-unknown}"

if [ "$CHECK" -eq 1 ]; then
    if openssl x509 -in "$CRT" -noout -checkend 0 >/dev/null 2>&1 \
        && openssl x509 -in "$CRT" -noout -checkend 7776000 >/dev/null 2>&1; then
        echo "OK: more than 90 days remaining"
        exit 0
    fi
    echo "WARNING: hub certificate expires within 90 days (or is expired) -- run axonwall-rotate-hub-cert" >&2
    exit 1
fi

require_root

if [ -s "$CA_CRT" ] && [ ! -s "$CA_KEY" ]; then
    echo "refusing to rotate: $CA_CRT is an operator CA whose key is held off-box." >&2
    echo "The hub certificate must be re-issued from that CA (scripts/generate-mtls-certs.sh);" >&2
    echo "replacing it with a self-signed certificate would break every satellite" >&2
    echo "verifying the hub against the operator CA." >&2
    exit 2
fi

if [ -s "$CA_CRT" ] && [ -s "$CA_KEY" ]; then
    issue_leaf "${DAYS:-825}" || exit 2
    restart_controller
    echo "Done. The leaf chains to the same appliance CA, so satellites provisioned with ca.crt and the controller's client-certificate checks are unaffected."
else
    issue_selfsigned "${DAYS:-3650}" || exit 2
    restart_controller
    echo "Done. No CA is installed on this appliance; consumers of the self-signed cert itself (browsers, system-root verifiers) must re-trust the new one. Run with --ensure to migrate to an appliance CA."
fi
