#!/usr/bin/env bash
# ==============================================================================
# Axonwall Restricted Operator Shell (/usr/local/bin/axonwall-opshell)
# Assigned to users in the 'axonwall-operator' POSIX/LDAP group.
# Prevents arbitrary root/bash escapes while providing structured appliance
# diagnostics, log inspection, and interactive Ink TUI / NastyMap access.
# ==============================================================================
set -uo pipefail

# Trap signals to prevent breaking out of the menu into a subshell
trap '' SIGINT SIGQUIT SIGTSTP

# Reject environment variables that could hijack execution inside child tools
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LESSSECURE=1
export PAGER="cat"

# Auto-detect primary active interface for intelligent CLI utility defaults
DEFAULT_IF="$(/sbin/ip route show default 2>/dev/null | awk '{print $5; exit}')"
if [[ -z "${DEFAULT_IF}" ]]; then
  DEFAULT_IF="$(/sbin/ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -vx 'lo' | head -n 1)"
fi
DEFAULT_IF="${DEFAULT_IF:-eth0}"

# Handle non-interactive SSH command execution: ssh user@host "<command>"
if [[ "${1:-}" == "-c" ]]; then
  CMD="${2:-}"
  case "$CMD" in
    "axonwall-tui")
      exec /usr/local/bin/axonwall-tui
      ;;
    "axonwall-tui --tab nastymap"|"nastymap")
      exec /usr/local/bin/axonwall-tui --tab nastymap
      ;;
    "axonwallctl status"|"axonwallctl diff"|"axonwallctl validate")
      exec /usr/local/bin/$CMD
      ;;
    "ip addr"|"ip a"|"ip -br addr")
      exec /sbin/ip addr show
      ;;
    "ip route"|"ip r")
      exec /sbin/ip route show
      ;;
    "uptime")
      exec /usr/bin/uptime
      ;;
    *)
      echo "axonwall-opshell: command rejected by operator policy: ${CMD}" >&2
      echo "Allowed non-interactive commands: 'axonwall-tui', 'nastymap', 'axonwallctl status', 'axonwallctl diff', 'axonwallctl validate', 'ip addr', 'ip route', 'uptime'" >&2
      exit 126
      ;;
  esac
fi

while true; do
  echo ""
  echo "================================================================================"
  echo "  Axonwall Operator Shell — User: $(whoami)@$(hostname) | Default NIC: ${DEFAULT_IF}"
  echo "  Role: axonwall-operator (Interactive TUI, NastyMap & Operations Environment)"
  echo "================================================================================"
  echo "  [1] Launch Axonwall Interactive TUI [Read-Only Operator] (axonwall-tui --readonly)"
  echo "  [2] Launch NastyMap Network Topology Viewer [Read-Only] (axonwall-tui --readonly --tab nastymap)"
  echo "  [3] Configuration Status / Diff / Validate (axonwallctl)"
  echo "  [4] Network Interfaces, Routing & Sockets (ip addr / ip route / netstat)"
  echo "  [5] Live Interface Bandwidth Monitor (slurm -z -i ${DEFAULT_IF})"
  echo "  [6] System CPU & Disk I/O Telemetry (mpstat / iostat)"
  echo "  [7] Ping & DNS Resolution Diagnostics (ping / dig)"
  echo "  [8] Tail Appliance Service Logs & HA Status (journalctl / chronyc)"
  echo "  [0] Exit SSH Session"
  echo "--------------------------------------------------------------------------------"
  printf "Select option [0-8]: "
  if ! IFS= read -r choice; then
    echo ""
    exit 0
  fi

  case "${choice}" in
    1|tui|TUI)
      if [[ -x /usr/local/bin/axonwall-tui ]]; then
        sudo /usr/local/bin/axonwall-tui --readonly 2>/dev/null || /usr/local/bin/axonwall-tui --readonly
      else
        echo "axonwall-tui not found."
      fi
      ;;
    2|nmap|nastymap)
      if [[ -x /usr/local/bin/axonwall-tui ]]; then
        sudo /usr/local/bin/axonwall-tui --readonly --tab nastymap 2>/dev/null || /usr/local/bin/axonwall-tui --readonly --tab nastymap
      else
        echo "axonwall-tui not found."
      fi
      ;;
    3)
      echo "--- Configuration Status ---"
      sudo /usr/local/bin/axonwallctl status 2>/dev/null || /usr/local/bin/axonwallctl status
      echo ""
      echo "--- Configuration Validation ---"
      sudo /usr/local/bin/axonwallctl validate 2>/dev/null || /usr/local/bin/axonwallctl validate
      echo ""
      echo "--- Pending Configuration Diff ---"
      sudo /usr/local/bin/axonwallctl diff 2>/dev/null || /usr/local/bin/axonwallctl diff
      ;;
    4)
      echo "--- Network Interfaces ---"
      /sbin/ip -br addr show
      echo ""
      echo "--- Routing Table ---"
      /sbin/ip route show
      echo ""
      echo "--- Listening Sockets (net-tools) ---"
      /bin/netstat -tuln 2>/dev/null || /bin/ss -tuln 2>/dev/null || true
      ;;
    5)
      if command -v slurm >/dev/null 2>&1; then
        /usr/bin/slurm -z -i "${DEFAULT_IF}" || true
      else
        /sbin/ip -s link show dev "${DEFAULT_IF}" || true
      fi
      ;;
    6)
      echo "--- CPU Utilization (sysstat mpstat) ---"
      /usr/bin/mpstat -P ALL 1 1 2>/dev/null || /usr/bin/uptime
      echo ""
      echo "--- Block Device I/O (sysstat iostat) ---"
      /usr/bin/iostat -xz 1 1 2>/dev/null || true
      ;;
    7)
      printf "Enter target IP or hostname to ping & resolve [default: 1.1.1.1]: "
      if IFS= read -r target; then
        target="${target:-1.1.1.1}"
        if [[ "$target" =~ ^[a-zA-Z0-9.:-]+$ ]] && [[ ! "$target" =~ ^- ]]; then
          echo "--- DNS Lookup (dig) ---"
          /usr/bin/dig +short "$target" 2>/dev/null || true
          echo "--- ICMP Ping ---"
          /bin/ping -c 4 -W 2 "$target" || true
        else
          echo "Invalid target format."
        fi
      fi
      ;;
    8)
      echo "--- System Services ---"
      /bin/systemctl is-active axonwalld slapd sssd keepalived chrony 2>/dev/null || true
      echo "--- Time Synchronization (chronyc tracking) ---"
      /usr/bin/chronyc tracking 2>/dev/null || true
      echo "--- Recent Service Logs ---"
      sudo /bin/journalctl -u axonwalld -u slapd -u sssd -n 50 --no-pager 2>/dev/null || \
        /bin/journalctl -u axonwalld -u slapd -u sssd -n 50 --no-pager || true
      ;;
    0|q|Q|exit|logout)
      echo "Logging out..."
      exit 0
      ;;
    *)
      echo "Invalid selection."
      ;;
  esac
done
