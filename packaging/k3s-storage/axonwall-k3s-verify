#!/bin/sh
# axonwall-k3s-verify -- post-firstboot readiness check for K3s Storage Host.
#
# Ordered AFTER `k3s.service` and `k3s-agent.service` and gated by
# `/etc/axonwall/.k3s-firstboot`. Polls up to 60s for the K3s control plane
# (`k3s kubectl get nodes`) or worker agent (service active AND this node
# registered with the cluster), logs health, and clears
# `/etc/axonwall/.k3s-firstboot`.
set -u

MARKER="/etc/axonwall/.k3s-firstboot"
AGENT_FLAG="/etc/rancher/k3s/agent-mode"
KUBELET_KUBECONFIG="/var/lib/rancher/k3s/agent/kubelet.kubeconfig"
# k3s lives in the core-k3s plugin dir now. Fall back to PATH (a
# pre-migration /usr/local/bin install) when the plugin binary is
# not staged, so this check still works on boxes upgraded before
# the plugin tree was ensured.
K3S_BIN="/var/lib/axonwall/core-k3s/bin/k3s"
if [ ! -x "$K3S_BIN" ]; then
    K3S_BIN="$(command -v k3s 2>/dev/null || echo /var/lib/axonwall/core-k3s/bin/k3s)"
fi

log() { echo "[axonwall-k3s-verify] $*"; }

# D-M4: membership proof for the agent branch. Liveness alone is not a
# join proof — with `Restart=always`, a misconfigured agent (wrong or
# unreachable server URL) retries internally and stays "active" forever
# without ever joining. The kubelet kubeconfig (system:node credentials)
# can read exactly this node's own Node object, and the API server only
# returns it once the kubelet has registered — so a successful lookup
# proves the agent joined the cluster.
agent_node_joined() {
    _node="$(hostname 2>/dev/null || echo "")"
    [ -n "$_node" ] || return 1
    [ -x "$K3S_BIN" ] || return 1
    [ -s "$KUBELET_KUBECONFIG" ] || return 1
    "$K3S_BIN" kubectl --kubeconfig="$KUBELET_KUBECONFIG" get node "$_node" >/dev/null 2>&1
}

if [ -f "$AGENT_FLAG" ]; then
    log "verifying k3s-agent service liveness and cluster membership (timeout: 60s)..."
    _elapsed=0
    while [ "$_elapsed" -lt 60 ]; do
        _agent_live=0
        if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet k3s-agent; then
            _pid1="$(systemctl show -p MainPID --value k3s-agent 2>/dev/null || echo 0)"
            sleep 3
            _elapsed=$(( _elapsed + 3 ))
            _pid2="$(systemctl show -p MainPID --value k3s-agent 2>/dev/null || echo 0)"
            if systemctl is-active --quiet k3s-agent && [ -n "$_pid1" ] && [ "$_pid1" != "0" ] && [ "$_pid1" = "$_pid2" ]; then
                if command -v curl >/dev/null 2>&1; then
                    if curl -fsS --max-time 2 http://127.0.0.1:10248/healthz >/dev/null 2>&1; then
                        _agent_live=1
                        _live_msg="k3s-agent is active, stable (PID=$_pid2), and kubelet /healthz is ready"
                    fi
                else
                    _agent_live=1
                    _live_msg="k3s-agent is active and stable (PID=$_pid2)"
                fi
            fi
        elif command -v rc-service >/dev/null 2>&1 && rc-service k3s-agent status >/dev/null 2>&1; then
            sleep 3
            _elapsed=$(( _elapsed + 3 ))
            if rc-service k3s-agent status >/dev/null 2>&1; then
                _agent_live=1
                _live_msg="k3s-agent (OpenRC) is active and sustained"
            fi
        fi
        # D-M4 + main: liveness is main's PID-stability / kubelet healthz
        # (systemd) or sustained-status (OpenRC) check; the marker clears
        # only once the node is ALSO proven registered with the cluster
        # (agent_node_joined above). Liveness alone is not a join proof.
        if [ "$_agent_live" -eq 1 ]; then
            if [ "${_logged_live:-0}" -eq 0 ]; then
                log "$_live_msg"
                _logged_live=1
            fi
            if agent_node_joined; then
                _node="$(hostname 2>/dev/null || echo "?")"
                log "node '${_node}' is registered with the cluster"
                # Ready status is informative, not gating: a registered node
                # can legitimately be NotReady while the CNI comes up.
                _ready="unknown"
                if [ -n "$_node" ] && [ "$_node" != "?" ]; then
                    _ready="$("$K3S_BIN" kubectl --kubeconfig="$KUBELET_KUBECONFIG" get node "$_node" -o 'jsonpath={.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo unknown)"
                fi
                log "node Ready status: ${_ready:-unknown}"
                rm -f "$MARKER"
                exit 0
            fi
        fi
        sleep 2
        _elapsed=$(( _elapsed + 2 ))
    done
    log "ERROR: k3s-agent did not join the cluster within 60s (retaining $MARKER for retry)"
    exit 1
fi

log "verifying k3s server API readiness (timeout: 60s)..."
_elapsed=0
while [ "$_elapsed" -lt 60 ]; do
    if "$K3S_BIN" kubectl get nodes >/dev/null 2>&1; then
        log "K3s API server is responsive:"
        "$K3S_BIN" kubectl get nodes -o wide 2>/dev/null || true
        rm -f "$MARKER"
        exit 0
    fi
    sleep 2
    _elapsed=$(( _elapsed + 2 ))
done

log "ERROR: K3s API server did not become ready within 60s (retaining $MARKER for retry)"
exit 1
