#!/bin/sh
# axonwall-k3s-firstboot -- first-boot provisioning for the Barebones K3s + OpenZFS
# + OpenEBS Storage Host Edition (`k3s-storage`).
#
# Runs once, gated by `/etc/axonwall/.k3s-firstboot` and ordered BEFORE
# `k3s.service` and `k3s-agent.service`. `axonwall-k3s-verify.service` removes
# the marker once K3s or K3s-agent passes readiness checks, so an interrupted
# firstboot safely retries on the next boot.
#
# CRITICAL: This script NEVER calls `systemctl start`! Starting a downstream
# unit from inside a unit ordered `Before=` it deadlocks the systemd boot
# transaction (matching `axonwall-vault-firstboot`).
set -u

CONF_DIR="/etc/axonwall"
CERT_DIR="${CONF_DIR}/certs"
ENV_FILE="${CONF_DIR}/k3s-storage.env"
PERSIST_ENV="/var/lib/axonwall/etc-axonwall/k3s-storage.env"
ZFS_JSON="/var/lib/axonwall/install-zfs.json"
K3S_CONF_DIR="/etc/rancher/k3s"
K3S_DATA_DIR="/var/lib/rancher/k3s"

log() { echo "[axonwall-k3s-firstboot] $*"; }
die() { echo "[axonwall-k3s-firstboot] ERROR: $*" >&2; exit 1; }

mkdir -p "$CONF_DIR" /var/lib/axonwall/etc-axonwall

# Restore persistent k3s-storage.env across A/B root slot switches if needed
if [ ! -s "$ENV_FILE" ] && [ -s "$PERSIST_ENV" ]; then
    cp -f "$PERSIST_ENV" "$ENV_FILE"
    chmod 0600 "$ENV_FILE"
fi

K3S_ROLE="server"
K3S_SERVER_URL=""
K3S_JOIN_TOKEN=""
ZFS_ARC_MAX_MB="0"

if [ -f "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    . "$ENV_FILE"
fi

case "${K3S_ROLE:-server}" in
    agent|worker) K3S_ROLE="agent" ;;
    *) K3S_ROLE="server" ;;
esac

# --- 1. Dynamic ZFS ARC cap (/etc/modprobe.d/zfs.conf + live sysfs) --------
compute_arc_max_bytes() {
    _override_mb="${ZFS_ARC_MAX_MB:-0}"
    case "$_override_mb" in
        ''|*[!0-9]*) _override_mb=0 ;;
    esac
    if [ "$_override_mb" -gt 0 ]; then
        echo $(( _override_mb * 1048576 ))
        return 0
    fi
    _mem_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 4194304)"
    case "$_mem_kb" in
        ''|*[!0-9]*) _mem_kb=4194304 ;;
    esac
    _mem_mb=$(( _mem_kb / 1024 ))
    if [ "$_mem_mb" -le 2048 ]; then
        echo $(( 384 * 1048576 ))
    elif [ "$_mem_mb" -le 4096 ]; then
        echo $(( 512 * 1048576 ))
    elif [ "$_mem_mb" -le 8192 ]; then
        echo $(( 1024 * 1048576 ))
    else
        echo $(( (_mem_kb * 1024) / 4 ))
    fi
}

ARC_MAX_BYTES="$(compute_arc_max_bytes)"
mkdir -p /etc/modprobe.d
printf '# Generated by axonwall-k3s-firstboot\noptions zfs zfs_arc_max=%s\n' "$ARC_MAX_BYTES" > /etc/modprobe.d/zfs.conf
chmod 0644 /etc/modprobe.d/zfs.conf
log "configured ZFS ARC cap: zfs_arc_max=${ARC_MAX_BYTES} bytes"

# --- 2. Kernel modules, live ZFS ARC cap, sysctl & host firewall -----------
for _mod in zfs overlay br_netfilter wireguard nf_conntrack; do
    modprobe "$_mod" 2>/dev/null || true
done

if [ -w /sys/module/zfs/parameters/zfs_arc_max ]; then
    echo "$ARC_MAX_BYTES" > /sys/module/zfs/parameters/zfs_arc_max 2>/dev/null || true
fi

sysctl --system >/dev/null 2>&1 || true

if command -v nft >/dev/null 2>&1 && [ -f /etc/nftables.conf ]; then
    log "applying isolated k3s_host_filter nftables ruleset"
    nft -f /etc/nftables.conf || log "WARNING: nft -f /etc/nftables.conf returned non-zero"
fi

# --- 3. Host Mode DHCP networking (no router NAT, no static 192.168.1.1) ---
has_ifupdown_dropins() {
    for _f in /etc/network/interfaces.d/*; do
        [ -s "$_f" ] && return 0
    done
    return 1
}

has_networkd_units() {
    for _f in /etc/systemd/network/*.network; do
        [ -s "$_f" ] && return 0
    done
    return 1
}

PHYS_NICS="$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -vE '^(lo|wg.*|tailscale.*|tun.*|tap.*|sit.*|ip6tnl.*|gre.*|gretap.*|erspan.*|ip_vti.*|ip6_vti.*|ip6gre.*|docker.*|veth.*|br-.*|cni.*|flannel.*|virbr.*|dummy.*|bond.*|pimreg)$' || true)"

if ! has_ifupdown_dropins && ! has_networkd_units && [ ! -f "${CONF_DIR}/.interfaces_configured" ]; then
    log "configuring Host Mode DHCP client networking on physical NICs"
    if [ -d /run/systemd/system ] && [ -d /lib/systemd ] && command -v networkctl >/dev/null 2>&1; then
        mkdir -p /etc/systemd/network
        cat << 'NET_EOF' > /etc/systemd/network/20-axonwall-k3s-dhcp.network
# Generated by axonwall-k3s-firstboot (Host Mode DHCP client)
[Match]
Name=en* eth*

[Network]
DHCP=yes
IPv6AcceptRA=yes

[DHCPv4]
UseDNS=yes
UseMTU=yes
NET_EOF
        chmod 0644 /etc/systemd/network/20-axonwall-k3s-dhcp.network
        networkctl reload 2>/dev/null || true
    else
        mkdir -p /etc/network /etc/network/interfaces.d
        {
            echo "# /etc/network/interfaces -- Generated by axonwall-k3s-firstboot (Host Mode)"
            echo "auto lo"
            echo "iface lo inet loopback"
            echo ""
            for _nic in $PHYS_NICS; do
                echo "auto ${_nic}"
                echo "iface ${_nic} inet dhcp"
                echo ""
            done
        } > /etc/network/interfaces
    fi
fi

# Bring physical NICs up and obtain an initial DHCPv4 lease if still unaddressed
for _nic in $PHYS_NICS; do
    ip link set up dev "$_nic" 2>/dev/null || true
    if ! ip -4 addr show dev "$_nic" 2>/dev/null | grep -q 'inet '; then
        if command -v dhcpcd >/dev/null 2>&1; then
            dhcpcd -4 -t 10 "$_nic" >/dev/null 2>&1 || true
        elif command -v dhclient >/dev/null 2>&1; then
            dhclient -1 -q "$_nic" >/dev/null 2>&1 || true
        elif command -v udhcpc >/dev/null 2>&1; then
            udhcpc -i "$_nic" -n -q -t 5 -T 2 >/dev/null 2>&1 || true
        fi
    fi
done

# Ensure SSH host keys exist on fresh images
if command -v ssh-keygen >/dev/null 2>&1; then
    _has_ssh_key=0
    for _hk in /etc/ssh/ssh_host_*_key; do
        [ -s "$_hk" ] && _has_ssh_key=1 && break
    done
    [ "$_has_ssh_key" -eq 0 ] && ssh-keygen -A >/dev/null 2>&1 || true
fi

# --- 4. Appliance TLS PKI (/etc/axonwall/certs) ----------------------------
mkdir -p "$CERT_DIR"
if command -v axonwall-rotate-hub-cert >/dev/null 2>&1; then
    log "provisioning appliance TLS PKI via axonwall-rotate-hub-cert --ensure"
    axonwall-rotate-hub-cert --ensure || true
fi
if [ ! -s "$CERT_DIR/hub.crt" ] || [ ! -s "$CERT_DIR/hub.key" ]; then
    if [ -s "$CERT_DIR/ca.crt" ]; then
        die "hub leaf missing/unusable while $CERT_DIR/ca.crt exists; refusing to mint a non-chaining self-signed certificate"
    fi
    _hn="$(hostname 2>/dev/null || echo axonwall-storage)"
    _san="DNS:${_hn},DNS:axonwall-storage.local,DNS:axonwall.local,DNS:localhost,IP:127.0.0.1"
    for _ip in $(hostname -I 2>/dev/null || ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]}' || true); do
        _san="${_san},IP:${_ip}"
    done
    log "generating fallback self-signed TLS certificate (SAN: ${_san})"
    openssl req -x509 -newkey rsa:2048 -nodes \
        -keyout "$CERT_DIR/hub.key" -out "$CERT_DIR/hub.crt" \
        -days 825 -subj "/O=Axonwall/OU=K3sStorage/CN=${_hn}" \
        -addext "subjectAltName=${_san}" \
        || die "TLS certificate generation failed"
fi
chown root:root "$CERT_DIR" "$CERT_DIR/hub.key" "$CERT_DIR/hub.crt" 2>/dev/null || true
chmod 0750 "$CONF_DIR" "$CERT_DIR" 2>/dev/null || true
chmod 0600 "$CERT_DIR/hub.key"
chmod 0644 "$CERT_DIR/hub.crt"

# --- 5. OpenZFS pool import / creation from install-zfs.json ---------------
if command -v zpool >/dev/null 2>&1; then
    if ! zpool list -H tank >/dev/null 2>&1; then
        zpool import -f tank >/dev/null 2>&1 || true
    fi
    if ! zpool list -H zroot >/dev/null 2>&1; then
        zpool import -f zroot >/dev/null 2>&1 || true
    fi

    if [ -s "$ZFS_JSON" ] && command -v jq >/dev/null 2>&1; then
        _zfs_pool="$(jq -r '.poolName // "tank"' "$ZFS_JSON" 2>/dev/null || echo "tank")"
        _zfs_topo="$(jq -r '.topology // "stripe"' "$ZFS_JSON" 2>/dev/null || echo "stripe")"
        _zfs_vdevs="$(jq -r '(.vdevs // []) | join(" ")' "$ZFS_JSON" 2>/dev/null || true)"
        _slog_vdevs="$(jq -r '(.slogVdevs // []) | join(" ")' "$ZFS_JSON" 2>/dev/null || true)"
        _l2arc_vdevs="$(jq -r '(.l2arcVdevs // []) | join(" ")' "$ZFS_JSON" 2>/dev/null || true)"
        _spare_vdevs="$(jq -r '(.spareVdevs // []) | join(" ")' "$ZFS_JSON" 2>/dev/null || true)"

        _accel_args=""
        if [ -n "$_slog_vdevs" ]; then
            _slog_cnt="$(printf '%s\n' "$_slog_vdevs" | wc -w | tr -d ' ')"
            if [ "$_slog_cnt" -ge 2 ]; then
                _accel_args="${_accel_args} log mirror ${_slog_vdevs}"
            else
                _accel_args="${_accel_args} log ${_slog_vdevs}"
            fi
        fi
        [ -n "$_l2arc_vdevs" ] && _accel_args="${_accel_args} cache ${_l2arc_vdevs}"
        [ -n "$_spare_vdevs" ] && _accel_args="${_accel_args} spare ${_spare_vdevs}"

        if [ -n "$_zfs_pool" ] && [ -n "$_zfs_vdevs" ]; then
            if ! zpool list -H "$_zfs_pool" >/dev/null 2>&1; then
                zpool import -f "$_zfs_pool" >/dev/null 2>&1 || true
            fi
            if ! zpool list -H "$_zfs_pool" >/dev/null 2>&1; then
                _topo_arg=""
                case "$_zfs_topo" in
                    mirror|raidz1|raidz2|raidz3|draid*) _topo_arg="$_zfs_topo" ;;
                    stripe|auto|"") _topo_arg="" ;;
                    *) _topo_arg="$_zfs_topo" ;;
                esac
                if [ "$_zfs_pool" = "zroot" ]; then
                    log "creating OpenZFS root/storage pool 'zroot' (${_zfs_topo}: ${_zfs_vdevs})"
                    # shellcheck disable=SC2086
                    zpool create -f \
                        -o ashift=12 -o autotrim=on \
                        -O compression=lz4 -O atime=off -O xattr=sa -O acltype=posixacl \
                        -O normalization=formD -O canmount=off -O mountpoint=none \
                        zroot $_topo_arg $_zfs_vdevs $_accel_args \
                        || log "WARNING: zpool create zroot failed"
                else
                    log "creating OpenZFS storage pool '${_zfs_pool}' (${_zfs_topo}: ${_zfs_vdevs})"
                    # shellcheck disable=SC2086
                    zpool create -f \
                        -o ashift=12 -o autotrim=on \
                        -O compression=lz4 -O atime=off -O xattr=sa -O acltype=posixacl \
                        -O normalization=formD -O mountpoint=/mnt/tank \
                        "$_zfs_pool" $_topo_arg $_zfs_vdevs $_accel_args \
                        || log "WARNING: zpool create ${_zfs_pool} failed"
                fi
            fi
        fi
    fi
fi

# --- 6. OpenEBS & K3s runtime ZFS datasets ---------------------------------
K8S_ZFS_POOL="tank/k8s"
if command -v zpool >/dev/null 2>&1 && command -v zfs >/dev/null 2>&1; then
    # Preserve any pre-existing files inside /var/lib/rancher/k3s before mounting ZFS dataset over it
    _k3s_stash=""
    if [ -d "$K3S_DATA_DIR" ] && [ -n "$(ls -A "$K3S_DATA_DIR" 2>/dev/null || true)" ]; then
        if ! awk -v mp="$K3S_DATA_DIR" '$2 == mp {found=1} END {exit !found}' /proc/mounts 2>/dev/null; then
            _k3s_stash="$(mktemp -d /run/k3s-runtime-stash.XXXXXX)"
            cp -a "${K3S_DATA_DIR}/." "${_k3s_stash}/" 2>/dev/null || true
        fi
    fi

    if zpool list -H tank >/dev/null 2>&1; then
        log "configuring OpenZFS datasets on pool 'tank' (tank/k8s + tank/k3s-runtime)"
        if ! zfs list -H tank/k8s >/dev/null 2>&1; then
            zfs create \
                -o compression=lz4 \
                -o atime=off \
                -o recordsize=128k \
                -o xattr=sa \
                -o acltype=posixacl \
                tank/k8s || die "failed to create tank/k8s dataset"
        else
            zfs set compression=lz4 atime=off recordsize=128k xattr=sa acltype=posixacl tank/k8s 2>/dev/null || true
        fi
        mkdir -p "$K3S_DATA_DIR"
        if ! zfs list -H tank/k3s-runtime >/dev/null 2>&1; then
            zfs create \
                -o mountpoint="$K3S_DATA_DIR" \
                -o canmount=on \
                -o compression=lz4 \
                -o atime=off \
                -o recordsize=128k \
                -o xattr=sa \
                -o acltype=posixacl \
                tank/k3s-runtime || die "failed to create tank/k3s-runtime dataset"
        else
            zfs set mountpoint="$K3S_DATA_DIR" canmount=on compression=lz4 atime=off recordsize=128k tank/k3s-runtime 2>/dev/null || true
            zfs mount tank/k3s-runtime 2>/dev/null || true
        fi
        K8S_ZFS_POOL="tank/k8s"
    elif zpool list -H zroot >/dev/null 2>&1; then
        log "configuring OpenZFS datasets on single-pool 'zroot' (zroot/k8s + zroot/k3s-runtime)"
        mkdir -p /var/lib/axonwall/k8s-zfs "$K3S_DATA_DIR"
        if ! zfs list -H zroot/k8s >/dev/null 2>&1; then
            zfs create \
                -o mountpoint=/var/lib/axonwall/k8s-zfs \
                -o canmount=on \
                -o compression=lz4 \
                -o atime=off \
                -o recordsize=128k \
                -o xattr=sa \
                -o acltype=posixacl \
                zroot/k8s || die "failed to create zroot/k8s dataset"
        else
            zfs set compression=lz4 atime=off recordsize=128k xattr=sa acltype=posixacl zroot/k8s 2>/dev/null || true
            zfs mount zroot/k8s 2>/dev/null || true
        fi
        if ! zfs list -H zroot/k3s-runtime >/dev/null 2>&1; then
            zfs create \
                -o mountpoint="$K3S_DATA_DIR" \
                -o canmount=on \
                -o compression=lz4 \
                -o atime=off \
                -o recordsize=128k \
                -o xattr=sa \
                -o acltype=posixacl \
                zroot/k3s-runtime || die "failed to create zroot/k3s-runtime dataset"
        else
            zfs set mountpoint="$K3S_DATA_DIR" canmount=on compression=lz4 atime=off recordsize=128k zroot/k3s-runtime 2>/dev/null || true
            zfs mount zroot/k3s-runtime 2>/dev/null || true
        fi
        K8S_ZFS_POOL="zroot/k8s"
    else
        log "WARNING: neither 'tank' nor 'zroot' OpenZFS pool is online yet; K3s runtime will use root filesystem until a ZFS pool is created"
        mkdir -p "$K3S_DATA_DIR"
    fi

    if [ -n "$_k3s_stash" ] && [ -d "$_k3s_stash" ]; then
        cp -a "${_k3s_stash}/." "${K3S_DATA_DIR}/" 2>/dev/null || true
        rm -rf "$_k3s_stash"
    fi
else
    mkdir -p "$K3S_DATA_DIR"
fi

# --- 7. Stage airgapped K3s/CSI container image archives if bundled --------
if [ -d /usr/share/axonwall/k3s/images ]; then
    for _img in /usr/share/axonwall/k3s/images/*.tar*; do
        [ -f "$_img" ] || continue
        mkdir -p "${K3S_DATA_DIR}/agent/images"
        cp -f "$_img" "${K3S_DATA_DIR}/agent/images/"
        log "staged airgap image bundle: $(basename "$_img")"
    done
fi

# --- 8. Write /etc/rancher/k3s/config.yaml & OpenEBS manifests -------------
mkdir -p "$K3S_CONF_DIR"
chmod 0700 "$K3S_CONF_DIR"

if [ "$K3S_ROLE" = "agent" ]; then
    log "configuring node in K3s AGENT (worker + ZFS storage) mode"
    touch "${K3S_CONF_DIR}/agent-mode"
    chmod 0600 "${K3S_CONF_DIR}/agent-mode"
    printf '%s\n' "${K3S_JOIN_TOKEN:-}" > "${K3S_CONF_DIR}/agent-token"
    chmod 0600 "${K3S_CONF_DIR}/agent-token"

    cat << EOF > "${K3S_CONF_DIR}/config.yaml"
# Generated by axonwall-k3s-firstboot (role: agent)
server: "${K3S_SERVER_URL:-}"
token-file: "${K3S_CONF_DIR}/agent-token"
kubelet-arg:
  - "eviction-hard=memory.available<200Mi,nodefs.available<5%"
EOF
    chmod 0600 "${K3S_CONF_DIR}/config.yaml"
else
    log "configuring node in K3s SERVER (control-plane + ZFS storage) mode"
    rm -f "${K3S_CONF_DIR}/agent-mode"
    _hn="$(hostname 2>/dev/null || echo axonwall-storage)"

    {
        echo "# Generated by axonwall-k3s-firstboot (role: server)"
        if [ -n "${K3S_SERVER_URL:-}" ]; then
            printf 'server: "%s"\n' "$K3S_SERVER_URL"
        fi
        if [ -n "${K3S_JOIN_TOKEN:-}" ]; then
            printf '%s\n' "$K3S_JOIN_TOKEN" > "${K3S_CONF_DIR}/agent-token"
            chmod 0600 "${K3S_CONF_DIR}/agent-token"
            echo "token-file: \"${K3S_CONF_DIR}/agent-token\""
        fi
        cat << 'CFG_STATIC'
write-kubeconfig-mode: "0600"
flannel-backend: "wireguard-native"
disable:
  - local-storage
  - traefik
  - servicelb
  - metrics-server
kubelet-arg:
  - "eviction-hard=memory.available<200Mi,nodefs.available<5%"
tls-san:
CFG_STATIC
        printf '  - "%s"\n' "$_hn"
        echo '  - "axonwall-storage.local"'
        echo '  - "localhost"'
        echo '  - "127.0.0.1"'
        for _ip in $(hostname -I 2>/dev/null || ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print a[1]}' || true); do
            [ "$_ip" = "127.0.0.1" ] && continue
            printf '  - "%s"\n' "$_ip"
        done
    } > "${K3S_CONF_DIR}/config.yaml"
    chmod 0600 "${K3S_CONF_DIR}/config.yaml"

    # Stage OpenEBS ZFS-LocalPV operator & default axonwall-zfs-local StorageClass
    MANIFEST_DIR="${K3S_DATA_DIR}/server/manifests"
    mkdir -p "$MANIFEST_DIR"
    if [ -s /usr/share/axonwall/k3s/zfs-operator.yaml ]; then
        cp -f /usr/share/axonwall/k3s/zfs-operator.yaml "${MANIFEST_DIR}/00-openebs-zfs-operator.yaml"
        chmod 0644 "${MANIFEST_DIR}/00-openebs-zfs-operator.yaml"
    else
        log "WARNING: /usr/share/axonwall/k3s/zfs-operator.yaml not found; OpenEBS operator manifest not staged"
    fi

    cat << EOF > "${MANIFEST_DIR}/01-axonwall-openebs.yaml"
# Generated by axonwall-k3s-firstboot
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: axonwall-zfs-local
  annotations:
    storageclass.kubernetes.io/is-default-class: "true"
provisioner: zfs.csi.openebs.io
allowVolumeExpansion: true
reclaimPolicy: Retain
volumeBindingMode: WaitForFirstConsumer
parameters:
  poolname: "${K8S_ZFS_POOL}"
  fstype: "zfs"
  compression: "lz4"
  thinprovision: "yes"
  recordsize: "128k"
EOF
    chmod 0644 "${MANIFEST_DIR}/01-axonwall-openebs.yaml"
fi

# Update /etc/issue login banner with K3s Storage Host quick hint
_primary_ip="$(ip -4 -o addr show scope global 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}' || true)"
cat << ISSUE_EOF > /etc/issue
======================================================================
  Axonwall K3s + OpenZFS + OpenEBS Storage Host ($(cat /etc/axonwall/version 2>/dev/null || echo "0.11.41"))
  Role: ${K3S_ROLE} | ZFS Dataset: ${K8S_ZFS_POOL} | IP: ${_primary_ip:-DHCP pending}
  Run 'axonwall-k3s-status' as root to inspect ZFS & K3s health.
======================================================================

ISSUE_EOF

log "firstboot configuration complete; handing off to systemd (k3s / k3s-agent)"
