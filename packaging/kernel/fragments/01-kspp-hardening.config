# ==============================================================================
# Axonwall Hardened Kernel — KSPP & LSM Security Fragment (01)
# Synthesizes Kernel Self-Protection Project (KSPP), Talos Linux, and
# Fedora CoreOS / Flatcar hardening while preserving K3s, OpenZFS, and eBPF.
# ==============================================================================

# LSM Stack & Integrity Lockdown (NOT Confidentiality — preserves eBPF CO-RE!)
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY is not set
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_SAFESETID=y
CONFIG_INTEGRITY=y
CONFIG_BPF_LSM=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"

# Slab / Page Allocator / Stack / ASLR Hardening (KSPP)
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_X86_KERNEL_IBT=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_SYN_COOKIES=y

# Cryptographic Module Signing (SHA-512; allows out-of-tree signed OpenZFS DKMS)
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_HASH="sha512"

# Legacy & High-Risk Attack Surface Stripping (Applies to Universal & Stripped)
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_DEVKMEM is not set
# CONFIG_IP_DCCP is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
# CONFIG_ATM is not set
# CONFIG_DECNET is not set
# CONFIG_X25 is not set
# CONFIG_ATALK is not set
# CONFIG_IPX is not set
# CONFIG_HAMRADIO is not set
# CONFIG_FIREWIRE is not set
# CONFIG_PCMCIA is not set
# CONFIG_BLK_DEV_FD is not set
# CONFIG_N_HDLC is not set
# CONFIG_ACPI_CUSTOM_METHOD is not set
# CONFIG_PROC_KCORE is not set
