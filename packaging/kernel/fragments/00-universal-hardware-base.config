# ==============================================================================
# Axonwall Universal Hardened Kernel — Hardware Support Fragment (00)
# Broad Debian-13-equivalent headless server, cloud VM & appliance hardware base.
# Keeps broad NIC, NVMe/SATA/SAS HBA, VirtIO, Cloud & TPM2 support while
# leaving desktop/consumer bloat to be stripped in `--mode stripped`.
# ==============================================================================

# Module & SMP / NUMA / ACPI / EFI Core
CONFIG_64BIT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_SMP=y
CONFIG_NUMA=y
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_DMI=y
CONFIG_DMIID=y

# PCIe & IOMMU (VFIO / SR-IOV / DMA Remapping)
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_PCI_IOV=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m

# CPU Microcode & Hardware Crypto Acceleration
CONFIG_MICROCODE=y
CONFIG_CRYPTO_AES_NI_INTEL=m
CONFIG_CRYPTO_CHACHA20_X86_64=m
CONFIG_CRYPTO_POLY1305_X86_64=m
CONFIG_CRYPTO_SHA256_SSSE3=m
CONFIG_CRYPTO_SHA512_SSSE3=m
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=m

# KVM Host & Cloud / Hypervisor Guests
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_VMXNET3=m
CONFIG_VMWARE_PVSCSI=m
CONFIG_HYPERV=m
CONFIG_HYPERV_NET=m
CONFIG_HYPERV_STORAGE=m
CONFIG_ENA_ETHERNET=m
CONFIG_GVE=m
CONFIG_XEN=y
CONFIG_XEN_BLKDEV_FRONTEND=m
CONFIG_XEN_NETDEV_FRONTEND=m

# Physical & Enterprise NICs (1GbE / 2.5GbE / 10GbE / 25GbE / 100GbE)
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_ICE=m
CONFIG_IDPF=m
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_CORE=m
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_BNXT=m
CONFIG_BNX2X=m
CONFIG_TIGON3=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=m

# Storage Controllers (NVMe / AHCI / SCSI / Enterprise RAID & HBA)
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=m
CONFIG_SCSI_MPT3SAS=m
CONFIG_MEGARAID_SAS=m
CONFIG_SCSI_SMARTPQI=m

# TPM2, Hardware Watchdogs, Sensors, Serial Console & Minimal USB
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_ITCO_WDT=m
CONFIG_SP5100_TCO=m
CONFIG_SOFT_WATCHDOG=m
CONFIG_HW_RANDOM=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_EHCI_PCI=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_HID=y
CONFIG_USB_HID=m
