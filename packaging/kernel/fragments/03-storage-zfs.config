# ==============================================================================
# Axonwall Hardened Kernel — OpenZFS, OpenEBS & Storage Stack Fragment (03)
# Preserves exported symbols needed by external OpenZFS DKMS/kmod modules.
# ==============================================================================

# Critical for external OpenZFS DKMS builds (never trim exported ksyms)
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_KALLSYMS=y

CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y

CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_XTS=y

CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_TCP=m

CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m

CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=m
CONFIG_DM_THIN_PROVISIONING=m

CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_FUSE_FS=m
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=m
CONFIG_ISCSI_TCP=m
CONFIG_SCSI_ISCSI_ATTRS=m
CONFIG_NFSD=m
CONFIG_NFSD_V4=y
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
