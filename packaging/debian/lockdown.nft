#!/usr/sbin/nft -f
# /usr/share/axonwall/lockdown.nft - Fail-safe emergency boot ruleset
# Axonwall owns ONLY 'table inet axonwall'. Never flushes other tables.

# Idempotent: create-if-missing then flush, so re-applying (e.g. on every
# axonwalld restart via ExecStartPre) doesn't append duplicate rules.
table inet axonwall {}
flush table inet axonwall

table inet axonwall {
    # WAN interface set for lockdown isolation (default: eth0, wan0; dynamically expandable)
    set wan_interfaces {
        type ifname
        elements = { "eth0", "wan0" }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        # Allow established / related state
        ct state established,related accept
        ct state invalid drop

        # Loopback
        iif "lo" accept

        # Standard ICMP
        icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept
        icmpv6 type { echo-request, echo-reply, destination-unreachable, packet-too-big, time-exceeded } accept

        # Drop incoming management access from WAN interfaces (mirrors OPNsense default deny on WAN)
        iifname @wan_interfaces tcp dport { 22, 80, 443, 2966, 3000 } drop comment "block-wan-management"

        # Emergency Anti-Lockout on internal interfaces only
        tcp dport { 22, 80, 443, 2966 } accept comment "emergency-anti-lockout"
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
