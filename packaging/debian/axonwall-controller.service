[Unit]
Description=Axonwall Changeset & Policy Compiler Controller
Documentation=https://github.com/axonwall/axonwall
After=network.target axonwalld.service axonwall-firstboot.service
Wants=axonwalld.service

[Service]
Type=simple
# Separate service identity (audit B-12): the controller holds the ZTP
# token, agent token and hub TLS key; the UI holds the JWT secret and
# admin credentials. axonwall-api is the shared group for the daemon
# sockets, agent.token and state traversal only.
User=axonwall-controller
Group=axonwall-api
WorkingDirectory=/opt/axonwall/apps/axonwall-controller
EnvironmentFile=-/etc/axonwall/controller.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5s

ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
ReadWritePaths=/opt/axonwall /var/lib/axonwall /etc/axonwall -/run/headscale -/run/axonwall

[Install]
WantedBy=multi-user.target
