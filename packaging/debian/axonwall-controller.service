[Unit]
Description=Axonwall Changeset & Policy Compiler Controller
Documentation=https://github.com/axonwall/axonwall
After=network.target axonwalld.service axonwall-firstboot.service
Wants=axonwalld.service
ConditionPathExists=!/etc/axonwall/.vault-edition
ConditionPathExists=!/etc/axonwall/.k3s-edition
ConditionKernelCommandLine=!axonwall_install=1
ConditionKernelCommandLine=!axonwall.install=1
ConditionKernelCommandLine=!axonwall.unattended=1

[Service]
Type=simple
# Separate service identity (audit B-12): the controller holds the ZTP
# token, agent token and hub TLS key; the UI holds the JWT secret and
# admin credentials. axonwall-api is the shared group for the daemon
# sockets, agent.token and state traversal only.
User=axonwall-controller
Group=axonwall-api
WorkingDirectory=/opt/axonwall/apps/axonwall-controller
EnvironmentFile=-/etc/axonwall/controller.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5s
LimitCORE=0

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/axonwall /etc/axonwall -/run/headscale -/run/axonwall
InaccessiblePaths=-/var/lib/axonwall/secrets -/var/lib/axonwall/ldap -/var/lib/axonwall/headscale -/var/lib/axonwall/vault -/var/lib/axonwall/home

[Install]
WantedBy=multi-user.target
