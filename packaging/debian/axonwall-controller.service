[Unit]
Description=Axonwall Changeset & Policy Compiler Controller
Documentation=https://github.com/axonwall/axonwall
After=network.target axonwalld.service axonwall-firstboot.service
Wants=axonwalld.service

[Service]
Type=simple
User=axonwall
Group=axonwall
WorkingDirectory=/opt/axonwall/apps/axonwall-controller
EnvironmentFile=-/etc/axonwall/axonwall.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5s

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/axonwall /var/lib/axonwall /etc/axonwall

[Install]
WantedBy=multi-user.target
