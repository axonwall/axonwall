#!/bin/sh
set -e

case "$1" in
    configure)
        # 1. Create axonwall system user and group if not already present
        if ! getent group axonwall >/dev/null 2>&1; then
            groupadd --system axonwall
        fi
        if ! getent passwd axonwall >/dev/null 2>&1; then
            useradd --system --gid axonwall --home-dir /var/lib/axonwall \
                --no-create-home --shell /usr/sbin/nologin \
                --comment "Axonwall Firewall System User" axonwall
        fi

        # Service-identity split (audit B-12): the controller runs as its own
        # user so a compromise of one Node service no longer yields the other
        # service's secrets. axonwall-api is the shared group for the daemon
        # sockets, the agent token and state traversal -- nothing else.
        if ! getent group axonwall-api >/dev/null 2>&1; then
            groupadd --system axonwall-api
        fi
        if ! getent group axonwall-controller >/dev/null 2>&1; then
            groupadd --system axonwall-controller
        fi
        if ! getent passwd axonwall-controller >/dev/null 2>&1; then
            useradd --system --gid axonwall-controller --home-dir /var/lib/axonwall \
                --no-create-home --shell /usr/sbin/nologin \
                --comment "Axonwall Controller Service User" axonwall-controller
        fi
        usermod -a -G axonwall-api axonwall 2>/dev/null || true
        usermod -a -G axonwall-api axonwall-controller 2>/dev/null || true

        # Headscale identity split (B-12 follow-up): headscale runs as
        # its own user so the web UI's identity no longer shares the
        # tailnet's database and config. The unit keeps
        # Group=axonwall-api, which is what the UI/controller CLI
        # callers use to reach the headscale socket in /run/headscale.
        if ! getent group axonwall-headscale >/dev/null 2>&1; then
            groupadd --system axonwall-headscale
        fi
        if ! getent passwd axonwall-headscale >/dev/null 2>&1; then
            useradd --system --gid axonwall-headscale --home-dir /var/lib/axonwall \
                --no-create-home --shell /usr/sbin/nologin \
                --comment "Axonwall Headscale Service User" axonwall-headscale
        fi

        # 2. Ensure directories exist with strict permissions
        mkdir -p /var/lib/axonwall /var/log/axonwall /run/axonwall /etc/axonwall/certs /opt/axonwall
        mkdir -p /var/lib/axonwall/headscale /var/lib/axonwall/bundles /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops /run/headscale
        mkdir -p /var/lib/axonwall/home /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups
        mkdir -p /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki

        chown root:axonwall-api /var/lib/axonwall
        chown -R axonwall:axonwall-api /var/lib/axonwall/bundles /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops /opt/axonwall
        for f in /var/lib/axonwall/state.json /var/lib/axonwall/slot_versions.json /var/lib/axonwall/session-epoch /var/lib/axonwall/revoked-jtis /var/lib/axonwall/.password_changed; do
            if [ -e "$f" ]; then
                chown axonwall:axonwall-api "$f" 2>/dev/null || true
            fi
        done
        chown -R axonwall:axonwall /var/log/axonwall
        chown -R axonwall-headscale:axonwall-headscale /var/lib/axonwall/headscale
        chown axonwall-headscale:axonwall-api /run/headscale
        # Headscale's config can carry the OIDC client secret: group
        # axonwall-api only (the service runs with that group, and the
        # UI/controller CLI callers are members) instead of the
        # UI-shared axonwall identity.
        if [ -f /etc/headscale/config.yaml ]; then
            chown root:axonwall-api /etc/headscale/config.yaml 2>/dev/null || true
            chmod 0640 /etc/headscale/config.yaml 2>/dev/null || true
        fi
        chown root:root /var/lib/axonwall/home
        chmod 0775 /var/lib/axonwall
        chmod 0755 /var/lib/axonwall/home
        chmod 750 /var/log/axonwall /opt/axonwall
        chmod 770 /var/lib/axonwall/headscale /run/headscale
        chmod 0700 /var/lib/axonwall/secrets /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki
        chown -R root:root /var/lib/axonwall/secrets

        if getent passwd openldap >/dev/null 2>&1; then
            chown -R openldap:openldap /var/lib/axonwall/ldap
            chmod 0750 /var/lib/axonwall/ldap /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups
        fi

        # Register /usr/local/bin/axonwall-opshell in /etc/shells
        if [ -f /etc/shells ] && ! grep -qxF '/usr/local/bin/axonwall-opshell' /etc/shells; then
            echo '/usr/local/bin/axonwall-opshell' >> /etc/shells
        fi

        # Ensure /etc/sudoers.d/axonwall has mode 0440
        if [ -f /etc/sudoers.d/axonwall ]; then
            chown root:root /etc/sudoers.d/axonwall 2>/dev/null || true
            chmod 0440 /etc/sudoers.d/axonwall 2>/dev/null || true
        fi

        # Migrate existing /home/* into /var/lib/axonwall/home and bind-mount /home only when /var/lib/axonwall is a separate partition (A/B mode)
        if mountpoint -q /var/lib/axonwall 2>/dev/null || [ -e /dev/disk/by-label/axon_root_b ]; then
            if [ -d /var/lib/axonwall/home ] && ! mountpoint -q /home 2>/dev/null; then
                if [ -d /home ] && [ "$(ls -A /home 2>/dev/null)" ]; then
                    cp -a /home/. /var/lib/axonwall/home/ 2>/dev/null || true
                fi
                chown root:root /var/lib/axonwall/home 2>/dev/null || true
                chmod 0755 /var/lib/axonwall/home 2>/dev/null || true
                mount --bind /var/lib/axonwall/home /home 2>/dev/null || true
            fi
            if [ -f /etc/fstab ] && ! grep -q '/var/lib/axonwall/home' /etc/fstab; then
                echo '/var/lib/axonwall/home  /home  none  bind  0  0' >> /etc/fstab
            fi
        fi
        chown root:root /var/lib/axonwall/home /home 2>/dev/null || true
        chmod 0755 /var/lib/axonwall/home /home 2>/dev/null || true

        chown root:axonwall-api /etc/axonwall /etc/axonwall/certs
        chmod 0770 /etc/axonwall
        chmod 0750 /etc/axonwall/certs
        if [ -f /etc/axonwall/admin.env ]; then
            chown axonwall /etc/axonwall/admin.env 2>/dev/null || true
            chmod 0600 /etc/axonwall/admin.env 2>/dev/null || true
        fi

        # 3. Provision the hub TLS PKI if needed (audit B-14): an on-box
        # appliance CA plus a CA-issued hub leaf, via the shared tool.
        # --ensure is idempotent, migrates legacy self-signed installs to
        # the CA model, and leaves operator-CA installs untouched. The
        # inline fallback (the previous self-signed generation) covers
        # the tool being unavailable.
        if command -v axonwall-rotate-hub-cert >/dev/null 2>&1; then
            axonwall-rotate-hub-cert --ensure || true
        elif [ ! -s /etc/axonwall/certs/hub.crt ] || [ ! -s /etc/axonwall/certs/hub.key ]; then
            if command -v openssl >/dev/null 2>&1; then
                SAN="DNS:$(hostname 2>/dev/null || echo axonwall),DNS:axonwall.local,DNS:localhost,IP:127.0.0.1"
                openssl req -x509 -newkey rsa:2048 -nodes \
                    -keyout /etc/axonwall/certs/hub.key \
                    -out /etc/axonwall/certs/hub.crt \
                    -days 3650 \
                    -subj "/O=Axonwall/OU=Appliance/CN=$(hostname 2>/dev/null || echo axonwall)" \
                    -addext "subjectAltName=${SAN}" >/dev/null 2>&1 || true
            fi
        fi

        if [ -f /etc/axonwall/certs/hub.key ]; then
            # The controller is the only reader of the hub key (audit B-12).
            chown axonwall-controller:axonwall-controller /etc/axonwall/certs/hub.key /etc/axonwall/certs/hub.crt 2>/dev/null || true
            chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
            chmod 0644 /etc/axonwall/certs/hub.crt 2>/dev/null || true
        fi

        # 4. Generate default environment secrets if absent
        if [ ! -s /etc/axonwall/axonwall.env ]; then
            JWT_SECRET=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' 2>/dev/null || echo "axonwall-secret-token")
            ZTP_TOKEN=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' 2>/dev/null || echo "axonwall-ztp")
            ADMIN_PASS="$(openssl rand -hex 16 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"

            cat << ENV_EOF > /etc/axonwall/axonwall.env
JWT_SECRET=${JWT_SECRET}
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=${ADMIN_PASS}
AGENT_SOCKET_PATH=/run/axonwall/agent.sock
AGENT_API_SOCKET=/run/axonwall/agent-api.sock
ENV_EOF
            chmod 0600 /etc/axonwall/axonwall.env
            chown axonwall /etc/axonwall/axonwall.env

            cat << ENV_EOF > /etc/axonwall/controller.env
AXONWALL_ZTP_TOKEN=${ZTP_TOKEN}
ENV_EOF
            chmod 0640 /etc/axonwall/controller.env
            chown root:axonwall-controller /etc/axonwall/controller.env

            # No public default (audit C9): the generated admin password
            # is random; surface it to the operator only, exactly like
            # firstboot does. No .password_changed marker is planted, so
            # the first login still forces a change.
            printf '%s\n' "$ADMIN_PASS" > /etc/axonwall/initial-admin-password
            chmod 0600 /etc/axonwall/initial-admin-password
            chown root:root /etc/axonwall/initial-admin-password
        fi

        # 4b. B-12 migration for upgrades: split the ZTP token out of a
        # monolith axonwall.env written before the service-identity split,
        # and re-assert the split ownership (idempotent).
        if [ -f /etc/axonwall/axonwall.env ]; then
            chown axonwall /etc/axonwall/axonwall.env 2>/dev/null || true
            chmod 0600 /etc/axonwall/axonwall.env 2>/dev/null || true
            if [ ! -f /etc/axonwall/controller.env ] && grep -q '^AXONWALL_ZTP_TOKEN=' /etc/axonwall/axonwall.env; then
                grep '^AXONWALL_ZTP_TOKEN=' /etc/axonwall/axonwall.env > /etc/axonwall/controller.env || true
                sed -i '/^AXONWALL_ZTP_TOKEN=/d' /etc/axonwall/axonwall.env
            fi
        fi
        if [ -f /etc/axonwall/controller.env ]; then
            chown root:axonwall-controller /etc/axonwall/controller.env 2>/dev/null || true
            chmod 0640 /etc/axonwall/controller.env 2>/dev/null || true
        fi
        if [ -f /etc/axonwall/agent.token ]; then
            chown root:axonwall-api /etc/axonwall/agent.token 2>/dev/null || true
            chmod 0640 /etc/axonwall/agent.token 2>/dev/null || true
        fi

        # 5. Initialize etckeeper if installed
        if command -v etckeeper >/dev/null 2>&1; then
            if [ ! -d /etc/.git ]; then
                etckeeper init || true
                etckeeper commit "Initial etckeeper commit for Axonwall appliance" || true
            fi
        fi

        # 5b. Configure VIM as standard editor & vi via update-alternatives, and ZSH as default interactive shell
        for vim_bin in /usr/bin/vim.basic /usr/bin/vim.nox /usr/bin/vim.tiny /usr/bin/vim; do
            if [ -x "$vim_bin" ] && command -v update-alternatives >/dev/null 2>&1; then
                update-alternatives --set editor "$vim_bin" >/dev/null 2>&1 || true
                update-alternatives --set vi "$vim_bin" >/dev/null 2>&1 || true
                update-alternatives --set view "$vim_bin" >/dev/null 2>&1 || true
                break
            fi
        done

        if [ -x /usr/bin/zsh ]; then
            if [ -f /etc/shells ] && ! grep -qxF '/usr/bin/zsh' /etc/shells; then
                echo '/usr/bin/zsh' >> /etc/shells
            fi
            if [ -f /etc/zsh/zshrc ] && ! grep -q '/etc/zsh/axonwall.zsh' /etc/zsh/zshrc; then
                printf '\n# Load Axonwall ZSH environment\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' >> /etc/zsh/zshrc
            fi
            mkdir -p /etc/skel
            if [ ! -f /etc/skel/.zshrc ]; then
                printf '# Axonwall Default User ZSH Profile\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' > /etc/skel/.zshrc
            fi
            if [ ! -f /root/.zshrc ]; then
                printf '# Axonwall Root ZSH Profile\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' > /root/.zshrc
            fi
            chsh -s /usr/bin/zsh root 2>/dev/null || usermod -s /usr/bin/zsh root 2>/dev/null || true

            # Set /usr/bin/zsh as default shell for any existing local interactive shell users (UID 1000..59999)
            if [ -f /etc/passwd ]; then
                awk -F: '($3 >= 1000 && $3 < 60000 && ($7 == "/bin/bash" || $7 == "/bin/sh")) {print $1 ":" $3 ":" $4 ":" $6}' /etc/passwd | while IFS=: read -r uname uid gid homedir; do
                    usermod -s /usr/bin/zsh "$uname" 2>/dev/null || true
                    if [ -n "$homedir" ] && [ -d "$homedir" ] && [ ! -f "${homedir}/.zshrc" ]; then
                        cp /etc/skel/.zshrc "${homedir}/.zshrc" 2>/dev/null || true
                        chown "${uid}:${gid}" "${homedir}/.zshrc" 2>/dev/null || true
                    fi
                done
            fi

            if [ -f /etc/default/useradd ]; then
                if grep -q '^SHELL=' /etc/default/useradd; then
                    sed -i 's|^SHELL=.*|SHELL=/usr/bin/zsh|' /etc/default/useradd 2>/dev/null || true
                else
                    echo 'SHELL=/usr/bin/zsh' >> /etc/default/useradd 2>/dev/null || true
                fi
            fi
            if [ -f /etc/adduser.conf ]; then
                if grep -q '^DSHELL=' /etc/adduser.conf; then
                    sed -i 's|^DSHELL=.*|DSHELL=/usr/bin/zsh|' /etc/adduser.conf 2>/dev/null || true
                else
                    echo 'DSHELL=/usr/bin/zsh' >> /etc/adduser.conf 2>/dev/null || true
                fi
            fi
        fi

        if [ -f /etc/default/sysstat ]; then
            sed -i 's/^ENABLED="false"/ENABLED="true"/' /etc/default/sysstat 2>/dev/null || true
        fi

        # 5c. Sync any regular systemd unit files in /etc/systemd/system/ so ISO-placed copies do not shadow updated /lib/systemd/system/ units
        for unit in axonwalld.service axonwall-controller.service axonwall-ui.service axonwall-console.service headscale.service; do
            if [ -f "/etc/systemd/system/${unit}" ] && [ ! -L "/etc/systemd/system/${unit}" ] && [ -f "/lib/systemd/system/${unit}" ]; then
                cp "/lib/systemd/system/${unit}" "/etc/systemd/system/${unit}" 2>/dev/null || true
            fi
        done

        # 6. Reload systemd daemon and enable services if systemd is running
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl enable axonwalld.service axonwall-controller.service axonwall-ui.service headscale.service axonwall-console.service axonwall-hub-cert-renew.timer ssh.service chrony.service sysstat.service || true
            systemctl restart --no-block axonwalld.service axonwall-controller.service axonwall-ui.service headscale.service ssh.service chrony.service sysstat.service || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
