#!/bin/sh
set -e

# D-M9: this postinst serves all four editions (axonwall, minimal, vault,
# k3s-storage). The optional blocks (headscale, zshell/vim, NGFW-only
# units) are gated on the installed edition so installing a flavor
# package never creates unwanted identity/state.
# Detection mirrors axonwall-update, in the same order: (1) the
# canonical /etc/axonwall/edition file, (2) the legacy markers,
# (3) the kernel cmdline, (4) the NGFW daemon binary as positive
# evidence on a legacy box with no signal at all — and only then.
# A box with no signal and no NGFW payload fails closed. Note the
# package's own edition file is already unpacked when postinst runs,
# so a flavor install detects its own edition.
AXONWALL_EDITION="axonwall"
_EDITION_FROM_FILE=0
if [ -f /etc/axonwall/edition ]; then
  _file_edition="$(tr -d ' \t\r\n' < /etc/axonwall/edition 2>/dev/null || true)"
  if [ -n "$_file_edition" ]; then
    case "$_file_edition" in
      axonwall|minimal|vault|k3s-storage)
        AXONWALL_EDITION="$_file_edition"
        _EDITION_FROM_FILE=1
        ;;
      *)
        echo "Error: /etc/axonwall/edition contains '${_file_edition}' (expected axonwall, minimal, vault, or k3s-storage); fix the file and re-run dpkg --configure." >&2
        exit 1
        ;;
    esac
    _contradiction=0
    if [ "$AXONWALL_EDITION" = "vault" ] && { [ -f /etc/axonwall/.k3s-edition ] || [ -f /etc/axonwall/.minimal-edition ]; }; then _contradiction=1; fi
    if [ "$AXONWALL_EDITION" = "k3s-storage" ] && { [ -f /etc/axonwall/.vault-edition ] || [ -f /etc/axonwall/.minimal-edition ]; }; then _contradiction=1; fi
    if [ "$AXONWALL_EDITION" = "minimal" ] && { [ -f /etc/axonwall/.vault-edition ] || [ -f /etc/axonwall/.k3s-edition ]; }; then _contradiction=1; fi
    if [ "$AXONWALL_EDITION" = "axonwall" ] && { [ -f /etc/axonwall/.vault-edition ] || [ -f /etc/axonwall/.k3s-edition ] || [ -f /etc/axonwall/.minimal-edition ]; }; then _contradiction=1; fi
    if [ "$_contradiction" = "1" ]; then
      echo "Error: /etc/axonwall/edition says '${AXONWALL_EDITION}' but a legacy edition marker disagrees; the installed edition is ambiguous. Remove the wrong marker and re-run dpkg --configure." >&2
      exit 1
    fi
  fi
fi
# No (usable) edition file: fall back to the legacy signals, in the
# same order as axonwall-update. An empty/whitespace-only file counts
# as no signal and reaches this chain (the flag above stays 0) — it
# must NOT silently default to axonwall.
if [ "$_EDITION_FROM_FILE" = "0" ]; then
  _vault_marker=0
  _k3s_marker=0
  _minimal_marker=0
  [ -f /etc/axonwall/.vault-edition ] && _vault_marker=1
  [ -f /etc/axonwall/.k3s-edition ] && _k3s_marker=1
  [ -f /etc/axonwall/.minimal-edition ] && _minimal_marker=1
  if [ "$((_vault_marker + _k3s_marker + _minimal_marker))" -gt 1 ]; then
    echo "Error: multiple conflicting edition markers exist under /etc/axonwall/; the installed edition is ambiguous. Remove the wrong marker(s) and re-run dpkg --configure." >&2
    exit 1
  elif [ "$_vault_marker" = "1" ]; then
    AXONWALL_EDITION="vault"
  elif [ "$_k3s_marker" = "1" ]; then
    AXONWALL_EDITION="k3s-storage"
  elif [ "$_minimal_marker" = "1" ]; then
    AXONWALL_EDITION="minimal"
  elif grep -qsE '(^|[[:space:]])(axonwall_edition|axonwall\.edition)=[^[:space:]]+' /proc/cmdline 2>/dev/null; then
    _cmdline_editions="$(grep -oE '(^|[[:space:]])(axonwall_edition|axonwall\.edition)=[^[:space:]]+' /proc/cmdline 2>/dev/null | sed -E 's/^[[:space:]]*[^=]+=//' | sort -u)"
    _cmdline_count="$(printf '%s\n' "$_cmdline_editions" | grep -c . || true)"
    if [ "$_cmdline_count" -gt 1 ]; then
      echo "Error: conflicting edition tokens in /proc/cmdline ($(printf '%s' "$_cmdline_editions" | tr '\n' ' ')); refusing to guess. Fix the cmdline/markers and re-run dpkg --configure." >&2
      exit 1
    fi
    case "$_cmdline_editions" in
      axonwall|minimal|vault|k3s-storage)
        AXONWALL_EDITION="$_cmdline_editions"
        ;;
      *)
        echo "Error: unknown edition '${_cmdline_editions}' in kernel cmdline (expected axonwall, minimal, vault, or k3s-storage); refusing to guess. Fix the cmdline/markers and re-run dpkg --configure." >&2
        exit 1
        ;;
    esac
  elif [ -x /usr/sbin/axonwalld ]; then
    echo "Warning: no edition signal found (no /etc/axonwall/edition, no legacy marker, no axonwall.edition kernel cmdline), but the NGFW daemon is present, so assuming axonwall. Create /etc/axonwall/edition containing the edition name to record it explicitly." >&2
    AXONWALL_EDITION="axonwall"
  else
    echo "Error: cannot determine the installed edition: no /etc/axonwall/edition, no legacy marker (.minimal-edition/.vault-edition/.k3s-edition), no axonwall.edition kernel cmdline, and no NGFW payload (/usr/sbin/axonwalld absent). Create /etc/axonwall/edition containing one of axonwall, minimal, vault, k3s-storage and re-run dpkg --configure." >&2
    exit 1
  fi
fi
# D-M9 (marker): ensure the canonical edition file exists with the
# detected edition. The .deb ships it in its payload, so this is a
# no-op on a normal install; it self-heals the file if it was deleted
# and postinst runs on reconfigure (dpkg --configure does not unpack).
printf '%s\n' "${AXONWALL_EDITION}" > /etc/axonwall/edition

case "$1" in
    configure)
        # 1. Create system users and groups.
        # D-M9: axonwall-api is the shared group for the NGFW control plane
        # (UI/controller/daemon) and /etc/axonwall on non-vault editions.
        # Vault uses its own axonwall-vault identity without axonwall-api
        # membership, and headscale uses its own axonwall-headscale identity.
        if ! getent group axonwall-api >/dev/null 2>&1; then
            groupadd --system axonwall-api
        fi
        if [ "${AXONWALL_EDITION}" = "axonwall" ] || [ "${AXONWALL_EDITION}" = "minimal" ]; then
        # Create axonwall system user and group if not already present
        if ! getent group axonwall >/dev/null 2>&1; then
            groupadd --system axonwall
        fi
        if ! getent passwd axonwall >/dev/null 2>&1; then
            useradd --system --gid axonwall --home-dir /var/lib/axonwall \
                --no-create-home --shell /usr/sbin/nologin \
                --comment "Axonwall Firewall System User" axonwall
        fi

        # Service-identity split (audit B-12): the controller runs as its own
        # user so a compromise of one Node service no longer yields the other
        # service's secrets. axonwall-api is the shared group for the daemon
        # sockets, the agent token and state traversal -- nothing else.
        if ! getent group axonwall-controller >/dev/null 2>&1; then
            groupadd --system axonwall-controller
        fi
        if ! getent passwd axonwall-controller >/dev/null 2>&1; then
            useradd --system --gid axonwall-controller --home-dir /var/lib/axonwall \
                --no-create-home --shell /usr/sbin/nologin \
                --comment "Axonwall Controller Service User" axonwall-controller
        fi
        usermod -a -G axonwall-api axonwall 2>/dev/null || true
        usermod -a -G axonwall-api axonwall-controller 2>/dev/null || true

        # Headscale identity split (B-12 follow-up / SEC-H25): headscale runs
        # strictly as axonwall-headscale:axonwall-headscale (not in axonwall-api).
        # UI/controller join axonwall-headscale solely for config/socket access.
        if [ "${AXONWALL_EDITION}" = "axonwall" ]; then
            if ! getent group axonwall-headscale >/dev/null 2>&1; then
                groupadd --system axonwall-headscale
            fi
            if ! getent passwd axonwall-headscale >/dev/null 2>&1; then
                useradd --system --gid axonwall-headscale --home-dir /var/lib/axonwall \
                    --no-create-home --shell /usr/sbin/nologin \
                    --comment "Axonwall Headscale Service User" axonwall-headscale
            fi
            usermod -a -G axonwall-headscale axonwall 2>/dev/null || true
            usermod -a -G axonwall-headscale axonwall-controller 2>/dev/null || true
            gpasswd -d axonwall-headscale axonwall-api >/dev/null 2>&1 || true
        fi
        elif [ "${AXONWALL_EDITION}" = "vault" ]; then
        # Vault service identity (packaging/vault/axonwall-vault.sysusers):
        # SeaweedFS runs isolated as axonwall-vault:axonwall-vault without
        # membership in axonwall-api (SEC-H25).
        if ! getent group axonwall-vault >/dev/null 2>&1; then
            groupadd --system axonwall-vault
        fi
        if ! getent passwd axonwall-vault >/dev/null 2>&1; then
            useradd --system --gid axonwall-vault --home-dir /var/lib/axonwall/vault \
                --no-create-home --shell /usr/sbin/nologin \
                --comment "Axonwall Vault Service User" axonwall-vault
        fi
        gpasswd -d axonwall-vault axonwall-api >/dev/null 2>&1 || true
        fi

        # 2. Ensure directories exist with strict permissions
        # D-M9: the shared directories are created for all editions.
        # The NGFW-only trees (LDAP, Headscale, /opt/axonwall, the
        # daemon/controller state dirs, the secrets dirs) are created
        # for the axonwall edition only; the vault data dir only for
        # vault. A flavor install must not conjure NGFW state dirs.
        mkdir -p /var/lib/axonwall /var/log/axonwall /run/axonwall /etc/axonwall/certs
        chown root:axonwall-api /var/lib/axonwall
        chmod 3775 /var/lib/axonwall
        if [ "${AXONWALL_EDITION}" = "vault" ]; then
            chown root:axonwall-vault /etc/axonwall
            chmod 0750 /etc/axonwall 2>/dev/null || true
        else
            chown root:axonwall-api /etc/axonwall
            chmod 1770 /etc/axonwall 2>/dev/null || true
        fi
        chown root:axonwall-api /var/log/axonwall
        chmod 1770 /var/log/axonwall
        if [ "${AXONWALL_EDITION}" = "axonwall" ] || [ "${AXONWALL_EDITION}" = "minimal" ]; then
        mkdir -p /var/cache/axonwall-ui /opt/axonwall
        mkdir -p /var/lib/axonwall/bundles /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops /var/lib/axonwall/captures /var/lib/axonwall/backups
        mkdir -p /var/lib/axonwall/home /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups
        mkdir -p /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki

        chown -R root:root /opt/axonwall
        chmod -R go-w /opt/axonwall 2>/dev/null || true
        chown -R axonwall:axonwall /var/cache/axonwall-ui
        chmod 0750 /var/cache/axonwall-ui
        chown -R axonwall:axonwall-api /var/lib/axonwall/bundles /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops /var/lib/axonwall/captures /var/lib/axonwall/backups
        chmod 3770 /var/lib/axonwall/etc-axonwall /var/lib/axonwall/gitops /var/lib/axonwall/captures /var/lib/axonwall/backups 2>/dev/null || true
        for f in /var/lib/axonwall/state.json /var/lib/axonwall/slot_versions.json /var/lib/axonwall/session-epoch /var/lib/axonwall/revoked-jtis /var/lib/axonwall/.password_changed /var/lib/axonwall/mcp-keys.json /var/lib/axonwall/mcp-settings.json /var/lib/axonwall/mcp-audit.jsonl; do
            if [ -e "$f" ]; then
                chown axonwall:axonwall-api "$f" 2>/dev/null || true
                chmod 0660 "$f" 2>/dev/null || true
            fi
        done
        if [ "${AXONWALL_EDITION}" = "axonwall" ]; then
            mkdir -p /var/lib/axonwall/headscale /run/headscale
            chown -R axonwall-headscale:axonwall-headscale /var/lib/axonwall/headscale
            chown axonwall-headscale:axonwall-headscale /run/headscale
            chmod 0700 /var/lib/axonwall/headscale
            chmod 0770 /run/headscale
            if [ -S /run/headscale/headscale.sock ]; then
                chown axonwall-headscale:axonwall-headscale /run/headscale/headscale.sock 2>/dev/null || true
                chmod 0770 /run/headscale/headscale.sock 2>/dev/null || true
            fi
            # Headscale's config can carry the OIDC client secret: group
            # axonwall-headscale only (headscale runs with that group, and the
            # UI/controller CLI callers are members), keeping axonwall-headscale
            # isolated from axonwall-api.
            if [ -f /etc/headscale/config.yaml ]; then
                chown root:axonwall-headscale /etc/headscale/config.yaml 2>/dev/null || true
                chmod 0640 /etc/headscale/config.yaml 2>/dev/null || true
            fi
        fi
        chown root:root /var/lib/axonwall/home
        chmod 0755 /var/lib/axonwall/home
        chmod 0755 /opt/axonwall
        chmod 0700 /var/lib/axonwall/secrets /var/lib/axonwall/secrets/ldap /var/lib/axonwall/secrets/ha-pki
        chown -R root:root /var/lib/axonwall/secrets

        if getent passwd openldap >/dev/null 2>&1; then
            chown -R openldap:openldap /var/lib/axonwall/ldap
            chmod 0750 /var/lib/axonwall/ldap /var/lib/axonwall/ldap/config /var/lib/axonwall/ldap/data /var/lib/axonwall/ldap/accesslog /var/lib/axonwall/ldap/backups
        fi
        elif [ "${AXONWALL_EDITION}" = "vault" ]; then
        mkdir -p /var/lib/axonwall/vault
        chown axonwall-vault:axonwall-vault /var/lib/axonwall/vault
        chmod 0750 /var/lib/axonwall/vault
        fi

        if getent group openldap >/dev/null 2>&1 && [ -d /var/lib/axonwall/secrets/ha-pki ]; then
            chown root:openldap /var/lib/axonwall/secrets /var/lib/axonwall/secrets/ha-pki
            chmod 0750 /var/lib/axonwall/secrets /var/lib/axonwall/secrets/ha-pki
            for pki_f in ca.crt node.crt; do
                if [ -f "/var/lib/axonwall/secrets/ha-pki/$pki_f" ]; then
                    chown root:openldap "/var/lib/axonwall/secrets/ha-pki/$pki_f"
                    chmod 0644 "/var/lib/axonwall/secrets/ha-pki/$pki_f"
                fi
            done
            if [ -f /var/lib/axonwall/secrets/ha-pki/node.key ]; then
                chown root:openldap /var/lib/axonwall/secrets/ha-pki/node.key
                chmod 0640 /var/lib/axonwall/secrets/ha-pki/node.key
            fi
        fi

        # Register /usr/local/bin/axonwall-opshell in /etc/shells
        if [ -f /etc/shells ] && ! grep -qxF '/usr/local/bin/axonwall-opshell' /etc/shells; then
            echo '/usr/local/bin/axonwall-opshell' >> /etc/shells
        fi

        # Ensure /etc/sudoers.d/axonwall has mode 0440
        if [ -f /etc/sudoers.d/axonwall ]; then
            chown root:root /etc/sudoers.d/axonwall 2>/dev/null || true
            chmod 0440 /etc/sudoers.d/axonwall 2>/dev/null || true
        fi

        # Migrate existing /home/* into /var/lib/axonwall/home and bind-mount /home only when /var/lib/axonwall is a separate partition (A/B mode)
        if mountpoint -q /var/lib/axonwall 2>/dev/null || [ -e /dev/disk/by-label/axon_root_b ]; then
            if [ -d /var/lib/axonwall/home ] && ! mountpoint -q /home 2>/dev/null; then
                if [ -d /home ] && [ "$(ls -A /home 2>/dev/null)" ]; then
                    cp -a /home/. /var/lib/axonwall/home/ 2>/dev/null || true
                fi
                chown root:root /var/lib/axonwall/home 2>/dev/null || true
                chmod 0755 /var/lib/axonwall/home 2>/dev/null || true
                mount --bind /var/lib/axonwall/home /home 2>/dev/null || true
            fi
            if [ -f /etc/fstab ] && ! grep -q '/var/lib/axonwall/home' /etc/fstab; then
                echo '/var/lib/axonwall/home  /home  none  bind  0  0' >> /etc/fstab
            fi
        fi
        chown root:root /var/lib/axonwall/home /home 2>/dev/null || true
        chmod 0755 /var/lib/axonwall/home /home 2>/dev/null || true

        if [ "${AXONWALL_EDITION}" = "vault" ]; then
            chown root:axonwall-vault /etc/axonwall /etc/axonwall/certs
            chmod 0750 /etc/axonwall /etc/axonwall/certs
            if [ -f /etc/axonwall/seaweedfs-s3.json ]; then
                chown root:axonwall-vault /etc/axonwall/seaweedfs-s3.json 2>/dev/null || true
                chmod 0640 /etc/axonwall/seaweedfs-s3.json 2>/dev/null || true
            fi
        else
            chown root:axonwall-api /etc/axonwall /etc/axonwall/certs
            chmod 1770 /etc/axonwall
            chmod 0750 /etc/axonwall/certs
        fi
        if [ -f /etc/axonwall/admin.env ]; then
            chown axonwall /etc/axonwall/admin.env 2>/dev/null || true
            chmod 0600 /etc/axonwall/admin.env 2>/dev/null || true
        fi

        # 3. Provision the hub TLS PKI if needed (audit B-14): an on-box
        # appliance CA plus a CA-issued hub leaf, via the shared tool.
        # --ensure is idempotent, migrates legacy self-signed installs to
        # the CA model, and leaves operator-CA installs untouched.
        mkdir -p /etc/axonwall/certs
        if [ -x /usr/local/bin/axonwall-rotate-hub-cert ]; then
            /usr/local/bin/axonwall-rotate-hub-cert --ensure || true
        elif command -v axonwall-rotate-hub-cert >/dev/null 2>&1; then
            axonwall-rotate-hub-cert --ensure || true
        fi
        # D-M4: the old elif fallback only ran when the tool was
        # missing, so a rotate failure left the box with no hub pair
        # at all. Generate the fallback whenever the pair is missing,
        # regardless of why rotate produced nothing -- EXCEPT when an
        # appliance CA exists, where minting a non-chaining
        # self-signed cert would defeat the operator-CA refusal (the
        # D-H3/B-H3 pattern). Fail the configure step loudly there
        # so the operator fixes the PKI and re-runs dpkg --configure
        # instead of silently degrading.
        if [ ! -s /etc/axonwall/certs/hub.crt ] || [ ! -s /etc/axonwall/certs/hub.key ]; then
            if [ -s /etc/axonwall/certs/ca.crt ]; then
                echo "Error: hub certificate pair missing but an appliance CA exists; refusing to mint a non-chaining certificate. Fix the PKI and re-run dpkg --configure." >&2
                exit 1
            fi
            # D-L4: a failed generation used to be swallowed (`|| true`)
            # and dpkg reported success with no hub pair. Fail the
            # configure step loudly instead, so the operator fixes it
            # and re-runs dpkg --configure.
            if command -v openssl >/dev/null 2>&1; then
                SAN="DNS:$(hostname 2>/dev/null || echo axonwall),DNS:axonwall.local,DNS:localhost,IP:127.0.0.1"
                (
                    umask 077
                    openssl req -x509 -newkey rsa:2048 -nodes \
                        -keyout /etc/axonwall/certs/hub.key \
                        -out /etc/axonwall/certs/hub.crt \
                        -days 3650 \
                        -subj "/O=Axonwall/OU=Appliance/CN=$(hostname 2>/dev/null || echo axonwall)" \
                        -addext "subjectAltName=${SAN}"
                ) || { echo "Error: TLS certificate generation failed; fix the PKI and re-run dpkg --configure." >&2; exit 1; }
            else
                echo "Error: openssl is required to generate the hub TLS certificate pair but is not installed; fix the install and re-run dpkg --configure." >&2
                exit 1
            fi
        fi

        if [ -f /etc/axonwall/certs/hub.key ]; then
            # D-M9: the hub key reader is edition-dependent. On axonwall
            # the controller is the only reader (audit B-12). On vault
            # the S3 endpoint (SeaweedFS, running as axonwall-vault)
            # serves the same hub leaf, so the key is root:axonwall-vault
            # 0640, matching the vault tmpfiles entry. On k3s-storage
            # no service identity reads it at install time.
            # (Main's fc576368 sets the same vault ownership via the
            # legacy marker; this keeps the single D-M9 detection
            # source and covers k3s-storage explicitly instead of
            # relying on a chown to a nonexistent user failing
            # silently.)
            if [ "${AXONWALL_EDITION}" = "axonwall" ] || [ "${AXONWALL_EDITION}" = "minimal" ]; then
                chown axonwall-controller:axonwall-controller /etc/axonwall/certs/hub.key /etc/axonwall/certs/hub.crt 2>/dev/null || true
                chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
            elif [ "${AXONWALL_EDITION}" = "vault" ]; then
                chown root:axonwall-vault /etc/axonwall/certs/hub.key 2>/dev/null || true
                chmod 0640 /etc/axonwall/certs/hub.key 2>/dev/null || true
            else
                chown root:root /etc/axonwall/certs/hub.key 2>/dev/null || true
                chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
            fi
            chmod 0644 /etc/axonwall/certs/hub.crt 2>/dev/null || true
        fi

        # D-M9: control-plane secrets (axonwall.env JWT/ZTP/admin password,
        # controller.env, agent.token) are for axonwall & minimal only.
        if [ "${AXONWALL_EDITION}" = "axonwall" ] || [ "${AXONWALL_EDITION}" = "minimal" ]; then
        # 4. Generate default environment secrets if absent
        if [ ! -s /etc/axonwall/axonwall.env ]; then
            JWT_SECRET="$(openssl rand -hex 32 2>/dev/null || od -An -tx1 -N32 /dev/urandom | tr -d ' \n')"
            ZTP_TOKEN="$(openssl rand -hex 16 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"
            ADMIN_PASS="$(openssl rand -hex 16 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"
            if [ "${#JWT_SECRET}" -lt 64 ] || [ "${#ZTP_TOKEN}" -lt 32 ] || [ "${#ADMIN_PASS}" -lt 16 ]; then
                echo "Error: CSPRNG failed to generate required entropy for Axonwall secrets" >&2
                exit 1
            fi

            (
                umask 077
                cat << ENV_EOF > /etc/axonwall/axonwall.env
JWT_SECRET=${JWT_SECRET}
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=${ADMIN_PASS}
AGENT_SOCKET_PATH=/run/axonwall/agent.sock
AGENT_API_SOCKET=/run/axonwall/agent-api.sock
ENV_EOF
                chown axonwall:axonwall /etc/axonwall/axonwall.env
                chmod 0600 /etc/axonwall/axonwall.env

                cat << ENV_EOF > /etc/axonwall/controller.env
AXONWALL_ZTP_TOKEN=${ZTP_TOKEN}
ENV_EOF
                chown root:axonwall-controller /etc/axonwall/controller.env
                chmod 0640 /etc/axonwall/controller.env

                # No public default (audit C9): the generated admin password
                # is random; surface it to the operator only, exactly like
                # firstboot does. No .password_changed marker is planted, so
                # the first login still forces a change.
                printf '%s\n' "$ADMIN_PASS" > /etc/axonwall/initial-admin-password
                chown root:root /etc/axonwall/initial-admin-password
                chmod 0600 /etc/axonwall/initial-admin-password
            )
        fi

        # 4b. B-12 migration for upgrades: split the ZTP token out of a
        # monolith axonwall.env written before the service-identity split,
        # and re-assert the split ownership (idempotent).
        if [ -f /etc/axonwall/axonwall.env ]; then
            chown axonwall:axonwall /etc/axonwall/axonwall.env 2>/dev/null || true
            chmod 0600 /etc/axonwall/axonwall.env 2>/dev/null || true
            if [ ! -f /etc/axonwall/controller.env ] && grep -q '^AXONWALL_ZTP_TOKEN=' /etc/axonwall/axonwall.env; then
                (
                    umask 077
                    grep '^AXONWALL_ZTP_TOKEN=' /etc/axonwall/axonwall.env > /etc/axonwall/controller.env || true
                    chown root:axonwall-controller /etc/axonwall/controller.env 2>/dev/null || true
                    chmod 0640 /etc/axonwall/controller.env 2>/dev/null || true
                    sed -i '/^AXONWALL_ZTP_TOKEN=/d' /etc/axonwall/axonwall.env
                )
            fi
        fi
        if [ -f /etc/axonwall/controller.env ]; then
            chown root:axonwall-controller /etc/axonwall/controller.env 2>/dev/null || true
            chmod 0640 /etc/axonwall/controller.env 2>/dev/null || true
        fi
        if [ -f /etc/axonwall/agent.token ]; then
            chown root:axonwall-api /etc/axonwall/agent.token 2>/dev/null || true
            chmod 0640 /etc/axonwall/agent.token 2>/dev/null || true
        fi
        fi # AXONWALL_EDITION == axonwall: end of NGFW secrets

        # 5. Snapshot /etc if etckeeper-audit was already initialized on upgrade
        if command -v etckeeper >/dev/null 2>&1 && [ -d /etc/.git ]; then
            etckeeper commit "Post-upgrade etckeeper snapshot for Axonwall appliance" || true
        fi

        # 5b. Configure VIM as standard editor & vi via update-alternatives, and ZSH as default interactive shell
        mkdir -p /usr/local/bin 2>/dev/null || true
        if [ -x /usr/bin/batcat ] && [ ! -e /usr/local/bin/bat ] && [ ! -e /usr/bin/bat ]; then
            ln -sf /usr/bin/batcat /usr/local/bin/bat 2>/dev/null || true
        fi
        if [ -x /usr/bin/fdfind ] && [ ! -e /usr/local/bin/fd ] && [ ! -e /usr/bin/fd ]; then
            ln -sf /usr/bin/fdfind /usr/local/bin/fd 2>/dev/null || true
        fi
        if [ -x /usr/local/bin/axonwall-zbm-theme ]; then
            [ -e /usr/local/bin/generate-zbm ] || ln -sf /usr/local/bin/axonwall-zbm-theme /usr/local/bin/generate-zbm 2>/dev/null || true
            [ -e /usr/local/bin/zbm-kcl ] || ln -sf /usr/local/bin/axonwall-zbm-theme /usr/local/bin/zbm-kcl 2>/dev/null || true
        fi

        for vim_bin in /usr/bin/vim.basic /usr/bin/vim.nox /usr/bin/vim.tiny /usr/bin/vim; do
            if [ -x "$vim_bin" ] && command -v update-alternatives >/dev/null 2>&1; then
                update-alternatives --set editor "$vim_bin" >/dev/null 2>&1 || true
                update-alternatives --set vi "$vim_bin" >/dev/null 2>&1 || true
                update-alternatives --set view "$vim_bin" >/dev/null 2>&1 || true
                break
            fi
        done

        if [ "${AXONWALL_EDITION}" != "minimal" ] && [ -x /usr/bin/zsh ]; then
            if [ -f /etc/shells ] && ! grep -qxF '/usr/bin/zsh' /etc/shells; then
                echo '/usr/bin/zsh' >> /etc/shells
            fi
            if [ -f /etc/zsh/zshrc ] && ! grep -q '/etc/zsh/axonwall.zsh' /etc/zsh/zshrc; then
                printf '\n# Load Axonwall ZSH environment\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' >> /etc/zsh/zshrc
            fi
            mkdir -p /etc/zsh
            if [ ! -f /etc/zsh/zshenv ] || ! grep -q '/usr/share/axonwall/zshenv' /etc/zsh/zshenv; then
                printf '\n# Load Axonwall ZSH env defaults\n[ -f /usr/share/axonwall/zshenv ] && source /usr/share/axonwall/zshenv\n' >> /etc/zsh/zshenv
            fi
            mkdir -p /etc/skel
            if [ ! -f /etc/skel/.zshrc ]; then
                printf '# Axonwall Default User ZSH Profile\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' > /etc/skel/.zshrc
            fi
            if [ ! -f /root/.zshrc ]; then
                printf '# Axonwall Root ZSH Profile\n[ -f /etc/zsh/axonwall.zsh ] && source /etc/zsh/axonwall.zsh\n' > /root/.zshrc
            fi
            if [ -d /usr/share/oh-my-zsh ] && [ ! -e /root/.oh-my-zsh ]; then
                ln -s /usr/share/oh-my-zsh /root/.oh-my-zsh 2>/dev/null || true
            fi
            chsh -s /usr/bin/zsh root 2>/dev/null || usermod -s /usr/bin/zsh root 2>/dev/null || true

            # Set /usr/bin/zsh as default shell for any existing local interactive shell users (UID 1000..59999)
            if [ -f /etc/passwd ]; then
                awk -F: '($3 >= 1000 && $3 < 60000 && ($7 == "/bin/bash" || $7 == "/bin/sh" || $7 == "/usr/bin/zsh")) {print $1 ":" $3 ":" $4 ":" $6}' /etc/passwd | while IFS=: read -r uname uid gid homedir; do
                    usermod -s /usr/bin/zsh "$uname" 2>/dev/null || true
                    if [ -n "$homedir" ] && [ -d "$homedir" ]; then
                        if [ ! -f "${homedir}/.zshrc" ]; then
                            cp /etc/skel/.zshrc "${homedir}/.zshrc" 2>/dev/null || true
                            chown "${uid}:${gid}" "${homedir}/.zshrc" 2>/dev/null || true
                        fi
                        if [ -d /usr/share/oh-my-zsh ] && [ ! -e "${homedir}/.oh-my-zsh" ]; then
                            ln -s /usr/share/oh-my-zsh "${homedir}/.oh-my-zsh" 2>/dev/null || true
                        fi
                    fi
                done
            fi

            if [ -f /etc/default/useradd ]; then
                if grep -q '^SHELL=' /etc/default/useradd; then
                    sed -i 's|^SHELL=.*|SHELL=/usr/bin/zsh|' /etc/default/useradd 2>/dev/null || true
                else
                    echo 'SHELL=/usr/bin/zsh' >> /etc/default/useradd 2>/dev/null || true
                fi
            fi
            if [ -f /etc/adduser.conf ]; then
                if grep -q '^DSHELL=' /etc/adduser.conf; then
                    sed -i 's|^DSHELL=.*|DSHELL=/usr/bin/zsh|' /etc/adduser.conf 2>/dev/null || true
                else
                    echo 'DSHELL=/usr/bin/zsh' >> /etc/adduser.conf 2>/dev/null || true
                fi
            fi
        fi

        if [ -f /etc/default/sysstat ]; then
            sed -i 's/^ENABLED="false"/ENABLED="true"/' /etc/default/sysstat 2>/dev/null || true
        fi

        if [ "${AXONWALL_EDITION}" = "minimal" ] && [ ! -f /var/lib/axonwall/plugins-disabled.json ]; then
            mkdir -p /var/lib/axonwall
            printf '{"core-firewall":true,"core-nas":true,"core-k3s":true,"core-virt":true,"core-vigilante":true,"cli-workstation":true,"host-malware-rootkit":true,"coroot-ebpf-apm":true}\n' > /var/lib/axonwall/plugins-disabled.json
            chmod 0644 /var/lib/axonwall/plugins-disabled.json
        fi

        # 5c. Sync any regular systemd unit files in /etc/systemd/system/ so ISO-placed copies do not shadow updated /lib/systemd/system/ units
        # D-M9: the sync list is the edition's own unit set; syncing the
        # NGFW list on a flavor box would resurrect units the flavor
        # deliberately does not ship.
        # (Main's fc576368 instead skips k3s.service when either flavor
        # marker exists; that is subsumed here — k3s.service is absent
        # from the vault list, and on k3s-storage it is the flavor's
        # own unit, which must be synced, not skipped.)
        case "${AXONWALL_EDITION}" in
            minimal) UNITS="axonwalld.service axonwall-controller.service axonwall-ui.service axonwall-console.service axonwall-hub-cert-renew.service axonwall-hub-cert-renew.timer" ;;
            vault) UNITS="axonwall-console.service seaweedfs.service axonwall-vault-firstboot.service axonwall-vault-provision.service axonwall-hub-cert-renew.service axonwall-hub-cert-renew.timer" ;;
            k3s-storage) UNITS="axonwall-console.service k3s.service k3s-agent.service axonwall-k3s-firstboot.service axonwall-k3s-verify.service axonwall-hub-cert-renew.service axonwall-hub-cert-renew.timer" ;;
            *) UNITS="axonwalld.service axonwall-controller.service axonwall-ui.service axonwall-console.service headscale.service k3s.service axonwall-hub-cert-renew.service axonwall-hub-cert-renew.timer" ;;
        esac
        for unit in ${UNITS}; do
            if [ -f "/etc/systemd/system/${unit}" ] && [ ! -L "/etc/systemd/system/${unit}" ] && [ -f "/lib/systemd/system/${unit}" ]; then
                cp "/lib/systemd/system/${unit}" "/etc/systemd/system/${unit}" 2>/dev/null || true
            fi
        done

        # 5c-bis. Apply kernel hardening sysctl profile (SEC-M31) cleanly on live hosts
        if [ -f /etc/sysctl.d/95-axonwall-kernel-hardening.conf ]; then
            if [ -x /usr/lib/systemd/systemd-sysctl ]; then
                /usr/lib/systemd/systemd-sysctl /etc/sysctl.d/95-axonwall-kernel-hardening.conf >/dev/null 2>&1 || true
            elif [ -x /lib/systemd/systemd-sysctl ]; then
                /lib/systemd/systemd-sysctl /etc/sysctl.d/95-axonwall-kernel-hardening.conf >/dev/null 2>&1 || true
            elif command -v sysctl >/dev/null 2>&1; then
                sysctl -p /etc/sysctl.d/95-axonwall-kernel-hardening.conf >/dev/null 2>&1 || true
            fi
        fi

        # 5d. Configure Axonwall Plymouth graphical boot theme when plymouth is installed
        if [ -x /usr/sbin/plymouth-set-default-theme ] && [ -f /usr/share/plymouth/themes/axonwall/axonwall.plymouth ]; then
            /usr/sbin/plymouth-set-default-theme axonwall >/dev/null 2>&1 || true
            if [ -d /run/systemd/system ] && command -v update-initramfs >/dev/null 2>&1; then
                update-initramfs -u >/dev/null 2>&1 || true
            fi
        fi

        # 6. Reload systemd daemon and enable services if systemd is running
        # D-M9: enable/restart only the edition's own units (ssh,
        # chrony, sysstat stay shared). k3s is enabled but not
        # restarted on either edition that ships it, matching the
        # pre-existing NGFW behaviour for k3s.service.
        # (Main's fc576368 enables only ssh on k3s-storage and restarts
        # nothing on either flavor; the D-M9 lists below are kept —
        # they enable each flavor's own units and restart the shared
        # services, matching the pre-existing NGFW behaviour.)
        # R4-D-L5 (re-applied at the round-4 / PR #136 reconcile):
        # enable/restart failures used to be swallowed (`|| true`)
        # while dpkg still reported the package configured. Every
        # service in each edition's lists below is deliberately
        # started on that edition, so there is no "not started on
        # this edition" exception to apply here: an enable or restart
        # failure now fails the configure step (exit 1) in all three
        # branches. (The openssl self-signed fallback half of D-L5
        # is the round-3 D-L4 area; main already fails closed there.)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            case "${AXONWALL_EDITION}" in
                minimal)
                    if ! systemctl enable axonwalld.service axonwall-controller.service axonwall-ui.service axonwall-console.service axonwall-hub-cert-renew.timer ssh.service chrony.service; then
                        echo "Error: failed to enable Minimal Edition services; dpkg configure failed. Fix systemd and re-run dpkg --configure." >&2
                        exit 1
                    fi
                    if ! systemctl restart --no-block axonwalld.service axonwall-controller.service axonwall-ui.service ssh.service chrony.service; then
                        echo "Error: failed to restart Minimal Edition services; dpkg configure failed. Fix systemd and re-run dpkg --configure." >&2
                        exit 1
                    fi
                    ;;
                vault)
                    if ! systemctl enable seaweedfs.service axonwall-vault-firstboot.service axonwall-vault-provision.service axonwall-console.service axonwall-hub-cert-renew.timer ssh.service chrony.service sysstat.service; then
                        echo "Error: failed to enable Vault Edition services; dpkg configure failed. Fix systemd and re-run dpkg --configure." >&2
                        exit 1
                    fi
                    if ! systemctl restart --no-block seaweedfs.service axonwall-console.service ssh.service chrony.service sysstat.service; then
                        echo "Error: failed to restart Vault Edition services; dpkg configure failed. Fix systemd and re-run dpkg --configure." >&2
                        exit 1
                    fi
                    ;;
                k3s-storage)
                    if ! systemctl enable k3s.service k3s-agent.service axonwall-k3s-firstboot.service axonwall-k3s-verify.service axonwall-console.service axonwall-hub-cert-renew.timer ssh.service chrony.service sysstat.service; then
                        echo "Error: failed to enable K3s Storage Edition services; dpkg configure failed. Fix systemd and re-run dpkg --configure." >&2
                        exit 1
                    fi
                    if ! systemctl restart --no-block axonwall-console.service ssh.service chrony.service sysstat.service; then
                        echo "Error: failed to restart K3s Storage Edition services; dpkg configure failed. Fix systemd and re-run dpkg --configure." >&2
                        exit 1
                    fi
                    ;;
                *)
                    if ! systemctl enable axonwalld.service axonwall-controller.service axonwall-ui.service axonwall-console.service axonwall-hub-cert-renew.timer ssh.service chrony.service; then
                        echo "Error: failed to enable Axonwall services; dpkg configure failed. Fix systemd and re-run dpkg --configure." >&2
                        exit 1
                    fi
                    if ! systemctl restart --no-block axonwalld.service axonwall-controller.service axonwall-ui.service ssh.service chrony.service; then
                        echo "Error: failed to restart Axonwall services; dpkg configure failed. Fix systemd and re-run dpkg --configure." >&2
                        exit 1
                    fi
                    if systemctl is-active --quiet headscale.service 2>/dev/null; then
                        if ! systemctl restart --no-block headscale.service; then
                            echo "Error: failed to restart headscale.service; dpkg configure failed. Fix systemd and re-run dpkg --configure." >&2
                            exit 1
                        fi
                    fi
                    ;;
            esac
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
