#!/bin/sh
set -e

case "$1" in
    configure)
        # 1. Create axonwall system user and group if not already present
        if ! getent group axonwall >/dev/null 2>&1; then
            groupadd --system axonwall
        fi
        if ! getent passwd axonwall >/dev/null 2>&1; then
            useradd --system --gid axonwall --home-dir /var/lib/axonwall \
                --no-create-home --shell /usr/sbin/nologin \
                --comment "Axonwall Firewall System User" axonwall
        fi

        # Service-identity split (audit B-12): the controller runs as its own
        # user so a compromise of one Node service no longer yields the other
        # service's secrets. axonwall-api is the shared group for the daemon
        # sockets, the agent token and state traversal -- nothing else.
        if ! getent group axonwall-api >/dev/null 2>&1; then
            groupadd --system axonwall-api
        fi
        if ! getent group axonwall-controller >/dev/null 2>&1; then
            groupadd --system axonwall-controller
        fi
        if ! getent passwd axonwall-controller >/dev/null 2>&1; then
            useradd --system --gid axonwall-controller --home-dir /var/lib/axonwall \
                --no-create-home --shell /usr/sbin/nologin \
                --comment "Axonwall Controller Service User" axonwall-controller
        fi
        usermod -a -G axonwall-api axonwall 2>/dev/null || true
        usermod -a -G axonwall-api axonwall-controller 2>/dev/null || true

        # 2. Ensure directories exist with strict permissions
        mkdir -p /var/lib/axonwall /var/log/axonwall /run/axonwall /etc/axonwall/certs /opt/axonwall
        mkdir -p /var/lib/axonwall/headscale /run/headscale

        chown -R axonwall:axonwall-api /var/lib/axonwall /opt/axonwall
        chown -R axonwall:axonwall /var/log/axonwall
        chown -R axonwall:axonwall /var/lib/axonwall/headscale
        chown axonwall:axonwall-api /run/headscale
        chmod 0770 /var/lib/axonwall
        chmod 750 /var/log/axonwall /opt/axonwall
        chmod 770 /var/lib/axonwall/headscale /run/headscale

        chown root:axonwall-api /etc/axonwall /etc/axonwall/certs
        chmod 0770 /etc/axonwall
        chmod 0750 /etc/axonwall/certs
        if [ -f /etc/axonwall/admin.env ]; then
            chown axonwall /etc/axonwall/admin.env 2>/dev/null || true
            chmod 0600 /etc/axonwall/admin.env 2>/dev/null || true
        fi

        # 3. Generate baseline TLS certificates if absent
        if [ ! -s /etc/axonwall/certs/hub.crt ] || [ ! -s /etc/axonwall/certs/hub.key ]; then
            if command -v openssl >/dev/null 2>&1; then
                SAN="DNS:$(hostname 2>/dev/null || echo axonwall),DNS:axonwall.local,DNS:localhost,IP:127.0.0.1"
                openssl req -x509 -newkey rsa:2048 -nodes \
                    -keyout /etc/axonwall/certs/hub.key \
                    -out /etc/axonwall/certs/hub.crt \
                    -days 3650 \
                    -subj "/O=Axonwall/OU=Appliance/CN=$(hostname 2>/dev/null || echo axonwall)" \
                    -addext "subjectAltName=${SAN}" >/dev/null 2>&1 || true
            fi
        fi

        if [ -f /etc/axonwall/certs/hub.key ]; then
            # The controller is the only reader of the hub key (audit B-12).
            chown axonwall-controller:axonwall-controller /etc/axonwall/certs/hub.key /etc/axonwall/certs/hub.crt 2>/dev/null || true
            chmod 0600 /etc/axonwall/certs/hub.key 2>/dev/null || true
            chmod 0644 /etc/axonwall/certs/hub.crt 2>/dev/null || true
        fi

        # 4. Generate default environment secrets if absent
        if [ ! -s /etc/axonwall/axonwall.env ]; then
            JWT_SECRET=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' 2>/dev/null || echo "axonwall-secret-token")
            ZTP_TOKEN=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' 2>/dev/null || echo "axonwall-ztp")
            ADMIN_PASS="$(openssl rand -hex 16 2>/dev/null || od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"

            cat << ENV_EOF > /etc/axonwall/axonwall.env
JWT_SECRET=${JWT_SECRET}
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=${ADMIN_PASS}
AGENT_SOCKET_PATH=/run/axonwall/agent.sock
AGENT_API_SOCKET=/run/axonwall/agent-api.sock
ENV_EOF
            chmod 0600 /etc/axonwall/axonwall.env
            chown axonwall /etc/axonwall/axonwall.env

            cat << ENV_EOF > /etc/axonwall/controller.env
AXONWALL_ZTP_TOKEN=${ZTP_TOKEN}
ENV_EOF
            chmod 0600 /etc/axonwall/controller.env
            chown root:root /etc/axonwall/controller.env

            # No public default (audit C9): the generated admin password
            # is random; surface it to the operator only, exactly like
            # firstboot does. No .password_changed marker is planted, so
            # the first login still forces a change.
            printf '%s\n' "$ADMIN_PASS" > /etc/axonwall/initial-admin-password
            chmod 0600 /etc/axonwall/initial-admin-password
            chown root:root /etc/axonwall/initial-admin-password
        fi

        # 4b. B-12 migration for upgrades: split the ZTP token out of a
        # monolith axonwall.env written before the service-identity split,
        # and re-assert the split ownership (idempotent).
        if [ -f /etc/axonwall/axonwall.env ]; then
            chown axonwall /etc/axonwall/axonwall.env 2>/dev/null || true
            chmod 0600 /etc/axonwall/axonwall.env 2>/dev/null || true
            if [ ! -f /etc/axonwall/controller.env ] && grep -q '^AXONWALL_ZTP_TOKEN=' /etc/axonwall/axonwall.env; then
                grep '^AXONWALL_ZTP_TOKEN=' /etc/axonwall/axonwall.env > /etc/axonwall/controller.env || true
                chown root:root /etc/axonwall/controller.env 2>/dev/null || true
                chmod 0600 /etc/axonwall/controller.env 2>/dev/null || true
                sed -i '/^AXONWALL_ZTP_TOKEN=/d' /etc/axonwall/axonwall.env
            fi
        fi
        if [ -f /etc/axonwall/agent.token ]; then
            chown root:axonwall-api /etc/axonwall/agent.token 2>/dev/null || true
            chmod 0640 /etc/axonwall/agent.token 2>/dev/null || true
        fi

        # 5. Initialize etckeeper if installed
        if command -v etckeeper >/dev/null 2>&1; then
            if [ ! -d /etc/.git ]; then
                etckeeper init || true
                etckeeper commit "Initial etckeeper commit for Axonwall appliance" || true
            fi
        fi

        # 6. Reload systemd daemon and enable services if systemd is running
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl enable axonwalld.service axonwall-controller.service axonwall-ui.service headscale.service axonwall-console.service ssh.service || true
            systemctl try-restart axonwalld.service axonwall-controller.service axonwall-ui.service headscale.service ssh.service || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

exit 0
