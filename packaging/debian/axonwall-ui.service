[Unit]
Description=Axonwall Web Console & API Server
Documentation=https://github.com/axonwall/axonwall
After=network.target axonwalld.service axonwall-firstboot.service
Wants=axonwalld.service
ConditionPathExists=!/etc/axonwall/.vault-edition
ConditionPathExists=!/etc/axonwall/.k3s-edition
ConditionKernelCommandLine=!axonwall_install=1
ConditionKernelCommandLine=!axonwall.install=1
ConditionKernelCommandLine=!axonwall.unattended=1

[Service]
Type=simple
User=axonwall
Group=axonwall
SupplementaryGroups=axonwall-api
WorkingDirectory=/opt/axonwall/apps/axonwall
EnvironmentFile=-/etc/axonwall/axonwall.env
EnvironmentFile=-/etc/axonwall/admin.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5s
LimitCORE=0

# Sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/axonwall /var/cache/axonwall-ui /etc/axonwall -/run/headscale -/run/axonwall
InaccessiblePaths=-/var/lib/axonwall/secrets -/var/lib/axonwall/ldap -/var/lib/axonwall/headscale -/var/lib/axonwall/vault -/var/lib/axonwall/home

[Install]
WantedBy=multi-user.target
