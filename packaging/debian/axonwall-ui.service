[Unit]
Description=Axonwall Web Console & API Server
Documentation=https://github.com/axonwall/axonwall
After=network.target axonwalld.service axonwall-firstboot.service
Wants=axonwalld.service

[Service]
Type=simple
User=axonwall
Group=axonwall
SupplementaryGroups=axonwall-api
WorkingDirectory=/opt/axonwall/apps/axonwall
EnvironmentFile=-/etc/axonwall/axonwall.env
EnvironmentFile=-/etc/axonwall/admin.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5s

# Sandboxing
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/axonwall /var/lib/axonwall /etc/axonwall -/run/headscale /run/axonwall

[Install]
WantedBy=multi-user.target
