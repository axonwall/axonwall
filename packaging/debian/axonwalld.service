[Unit]
Description=Axonwall Privileged Firewall & Networking Daemon
Documentation=https://github.com/axonwall/axonwall
After=local-fs.target network-pre.target systemd-sysctl.service
Requires=local-fs.target
Before=network.target
Wants=network-pre.target
DefaultDependencies=no
ConditionKernelCommandLine=!axonwall_install=1
ConditionKernelCommandLine=!axonwall.install=1
ConditionKernelCommandLine=!axonwall.unattended=1

[Service]
Type=simple
ExecStartPre=/usr/sbin/nft -f /usr/share/axonwall/lockdown.nft
ExecStart=/usr/sbin/axonwalld --socket /run/axonwall/agent.sock --boot-apply
Restart=always
RestartSec=3s
KillMode=process

# Privilege Separation & Sandboxing
User=root
Group=axonwall-api
RuntimeDirectory=axonwall
RuntimeDirectoryMode=0770
LogsDirectory=axonwall

# Sandboxing
ProtectSystem=false
ReadWritePaths=/etc /var/lib/axonwall /var/log/axonwall /run /home /usr/share/axonwall /boot
ProtectHome=false
PrivateTmp=true
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
