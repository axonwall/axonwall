[Unit]
Description=Axonwall Privileged Firewall & Networking Daemon
Documentation=https://github.com/axonwall/axonwall
After=network-pre.target systemd-sysctl.service
Before=network.target
Wants=network-pre.target
DefaultDependencies=no

[Service]
Type=simple
ExecStartPre=/usr/sbin/nft -f /usr/share/axonwall/lockdown.nft
ExecStart=/usr/sbin/axonwalld --socket /run/axonwall/agent.sock --boot-apply
Restart=always
RestartSec=3s
KillMode=process

# Privilege Separation & Sandboxing
User=root
Group=axonwall
RuntimeDirectory=axonwall
RuntimeDirectoryMode=0770
StateDirectory=axonwall
LogsDirectory=axonwall

# Linux Capabilities
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# Sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
