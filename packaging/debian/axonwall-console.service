[Unit]
Description=Axonwall Appliance Terminal Console
After=axonwalld.service axonwall-ui.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
ExecStart=/usr/sbin/axonwall-console
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
