[Unit]
Description=Axonwall Appliance Terminal Console
After=systemd-user-sessions.service plymouth-quit-wait.service axonwall-firstboot.service axonwall-vault-firstboot.service
Before=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
ExecStart=/usr/sbin/axonwall-console
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
