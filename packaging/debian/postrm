#!/bin/sh
set -e

case "$1" in
    purge)
        rm -rf /run/axonwall /run/headscale
        # Preserving /var/lib/axonwall and /etc/axonwall unless user explicitly removes
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
    *)
        ;;
esac

exit 0
