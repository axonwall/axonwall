[Unit]
Description=Axonwall Vault Firstboot Provisioner
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/axonwall/.vault-firstboot
ConditionKernelCommandLine=!axonwall_install=1
ConditionKernelCommandLine=!axonwall.install=1
ConditionKernelCommandLine=!axonwall.unattended=1

[Service]
Type=oneshot
ExecStart=/usr/local/bin/axonwall-vault-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
