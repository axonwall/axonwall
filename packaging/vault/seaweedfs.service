[Unit]
Description=Axonwall Vault storage (SeaweedFS)
Documentation=https://github.com/seaweedfs/seaweedfs
After=network-online.target nftables.service axonwall-vault-firstboot.service
Wants=network-online.target
Requires=nftables.service
# Enabled in the image but inert until firstboot has written the S3
# identity config; the ordering edge lives here (never in the firstboot
# unit) so no service ever starts a unit it is ordered against.
ConditionPathExists=/etc/axonwall/seaweedfs-s3.json
ConditionKernelCommandLine=!axonwall_install=1
ConditionKernelCommandLine=!axonwall.install=1
ConditionKernelCommandLine=!axonwall.unattended=1

[Service]
Type=simple
User=axonwall-vault
Group=axonwall-vault
# All-in-one SeaweedFS: master + volume + filer + S3 gateway.
# Vault posture (Phase 0 bench findings, all mandatory):
#   -filer.disableHttp=true          the filer HTTP surface can delete
#                                    locked buckets; S3 uses gRPC instead
#   -s3.allowDeleteBucketNotEmpty=false
#                                    AWS semantics; the upstream default
#                                    (true) destroys non-empty buckets
#   -s3.autoCreateBucket=false       bucket creation is a provisioning act
# Only the S3 port (8333, TLS) binds 0.0.0.0 behind nftables.service; the
# master (9333/19333), volume (8080/18080), and filer (8888/18888)
# admin listeners are bound strictly to 127.0.0.1, and auxiliary Iceberg
# (8181) / Lance (9101) listeners are disabled.
ExecStart=/usr/sbin/weed server \
  -dir=/var/lib/axonwall/vault \
  -ip=127.0.0.1 \
  -ip.bind=127.0.0.1 \
  -master.port=9333 \
  -volume.port=8080 \
  -master.volumeSizeLimitMB=5120 \
  -filer.port=8888 \
  -filer.disableHttp=true \
  -s3 \
  -s3.ip.bind=0.0.0.0 \
  -s3.port=8333 \
  -s3.port.iceberg=0 \
  -s3.port.lance=0 \
  -s3.config=/etc/axonwall/seaweedfs-s3.json \
  -s3.allowDeleteBucketNotEmpty=false \
  -s3.autoCreateBucket=false \
  -s3.cert.file=/etc/axonwall/certs/hub.crt \
  -s3.key.file=/etc/axonwall/certs/hub.key
Restart=on-failure
RestartSec=5
# SeaweedFS takes ~20s to release its ports on shutdown (Phase 0 note);
# do not SIGKILL it into a half-drained state.
TimeoutStopSec=90
LimitNOFILE=65536
LimitCORE=0

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/axonwall/vault
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
