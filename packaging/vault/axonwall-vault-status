#!/bin/sh
# axonwall-vault-status -- read-only status report for a Vault Edition
# appliance: service liveness, bucket lock posture, stored data volume,
# disk, and clock. Uses the vault admin credential over the loopback
# endpoint only; prints no secrets.
#
# Environment: same variables as axonwall-vault-provision, plus
#   VAULT_DATA_DIR   default /var/lib/axonwall/vault
set -u

CONF_DIR="${VAULT_CONF_DIR:-/etc/axonwall}"
BUCKET="${VAULT_BUCKET:-backups}"
ENDPOINT="${VAULT_S3_ENDPOINT:-http://127.0.0.1:8333}"
CACERT="${VAULT_S3_CACERT:-}"
DATA_DIR="${VAULT_DATA_DIR:-/var/lib/axonwall/vault}"
ADMIN_ENV="$CONF_DIR/vault-admin.env"
STAMP="$CONF_DIR/vault-provisioned-at"

HOSTPORT="$(printf '%s' "$ENDPOINT" | sed -e 's|^https\?://||' -e 's|/.*$||')"

# --- SigV4 signing (POSIX sh + openssl) -----------------------------------
# s3_req ACCESS SECRET METHOD PATH QUERY BODYFILE [EXTRA-HEADER ...]
# Prints the response body on stdout; the HTTP status is left in
# $S3_STATUS and response headers in the file $S3_HDRS.
# (Block shared verbatim with axonwall-vault-provision.)
s3_req() {
    _ak="$1"; _sk="$2"; _method="$3"; _path="$4"; _query="$5"; _body="$6"; shift 6
    _amzdate="$(date -u +%Y%m%dT%H%M%SZ)"
    _datestamp="$(date -u +%Y%m%d)"
    if [ -n "$_body" ]; then
        _payload_hash="$(openssl dgst -sha256 "$_body" | sed -e 's/^.*= *//')"
    else
        _payload_hash="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    fi
    _hdr_file="$(mktemp)"
    {
        printf 'host:%s\n' "$HOSTPORT"
        printf 'x-amz-content-sha256:%s\n' "$_payload_hash"
        printf 'x-amz-date:%s\n' "$_amzdate"
        for _h in "$@"; do
            _n="$(printf '%s' "$_h" | cut -d: -f1 | tr 'A-Z' 'a-z')"
            _v="$(printf '%s' "$_h" | cut -d: -f2- | sed -e 's/^ *//')"
            printf '%s:%s\n' "$_n" "$_v"
        done
    } | LC_ALL=C sort > "$_hdr_file"
    _signed="$(cut -d: -f1 "$_hdr_file" | paste -sd';' -)"
    _canon_body="$(mktemp)"
    _canon_query="$(printf '%s' "$_query" | awk -F'&' 'BEGIN{OFS="&"} {for(i=1;i<=NF;i++){if(index($i,"=")==0) $i=$i"="}; print}')"
    {
        printf '%s\n%s\n%s\n' "$_method" "$_path" "$_canon_query"
        cat "$_hdr_file"
        printf '\n%s\n%s' "$_signed" "$_payload_hash"
    } > "$_canon_body"
    _canon_hash="$(openssl dgst -sha256 "$_canon_body" | sed -e 's/^.*= *//')"
    _scope="$_datestamp/us-east-1/s3/aws4_request"
    _string_to_sign="AWS4-HMAC-SHA256
$_amzdate
$_scope
$_canon_hash"
    _k1="$(printf '%s' "$_datestamp" | openssl dgst -sha256 -hmac "AWS4$_sk" -binary | od -An -tx1 | tr -d ' \n')"
    _k2="$(printf '%s' 'us-east-1' | openssl dgst -sha256 -mac HMAC -macopt hexkey:"$_k1" -binary | od -An -tx1 | tr -d ' \n')"
    _k3="$(printf '%s' 's3' | openssl dgst -sha256 -mac HMAC -macopt hexkey:"$_k2" -binary | od -An -tx1 | tr -d ' \n')"
    _k4="$(printf '%s' 'aws4_request' | openssl dgst -sha256 -mac HMAC -macopt hexkey:"$_k3" | sed -e 's/^.*= *//')"
    _signature="$(printf '%s' "$_string_to_sign" | openssl dgst -sha256 -mac HMAC -macopt hexkey:"$_k4" | sed -e 's/^.*= *//')"
    _auth="AWS4-HMAC-SHA256 Credential=$_ak/$_scope, SignedHeaders=$_signed, Signature=$_signature"
    _url="$ENDPOINT$_path"
    [ -n "$_query" ] && _url="$_url?$_query"
    S3_HDRS="$(mktemp)"
    _curl_hdr_args=""
    while IFS= read -r _line; do
        _curl_hdr_args="$_curl_hdr_args
$_line"
    done < "$_hdr_file"
    rm -f "$_hdr_file" "$_canon_body"
    _resp_body_tmp="$(mktemp)"
    # Build the curl invocation with one -H per signed header, without eval:
    _args_file="$(mktemp)"
    {
        echo "-s"
        echo "-D"; echo "$S3_HDRS"
        echo "-o"; echo "$_resp_body_tmp"
        echo "-w"; echo "%{http_code}"
        echo "-X"; echo "$_method"
        [ -n "$CACERT" ] && { echo "--cacert"; echo "$CACERT"; }
        echo "-H"; echo "Authorization: $_auth"
        while IFS= read -r _line; do echo "-H"; echo "$_line"; done <<EOF
$(printf '%s' "$_curl_hdr_args" | tail -n +2)
EOF
        [ -n "$_body" ] && { echo "--data-binary"; echo "@$_body"; }
        echo "$_url"
    } > "$_args_file"
    S3_STATUS="$(xargs -a "$_args_file" -d '\n' curl 2>/dev/null)"
    rm -f "$_args_file"
    cat "$_resp_body_tmp"
    rm -f "$_resp_body_tmp"
}

echo "== Axonwall Vault status =="
echo "time (UTC):   $(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ -f "$STAMP" ]; then echo "provisioned:  $(cat "$STAMP")"; else echo "provisioned:  (no stamp -- run axonwall-vault-provision --ensure)"; fi

_code="$(curl -s -o /dev/null -w '%{http_code}' ${CACERT:+--cacert "$CACERT"} "$ENDPOINT/" 2>/dev/null || echo 000)"
if [ "$_code" = "000" ]; then
    echo "s3 endpoint:  DOWN ($ENDPOINT unreachable)"
    exit 1
fi
echo "s3 endpoint:  up ($ENDPOINT, HTTP $_code unauthenticated)"

if [ -d "$DATA_DIR" ]; then
    echo "data dir:     $DATA_DIR"
    df -h "$DATA_DIR" | tail -1 | awk '{print "  filesystem: " $1 "  size " $2 "  used " $3 "  avail " $4 "  (" $5 " used)"}'
    echo "  stored:     $(du -sh "$DATA_DIR" 2>/dev/null | cut -f1) on disk"
else
    echo "data dir:     $DATA_DIR (missing)"
fi

if [ ! -f "$ADMIN_ENV" ]; then
    echo "bucket:       (no admin credentials at $ADMIN_ENV -- not provisioned)"
    exit 1
fi
# shellcheck disable=SC1090
. "$ADMIN_ENV"

_cfg_tmp="$(mktemp)"
s3_req "$VAULT_ADMIN_ACCESS_KEY" "$VAULT_ADMIN_SECRET_KEY" GET "/$BUCKET" "object-lock" "" > "$_cfg_tmp"
_cfg_status="$S3_STATUS"
_cfg="$(cat "$_cfg_tmp")"; rm -f "$_cfg_tmp"
if [ "$_cfg_status" != "200" ]; then
    echo "bucket:       $BUCKET (object-lock config unreadable, HTTP $_cfg_status)"
    exit 1
fi
_mode="$(printf '%s' "$_cfg" | grep -o '<Mode>[^<]*</Mode>' | head -1 | sed -e 's/<[^>]*>//g')"
_days="$(printf '%s' "$_cfg" | grep -o '<Days>[^<]*</Days>' | head -1 | sed -e 's/<[^>]*>//g')"
echo "bucket:       $BUCKET"
echo "  object lock: Enabled, default retention ${_mode:-unknown} ${_days:-?}d"

_list_tmp="$(mktemp)"
s3_req "$VAULT_ADMIN_ACCESS_KEY" "$VAULT_ADMIN_SECRET_KEY" GET "/$BUCKET" "list-type=2&max-keys=1000" "" > "$_list_tmp"
_list_status="$S3_STATUS"
_list="$(cat "$_list_tmp")"; rm -f "$_list_tmp"
if [ "$_list_status" = "200" ]; then
    _count="$(printf '%s' "$_list" | grep -o '<KeyCount>[0-9]*</KeyCount>' | sed -e 's/<[^>]*>//g')"
    _bytes="$(printf '%s' "$_list" | grep -o '<Size>[0-9]*</Size>' | sed -e 's/<[^>]*>//g' | awk '{s += $1} END {print s + 0}')"
    _trunc="$(printf '%s' "$_list" | grep -o '<IsTruncated>[a-z]*</IsTruncated>' | sed -e 's/<[^>]*>//g')"
    _trunc_note=""
    [ "$_trunc" = "true" ] && _trunc_note=" (listing truncated at 1000)"
    echo "  objects:    ${_count:-0} visible (latest versions, first page) totalling ${_bytes:-0} bytes$_trunc_note"
else
    echo "  objects:    (listing failed, HTTP $_list_status)"
fi
echo "note: locked versions and delete markers are not shown in the object count;"
echo "      immutability posture is proven by axonwall-vault-provision --verify."
