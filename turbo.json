{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "AXONWALL_*",
    "JWT_SECRET",
    "LOCAL_ADMIN_*",
    "AGENT_API_*",
    "LDAP_*",
    "PORT",
    "HOST",
    "SUDO_UID",
    "SUDO_GID",
    "SUDO_USER",
    "XDG_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
