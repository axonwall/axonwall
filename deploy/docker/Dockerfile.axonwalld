# Multi-stage build for axonwalld (Privileged Go Daemon & Unprivileged ModeCollector)
FROM golang:1.27-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS builder

WORKDIR /src
COPY apps/axonwalld/go.mod apps/axonwalld/go.sum* ./
RUN go mod download

COPY apps/axonwalld ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/axonwalld .

FROM debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

RUN apt-get update && apt-get install -y --no-install-recommends \
    nftables \
    iproute2 \
    procps \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1001 axonwall \
    && useradd --system --uid 1001 --gid 1001 --no-create-home axonwall \
    && mkdir -p \
      /run/axonwalld \
      /run/axonwall \
      /etc/axonwall/managed \
      /var/lib/axonwall/bundles \
      /var/lib/axonwall/telemetry-spool \
      /var/log/axonwall \
    && chown -R 1001:1001 /run/axonwalld /run/axonwall /etc/axonwall /var/lib/axonwall /var/log/axonwall \
    && chmod 0775 /run/axonwalld /run/axonwall /etc/axonwall /etc/axonwall/managed /var/lib/axonwall /var/lib/axonwall/bundles /var/lib/axonwall/telemetry-spool /var/log/axonwall

COPY --from=builder /bin/axonwalld /usr/sbin/axonwalld
COPY packaging/debian/lockdown.nft /usr/share/axonwall/lockdown.nft

ENTRYPOINT ["/usr/sbin/axonwalld"]
CMD ["--socket", "/run/axonwalld/agent.sock", "--boot-apply"]
