# Multi-stage build for Axonwall Next.js Web Console
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS builder
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json biome.json ./
COPY packages/axonwall_lib ./packages/axonwall_lib
COPY apps/axonwall ./apps/axonwall
COPY apps/axonwall-controller ./apps/axonwall-controller

RUN pnpm install --frozen-lockfile
RUN pnpm build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/axonwall/public ./apps/axonwall/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/axonwall/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/axonwall/.next/static ./apps/axonwall/.next/static

USER nextjs
EXPOSE 3000

CMD ["node", "apps/axonwall/server.js"]
